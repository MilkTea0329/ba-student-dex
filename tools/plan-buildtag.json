{
  "url": "http://127.0.0.1:8123/_test-update.html",
  "width": 390, "height": 844, "dpr": 2, "outDir": "shots/reg",
  "preScript": "window.__errs=[];window.addEventListener('error',function(e){window.__errs.push(e.message)});",
  "shots": [
    { "name": "Z1", "wait": 3500, "after": 200,
      "js": "(function(){var m=document.getElementById('update-modal');if(m){var b=document.querySelector('[data-act=modal-close]');if(b)b.click();}document.querySelector('[data-tab=rank]').click();return 'ok'})()" },
    { "name": "Z2-jp", "after": 7000, "wait": 300,
      "js": "(function(){var sel=document.querySelector('.rseason.on');return {sel:sel?sel.textContent:null,meta:(document.querySelector('.rankmeta')||{}).innerText,tiers:Array.from(document.querySelectorAll('.rankcard')).map(function(c){return c.innerText.split('\\n')[1]}),soon:document.querySelectorAll('.rseason.soon').length}})()" },
    { "name": "Z3-more", "after": 400, "wait": 100,
      "js": "(function(){document.querySelector('[data-tab=more]').click();return new Promise(function(r){setTimeout(function(){r({version:(document.getElementById('app-version')||{}).textContent,rows:Array.from(document.querySelectorAll('.rowlink')).slice(4,7).map(function(x){return x.textContent.replace(/\\s+/g,' ').trim()})})},800)})})()" }
  ]
}
