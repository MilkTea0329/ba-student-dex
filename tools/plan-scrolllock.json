{
  "url": "http://127.0.0.1:8123/index.html",
  "width": 390,
  "height": 844,
  "dpr": 3,
  "outDir": "shots",
  "preScript": "window.__errs=[];window.addEventListener('error',function(e){window.__errs.push('error: '+e.message)});",
  "shots": [
    { "name": "U1-scroll-page", "wait": 1700, "after": 400,
      "js": "(function(){window.scrollTo(0,600);return {before:Math.round(window.scrollY)}})()" },
    { "name": "U2-open", "after": 600, "wait": 100,
      "js": "(function(){document.querySelector('[data-act=filter-open]').click();var b=document.body;var sb=document.querySelector('.sheet-body');return {bodyPos:b.style.position,bodyTop:b.style.top,windowScrollY:Math.round(window.scrollY),overscroll:getComputedStyle(sb).overscrollBehaviorY}})()" },
    { "name": "U3-scroll-inner", "after": 500, "wait": 100,
      "js": "(function(){var sb=document.querySelector('.sheet-body');sb.scrollTop=sb.scrollHeight;return {sheetScroll:Math.round(sb.scrollTop),pageScrollY:Math.round(window.scrollY)}})()" },
    { "name": "U4-close", "after": 700, "wait": 100,
      "js": "(function(){document.querySelector('.sheet-foot .btn.primary').click();return {bodyPos:document.body.style.position,windowScrollY:Math.round(window.scrollY),errs:window.__errs}})()" }
  ]
}
