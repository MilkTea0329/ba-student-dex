{
  "url": "http://127.0.0.1:8123/_test-update.html",
  "width": 390, "height": 844, "dpr": 2, "outDir": "shots/reg",
  "preScript": "window.__errs=[];",
  "shots": [
    { "name": "F1", "wait": 3500, "after": 200,
      "js": "(function(){var m=document.getElementById('update-modal');if(m){var b=document.querySelector('[data-act=modal-close]');if(b)b.click();}document.querySelector('[data-tab=rank]').click();return 'ok'})()" },
    { "name": "F2-cn", "after": 6000, "wait": 200,
      "js": "(function(){var b=Array.from(document.querySelectorAll('[data-act=rank-server]')).filter(function(x){return x.dataset.s==='cn'})[0];b.click();return 'ok'})()" },
    { "name": "F3-cn-verify", "after": 6000, "wait": 200,
      "js": "(function(){var sel=document.querySelector('.rseason.on');return {jp:null,cn:sel?sel.textContent:null,meta:(document.querySelector('.rankmeta')||{}).innerText}})()" }
  ]
}
