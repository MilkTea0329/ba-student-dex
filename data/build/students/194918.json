/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！ですよ～！","zh":"这里是碧蓝档案~！"},{"label":"卡池抽取","jp":"おや…お目が高いでね、お客様……いえ、先生！\n……申し遅れました。ワイルドハント芸術学院2年、若狭フユです。以後、お見知りおきを！","zh":"哎呀…您真是好眼光啊，这位客人…呃，老师！\n……恕我冒昧。这里是狂猎艺术学院二年级学生，若狭冬。今后请多指教！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしてましたよ、先生！","zh":"正等着您呢，老师！"},{"label":"登陆2","jp":"さあ、おかけください。ビジネスの話と参りましょう。","zh":"请坐，我们来谈谈业务上的事吧。"},{"label":"大厅1","jp":"ふむ、これが内勤の仕事ですか……。","zh":"唔唔，这就是内勤的工作内容啊……"},{"label":"大厅2","jp":"どうです？特殊交易部顧問の椅子は、いつでも空けてありますよ？","zh":"怎么样？特殊交易部顾问的位置，随时为你空着哦？"},{"label":"大厅4","jp":"落ち着きますねぇ……\nちょっとくらい肩の力を抜いても……ふわぁ。","zh":"真让人放松呢……\n稍微让肩膀放松一下也没关系吧……呼啊。"},{"label":"大厅5","jp":"もう……そんなにつっつくなら……\n隙間を埋めちゃいますよ？\nぴったりくっついたら、イタズラできませんよね？","zh":"真是的……既然您这样步步紧逼的话……\n我可要把缝隙全都填满哦？\n要是完全贴紧的话，您就没办法使坏了吧？"},{"label":"回忆大厅1","jp":"ここは、スクリーンの裏側です。\nつまり、舞台裏……。","zh":"这里是荧幕的背面。\n也就是说，幕后……"},{"label":"回忆大厅2","jp":"作家だけが出入りできる空間です。\nここに入る唯一の方法は……\n作家である私に許可を取ること。","zh":"这是只有作家才能进出的空间。\n进入这里的唯一方法……\n就是获得身为作家的我的许可。"},{"label":"回忆大厅3","jp":"だから、ここは今――\n先生と私、二人……きりの……。","zh":"所以，此刻这里——\n只有老师和我，两个人……独处的……"},{"label":"回忆大厅4","jp":"って！いやいやいや！\nそ、そうじゃなくてですね！\nとにかく！お弁当を作ってきたんですけど……。","zh":"等、等等！不、不是这样的！\n我、我不是那个意思！\n总、总之！我做了便当要给您……"},{"label":"回忆大厅5","jp":"えっと、もし、よろしければ……。\n……一緒に、食べませんか？","zh":"那个…如果您不介意的话……\n……要一起……吃吗？"},{"label":"咖啡馆1","jp":"へぇ、打ち合わせ場所に良さそうだね。","zh":"欸，这地方挺适合接头的嘛。"},{"label":"咖啡馆2","jp":"スクリーンを設置するならどこがいいかな……。","zh":"要安个屏幕的话，装在哪里好呢……"},{"label":"咖啡馆3","jp":"（ここのコーヒー、中々いい豆を使ってるね……これも仕入れてみようかな？）","zh":"（这里的咖啡豆用得相当不错呢……要不要也进点货试试？）"},{"label":"咖啡馆4","jp":"ところで……先生は来ないのかな。","zh":"话说回来……老师不在吗。"},{"label":"咖啡馆5","jp":"（あれは……寮監隊！？どうしよう……逃げる！？）","zh":"（那是……舍监队！？怎么办……要逃吗！？）"}],"好感度":[{"label":"好感度1","jp":"メディアに、芸術……私なりに教えて差し上げましょうか？","zh":"媒体、艺术……要不要让我来教教您这些呢？"},{"label":"好感度2","jp":"おかしいですよね。先生としゃべっていると、つい時間を忘れちゃうんです。","zh":"真奇怪呢。和老师聊天时，不知不觉就会忘记时间。"},{"label":"好感度3","jp":"あの……映画はお好きですか？えっ……あ、いえ、他意は無いんですが……！","zh":"那个……老师喜欢看电影吗？诶……啊，不是，我没别的意思！"},{"label":"好感度4","jp":"いつでも会えるのに……。なぜでしょう。手元に置いておきたい、と思ってしまうのは……。","zh":"明明随时都能见到老师……但不知为何，我却总想着要把您留在手边……"}],"战斗":[{"label":"编入队伍1","jp":"ええ、後悔はさせませんとも。","zh":"嗯，保证不会让您后悔的。"},{"label":"编入队伍2","jp":"お求めの品は……「勝利」、ですかね？","zh":"您想要的商品是……“胜利”，对吧？"},{"label":"拎起","jp":"ふふっ……うあぁっとと！……ふぅ。","zh":"呵呵......呜哇等等......呼。"},{"label":"任命队长1","jp":"さて、市場調査といきますか。","zh":"那么，开始市场调研吧。"},{"label":"任命队长2","jp":"どんなモノがあれば勝てるかな……。","zh":"要有什么东西才能赢呢……"},{"label":"普通技能","jp":"ふふ、いい物揃ってますよ？","zh":"呵呵，好货色还真不少。"},{"label":"EX动画1","jp":"しーっ、今見たものは企業秘密ですよ？","zh":"嘘——，刚刚那个是商业机密哦？"},{"label":"EX动画2","jp":"どうです？カッコよかったでしょう？","zh":"怎样？看着不错吧？"},{"label":"EX动画3","jp":"さあ、バレないうちにずらかりますよ！","zh":"好了，趁还没被发现赶紧溜吧！"},{"label":"EX技能1","jp":"弾丸、お届けにあがりました！","zh":"您的子弹到货了！"},{"label":"EX技能2","jp":"お届けは迅速かつ丁寧に！","zh":"送货要又快又稳！"},{"label":"EX技能3","jp":"どんな相手だろうとお客様ですから！お届けに参りました！","zh":"不论对方是谁都是我的顾客！我给您送货来了！"},{"label":"战斗开始1","jp":"さあ、「勝利」を仕入れに行きますよ！","zh":"好，去采购点“胜利”吧！"},{"label":"战斗开始2","jp":"補給はお任せあれ。","zh":"补给包在我身上吧。"},{"label":"获得BUFF","jp":"お代はツケといてください……！","zh":"费用就先赊着吧……！"},{"label":"施放BUFF","jp":"商品は自分で試しておかないとですからね！","zh":"商品当然得先自己用过才行呢！"},{"label":"掩体","jp":"はぁ～隠れられた……！","zh":"呼~能藏起来了……！"},{"label":"回避","jp":"ふ、ふふっ、こ、この程度……！","zh":"呵、呵呵呵，就、就这种程度的攻击……！"},{"label":"队伍移动1","jp":"さあ、行きましょう！","zh":"走，出发吧！"},{"label":"队伍移动2","jp":"リラックスリラックス～","zh":"放轻松放轻松~"},{"label":"回复","jp":"お取引、ありがとうございます……！","zh":"感谢您的惠顾……！"},{"label":"中途退出","jp":"もう〜疲れた...","zh":"啊~累死了……"},{"label":"战斗胜利1","jp":"スムーズなお取引でしたね。","zh":"顺利的交易呢。"},{"label":"战斗胜利2","jp":"後で高評価の方、よろしくお願いしますよ。","zh":"之后麻烦给个好评哦。"},{"label":"关卡完成1","jp":"ふふ、予想通りです。","zh":"呵呵，不出所料。"},{"label":"关卡完成2","jp":"「勝利」をお届けに参りました。あ、ハンコはこちらに。","zh":"您的“胜利”到货了。啊，印章请盖在这里。"},{"label":"战斗失败1","jp":"はうぅぅ...ごめんなさい...","zh":"呜……对不起……"},{"label":"战斗失败2","jp":"調子こいですみません","zh":"对不起刚刚我得意忘形了……"}],"成长":[{"label":"升级1","jp":"一体、どこでこんなものを……！ありがとうございます、先生！","zh":"到底是从哪里弄来这些……！非常感谢，老师！"},{"label":"升级2","jp":"えっ、投資……こんなに！？ふふっ、失望はさせませんよ！","zh":"诶，投资……这么多！？呵呵，我绝不会让您失望的！"},{"label":"升级3","jp":"私にここまで……？……なにか、どうしても欲しいモノでもあるんですか？","zh":"为我做到这种地步……？……您莫非，有什么非得到不可的东西？"},{"label":"升级4","jp":"ありがとうございます。ご期待には、必ず……！","zh":"非常感谢。我一定不负您的期待……！"},{"label":"获得专武","jp":"受けた投資にはそれ以上のリターンを。\nそれがビジネスですからね！なので……いつか恩返しできるその時まで、そばにいてください、先生。","zh":"投资必须获得超额回报。\n这才是商业法则呢！所以……\n在我能报答您之前，请一直留在我身边吧，老师。"}],"事件":[{"label":"学生生日","jp":"誕生日プレゼント……\n私の欲しいモノ、ですか……。\nモノはいらないので……一日、先生のお時間を\nいただけませんか？","zh":"生日礼物吗……\n说我想要的东西啊……\n比起物品……更想要老师一整天的时间呢，可以吗？"},{"label":"老师生日","jp":"ハッピーバースデー！先生！\nお祝いの動画を作ってきたのですが……\nい、一緒に観ませんか……？","zh":"生日快乐！老师！\n为你做了庆祝生日的视频……\n要、要不要一起看看……？"},{"label":"万圣节","jp":"少々お待ちください、先生。\nちょうど、新鮮なカボチャを手に入れましたので！","zh":"请稍等，老师。\n正好刚到手新鲜的南瓜呢！"},{"label":"新年","jp":"明けましておめでとうございます、先生。\n……はい？ああ、これですか？\n昨日の録画データです。\nテレビでやってた、除夜の鐘の。締めて108回分。\nさて……これをどう\n芸術にしましょうかね。","zh":"新年快乐，老师。\n…嗯？啊，这个吗？\n是昨天的录像呢。电视里播放的除夕钟声，完整录了108下。\n那么……该怎样把这份声音变成艺术呢？"},{"label":"圣诞节","jp":"ちょうど、仕入れてきたサンタ服があるんですけど……。\nき、気になりますか……？","zh":"正好，刚入手了一套圣诞服装......\n想、想看吗......？"}],"活动":[{"label":"活动登陆1","jp":"特殊交易部の営業室長！\n若狭フユです！","zh":"这里是特殊交易部销售部长！\n若狭冬！"},{"label":"活动登陆2","jp":"なにか欲しいものがありましたら、お気軽にご相談ください。","zh":"如果有任何需要，请随时咨询。"},{"label":"活动大厅1","jp":"ええ、特殊交易部の窓口担当は私です。","zh":"嗯嗯，这里是特殊交易部的窗口负责人。"},{"label":"活动大厅2","jp":"接触し、依頼につなげて、お客様に満足を提供する……。\nそれが、私の役割です。","zh":"主动接触、承接委托，为客人提供满意的服务……\n这是我的职责。"},{"label":"活动大厅3","jp":"ミヨとリッちゃんのサポートがなかったら、\n私なんてただの一芸術学院生にすぎませんから。","zh":"如果没有美代和律酱的支持，我不过就是个普通的艺术学院学生罢了。"},{"label":"活动大厅4","jp":"……芸術って、難しいんですよね。","zh":"……艺术啊，太难了吧。"},{"label":"活动事件1","jp":"ふ、ふふ……\nいつも通りですね。\n問題ありません。","zh":"呵，呵呵……\n还是老样子呢。\n没问题。"},{"label":"活动事件2","jp":"（どうして……？どこで間違えちゃったの……？）\n（もう終わり？そうだよね？やっぱ終わりだよね！？）","zh":"（为什么……？到底哪里做错了……？）\n（已经结束了吗？是吧？果然还是结束了吧！？）"},{"label":"活动结束","jp":"ふ……ふふ……\nこの手の依頼、しばらくはやめとこうかな……。","zh":"……呵呵……\n这类委托，还是暂时先不接了吧……"},{"label":"活动商店1","jp":"ここには無いものが欲しい……？\n……お話はあちらで伺いましょうか。","zh":"想要这里没有的东西……？\n...不如移步详谈？"},{"label":"活动商店2","jp":"ははっ！つっついても、安くなりませんよ？","zh":"哈哈！戳我也不能给你便宜一点噢？"},{"label":"活动商店关闭","jp":"まだしばらくは大丈夫ですよ。ごゆっくりどうぞ。","zh":"没关系哦。不用着急。"},{"label":"活动商店登陆1","jp":"在庫は十分ありますよ。\nどうぞ、心ゆくまで見て行ってください。","zh":"库存十分充足哟。\n请随心挑选看看吧。"},{"label":"活动商店登陆2","jp":"欲しいものは見つかりましたか？","zh":"找到想买的东西了吗？"},{"label":"活动商店购买1","jp":"さすが先生。お目が高いですね。","zh":"不愧是老师。眼光真好。"},{"label":"活动商店购买2","jp":"それ、私のイチオシなんです。","zh":"那个，是我强烈推荐的。"},{"label":"活动商店购买3","jp":"返品交換はできませんので。\nご了承ください。","zh":"无法退换商品，敬请谅解。"},{"label":"活动商店购买4","jp":"ナイスチョイスです。\nこちら、お包みしますか？","zh":"不错的选择。\n需要帮您包起来吗？"}]},"stats":{"init":[{"name":"攻击力","value":"274"},{"name":"防御力","value":"16"},{"name":"生命值","value":"2057"},{"name":"治愈力","value":"1423"},{"name":"命中值","value":"108"},{"name":"闪避值","value":"1010"},{"name":"暴击值","value":"216"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"916"},{"name":"射程","value":"550"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"20"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"3116"},{"name":"防御力","value":"88"},{"name":"生命值","value":"26065"},{"name":"治愈力","value":"4898"},{"name":"命中值","value":"108"},{"name":"闪避值","value":"1010"},{"name":"暴击值","value":"216"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"916"},{"name":"射程","value":"550"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"20"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"135%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"626"},{"name":"生命值","value":"3873"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"徽章","grade":"T10","attrs":[{"name":"生命值","value":"16000"},{"name":"受恢复率","value":"3500"},{"name":"生命值","value":"25%"}]},{"slot":"3号装备","name":"项链","grade":"T10","attrs":[{"name":"治愈力","value":"42%"},{"name":"群控强化力","value":"38%"},{"name":"攻击力","value"