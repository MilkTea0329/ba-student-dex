[{"name":"生命值","value":"962"},{"name":"攻击力","value":"131"},{"name":"治愈力","value":"207"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 白子","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/50495.png","url":"https://www.gamekee.com/ba/46677.html"},{"name":"★3 白子（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/818483.png","url":"https://www.gamekee.com/ba/161196.html"},{"name":"★3 白子*恐怖","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/134620.png","url":"https://www.gamekee.com/ba/162557.html"},{"name":"NPC 白子（1年级）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/114514.png","url":"https://www.gamekee.com/ba/624154.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"-"},{"label":"卡池抽取","jp":"あっ。うん、ライディング中だったの。\n先生も一緒にどう？まずは軽く200kmくらい。","zh":"我正骑行，老师要不要一起先简单骑个200公里左右。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生。今から一緒にライディングに行かない？","zh":"你来了，老师。\n要不要跟我一起去骑行？"},{"label":"登陆2","jp":"待ってたよ。今度はどこに行こっか？","zh":"我正等着你呢，这次该去哪里转转呢？"},{"label":"大厅1","jp":"最近はケイデンスを上げるために練習してるの。\n低いギアでペダルをもっと速く回す方式だよ。","zh":"最近我正在做提高频的练习，就是使用低档齿轮更快的踩动踏板。"},{"label":"大厅2","jp":"最近委員会の活動で忙しくて、ライディングをする時間があまりなくって。\nだから今日は久しぶりに走ってみようと思う。","zh":"最近在忙对策委员会的事，都没什么时间骑行了，所以今天我想痛快的骑一下。"},{"label":"大厅3","jp":"先生もライディング、やってみない？\n私が前で風を防ぐから先生はついてきてくれればいい。\nそうすればきっと走りやすいと思うから。","zh":"老师要不要也试试骑行，我在前面破风，\n老师跟在后面就好，这样能轻松不少。\n大厅4"},{"label":"大厅4","jp":"買いたい部品はいっぱいあるけど……\n我慢するしかないか。自転車の部品って高いから。","zh":"虽然有好多想买的配件，不过自行车配件太贵，只能忍一忍了。"},{"label":"大厅5","jp":"実はこのジャージ、お揃いのものなんだけど、\nみんなに着たくないって言われちゃって……。\nとりあえず一人で着てる。","zh":"其实这套运动服是统一服装，\n不过因为大家都不想穿，所以暂时就只有我穿着而已。"},{"label":"回忆大厅1","jp":"……ありがと、先生。","zh":"谢谢你，老师。"},{"label":"回忆大厅2","jp":"その、何て言うのかな……。\nこんな風にしっかり誰かにサポートしてもらったの、初めてで……。","zh":"该怎么说呢？\n我还是第一次像这样被人支持着。"},{"label":"回忆大厅3","jp":"……先生と一緒にいると、毎日色々、新しい事が起きるね。","zh":"和老师在一起，每天都会遇到各种新鲜事呢。"},{"label":"回忆大厅4","jp":"（……？何でだろ。心臓の音、止まらない……）","zh":"心跳声停不下来。"},{"label":"回忆大厅5","jp":"……変なの。こういうのも、初めて。","zh":"好奇怪，这种感觉也是第一次。\n咖啡馆1"},{"label":"咖啡馆1","jp":"途中でバテないように、カロリーを摂取しておかないと。","zh":"必须摄取足量卡路里，路上才不会累。"},{"label":"咖啡馆2","jp":"グループライディングも楽しそうだけど……。","zh":"组队骑行应该也会很开心。"},{"label":"咖啡馆3","jp":"今日の平均速度は……うん、ちょっと速くなった感じ……。","zh":"今天的平均速度感觉比平时稍微快一些。"},{"label":"咖啡馆4","jp":"うーん……汗を乾かしたいけど。","zh":"我想先擦擦汗。"},{"label":"咖啡馆5","jp":"次はどこに行ってみようかな……。","zh":"下次要去哪儿呢？"}],"好感度":[{"label":"好感度1","jp":"一緒に過ごせて楽しい、先生。","zh":"和老师在一起很开心。"},{"label":"好感度2","jp":"次もよろしくね。","zh":"下次也请多关照的。"},{"label":"好感度3","jp":"気にかけてくれてありがとう。","zh":"多谢关心。"},{"label":"好感度4","jp":"ん……またお世話になってしまった……。","zh":"又麻烦你了。"}],"战斗":[{"label":"编入队伍1","jp":"ん、準備は出来てる。","zh":"准备好了。"},{"label":"编入队伍2","jp":"私？分かった。","zh":"我知道了。"},{"label":"拎起","jp":"んん…。","zh":"唔…。"},{"label":"任命队长1","jp":"作戦は完璧。始めよう。","zh":"完美的作战计划，开始吧。"},{"label":"任命队长2","jp":"作戦開始。大丈夫、私について来て。","zh":"战斗开始。没关系，跟我来。"},{"label":"EX动画1","jp":"これを出す時が来たね。","zh":"是时候拿出这个了。"},{"label":"EX动画2","jp":"出すつもりなかったんだけど。","zh":"本来没准备用它的。"},{"label":"EX动画3","jp":"むぅ、仕方ない。","zh":"没办法了。"},{"label":"EX技能1","jp":"ライディング用グレネードだよ。","zh":"骑行专用手榴弹。"},{"label":"EX技能2","jp":"自転車乗りの必需品だよ。","zh":"骑行必备。"},{"label":"EX技能3","jp":"効果抜群。","zh":"效果出众。"},{"label":"战斗开始1","jp":"さあ、出発しよう。","zh":"那么出发吧。"},{"label":"战斗开始2","jp":"始めよう。","zh":"开始吧。"},{"label":"获得BUFF","jp":"ありがとう。","zh":"-"},{"label":"施放BUFF","jp":"準備完了。","zh":"准备完毕。"},{"label":"掩体","jp":"いったん隠れる。","zh":"藏好了。"},{"label":"被CC1","jp":"-","zh":"-"},{"label":"被CC2","jp":"-","zh":"-"},{"label":"被CC3","jp":"これじゃ…。","zh":"这样的话。"},{"label":"回避","jp":"うん、問題ない。","zh":"没问题。"},{"label":"队伍移动1","jp":"移動するよ。行こう。","zh":"准备出发"},{"label":"队伍移动2","jp":"うん、じゃ次。","zh":"下一个"},{"label":"回复","jp":"ありがとう、確かに受け取った。","zh":"谢谢，确实收到了。"},{"label":"中途退出","jp":"ごめん、こんなことになるなんて…","zh":"对不起，没想到会变成这样。"},{"label":"战斗喊叫","jp":"そこ！","zh":"那边。"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"角色移动","jp":"まだまだやれる。","zh":"就是这种感觉。"},{"label":"战斗胜利1","jp":"うん…","zh":"-"},{"label":"战斗胜利2","jp":"ふぅ…。お疲れ様。","zh":"辛苦了。"},{"label":"关卡完成1","jp":"うん、想定通り。","zh":"符合预期。"},{"label":"关卡完成2","jp":"先生の指揮のおかげ。","zh":"多亏了老师的指挥。"},{"label":"战斗失败1","jp":"準備が足りなかったみたい。","zh":"看来是我准备不足。"},{"label":"战斗失败2","jp":"作戦、完璧だったはずなのに…。","zh":"作战计划明明很完美啊。"}],"成长":[{"label":"升级1","jp":"トレーニングはずっと欠かしてない。もっともっと強くなれるはず。","zh":"我一直在训练，应该能变得更强。"},{"label":"升级2","jp":"まだまだ成長期、かも。","zh":"我还在成长期，大概。"},{"label":"升级3","jp":"先生、いつも助けてくれてありがとう。","zh":"老师，谢谢你一直以来的帮助。"},{"label":"升级4","jp":"これでもっとスピードが出せるようになるはず。","zh":"这样应该就能更快的。"},{"label":"获得专武","jp":"これはライディング用に特別に改造された軽量型個人向け火器。\n軽いから素早い戦術行動が可能になるし、\nもちろん長距離のライディングの時も負担にならないの。","zh":"这是专为骑行特别改良过的轻量型单兵武器，因为轻便，可以采取更敏捷的战术行动，当然长途骑行时负担也比较小。"}],"事件":[{"label":"学生生日","jp":"私の誕生日？……ああ。\nもうそんな日か……\nあ、ありがとう。","zh":"我的生日？\n时间过得真快啊，谢……谢谢。"},{"label":"老师生日","jp":"今日って、先生のお誕生日……？\nそれじゃお祝いの意味で……\nライディング、行く？","zh":"生日嘛，\n为了庆祝老师的生日，要不要一起骑行？"},{"label":"万圣节","jp":"あ……ハロウィーン……今日だったっけ。\nえーと……それじゃあ、トリックオアライディング……？","zh":"万圣节原来就在今天，那不骑行就捣蛋。"},{"label":"新年","jp":"日の出が見られる山岳コースを知ってるの。\n一晩中走って、頂上から日が昇るのを見るんだ。\n一緒に行かない？標高２０００mくらいだから。","zh":"我知道一条可以看日出的山地路线，骑一晚上正好能在山顶看太阳升起，要不要一起去？海拔才2000米而已。"},{"label":"圣诞节","jp":"こんな日にも自転車かって？\nうーん……特に約束もなかったから……。\nだったら、今から先生と約束があったことにしよっか。\nえ、ライディング抜きで？う、うーん……。","zh":"这种日子也骑自行车？\n因为我也没有别的约会，所以现在陪老师也可以啊\n不能去骑行？哦……"},{"label":"春节","jp":"","zh":"是新年，今天先休息一天，老师新的一年也请多多指教了。"},{"label":"中秋","jp":"","zh":"偶尔在月光下骑行，也是很新鲜的体验呢。"}]},"stats":{"init":[{"name":"攻击力","value":"352"},{"name":"防御力","value":"18"},{"name":"生命值","value":"236