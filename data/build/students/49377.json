4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/214226.png","name":"長生不老的靈藥（失敗作）","desc":"沙耶以巧克力為基底做成的新款靈藥。因為味道和普通的巧克力並無二致，或許也能算是普通的巧克力"},"ability":{"attrs":[{"name":"生命值","value":"780"},{"name":"攻击力","value":"88"},{"name":"治愈力","value":"221"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/660262.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/790465.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 纱绫（私服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/707601.png","url":"https://www.gamekee.com/ba/87912.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"ぼく様、登場！\n今回の実験の被検体はどこだ","zh":"小爷我闪亮登场！这次的实验对象……在哪儿呢？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰り、先生。ちょうど新薬を実験するために呼ぼうとしていたのだ。","zh":"老师，你回来啦~正好想找你，试验一下新药呢！"},{"label":"登陆2","jp":"何？まだぼく様に会いたくて来たの？仕方ないな","zh":"什么……又是想小爷我了才来的嘛？唉……真拿你没办法~"},{"label":"大厅1","jp":"ぼく様は！偉大なのだ！","zh":"小爷我，很——了不起哒！"},{"label":"大厅2","jp":"ネズ助はハムスターなのかな？それともモルモットなのかな？正解は…次回なのだ！","zh":"鼠鼠是仓鼠还是豚鼠呢~正确答案……下期揭晓啦~"},{"label":"大厅3","jp":"世界的に、歴史的に、一番愛されたキャラクターはいつもネズミだったのだ～！","zh":"放眼世界，纵观历史，最受喜爱的角色，一直都是老鼠哒！"},{"label":"大厅4","jp":"毒と薬は、使い道で変わってくる両刃の剣だよね！","zh":"同一样东西，可以是毒，也可以是药。区别只在于用法的不同！"},{"label":"大厅5","jp":"可愛いモルモットだね。一緒にぼく様と実験をしないか","zh":"好可爱的豚鼠啊~要不要和小爷我一起做实验呐~"},{"label":"回忆大厅1","jp":"ぼく様らしくない、こんなミスをするなんて。\nなんてことだ…。先生から目が離せない…！","zh":"小爷我这是怎么了……居然会犯这种错误……怎会如此……总是忍不住……想看看老师！"},{"label":"回忆大厅2","jp":"先生、ぼくの前から離れ…\nやっぱり、離れないで！このまま…少しだけ一緒にいて…。","zh":"老师……你要不……走开……嗯……算了，就、就在这吧！就这样……陪我……待一会吧……"},{"label":"回忆大厅3","jp":"うう…困ったのだ。\nでも、どうしても先生から目が離せない…。","zh":"嗯……太伤脑筋了……可是……真的老忍不住想看老师……！\n回忆大厅4"},{"label":"回忆大厅4","jp":"今ぼくの目には先生が…とっても美味しいチーズの塊に見えるのだ！","zh":"老师现在在我眼里……就像是一块超级好吃的奶酪块"},{"label":"回忆大厅5","jp":"ダメだ、先生…ちょっとだけ、一口…一口だけ噛ませてくれない？","zh":"不行了……老师……我不贪心……一口！就让我咬你一口好不好……！"},{"label":"咖啡馆1","jp":"あっ、どっかからチーズの匂いがするのだ！","zh":"哇，闻到一股奶酪的味道呢！"},{"label":"咖啡馆2","jp":"ネズ助、この！暴れるな！","zh":"鼠鼠！你这个家伙，不要乱跑！"},{"label":"咖啡馆3","jp":"ふふ、この部屋。ぼく様の実験室として使ってもいいかも","zh":"哼哼，这个房间啊，给小爷我当实验室用，感觉应该还不错"},{"label":"咖啡馆4","jp":"次回はメイを相手に何の実験をしようかな？","zh":"下回在梅身上，做什么实验好呢~"},{"label":"咖啡馆5","jp":"これぐらいの温度と湿度なら、ぼく様の可愛い菌たちが育つのにとても良さそうだね。ふーふっふっふ…","zh":"这里的温度和湿度，很适合小爷我的宝贝们成长~嗯哼哼哼~"}],"好感度":[{"label":"好感度1","jp":"偉大なぼく様と仲良くなるチャンスなんて先生にとってすっごいお得なことなのだ！","zh":"和伟大的小爷我搞好关系的机会，老师可不能错过啊~"},{"label":"好感度2","jp":"ぼく様の研究はすべて機密事項だけど、先生になら少しだけ見せてもいいのだ。","zh":"小爷我所有的研究都是保密的~不过……可以稍微给老师看一点点~"},{"label":"好感度3","jp":"先生と一緒なら、どんな難題でも簡単に解決できそう","zh":"有了老师，感觉任何难题都可以轻松解决！"},{"label":"好感度4","jp":"もしかして、チーズ、好き？先生にもぼく様と同じものを好きでいてほしいんだけど……。","zh":"该不会你也喜欢……奶酪？要是老师也和小爷我喜欢一样的东西就好了~"}],"战斗":[{"label":"编入队伍1","jp":"ようやくぼく様の新薬を発揮できる時が来たのだ。","zh":"终于到了展现小爷我真正价值的时候了~"},{"label":"编入队伍2","jp":"ふふん、ぼく様の活躍を期待しているといいのだ。","zh":"哼哼，等着看小爷我大展身手吧"},{"label":"拎起","jp":"ちょっと待ってなぁ。ぼく様に乱暴が許さないのだ。","zh":"慢着慢着……！不许对小爷我如此无礼！"},{"label":"任命队长1","jp":"新しい武器を実験する番だな！","zh":"该实验新武器啦！"},{"label":"任命队长2","jp":"皆、ハムスターは連れて来たか？行くのだ！","zh":"各位，都带好仓鼠了吗？出发啦~！"},{"label":"普通技能","jp":"実験記録001、観察開始！","zh":"实验记录001，观察开始！"},{"label":"EX动画1","jp":"さあ、それではぼく様の傑作を試してみようか！","zh":"好~！那就试试小爷我的杰作吧~！"},{"label":"EX动画2","jp":"ふふふふっ、いってらっしゃいなのだネズ助！","zh":"嗯哼哼哼哼~鼠鼠~路上小心啊~！"},{"label":"EX动画3","jp":"この瞬間を待っているのだ！","zh":"就等着现在呐！"},{"label":"EX技能1","jp":"割れろ！","zh":"我摔！"},{"label":"EX技能2","jp":"平がれ！","zh":"扩散吧！"},{"label":"EX技能3","jp":"これ一つで身動きできなくなるぞ！","zh":"只要用了这个，你就会动弹不得喽！"},{"label":"战斗开始1","jp":"実験を始めるのだ。","zh":"实验开始喽！"},{"label":"战斗开始2","jp":"行こう、ネズ助！","zh":"鼠鼠，走吧！"},{"label":"被CC1","jp":"な、なに！？","zh":"什……什么！"},{"label":"被CC2","jp":"ひぃ","zh":"噫！"},{"label":"被CC3","jp":"うわ！","zh":"哇！"},{"label":"回复","jp":"この回復薬、気にいった。","zh":"这个回复药，我喜欢！"},{"label":"中途退出","jp":"ネズ助…お前だけでも……","zh":"鼠鼠……你要……活下去……"},{"label":"战斗喊叫","jp":"はぁ！","zh":"哈！"},{"label":"战斗喊叫","jp":"くらえ！","zh":"吃我这招！"},{"label":"战斗喊叫","jp":"やっ！","zh":"耶！"},{"label":"战斗胜利1","jp":"予想通りの展開だったのだ。","zh":"果然不出所料啦~"},{"label":"战斗胜利2","jp":"なんだ、ひ弱いそうな敵ばかりじゃん、つまんないのだ","zh":"都是什么虾兵蟹将啊，无聊死了！"},{"label":"关卡完成1","jp":"うははは！勝利！","zh":"嗯哈哈哈哈~胜利~！"},{"label":"关卡完成2","jp":"うははは！当然の結果なのだ！","zh":"嗯哈哈哈~这是理所当然的结果啦~！"},{"label":"战斗失败1","jp":"ご、誤差が発生しただけなのだ！","zh":"只……只是有点误差而已啦！"},{"label":"战斗失败2","jp":"こんな結果を許されないのだー！","zh":"我才不接受这样的结果——！"}],"成长":[{"label":"升级1","jp":"なんだこれ？ものすごい力を感じるのだ。","zh":"怎么回事……！我感受到了一股巨大的力量呢！"},{"label":"升级2","jp":"グレードアップしたのだ。","zh":"升级啦~！"},{"label":"升级3","jp":"ふふふふっ、もっと面白い実験ができそうだ！","zh":"哼哼哼哼~感觉可以做更多有意思的实验啦~"},{"label":"升级4","jp":"もっと、もっと強くなりたい！","zh":"我还要变强，变得更强~！"},{"label":"获得专武","jp":"ぼく様の拳銃がやっと届いたのか。もちろん、この恐ろしい細菌兵器に比べれば、優しいレベルだけど。","zh":"小爷我的手枪终于到啦~当然，和我研究的其他恐怖兵器比起来，这把枪算是很温柔啦！"}],"事件":[{"label":"学生生日","jp":"ぼく様の誕生日をお祝ってくれるの？見た目によらず記憶力がいいね、先生！日曜日にも出勤するから、日にちが数えられないと思っていたのに...！","zh":"祝贺小爷我过生日……？看不出来啊~老师的记忆力不错嘛！看你周日也上班，还以为你……不识数呐！"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。うんっ？なんで誕生日を覚えているか？それりゃぁ、研究者として当たり前の心得だから。","zh":"生日快乐，老师~哦？为什么会记得你的生日？这是研究人员的基本素养嘛"},{"label":"万圣节","jp":"ハロウィンに市内を歩くあの死体たちは、一体どんな薬を注射されたのだ？\nぼく様の知らない薬があるんなんて、悔しいー！","zh":"万圣节在城里走动的那些躯壳，到底是用什么药物呢……！居然还有小爷我不知道的药……真不甘心！"},{"label":"新年","jp":"今年をよろしくなのだ、先生。今年こそ絶対不老不死霊薬を作って見せるよ！","zh":"今年也多指教啦，老师~！今年一定要把长生不老的灵药，研究出来！"},{"label":"圣诞节","jp":"巨大なプレゼント袋を担いでいた老人が、キヴォトスの全境をうろずくシーズンが来たのだ。あの老人は一体どんな薬を飲んだらあれだけ元気になれるんだろう…","zh":"又到了那个背着大袋礼物的老人走遍基沃托斯全境的季节啦！嗯……那个老人究竟吃了什么药，年纪那么大了，身体还能这么硬朗！"},{"label":"春节","jp":"","zh":"新春快乐，老师~今年小爷我，会研究出更厉害的灵药！老师要记得来帮忙做实验啊~"},{"label":"中秋","jp":"","zh":"老师，中秋节快乐~小爷我在月饼里，加了些新做的灵药。要不要尝尝~？诶，怎么跑了……！"}]},"stats":{"init":[{"name":"攻击力","value":"237"},{"name":"防御力","value":"20"},{"name":"生命值","valu