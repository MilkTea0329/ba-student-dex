25574muy18szr.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/14687271muy194ez.webp"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/98243175muxxagn3.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/78409466muxxao86.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/72856367muy17wlu.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/31287961muy183op.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/21080239muy18bvs.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/04125574muy18szr.webp","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/1017575/2026/9/7/14687271muy194ez.webp"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"这个不用写"},{"name":"攻击力","value":"这个不用写"},{"name":"治愈力","value":"这个不用写"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ、アンド・ピース。","zh":"Blue Archive，与和平。"},{"label":"卡池抽取","jp":"ワイルドハント芸術学院、オカルト研究会の\n椎名ツムギです。ええ、ギターは持っていますよ――\n「ラブ・アンド・ピース」。……は大事ですから。","zh":"我是狂猎艺术学院神秘学研究会的椎名䌷。\n嗯，我是带着吉他的哦，毕竟——\n「爱与和平」……是很重要的。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。\n今日も私の芸術に――\nお付き合いください。","zh":"你好，老师。\n今天也请陪我一起——\n沉浸于我的艺术吧。"},{"label":"登陆2","jp":"ふふっ、心弾む一日に\nなりそうです。……先生も、\nそう思いませんか？","zh":"呵呵，今天看来会是让人心潮澎湃的一天呢。\n……老师，你不这么觉得吗？"},{"label":"大厅1","jp":"音楽は魂の共通言語……そう言われています。言葉を交わさずとも、互いの心に触れ合うことができますから。では、一曲――\n聞いていただけますか？","zh":"音乐是灵魂的通用语言……人们是这么说的。\n因为就算不交谈，也能触碰到彼此的心。那么，一曲——能请您听听看吗？"},{"label":"大厅2","jp":"人魚姫は、愛する人のために自らの声を差し出しました。ええ、それはあまりに気高く――美しい決断です。ふふっ……私にもいつか、それほどの感情を抱ける方が現れるのでしょうか？","zh":"人鱼公主为了心爱的人献出了自己的声音。嗯，那是何等高贵——而美丽的决断。\n呵呵……有朝一日，我的生命里也会出现让我怀抱那般感情的人吗？"},{"label":"大厅3","jp":"意外と、童話のオリジナルは残酷な物語が多いんです。当時、子どものために紡がれたものではなかったからなのでしょう。芸術とはそういうもの……時代の潮流によっていかようにでも形を変えるのです。","zh":"意外的是，童话的原版里残酷的故事还挺多的。\n大概是因为当年它们并不是为孩子而编织的吧。\n艺术就是这样的东西……会随时代的潮流，改变成任何形态。"},{"label":"大厅4","jp":"先生にとってのデスメタルとは、どのようなものですか？私にとっては――――「人生」。……でしょうか。デスメタルに触れてから、私の物語に色が増えたのですから。もちろん、良い意味ですよ？ふふっ。","zh":"对老师来说，死亡金属是什么样的东西？对我来说——是「人生」……大概吧。\n因为自从接触了死亡金属，我的故事就增添了色彩。当然是好的意义上哦？呵呵。"},{"label":"大厅5","jp":"デスメタルをはじめたきっかけ……ですか？ふふっ、内緒です。誰にだって、一つや二つくらいあるでしょう？――「聖域」に\n隠した謎、が。","zh":"我接触死亡金属的契机……吗？呵呵，保密。不管是谁，都会有一两个的吧？\n——藏在「圣域」里的谜团，之类的。"},{"label":"回忆大厅0","jp":"誰の心にだって、\n闇は存在するもの。それぞれ悩みを抱え、\n迷い――道を歩んでいる。","zh":"无论谁的心中，都存在着黑暗。\n各自怀着烦恼，迷茫——走在自己的道路上。"},{"label":"回忆大厅1","jp":"――私も、そうです。この道で良いのか、と。\n悩む時もあります。","zh":"——我也一样。\n也会烦恼，想着这条路究竟对不对。"},{"label":"回忆大厅2","jp":"そんな私に、\n先生は言ってくれましたよね。私が自由に――後悔のない日々を\n過ごせるよう、支える、と。","zh":"对那样的我，老师你对我说过吧。\n会支持我，让我能自由地——度过没有后悔的日子。"},{"label":"回忆大厅3","jp":"ですから、先生は……。――「私の闇を照らす光」\nだったのです。","zh":"所以，老师你……。\n——就是「照亮我黑暗的光」。"},{"label":"回忆大厅4","jp":"私の光であるあなたへ、\nこの曲を捧げましょう。感謝を込めた、旋律を……\n聞いてください。","zh":"这首曲子，献给你——我的光芒。\n饱含感谢的，旋律……请聆听。"},{"label":"咖啡馆1","jp":"ふふっ、ここで\nライブを\nしてみたいですね。","zh":"呵呵，真想在这里办一场现场演出呢。"},{"label":"咖啡馆2","jp":"あの飾り……\n打楽器に\n使えそうですね。","zh":"那个装饰……\n好像能当打击乐器用呢。"},{"label":"咖啡馆3","jp":"この辺りなら\n「お菓子の家」を\n作れそうです。","zh":"在这一带的话好像能搭一座「糖果屋」。"},{"label":"咖啡馆4","jp":"BGMを流すなら……\nデスメタルが\nぴったりですね","zh":"要放背景音乐的话……\n死亡金属再合适不过了呢"},{"label":"咖啡馆5","jp":"ここは、みなさんの\n思い出が宿る場所……\n私にとっても、\nそうかもしれません。","zh":"这里是承载着大家回忆的地方……\n对我来说，或许也是如此。"}],"好感度":[{"label":"好感度1","jp":"音楽とは、アーティストと心を通わせること。\n……であるのなら、\n今この瞬間も音楽と呼べるのではないでしょうか？ふふっ。","zh":"所谓音乐，就是与艺术家心灵相通。\n……若真是如此，\n那此刻这个瞬间，不也可以称作音乐吗？呵呵。"},{"label":"好感度2","jp":"ふと……心の音色を奏でたくなりました。\n言葉にできない想いも、旋律になら乗せることができますから。","zh":"忽然……想奏响心中的音色。\n因为无法言说的思念，\n若是用旋律，或许就能够承载。"},{"label":"好感度3","jp":"シンデレラの気持ちがいまなら理解できます。\n12時を目前にして……このまま、\n時間が止まってくれればいいのに、と。\nどれほど願ったことでしょう。","zh":"现在我终于理解灰姑娘的心情了。\n眼看着就要到12点……就这样，要是时间能停下来就好了。\n我曾无数次这样祈祷过。"},{"label":"好感度4","jp":"人は生きていく限り、変化していくもの。\nけれど、今のこの気持ちだけは……\n永遠に変わらないでほしい、とそう思っています。","zh":"人只要活着，就会不断变化。\n但是，唯有此刻这份心情……\n希望它永远不要改变，我是这么想的。"}],"战斗":[{"label":"编入队伍1","jp":"開演の準備は整っています。","zh":"开演的准备工作已经就绪。"},{"label":"编入队伍2","jp":"今日は何を聞きたいですか？","zh":"今天想听什么呢？"},{"label":"拎起","jp":"ふふっ、この子も、立派な楽器ですよ？","zh":"呵呵，这孩子也是件出色的乐器哦？"},{"label":"任命队长1","jp":"ここが、今宵のステージですね！","zh":"这里就是今宵的舞台呢！"},{"label":"任命队长2","jp":"ツムギ音楽隊、出発です！","zh":"䌷音乐队，出发！"},{"label":"普通技能","jp":"ふふ、インスピレーションが湧いてきました。","zh":"呵呵，灵感涌上来了。"},{"label":"EX动画1","jp":"饗宴の幕開けです。","zh":"饗宴开幕。"},{"label":"EX动画2","jp":"この瞬間を、待っていました。","zh":"我一直在等待这一刻。"},{"label":"EX动画3","jp":"みなさん、準備は良いですか？","zh":"各位，准备好了吗？"},{"label":"EX技能1","jp":"これが社会の福祉だぁぁ！！","zh":"这就是社会的福祉啊啊！！"},{"label":"EX技能2","jp":"平和……平和だけがあればいい！","zh":"和平……只要有和平就够了！"},{"label":"EX技能3","jp":"ラブ・アンド・ピーーーース！","zh":"爱与和——平——！"},{"label":"战斗开始1","jp":"悪魔の召喚儀式……ご一緒にいかがですか？","zh":"恶魔的召唤仪式……要不要一起来？"},{"label":"战斗开始2","jp":"さあ、鎮魂歌を奏でましょう。","zh":"来吧，奏响镇魂曲吧。"},{"label":"获得BUFF","jp":"「友情」……は大事ですから。","zh":"毕竟「友情」……是很重要的。"},{"label":"施放BUFF","jp":"BPMを上げていきましょう！","zh":"提高BPM（节拍）吧！"},{"label":"掩体","jp":"小休止としましょう。","zh":"稍作小憩吧。"},{"label":"被CC1","jp":"ああっ！","zh":"啊！"},{"label":"被CC2","jp":"あらっ！","zh":"哎呀！"},{"label":"被CC3","jp":"くっ…","zh":"呃…"},{"label":"回避","jp":"ふふっ、可愛いですね","zh":"呵呵，真可爱呢。"},{"label":"队伍移动1","jp":"パフォーマンスの場所を変えましょうか。","zh":"把表演的地点换一换吧。"},{"label":"队伍移动2","jp":"あちらで待っている方がいますね。","zh":"那边有正在等着的人呢。"},{"label":"回复","jp":"……温かい。","zh":"……好温暖。"},{"label":"中途退出","jp":"少し、はしゃぎすぎてしまったようです…","zh":"似乎有点得意忘形了…"},{"label":"战斗喊叫","jp":"えい！","zh":"嘿！"},{"label":"战斗喊叫","jp":"はっ！","zh":"哈！"},{"label":"战斗喊叫","jp":"ふふっ！","zh":"呵呵！"},{"label":"角色移动","jp":"せーのっ！","zh":"预~备！"},{"label":"战斗胜利1","jp":"次の饗宴を楽しみにしています。","zh":"期待下一场盛宴。"},{"label":"战斗胜利2","jp":"ラブ・アンド・ピース、ですね。","zh":"爱与和平，对吧。"},{"label":"关卡完成1","jp":"ふふっ、音楽隊の演奏はいかがでしたか？","zh":"呵呵，音乐队的演奏如何？"},{"label":"关卡完成2","jp":"公演の感想、ぜひお聞かせください","zh":"请务必告诉我您对演出的感想。"},{"label":"战斗失败1","jp":"ウサギの穴へ…あら、踏み外してしまいました…","zh":"去往兔子洞…哎呀，一脚踩空了…"},{"label":"战斗失败2","jp":"糸車の針に刺されて、深き微睡みへ、落ちてゆきます…","zh":"被纺车的针刺伤，向着深沉的微睡坠落…"}],"成长":[{"label":"升级1","jp":"先生のおかげで、降りてきました。作曲においては――\n「インスピレーション」\nが何よりも大事ですから。","zh":"多亏了老师，我才迎来了灵感。\n毕竟在作曲上——「灵感」\n比什么都重要。"},{"label":"升级2","jp":"ええ、喜ばしいことです。\n新しい成長の扉を開くことができるのですから。","zh":"嗯，这是值得高兴的事。\n因为能够打开新的成长之门。"},{"label":"升级3","jp":"ふふっ……奥底で眠っていた何かが、\n今、目覚めた気がします。","zh":"呵呵……我感觉沉睡在深处的\n某样东西，此刻苏醒了。"},{"label":"升级4","jp":"成長を実感したとしても、自惚れてはいけません。\n果てなき芸術の世界では――\n――「チャレンジ」。\n……が大事ですから。","zh":"就算切实感受到成长，也不能自满。\n在无尽的艺术世界里——「挑战」。\n……是很重要的。"},{"label":"获得专武","jp":"ありがとうございます、先生。\nこの子がいれば、\nどこでも演奏会が開けそうです。\n平和へと導く――煉獄の旋律を。","zh":"谢谢你，老师。\n有了这孩子，感觉在哪里都能开演奏会。\n奏响引领向和平的——炼狱之旋律。"}],"事件":[{"label":"学生生日","jp":"よく、友人の誕生日に歌を歌っているのですが……。先生は、どのようにお祝いをなさるのですか？よければ……私のために、歌っていただけませんか？","zh":"我经常在朋友生日的时候唱歌……。老师是怎样庆祝的呢？可以的话……能为我，唱一首吗？"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。先生のためのバースデーソング――ええ、ありきたりなものであってはいけません。私の方でアレンジしてみたのですが……聞いていきますか？","zh":"生日快乐，老师。献给老师的生日歌——嗯，可不能是平庸之作。\n我这边试着重新编曲了……要听听看吗？"},{"label":"万圣节","jp":"今日ほど、デスメタルが似合う日もないと思います。では、始めましょうか。戻ってきた魂に捧げる、鎮魂歌を。","zh":"我想没有比今天更适合死亡金属的日子了。那么，开始吧。为归来的亡魂献上的，镇魂曲。"},{"label":"新年","jp":"まるで何も書き込まれていないスコアのような日、ですね。あけましておめでとうございます、先生。私とこの楽譜に――新たな音を刻んでいきましょう。","zh":"就像是还没写上任何音符的乐谱的一天这样呢。新年快乐，老师。\n让我们在这份乐谱上——与我一起刻下新的音符吧。"},{"label":"圣诞节","jp":"今年の楽章も、そろそろ終わりが近づいてきましたね。先生の一年は、どんな旋律でしたか？明るいものであったなら……私も嬉しいです。","zh":"今年的乐章，也快要接近终点了呢。\n老师的一年，是怎样的旋律呢？若是明朗的旋律……我也会很高兴的。"}],"活动":[{"label":"活动登陆1","jp":"ようこそ。夢と\n希望のワンダーランドへ。","zh":"欢迎。来到充满梦想与希望的仙境。"},{"label":"活动登陆2","jp":"ふふっ、先生を導く\nことができて光栄です。","zh":"呵呵，能引导老师，\n是我的荣幸。"},{"label":"活动大厅1","jp":"先生もコープス・\nペイントを\nしてみませんか？私にお任せください。\n素敵に仕上げて\n見せますよ？","zh":"老师要不要也试试尸妆？\n就交给我吧。\n我会帮你化得很漂亮的哦？"},{"label":"活动大厅2","jp":"…やはり、バニーガールの\n格好でお迎えすべきで\nしたでしょうか？","zh":"……果然，我应该穿兔女郎装来迎接才对吗？"},{"label":"活动大厅3","jp":"私のギターは、\n平和を歌っています。……ええ、\n嘘はついてませんとも。","zh":"我的吉他，歌唱着和平。\n……嗯，我可没有说谎。"},{"label":"活动大厅4","jp":"ふふっ。\nセッションで触れる\n魂の共鳴も素敵ですが……指先のふれあいも、\n大切にしていきたい\nですね。","zh":"呵呵。\n合奏时触及的灵魂共鸣固然美妙……\n但指尖的触碰，我也想好好珍惜呢。"},{"label":"活动事件1","jp":"みなさんの努力が、\n実を結びますように。","zh":"愿大家的努力，都能结出果实。"},{"label":"活动事件2","jp":"そろそろ……\nエンディングの\nお時間ですね。饗宴の準備は\nできています。","zh":"差不多……\n到终章的时间了呢。\n饗宴已经准备好了。"},{"label":"活动结束","jp":"先生の魂に残る\n調べであったのなら、\n幸いです。","zh":"这旋律若是能留在老师的灵魂中，那就太好了。"}]},"stats":{"init":[{"name":"攻击力","value":"305"},{"name":"防御力","value":"174"},{"name":"生命值","value":"3856"},{"name":"治愈力","value":"1356"},{"name":"命中值","value":"103"},{"name":"闪避值","value":"232"},{"name":"暴击值","value":"206"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1356"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"24(4)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4880"},{"name":"防御力","value":"2659"},{"name":"生命值","value":"91725"},{"name":"治愈力","value":"4666"},{"name":"命中值","value":"103"},{"name":"闪避值","value":"232"},{"name":"暴击值","value":"206"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1356"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"24(4)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"不用写"},{"name":"生命值","value":"不用写"},{"name":"治愈力","value":"不用写"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"包包","grade":"T10","attrs":[{"name":"生命值","value":"14000"},{"name":"防御力","value":"1700"},{"name":"生命值","value":"5%"}]},{"slot":"3号装备","name":"项链","grade":"T10","attrs":[{"name":"治愈力","value":"42%"},{"name":"群控强化力","value":"38%"},{"name":"攻击力","value":"18%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"2200"},{"name":"攻击力","value":"110"},{"name