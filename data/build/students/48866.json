"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/12/535161.png","url":"https://www.gamekee.com/ba/609143.html"},{"name":"NPC 晴（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/854782.png","url":"https://www.gamekee.com/ba/643810.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"会えて嬉しい、先生。\nミレニアムの力を、先生に見せてあげる。","zh":"很高兴认识你，老师，我会让老师见识一下千禧年的实力。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"や、先生。コーヒーはいかが？","zh":"呀！老师，来杯咖啡吗？"},{"label":"登陆2","jp":"ようこそ、先生。私の予想より約43秒早く到着したね。","zh":"老师，欢迎您，你比我预测的早到了43秒。"},{"label":"大厅1","jp":"こう見えてゲームは結構上手い方だよ。\n先生も一度相手してみる？","zh":"看不出来吧？我超会打游戏的哦，老师要不要和我比试一下？"},{"label":"大厅2","jp":"チート…？いくらハッカーでも、楽しさのためにやってるゲームにそんなのを使うはずないでしょ。","zh":"作弊？虽然我是黑客，但是打游戏最重要的是开心嘛，我不会作弊的。"},{"label":"大厅3","jp":"私たちがやることが、そんなに過激に見えた?","zh":"在你看来，我们做的事情有那么极端吗？"},{"label":"大厅4","jp":"知識は自由であるべき…。うん、やっぱりいい言葉だね。","zh":"知识，应该是自由的，嗯，这句话说得真好。"},{"label":"大厅5","jp":"この甘い炭酸飲料こそ知性ある人の飲み物だよ。","zh":"这种甜甜的碳酸饮料，才是高智商人士该喝的东西呢。"},{"label":"回忆大厅1","jp":"ふう…急に夕立だなんて。\n最近は、天気予報も信頼できなくて困るね。","zh":"嗯…怎么突然下雨了，最近连天气预报都不敢信了，真麻烦。"},{"label":"回忆大厅2","jp":"さて…この後、何をしようか？\n（ん…今の言葉、もしかして変な意味に聞こえたかな？）","zh":"嗯，接下来干什么呢？（出声）\n我刚才说的话不会让人误解成什么不好的意思了吧？（心声）"},{"label":"回忆大厅3","jp":"（でも、ネットカフェなんて私も初めてだし、\n普通こういう所で何をするものなのかも知らないし…）\n（というかこの空間、狭くて…先生の顔が近い…っ）","zh":"可我第一次来网吧这种地方，也不知道别人一般会在这里干什么，\n而且这里也太窄了，老师的脸好近！"},{"label":"回忆大厅4","jp":"え、さ、先にシャワーを浴びてくるって？ちょっと、なっ、どうして？！\nあ、雨に濡れたから、髪を洗いに？…ごめん、いや、気にしないで。\nネットカフェには、シャワーの設備もあるんだね。","zh":"您要先去洗个澡？等下，为什么？头发淋湿了要去洗一下，对不起，没事，当我没说吧。"},{"label":"回忆大厅5","jp":"あ、見て、先生。ドリンクバーが無料だって。\nエナジードリンクもあるかな？\nネットも自由に使えるし、ドリンクも無料だし。\nこれは素晴らしい、完全に私のような人間のための空間。","zh":"原来网吧还有洗澡的地方啊，啊，老师快看，\n饮料是免费的欸，不知道有没有能量饮料，网络也能随便用，\n饮料也不要钱，这也太幸福了，完全就是给我这种人设计的地方啊。"},{"label":"回忆大厅6","jp":"ここになら、いつまででもずっといられそうだね？\nあ、えっと…今のも、別に変な意味ではないから。誤解しないでね…。","zh":"要在这里呆多久我都愿意，那个，刚才那句话没什么特别的意思，不要误会哦。"},{"label":"咖啡馆1","jp":"これをこうやって直して、あそこをああやって直せば…\nよし。すぐ改造してみようかな？","zh":"这里可以这么修，那里在那么修一下，好，马上改造一下试试吧。"},{"label":"咖啡馆2","jp":"ふーん。うん？\nああ、何してるかって？新作のゲームを やってたの。","zh":"嗯？啊，问我在干什么？在玩新出的游戏呢。"},{"label":"咖啡馆3","jp":"自販機からエナジードリンクだけが出るようにはできないのかな…？","zh":"不能让自动售货机只卖能量饮料吗？"},{"label":"咖啡馆4","jp":"ううーん…。ちょっと一眠りしてから続けようかな？","zh":"嗯…要不要先眯一会再继续呢？"},{"label":"咖啡馆5","jp":"糖分が足りない…。","zh":"糖分不足…"}],"好感度":[{"label":"好感度1","jp":"この研究が終わったら、次は先生のことを研究してみたいな。","zh":"等这项研究结束了，下次想研究一下老师。"},{"label":"好感度2","jp":"人の心も、顕微鏡で覗き込んで、見ることが出来たら良いのに…。","zh":"要是人的心灵也可以用显微镜去观察就好了。"},{"label":"好感度3","jp":"先生に惹かれるこの心は、どんな力学で証明できるんだろう…。","zh":"用什么样的力学，才能证明这颗被老师吸引的心呢？"},{"label":"好感度4","jp":"私の能力で時間を巻き戻せるのかって？\nさぁ…でも私はこの瞬間を永遠に楽しみたいけど。","zh":"你问我的能力能不能让时间倒流？谁知道呢？但是我很想永远享受现在这个瞬间。"}],"战斗":[{"label":"编入队伍1","jp":"私の実力を証明してみせる機会だねー","zh":"证明我实力的机会到了。"},{"label":"编入队伍2","jp":"任せて。","zh":"交给我。"},{"label":"拎起","jp":"アテナ3号、問題なし。","zh":"雅典娜3号，没有问题。"},{"label":"普通技能","jp":"これは痛いよ。","zh":"这下会很痛哦。"},{"label":"EX动画1","jp":"電磁パルス、稼働開始","zh":"电磁脉冲，开始运行。"},{"label":"EX动画2","jp":"EMPドローン、稼働。","zh":"EMP无人机，启动。"},{"label":"EX动画3","jp":"第一段階エミッター、作動開始。","zh":"第一阶段发射器，开始运行。"},{"label":"EX技能1","jp":"装備を停止する。","zh":"设备停止。"},{"label":"EX技能2","jp":"予想通りかぁ。","zh":"和预期一样啊。"},{"label":"EX技能3","jp":"みんな、後ろに下がって。","zh":"大家，退后。"},{"label":"战斗开始1","jp":"さあ、思い切りかき回してみようか。","zh":"好，来尽情的搞一搞破坏吧。"},{"label":"战斗开始2","jp":"まずは、データを集めてみようか。","zh":"先来收集一下数据吧。"},{"label":"特殊载具","jp":"テックレベル7、登場完了。","zh":"Tech Level 7登机完毕。"},{"label":"特殊载具","jp":"これで終わらせよう。","zh":"就用这一击作为结束吧。"}],"成长":[{"label":"升级1","jp":"ん～、これは目を見張る結果だね。","zh":"嗯？效果还挺惊人的嘛。"},{"label":"升级2","jp":"もっと多くのデータが必要だね。","zh":"我还需要更多的数据。"},{"label":"升级3","jp":"この込み上げる力も、数値化出来るのかなぁ。","zh":"涌现出来的这股力量，能不能量化呢？"},{"label":"升级4","jp":"未知の知識を探求するのは、いつだって楽しいことだね。","zh":"探索未知的知识，总是很有趣呢。"},{"label":"获得专武","jp":"古い武器だけど……この武器には数値化できない思い出が込められてる。","zh":"虽然是一件旧武器，不过这件武器里面，包含着无法量化的记忆。"}],"事件":[{"label":"学生生日","jp":"うーん、私が言ったラズベリーパイはこれじゃないけど…。\nでも誕生日を祝ってくれてありがとう。","zh":"嗯..我说的树莓派不是这个东西，不过谢谢你为我庆祝生日。\n（编者注：此处的树莓派应为一款卡片式电脑）"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\n今日一日はどんなコードを書いてもバグが出ないハレのご加護を授けよう。","zh":"生日快乐，老师，今天晴会保佑你，不管些什么代码都不会出现漏洞。"},{"label":"万圣节","jp":"外のお祭りを楽しみに出かけないのかって?\nハロウィーンのお祭りはモニターの中でも開かれているもの。","zh":"你问我为什么不去外面过节？万圣节的庆典，用显示器也能看嘛。"},{"label":"新年","jp":"ハロー、ニューワールド。","zh":"Hello,new world.\n（编者注：此处的\"hello world\"程序为测试时常用的程序代码）"},{"label":"圣诞节","jp":"あれ知ってる、先生？\nクリスマスは1年の中で“あれ”が一番多く行われる日なの。\nふふ、それはそう…ハッキングだよ。","zh":"老师，你知道么，一年之中圣诞节是发生那个次数最多的一天，\n没错，就是破解入侵哦！"},{"label":"春节","jp":"","zh":"希望新的一年里不要遇到那么多bug了"},{"label":"中秋","jp":"","zh":"今天，是团圆的节日吗？﻿\n﻿即使是我，也有想呆在老师身边的时候呢……"}]},"stats":{"init":[{"name":"攻击力","value":"235"},{"name":"防御力","value":"19"},{"name":"生命值","value":"249"},{"name":"治愈力","value":"1930"},{"name":"命中值","value":"714"},{"name":"闪避值","value":"816"},{"name":"暴击值","value":"204"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1573"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6348"},{"name":"防御力","value":"107"},{"name":"生命值","value":"46570"},{"name":"治愈力","value":"11329"},{"name":"命中值","value":"714"},{"name":"闪避值","value":"816"},{"name":"暴击值","value":"354"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1573"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"416"},{"name":"生命值","value":"2353"},{"name":"治愈力","value":"948"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"项链","grade":"T10","attrs":[{"name":"治愈力","value":"42%"},{"name":"群控强化力","value":"38%"},{"name":"攻击力","value":"18%"}]}],"giftDetail":{"t1Val