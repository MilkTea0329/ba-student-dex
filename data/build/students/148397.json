iki2.0/images/w_304/h_240/829/86082/2025/5/12/970705.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"1011"},{"name":"攻击力","value":"120"},{"name":"治愈力","value":"198"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/447094.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/168114.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 好美","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_182/h_144/829/86082/2025/5/12/147492.png","url":"https://www.gamekee.com/ba/66272.html"},{"name":"NPC 好美（鬼屋）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/132531.png","url":"https://www.gamekee.com/ba/639189.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"BlueArchive~！！"},{"label":"卡池抽取","jp":"期待していいから…いや期待して！\n私の演奏！！","zh":"你可以期待一下我的演奏……不对，是必须期待！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"せ、先生！？いつ来たの…！？\nわ、私？れ、練習をちょっと…。","zh":"老，老师？！你什么时候来的……？！我，我？就，就是在练习啦……"},{"label":"登陆2","jp":"ようこそ、先生！\nも、もしその…その…。\nBGM…いる？\n演奏、しようか？","zh":"老师，你来啦！呃，那个，你是不是……\n需要点……BGM？要不我来弹点儿？"},{"label":"大厅1","jp":"なんか、こうしてるといつもより自信が溢れてくるんだよね。","zh":"总觉得这样子会比平时更有自信呢。"},{"label":"大厅2","jp":"な、なに！？何でそんなにじっと見てくるのよ…？\n欲しいものがあるなら口で言ってよ！","zh":"怎么了？！干嘛这样盯着我看……？有什么话就直说！"},{"label":"大厅3","jp":"何か食べ物でも持ってくればよかった…。\n先生、食べたい物ある？","zh":"早知道该拿点吃的来……老师，你有没有什么想吃的？"},{"label":"大厅4","jp":"練習の方が授業より絶対楽しいと思ってたんだけど、\n真面目にやるとこっちも大変なのよね。","zh":"本来以为练习肯定比上课有意思，没想到认真起来也挺累的。"},{"label":"大厅5","jp":"うん？練習で忙しいんじゃないかって？\nそ、それはそうだけど…。\nというか、何で急に聞くのよ！？\nわざとでしょ！？\nクサいこと言おうとして！！","zh":"嗯？我现在应该正忙着练习才对？这，这么说也没错，就是……\n你突然问我这个干嘛？！是故意的吧？！一副拿我寻开心的样子！！"},{"label":"回忆大厅1","jp":"ふぅ……ふう…。\n…や、やった…。\nやり遂げたわ…。","zh":"呼……呼…………\n成，成功了……\n我做到了……"},{"label":"回忆大厅2","jp":"そ、そう…？\n先生が聴いてた感じもそうだった…？\nふざけてるんじゃないわよね？\nこれは…本当にそう思ってる？","zh":"是，是吗……？老师听完也这么想……？\n不是在捉弄我吧？这是……真心话吧？"},{"label":"回忆大厅3","jp":"なんか…ドキドキして…。\nこんなの、初めて…","zh":"莫名觉得……心跳得好快……\n这种感觉还是第一次……"},{"label":"回忆大厅4","jp":"…先生…。\n思い返して見たら、先生に初めて見せたんじゃないかな。","zh":"……老师\n……仔细想想，这好像是我第一次在老师面前弹吉他呢。"},{"label":"回忆大厅5","jp":"なんというか…\nその…。\n…私の「格好いい」姿…ってやつ…","zh":"怎么说呢……那个……\n……有没有看到我“帅气”的样子……之类的……"},{"label":"咖啡馆1","jp":"結構広いわね…演奏するのにちょうど良いかも。","zh":"这里挺宽敞的……感觉很适合演奏啊。"},{"label":"咖啡馆2","jp":"練習しようと思ったのに、人が多い…","zh":"本来想练习一下，但人太多了……"},{"label":"咖啡馆3","jp":"お腹空いた、どこかに甘い物無いかな？","zh":"我有点饿了，有什么甜的能吃吗？"},{"label":"咖啡馆4","jp":"ちょっと休もうかな…","zh":"要不稍微休息一下……"},{"label":"咖啡馆5","jp":"あれ。ここに集まるって言ってなかった？","zh":"诶？不是说在这里集合吗？"}],"好感度":[{"label":"好感度1","jp":"こ、このものを私にくれていいの？や、いや、おかしい気がするじゃないけど…","zh":"这，这个真的可以给我吗……？不，不是的！我才不会还你呢！"},{"label":"好感度2","jp":"あー行ったり、こー行ったり…よくわからない人…","zh":"一会儿这样一会儿那样……真是个搞不懂的人……"},{"label":"好感度3","jp":"演奏、ちゃんと聞いて。後、誰にも言わないで。","zh":"我的演奏……你要好好听。还有，不准跟任何人说！"},{"label":"好感度4","jp":"う…嬉しいけど…これ私に“バンド続けて”って言うつもりじゃないわよね？","zh":"这，这样是不错啦……但你这是让我继续玩乐队的意思吗？"}],"战斗":[{"label":"编入队伍1","jp":"仕方がないから、やってあげる。","zh":"真没办法，那就答应你吧！"},{"label":"编入队伍2","jp":"私の演奏が聴きたいの？","zh":"想听我演奏？"},{"label":"拎起","jp":"はあ！やっぱ私しかいないんじゃない？","zh":"哼！果然非我不可对吧？"},{"label":"任命队长1","jp":"な、なによ、いきなり喧嘩？","zh":"什么情况？怎么突然就开打了？！"},{"label":"任命队长2","jp":"演奏するんじゃなかったの？","zh":"不是要演奏吗？！"},{"label":"普通技能","jp":"私の音色で染めてやるだから。","zh":"用我的音色感染你！"},{"label":"EX动画1","jp":"よく見ててよね。","zh":"好好看着吧！"},{"label":"EX动画2","jp":"テンション上がる！","zh":"真让人兴奋！"},{"label":"EX动画3","jp":"ここがクライマックスよ。","zh":"这里可是高潮部分！"},{"label":"EX技能1","jp":"行くよ！","zh":"开始吧！"},{"label":"EX技能2","jp":"ついて来れるわよね。","zh":"都能跟上吧？"},{"label":"EX技能3","jp":"私に集中して！","zh":"大家都听好了！"},{"label":"战斗开始1","jp":"やるにはちゃんとやるよ。","zh":"既然决定了，我也会认真对待的！"},{"label":"战斗开始2","jp":"私の合図でスタートするわよ。","zh":"看到我的信号就开始！"},{"label":"获得BUFF","jp":"いいんじゃない！","zh":"不错嘛！"},{"label":"施放BUFF","jp":"集中…集中！","zh":"专心…要专心！"},{"label":"掩体","jp":"とりあえずこっち。","zh":"先来这边！"},{"label":"被CC1","jp":"あっ","zh":"啊！"},{"label":"被CC2","jp":"へっ","zh":"诶？"},{"label":"被CC3","jp":"あっ","zh":"唔诶……"},{"label":"回避","jp":"無駄よ！","zh":"没用的！"},{"label":"队伍移动1","jp":"次の小節、行くわよ。","zh":"准备好进下一个小节！"},{"label":"队伍移动2","jp":"まだ演奏は終わっていないわよ！","zh":"演奏还没结束呢！"},{"label":"回复","jp":"ありがとう。","zh":"谢啦！"},{"label":"中途退出","jp":"ふあー、ギターが…","zh":"哇啊！我的吉他！"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"角色移动","jp":"は！","zh":"哈！"},{"label":"战斗胜利1","jp":"ふ…ふ…ふ…やった！","zh":"哈啊…哈啊…哈啊…我做到了…！"},{"label":"战斗胜利2","jp":"うん、これよこれ。","zh":"嗯！这样才对嘛！"},{"label":"关卡完成1","jp":"ふん、あたりまえでしょう。","zh":"哼！那还用说！"},{"label":"关卡完成2","jp":"悪くない演奏だったでしょう。","zh":"演奏得还不错吧？"},{"label":"战斗失败1","jp":"うるさくて集中できない。","zh":"太吵了完全没法集中精力！"},{"label":"战斗失败2","jp":"練習の時と違う…","zh":"跟练习的时候不一样……"}],"成长":[{"label":"升级1","jp":"うまくなったかも。","zh":"感觉好像有进步了？"},{"label":"升级2","jp":"私、頑張るから。","zh":"我会加油的！"},{"label":"升级3","jp":"もうこのレベルに.…。私はもうしかして才能があるのかな。","zh":"竟然都有这种水平了……？我难道是个天才？"},{"label":"升级4","jp":"期待してもらった分は答えるわよ、演奏で。","zh":"我会用演奏，回应你的期待！"},{"label":"获得专武","jp":"どんな状況でも先生は先生なんだね…。\nそっか。私も同じなんだよね？\nどんな状況でも…\n必要なら呼んでよね！私、行くから！","zh":"不管在什么情况下，老师都还是老师啊……\n嗯。其实我也一样吧？\n无论什么情况……\n需要的话就叫我吧！\n我一定会来的！"}],"事件":[{"label":"学生生日","jp":"う、ううん？私の誕生日…？\nやっぱり、覚えてたんだ？","zh":"唔，嗯？我的生日……？原来你一直记着啊？"},{"label":"老师生日","jp":"ハッピーバースデートゥーユー♪ハッピーバースデートゥーユー♪\n…何で歌うのって！？\n余計なこといわない！","zh":"祝你生日快乐♪ 祝你生日快乐♪什么？我为什么要唱生日歌？！……不要明知故问！！"},{"label":"万圣节","jp":"わちゃわちゃな日だね！\n嫌いじゃない。むしろ何かしたいわね？","zh":"今天真热闹呀！这种日子我也不讨厌，反而还想做点什么呢？"},{"label":"新年","jp":"あけましておめでとう、先生！\n聞きたい曲とかある？","zh":"新年快乐，老师！有什么想听的曲子吗？"},{"label":"圣诞节","jp":"クリスマスかー！\nな、何！？別にもうサンタを信じるような歳じゃないから！？","zh":"圣诞节到了啊！\n怎，怎么了？！\n我又不是还相信圣诞老人存在的小孩子了！"},{"label":"春节","jp":"","zh":"老师，那个……新春快乐！\n嗯？我为什么穿着这身衣服……\n那，那是因为要和大家一起出去玩！\n穿同款不是更好看嘛？\n而且节日上说不定还有露一手吉他的机会呢！\n你可别小看我的实力！"},{"label":"中秋","jp":"","zh":"老师你知道吗？\n今天是中秋节！\n其实我也不怎么了解传统啦，但总之应该是个好日子！\n爱理说难得有机会，要我们几个一起复活一下乐队，我想让你来帮忙看看我练习，有空吗？\n……这件事不许告诉其他人哦？"}],"活动":[{"label":"活动登陆1","jp":"遅いよ、先生！早く行くよ！","zh":"要迟到了，老师！快出发吧！"},{"label":"活动登陆2","jp":"あ、先生！こっちよ、こっち！","zh":"啊，老师！\n这里，这里！"},{"label":"活动大厅1","jp":"あ、な、何するのよ！？\n言葉にしてよ、言葉に！","zh":"啊，你，你干什么？！\n有话就用嘴说，用嘴！"},{"label":"活动大厅2","jp":"いたずらはやめて……！\n怒るよ！！","zh":"别再胡闹了……！\n我要生气了！！"},{"label":"活动大厅3","jp":"ん？……呼んだ？","zh":"嗯？\n……叫我吗？"},{"label":"活动大厅4","jp":"ギター触ってみたいの？はい。","zh":"想摸摸吉他？\n给。"},{"label":"活动事件1","jp":"演奏が始まってるわよ！\nついてきて！","zh":"演奏开始了！快跟我来！"},{"label":"活动事件2","jp":"クライマックスかしら？\n任せて！","zh":"到高潮部分了？交给我吧！"},{"label":"活动结束","jp":"ふう、気持ちよかった。\nね、先生？","zh":"呼，真痛快。\n对吧，老师？"},{"label":"活动商店1","jp":"な、何よ！？\nビックリしたじゃない！","zh":"什，什么嘛？！吓我一跳！"},{"label":"活动商店2","jp":"いたずらはやめてってば！\nビックリするじゃない！！","zh":"别搞恶作剧了！吓死人了！！"},{"label":"活动商店关闭","jp":"余らせとくのも勿体ないでしょ？なるべく取れるもの取っていきなさいよ。","zh":"东西剩下多可惜？能拿就多拿点呗。"},{"label":"活动商店登陆1","jp":"はい、はい！時間ないよ！\nとっとと持ってって！","zh":"好了好了！没时间了！快点拿走！"},{"label":"活动商店登陆2","jp":"はあ先生。こっちよこっち。","zh":"啊！老师！这里，这里！"},{"label":"活动商店购买1","jp":"ふ～ん？いいんじゃない？","zh":"嗯~？还行吧？"},{"label":"活动商店购买2","jp":"悪くない選択ね。","zh":"眼光不错嘛。"},{"label":"活动商店购买3","jp":"いいね。私もそれ狙ってたんだ。","zh":"这个不错，我也想要呢。"},{"label":"活动商店购买4","jp":"それでいくの？オッケー。","zh":"要那个是吗？OK——"},{"label":"小游戏1","jp":"分かるような、分からないような…。","zh":"好像懂了…又好像没有。"},{"label":"小游戏2","jp":"よし！完璧に理解したわ！！","zh":"好…！我完全理解了！"},{"label":"小游戏3","jp":"いい雰囲気ね！このまま行くわよ！","zh":"气氛不错！就这样保持下去！"},{"label":"小游戏4","jp":"私たちも頑張るからさ、最後までお願いね。先生！","zh":"我们也会加油的！陪我们到最后吧，老师！"},{"label":"小游戏绝赞","jp":"うわぁ！今のなに！？やばい...。","zh":"哦…！~刚刚那是什么！太强啦！"},{"label":"小游戏\n每日结束","jp":"はぁ～今日も一日充実でしたわ。また明日。","zh":"哈啊~！今天也是充实的一天，明天再见啦！"},{"label":"小游戏失败","jp":"も、もう一回。次はうまくできるわよ！","zh":"再来一次！下次一定能做好的！"},{"label":"小游戏成功","jp":"見たでしょう？私はこれぐらいできるのよ！","zh":"看到了吧！都说我很厉害啦！"}]},"stats":{"init":[{"name":"攻击力","value":"321"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2492"},{"name":"治愈力","value":"1662"},{"name":"命中值","value":"707"},{"name":"闪避值","value":"791"},{"name":"暴击值","value":"252"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","