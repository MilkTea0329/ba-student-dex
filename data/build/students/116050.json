g-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/13/799725.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/13/375258.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/13/721936.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/13/558844.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/83604.png","name":"可可碎粒茶","desc":"妃咲结合茶道兴趣冲泡的可可碎粒茶。与巧克力的浓郁香气形成对比，苦涩与焦香风味令人印象深刻。"},"ability":{"attrs":[{"name":"生命值","value":"116"},{"name":"攻击力","value":"962"},{"name":"治愈力","value":"248"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/434174.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/438853.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"妃咲(梅花园校服)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/724841.png","url":"https://www.gamekee.com/ba/636904.html"},{"name":"妃妃(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/30132389mqs0xrrr.png","url":"https://www.gamekee.com/ba/710108.html"},{"name":"妃咲(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/16642445mqrzk7g8.png","url":"https://www.gamekee.com/ba/tj/709615.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"山海経高級中学校、玄龍門の門主。竜華キサキじゃ。\nふふ。妾の力が必要かの？","zh":"山海经高等学院玄龙门门主，龙华妃咲。（笑）莫非，需借妾身之力吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"来たかの、先生。\nふふ、玄龍門の門主を待たせるとはいい度胸じゃ。","zh":"先生来啦。（笑）竟教山海经的门主候着，好大的排场。"},{"label":"登陆2","jp":"待っておったぞ。先生。\n大切なことゆえもう一度告げようか。\n先生を、ずうっと待っておったのじゃ。","zh":"久候多时了，先生。此事至关紧要，容妾身，再三强调。可教妾身好等啊……先生。"},{"label":"大厅1","jp":"力で人は治められぬ。\n心を無くしてしまうからの。\nまあ、其方ならよく知っておろう。","zh":"以力服人，终难持久，只因会失了人性。（笑）这个道理，你自是明白的。"},{"label":"大厅2","jp":"何ぞ用でもあるかの？ふむ…\n声をかけてみただけ、と？\nふふ。其方はイタズラが好きなのじゃな。構わぬ、妾もよくやるからの。","zh":"可是先生在唤妾身？……嗯，不过随口搭个话？（笑）你倒是个爱开玩笑的，无妨。妾身也偶有此兴。"},{"label":"大厅3","jp":"山海経の外に出るのは久々じゃ。\nそれに、シャーレというこの場所この瞬間はほんに特別じゃ。\nだって……此処には其方がおるじゃろう？","zh":"久违地踏出山海经了，来的还是这沙勒……此刻，当真别有意趣。最要紧的是……席间还有你在。"},{"label":"大厅4","jp":"時がこのまま止まってしまえばいい、そう思ったことはないかの？先生。\n妾はあるぞ。いま、そう思っておる。","zh":"可曾想过，叫时光就这般停住呢……先生，此刻，当下，妾身便是这般想的。"},{"label":"大厅5","jp":"香をたいてみたのじゃ。\n不思議な香りがするじゃろう？\n一服いかがかな？\n疲れたのであれば共に眠ればよい…そうじゃろう？","zh":"香炉已备下了。这香气可还别致？共品一盏茶如何？若觉困倦了……不妨同榻共眠，好吗？"},{"label":"回忆大厅1","jp":"ふふ……ようやくこちらを見てくれたかの。\nじゃが、先生。一度考えてみてくれぬか","zh":"（笑）……可算肯正眼瞧妾身了。只是先生啊，你不妨先想一想。"},{"label":"回忆大厅2","jp":"妾は今、弱っているのかもしれぬが……\n弱ったふりをしているだけかもしれぬ。","zh":"此刻妾身……安知是当真力怯……还是，故作娇态呢？"},{"label":"回忆大厅3","jp":"あるいは……先生の出方を伺っているだけなのやも。\n単に――其方を心から信じているだけかもしれぬしな？","zh":"又许是……专要试探你如何应对呢？只怕是，将全副心肠都托付予你了？"},{"label":"回忆大厅4","jp":"だが……そうじゃな、これだけは確約できる。","zh":"不过，也对。有桩事可与你作保。"},{"label":"回忆大厅5","jp":"此処で何が起こったとて……\n妾が其方を責めることは無いじゃろう。……永劫にな。","zh":"无论在此处发生什么事……妾身断不会怨你分毫，永远都不会。"},{"label":"咖啡馆1","jp":"ふむ……香の置き場は……。","zh":"嗯……可有何易安置香炉的所在吗？"},{"label":"咖啡馆2","jp":"（山海経の外は…本当に多種多様じゃな）","zh":"（这山海经外的世面……当真五花八门。）"},{"label":"咖啡馆3","jp":"一服するのによさそうな場所じゃな…。","zh":"（倒是个喫茶的好去处。）"},{"label":"咖啡馆4","jp":"（あれは…何じゃ…？）","zh":"（那东西……是个什么来历？）"},{"label":"咖啡馆5","jp":"ふふ……此処は居心地が良いのう。","zh":"（笑）……在此处，倒觉身子松快许多。"}],"好感度":[{"label":"好感度1","jp":"生とは流れゆく川のようなもの。\nそして、それを受け止めてくれる相手を求めるものじゃ。\n深い意味はない……が、意味がないわけでもないぞ？","zh":"人生在世，原似那流水浮萍，不过求个能托付的知己罢了。……说不上什么深意，却也不能说是，全无意味吧。"},{"label":"好感度2","jp":"月光はいつから在ったのか、杯を手に空に問う……ふふ。\nもしかすると、先生はずっと其処に居たのやもしれんのう。","zh":"明月几时有，把酒问青天……（笑）或许先生，是一直都在的吧。"},{"label":"好感度3","jp":"空いた手は妾が取ろう。\n満たされぬ心は、妾が埋めよう。\n……ゆえに、其方は今のままでよいのじゃ。","zh":"若您手边空落……自有妾身伸手相握；若你心头寂寥，自有妾身填补空缺。\n所以你啊，就这般原样便好。"},{"label":"好感度4","jp":"一期に一度の会、とは言うが、うら寂しいものじゃ。\n……じゃが、妾が先生を忘れることはない。\n何があろうと、いつまでも、な。","zh":"世人道是，缘分，如风掠衣襟版缥缈。这话听着总带几分凄凉……但先生啊，妾身断不会忘了你。任他沧海桑田，至死方休……"}],"战斗":[{"label":"编入队伍1","jp":"其方の選択が正しかったと、証明してみせよう。","zh":"且看妾身为你证明，你的选择并无差错"},{"label":"编入队伍2","jp":"共に参ろうか、先生。","zh":"我们一道去吧，先生"},{"label":"拎起","jp":"ふむ……こちらに来るのじゃ。","zh":"唔姆……到此处来吧。"},{"label":"普通技能","jp":"しばし休んでいくと良い。","zh":"歇歇脚倒也无妨。"},{"label":"EX动画1","jp":"これで完成なのじゃが……。","zh":"如此便周全了，只是……"},{"label":"EX动画2","jp":"この辺りでやめるべきかの……？","zh":"在此了解，可算得妥当吗？"},{"label":"EX动画3","jp":"もう少し様子を見たかったのじゃが……。","zh":"本想再观望一阵子的……"},{"label":"EX技能1","jp":"さあ、やってみよ。","zh":"且试试吧？"},{"label":"EX技能2","jp":"あとは任せようかの。","zh":"后头的事便托付予你了。"},{"label":"EX技能3","jp":"其方の時間じゃ。","zh":"这回该瞧你的了。"}],"成长":[{"label":"升级1","jp":"成長……か。\nふふ、悪くない気分じゃ","zh":"这便是，长进了吧。（笑）倒有几分受用。"},{"label":"升级2","jp":"せめて妾の……\nいや、なんでもない。","zh":"至少妾身这……罢了，原不值什么。"},{"label":"升级3","jp":"可能性とは良いものじゃ。我の先を示してくれる。\nふふ……すべて、其方のおかげじゃ。","zh":"【机缘】二字，最是妙不可言。可昭示吾等前路。（笑）倒要谢你成全了。"},{"label":"升级4","jp":"まだできる、と……？\nふむ……其方がそう言うのなら、そうなのじゃろうな。","zh":"尚有余力……？嗯，既你这般说，想必便是如此了。"},{"label":"获得专武","jp":"ご苦労じゃった、先生。\nふふ、妾が言うのものではないのかもしれぬが……\n心より感謝しておる。妾のすべてを懸けて、大切にしよう。","zh":"先生辛苦了。（笑）这话原不该由妾身来说，当真感激不尽。妾身，自当倾尽所有，好生珍重带的。"}],"事件":[{"label":"学生生日","jp":"……そうか、覚えていたか。\n礼を言う、先生。\n多くの者から祝福されるが……\n其方からの言葉を\n一番嬉しく思っておるぞ。","zh":"原来如此……你竟都记得。谢过先生了。虽尝得众人道贺，唯你这份，最教妾身心下欢喜。"},{"label":"老师生日","jp":"忘れるはずがない。\nああ覚えているとも。\n他の誰でもない、其方がこの世界と出会った日じゃからの。\nほれ、早く支度するのじゃ。\n山海経流の最高のもてなしをご覧に入れよう。","zh":"妾身记得真真的，断不会忘。那可是你头一回见世面的日子呢。好啦，快些预备着，妾身定要教你见识山海经第一等的排场。"},{"label":"万圣节","jp":"ハロウィーン、か？詳しくは知らぬが……\nカボチャを食べる日、というのは知っておる。\nほれ、カボチャとナツメの料理じゃ。\n其方と一緒に食べたいと思ってな。","zh":"万圣佳节……虽不甚了了，也罢，横竖之道，是个吃南瓜的日子。喏，这是南瓜枣子糕。原想着要与你同食的。"},{"label":"新年","jp":"ふふ。あけましておめでとう、じゃな。\nこの包みを受け取ってくれ。\nああ、それと餃子、魚、花火と…\nふむ？これは先生が渡すべきもの、じゃと……？\n……。\nそうじゃったな！","zh":"（笑）新岁纳福了。这红封且收着，啊，还有饺子，全鱼，炮仗……嗯？先生说，这合该是你给的礼才是？……可不是嘛！"},{"label":"圣诞节","jp":"クリスマス……そうじゃな、穏やかな日を過ごしてくれ。\nリンゴを持ってきが、一緒に食べぬか？","zh":"圣诞佳节……（笑）也罢，愿你得享平安喜乐。妾身带了苹果来，可要共尝吗？"},{"label":"春节","jp":"","zh":"可知为何又有年礼相送了？（笑）先生果然是明白人。先前那只是基沃托斯的公共节日，而今这按旧历走的，才是我们山海经传统的新年呢。那就祝先生，新岁添祥，诸事顺遂啦。"},{"label":"中秋","jp":"","zh":"月饼圆，今宵的月儿更圆。妾身特意留了双簧馅儿的给先生。……甜吗？（笑）甜便是了。往后每个中秋，咱们都得这么甜着过。"}],"活动":[{"label":"活动登陆1","jp":"山海経へよくぞ参った、先生。\n月影祭を心ゆくまで楽しんでいくと良い。","zh":"欢迎先生光临山海经。还望好生赏玩这月影节了。"},{"label":"活动登陆2","jp":"行き先に悩んだ時には妾に申し付けよ。\nすぐに人を手配しよう。","zh":"若不知该往何处去，只管开口便是。妾身会遣人给您引路的。"},{"label":"活动大厅1","jp":"月影祭では数多の物語が交差する。\nふふ、興味があるのならこれを機に調べてみてはどうじゃ？","zh":"月影节里，不知有多少奇闻异事流转呢。（笑）既有兴致，何不趁此机缘探听一耳？"},{"label":"活动大厅2","jp":"玄武商会は月影祭に乗じて外部と交流を深めようとしておる。\n門主として、特段立場は表明しておらぬが…","zh":"玄武商会，正欲借这月影节，与外头多些往来走动。妾身身为门主，虽未明言表态……"},{"label":"活动大厅3","jp":"玄龍門と玄武商会、どちらに非があるものか…ふむ。すまぬ、先生。\n門主といえども、すべてを見通せるわけではないのじゃ…。","zh":"不过，玄龙门与玄武商会……究竟那边才是在根子上出了岔子呢……？实在对不住，先生。纵是门主，亦有难以参透的关碍……"},{"label":"活动大厅4","jp":"妾が門主として居る間は、山海経での安全を保証しよう。\n相手が誰であろうとな。\n無論、先生も例外ではない。","zh":"只要妾身一日身为门主，定教这山海经里外，安稳无余。任他是谁也休想造次。自然，先生您也不例外。"},{"label":"活动事件1","jp":"こんなことになろうとはな…\n先生には迷惑をかける。\n其方は…妾のそばに居てくれるのじゃろう？","zh":"未料事尽至此，倒劳先生受累了。你……会伴妾身左右的吧？"},{"label":"活动事件2","jp":"すべては巡り巡って己に帰ってくるもの…\nさあ、我が山海経を取り戻しにゆこうか。","zh":"万般皆有定数，终归各得其所。哼……且去将我们的山海经，讨回来吧。"},{"label":"活动结束","jp":"ほんにご苦労じゃった、先生。\n玄龍門の門主として、そして一人の生徒として、\n其方に心からの敬意と、感謝を。","zh":"当真辛苦先生了。身为玄龙门之主，亦身为寻常学员，谨此奉上至诚的敬意……与谢忱。"},{"label":"活动任务1","jp":"なんじゃ、先生。妾をくすぐってみたいのかえ？\nふふ。なんとも無礼なヤツじゃ\n…じゃが、許そう。","zh":"……这是做什么先生？莫非，想与妾身玩搔痒的游戏？（笑）好生无礼呢，偏偏你这般模样，叫人舍不得怪罪。"},{"label":"活动任务2","jp":"じゃれ合いたいのか？\nよい、好きなだけしてみせよ。\n妾と先生のことじゃからのう。\n…他に人がいる時は、わきまえるんじゃぞ？","zh":"这是在与妾身开玩笑吗？也罢，随你怎样都好。横竖是你我之间的事。只是若有他人在场，还望收敛些。"},{"label":"活动任务每日结束","jp":"ご苦労様じゃった。\n日進月歩。日々進みようぞ。","zh":"辛苦了。有句话叫，日新月异。便是妾身对咱们今后的期盼呢。"},{"label":"活动任务登录1","jp":"日課、じゃな？\n…なぜ妾がここに 居るのか？\nこれも門主の務めじゃからの。","zh":"公务吗？问妾身怎在此处？门主的职责，原也该当如此的。"},{"label":"活动任务登陆2","jp":"日々新たにして、また日に新たなり――\n日々新しく前に進むべきという意味じゃ。\n手助けが必要ならいつでも力になるぞ？","zh":"所谓日新又日新……原是日日精进之意。若有需相助之处，先生随时开口便是。"},{"label":"活动任务获取1","jp":"ああ。其方がやり遂げたのだから\n遠慮せず持っていくがよい。","zh":"嗯，这是你应得的。不必推辞，且收下吧。"},{"label":"活动任务获取2","jp":"其方は誠実じゃな。\nやはり出来ることなら妾のそばに…\nいや、忘れてくれ。","zh":"先生真是勤勉……若能长久留在妾身身旁，自是最好。……罢了，罢了，只当妾身没说吧。