","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/22939.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/826638.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/210215.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/585658.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/631286.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/231735.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/582707.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/10/946291.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"733"},{"name":"攻击力","value":"131"},{"name":"治愈力","value":"235"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/10/49650.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/10/451260.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★2 绫音","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_216/h_216/829/103682/2025/5/10/625391.png","url":"https://www.gamekee.com/ba/46923.html"},{"name":"NPC 绫音(偶像)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/164428.png","url":"https://www.gamekee.com/ba/639183.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","zh":"blue archive"},{"label":"卡池抽取","jp":"お、奥空アヤネです。ど、どうでしょうか…こういう格好は、少し恥ずかしいですね。","zh":"我是奥空绫音，您觉得如何呢？打扮成这样，我有点不好意思。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あっ、おかえりなさい、先生！","zh":"老师，欢迎回来。"},{"label":"登陆2","jp":"先生、お待ちしておりました。","zh":"老师，我正等您呢。"},{"label":"大厅1","jp":"えっと…ど、どうされましたか…？","zh":"怎么了吗？"},{"label":"大厅2","jp":"こ、この格好ですか？\nえ、えっと…夏っぽさを出してみようと…。","zh":"这身打扮？\n想……想稍微打扮的像夏天一点，所以就……"},{"label":"大厅3","jp":"ど、どうですか？に、似合ってますでしょうか…？","zh":"怎么样？还算好看吗？"},{"label":"大厅4","jp":"いつもあれをしなきゃ、これをしなきゃって考えてばかりだったので…\n何だかこういうゆったりした時間は、不思議な気分です。","zh":"我每天都忙得焦头烂额的，没想到居然还能像现在这样悠闲，\n真是不可思议啊。"},{"label":"大厅5","jp":"この格好ですと、何だか気が緩んでしまいますね。","zh":"不知道为什么，一打扮成这样，就会不知不觉的放松下来了。"},{"label":"回忆大厅1","jp":"えっと、私はこの辺の、端っこに写っていれば良いでしょうか…？\nこんな感じで、大丈夫ですかね…？","zh":"我就站在这旁边可以吗？这样拍没问题吧。"},{"label":"回忆大厅2","jp":"ど、どうすればヘリが際立つんでしょう…？\nすみません、こういうのはあまり慣れてなくって…","zh":"要怎么才能把直升机拍的更清楚呢？不好意思，我还不太习惯这样拍照"},{"label":"回忆大厅3","jp":"えっと…先生？修理の記念写真ということでしたら…\nもっとヘリを中心に撮った方が良いのでは…？","zh":"老师既然是在给这次维修拍照留念，是不是多拍拍直升机会更好呢？"},{"label":"回忆大厅4","jp":"…え、ヘリではなくて、私の記念写真…？\nそ、そうだったんですか！？えぇっ！？","zh":"要留念的不是直升机，而是我吗？原来是这样吗？"},{"label":"回忆大厅5","jp":"そ、それはその、いえ、嫌ではないですが…！\nな、何だか急に、顔が熱く…っ","zh":"我不是不喜欢这样，这只是不知道为什么脸上突然变得很烫。"},{"label":"咖啡馆1","jp":"こ、この格好でここにいるのは、ちょっと恥ずかしいですね…","zh":"在这里打扮成这样也有点害羞。"},{"label":"咖啡馆2","jp":"あれ、みんなはどこに…？","zh":"大家都去哪儿了？"},{"label":"咖啡馆3","jp":"どこかゆっくりできそうなところは…","zh":"在哪里可以好好放松呢？"},{"label":"咖啡馆4","jp":"ん…？あれは何でしょう…？","zh":"那是什么？"},{"label":"咖啡馆5","jp":"何だか、楽しくなっちゃいますね","zh":"总觉得好开心。"}],"好感度":[{"label":"好感度1","jp":"いつもと雰囲気が違う、ですか…？そ、そうでしょうか？","zh":"给人的感觉和平时不太一样。是吗？"},{"label":"好感度2","jp":"この瞬間が、ずっと続いたら良いなって、思ってしまいます。","zh":"如果这一刻能成为永恒就好了。"},{"label":"好感度3","jp":"水着だからでしょうか？なんだかいつもより……こう、つい浮かれてしまうといいますか……。","zh":"是因为穿了泳装吗？总感觉心情比平时更激动了。"},{"label":"好感度4","jp":"ありがとうございます。本当に心から感謝しているんです。","zh":"谢谢，我发自内心的感谢您。"}],"战斗":[{"label":"编入队伍1","jp":"はい！お任せください！","zh":"好的，交给我。"},{"label":"编入队伍2","jp":"整備はもうパッチリです！","zh":"已经做好准备了。"},{"label":"拎起","jp":"どうかされましたか？","zh":"出什么事了嘛"},{"label":"普通技能","jp":"火力支援、行きます！","zh":"开始火力支援。"},{"label":"普通技能","jp":"攻撃します！","zh":"开始攻击！"},{"label":"EX动画1","jp":"私も、手助けします！","zh":"我也来帮忙。"},{"label":"EX动画2","jp":"くからではなく、私も！","zh":"这次不再是后方支援，我也要上来。"},{"label":"EX动画3","jp":"少々お待ちください！","zh":"请再等等。"},{"label":"EX技能1","jp":"お待たせしました！","zh":"久等了。"},{"label":"EX技能2","jp":"すみません！遅くなりました。","zh":"抱歉，我来晚了。"},{"label":"EX技能3","jp":"到着しました！","zh":"已经抵达"}],"成长":[{"label":"升级1","jp":"その、いつもありがとうございます、先生。","zh":"老师，感谢您一直以来的照顾。"},{"label":"升级2","jp":"本当に、いつもありがとうございます。このご恩は、必ず","zh":"真的很感谢您，我一定会报答您的。"},{"label":"升级3","jp":"うふふ。なんだか先生には、いつも助けていただいてばかりですね。","zh":"感觉一直都在接受老师的帮助呢。"},{"label":"升级4","jp":"いつも助けられてばかりなので、私も頑張ります。","zh":"我总是在接受别人的帮助，我也会加油的。"},{"label":"获得专武","jp":"こんなに凄いものを、私に…\n先生にはいつも、色んな物を頂いてばかりですね。\n少しでもお返しできるよう、引き続き頑張ります！","zh":"要把这么贵重的东西送给我吗？\n老师对我总是这么好呢，为了报答您，我会继续努力的。"}],"事件":[{"label":"学生生日","jp":"せ、先生…その…き、今日は、えっと…\nあっ…ありがとう、ございます。\nこうしていられるだけで嬉しいのに、誕生日まで祝ってもらって…\n贅沢な一日です","zh":"老师，今天？\n……谢谢你，光是和老师待在一起就很开心了，没想到还能收到您的生日祝福，\n真是奢侈的一天。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\n先生と出会えたこと、こうしてゆっくりと過ごせること…\n本当に嬉しく思います。","zh":"老师，祝您生日快乐，能遇见老师，能和老师一起度过这样悠闲的时光，我真的很开心。"},{"label":"万圣节","jp":"なるほど、ハロウィンだからみなさん仮装を…\nあ、いえ、私のこれはそういう意味ではなく…！？","zh":"原来如此，因为是万圣节，所以大家才会穿上特别的服装。不是的，我不是因为这个才穿的。"},{"label":"新年","jp":"新年あけましておめでとうございます！\n今年もたくさん、楽しいことがあるように願ってます！","zh":"祝您新年快乐，希望老师今年也能碰到各种各样的好事情。"},{"label":"圣诞节","jp":"メリークリスマス！\nな、何かリアクションを頂けないと、恥ずかしいです…","zh":"圣诞快乐，请您说点什么，不然我会很害羞的。"},{"label":"春节","jp":"","zh":"老师，祝您新春快乐，即使是我今天也会好好休息的。请您先放下手头的工作，和我一起好好享受今天。"},{"label":"中秋","jp":"","zh":"老师，祝您中秋快乐。你想和我一起在直升机上赏月吗？"}],"活动":[{"label":"活动登陆1","jp":"お疲れ様です、先生。\n準備ならお任せください！","zh":"老师，欢迎光临，准备工作就交给我吧。"},{"label":"活动登陆2","jp":"お待ちしておりました、先生！一緒に頑張りましょう！","zh":"老师，我正等着你呢，一起加油吧。"},{"label":"活动大厅1","jp":"…えっと、先生？どうかされましたか？","zh":"老师，有你有什么事吗？"},{"label":"活动大厅2","jp":"ど、どうしましたか？どこかに虫とか付いてます…？","zh":"怎怎么了？难道我身上有虫子？"},{"label":"活动大厅3","jp":"えっと…先生、呼びましたか？","zh":"老师，您叫我了吗？"},{"label":"活动大厅4","jp":"す、すみません、あまり見られると恥ずかしいです…","zh":"不，不好意思，您这样一直看着我，我会害羞的。"},{"label":"活动事件1","jp":"さあ、張り切って行きましょうか！","zh":"好，加油上吧。"},{"label":"活动事件2","jp":"もう少しで何とかなりそうですね。頑張りましょう、先生！","zh":"只要再加把劲就能解决了，老师加油吧。"},{"label":"活动结束","jp":"後片付けも大事ですよね、お手伝いします！","zh":"善后也是很重要的，我来帮您吧"},{"label":"活动任务1","jp":"目標が一つずつ達成されていくのって、気持ち良いですよね。","zh":"一个个完成目标的感觉真不错呀。"},{"label":"活动任务2","jp":"こうやって一緒にリストを整理してるだけで、何だか楽しいです。","zh":"即使只是在一起整理目标清单，我也觉得很开心。"},{"label":"活动任务每日结束","jp":"今日の目標、全て完了です！\nお疲れ様でした！","zh":"今天的目标已经全部完成了，谢谢老师。"},{"label":"活动任务登录1","jp":"目標のリストを整理しておきました。","zh":"目标清单我已经整理好了。"},{"label":"活动任务登陆2","jp":"こちらが現在の目標です。","zh":"这些就是本次的目标。"},{"label":"活动任务获取1","jp":"はい、お疲れ様でした！","zh":"好，加油上吧。"},{"label":"活动任务获取2","jp":"さすがは先生ですね！","zh":"不愧是老师。"}]},"stats":{"init":[{"name":"攻击力","value":"289"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2149"},{"name":"治愈力","value":"1682"},{"name":"命中值","value":"940"},{"name":"闪避值","value":"191"},{"name":"暴击值","value":"261"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2194"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"7493"},{"name":"防御力","value":"1804"},{"name":"生命值","value":"46530"},{"name":"治愈力","value":"8526"},{"name":"命中值","value":"1160"},{"name":"闪避值","value":"191"},{"name":"暴击值","value":"1201"},{"name":"暴击伤害","value":"225%"},{"name":"稳定值","value":"2194"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"554"},{"name":"生命值","value":"2039"},{"name":"治愈力","value":"863"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"背包","grade":"T10","attrs":[{"name":"生命值","value":"14000"},{"name":"防御力","value":"1700"},{"name":"生命值","value":"5%"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail