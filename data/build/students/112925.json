2.gamekee.com/wiki2.0/images/w_182/h_144/829/86082/2025/5/4/785530.png","url":"https://www.gamekee.com/ba/66394.html"},{"name":"★3 莲见（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/43637/2025/6/24/445879.png","url":"https://www.gamekee.com/ba/tj/671015.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"あら、先生。こちらでもお会いしましたね。\nトリニティ総合学園、正義実現委員会の羽川ハスミ。\nこの度はトリニティを代表して実行委員を務めることになりました。\n何卒よろしくお願いいたします。","zh":"您好，老师在这里也见面了。\n我是崔尼蒂综合学院正义实现部的羽川莲见。\n这次我以崔尼蒂代表的身份担任晄轮大会执行委员，请您多多关照。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしておりました、先生。\n本日の試合日程はこちらです。","zh":"我正等您呢。老师，一起来看看今天的比赛日程吧。"},{"label":"登陆2","jp":"お疲れ様です、先生。\n今日はどんな日でしたか？","zh":"老师，您辛苦了。今天一天过得怎么样？"},{"label":"大厅1","jp":"この格好だと、普段より動きやすいからか\n少しだけ浮かれてしまっているような気がします。","zh":"可能因为穿着这身衣服活动更方便，我感觉有点兴奋。"},{"label":"大厅2","jp":"浮かれすぎるのは良くないですが…少しだけなら…。","zh":"虽然过于兴奋不太好，但一点点的话。"},{"label":"大厅3","jp":"結構運動したからか、少しお腹が空いてきたような…","zh":"可能因为今天运动量比较大，我感觉有点饿了。"},{"label":"大厅4","jp":"運動はいつやっても良いものです。健康な体には、健康な精神が宿るのですから。","zh":"生命在于运动，因为健全的精神寓于健康的身体。"},{"label":"大厅5","jp":"先生、もしよろしければ…レモンの蜂蜜漬けなど、いかがでしょう？","zh":"要是老师方便的话，来点蜜渍柠檬怎么样？"},{"label":"回忆大厅1","jp":"ううん…うぅっ…\nくっ…ふっ…！","zh":"呼...唔...\n唔...呼...！"},{"label":"回忆大厅2","jp":"分かってはいましたが…やはり難しいようですね。\n先生、すみません…\nご覧の通り、このような状況となってしまいまして…","zh":"虽然已经预料到了，但果然还是太勉强了。\n老师，对不起，你也看到了，现在变成这样了。"},{"label":"回忆大厅3","jp":"そうでなくてもお忙しいのに…\n余計にお手間をおかけしてしまって、申し訳ございません。","zh":"老师本来就很忙了，我还给您添了更多的麻烦，真的很对不起。"},{"label":"回忆大厅4","jp":"去年まではよく着ていた服のはずなのに…\nどうして…一年の間にこのような…。","zh":"明明到去年为止还经常穿这件衣服，为什么只过了一年就变成了这样？"},{"label":"回忆大厅5","jp":"い、いえ、あまり大きな違いは…。\nその…あまり、体重は変わってないはず…なのですが\nた、たぶん…。","zh":"没没有应该没有很大变化，体重应该没什么大的变化。应该。"},{"label":"咖啡馆1","jp":"…よく片付いた場所ですね。","zh":"这里收拾的真整洁。"},{"label":"咖啡馆2","jp":"競技場でもないのにこんな格好でいるのは変でしょうか…？","zh":"这里不是赛场，我穿这身衣服会不会很奇怪？"},{"label":"咖啡馆3","jp":"あ…あれは…?","zh":"这是。"},{"label":"咖啡馆4","jp":"いつもと違って、ちょっと走りたくなりますね。","zh":"和平时不太一样，现在有点想跑步呢。"},{"label":"咖啡馆5","jp":"（ううっ…ダイエットの大敵が…）","zh":"减肥的大敌。"}],"好感度":[{"label":"好感度1","jp":"おそばにいってくださるだけでも心強いです。","zh":"只要您在我身边，我就觉得安心。"},{"label":"好感度2","jp":"先生さえよろしければ、もう少しご一緒に…。","zh":"如果老师愿意的话，我们可以在一起多……"},{"label":"好感度3","jp":"たまには先生も欲しいものをおっしゃってくださいね。","zh":"偶尔也请老师告诉我，您想要什么。"},{"label":"好感度4","jp":"ありがとうございます。こんな風に励まして頂いたのは久しぶりです。","zh":"谢谢您，好久没有被这样鼓励过了。"}],"战斗":[{"label":"编入队伍1","jp":"お任せください。","zh":"请交给我吧。"},{"label":"编入队伍2","jp":"お待ちしておりました。先生、ご指示を。","zh":"我正等您呢，老师，请指示。"},{"label":"拎起","jp":"先…生…？","zh":"老师。"},{"label":"任命队长1","jp":"試合開始です。","zh":"比赛开始了。"},{"label":"任命队长2","jp":"最善を尽くします。","zh":"我会全力以赴。"},{"label":"普通技能","jp":"集中します。","zh":"集中注意力。"},{"label":"EX动画1","jp":"美味しいそう…。","zh":"看上去好好吃啊。"},{"label":"EX动画2","jp":"うぅ…","zh":"呜…"},{"label":"EX动画3","jp":"耐え難い誘惑です…。","zh":"真是难以抵挡的诱惑。"},{"label":"EX技能1","jp":"集中、集中。","zh":"专注。"},{"label":"EX技能2","jp":"こんな時こそ深呼吸を。","zh":"越是这种时候，越要深呼吸。"},{"label":"EX技能3","jp":"しっかりしなさい、ハスミ！","zh":"莲见，振作起来。"},{"label":"战斗开始1","jp":"それではまず、走ってみましょうか。","zh":"那么就先跑起来吧。"},{"label":"战斗开始2","jp":"正々堂々と、参ります。","zh":"我会堂堂正正的战斗。"},{"label":"获得BUFF","jp":"声援、感謝します。","zh":"多谢支持。"},{"label":"施放BUFF","jp":"もう少し頑張ってみます。","zh":"再加把劲吧。"},{"label":"掩体","jp":"隠れます。","zh":"隐蔽。"},{"label":"被CC4","jp":"\\","zh":"\\"},{"label":"被CC6","jp":"\\","zh":"\\"},{"label":"回避","jp":"残念です。もう少し頑張ってください。","zh":"真可惜，祝你下次好运。"},{"label":"队伍移动1","jp":"急ぎましょう。","zh":"请抓紧时间。"},{"label":"队伍移动2","jp":"まだ終わっていません。","zh":"还没有结束。"},{"label":"回复","jp":"ありがとうございます。","zh":"非常感谢。"},{"label":"中途退出","jp":"そんな......","zh":"怎么会？"},{"label":"战斗喊叫","jp":"発射します。","zh":"发射。"},{"label":"角色移动","jp":"次へ行きましょう。","zh":"向下个目标出发吧。"},{"label":"战斗胜利1","jp":"素晴らしい試合でした。","zh":"很精彩的比赛。"},{"label":"战斗胜利2","jp":"これぐらいは達成できないといけませんね。","zh":"这是我们应该做到的。"},{"label":"关卡完成1","jp":"素晴らしい作戦でした、先生。","zh":"很出色的作战，老师。"},{"label":"关卡完成2","jp":"たまにはこういう格好も動きやすくていいですね。","zh":"偶尔穿这种便于活动的衣服也不错呢。"},{"label":"战斗失败1","jp":"申し訳ございません。","zh":"对不起，是我的错。"},{"label":"战斗失败2","jp":"これでは、選手失格ですね…。","zh":"这样根本不配作为一名选手。"}],"z'd":[{"label":"被CC5","jp":"\\","zh":"\\"}],"成长":[{"label":"升级1","jp":"期待して下さった分、結果でお返しいたしますね。","zh":"我会用结果来回报您的期待。"},{"label":"升级2","jp":"ありがとうございます。このご恩は、いつか必ず。","zh":"谢谢您。总有一天，我一定报答这份恩情。"},{"label":"升级3","jp":"これも試合のサポート…でしょうか。","zh":"这也是对比赛的支持吗？"},{"label":"升级4","jp":"こんなに期待していただいたのですから、全力を尽くすしかないですね。","zh":"既然老师对我如此期待，我也只能全力以赴了。"},{"label":"获得专武","jp":"ありがとうございます、先生。まるで優勝旗をいただいたような気分です。\n先生が一緒にいてくださる以上、今後も負けることはありません。\nですので、これからもよろしくお願いいたしますね。","zh":"老师，谢谢您。我现在就像拿到了冠军的锦旗一样，\n只要老师和我在一起，我将再也不会失败。所以以后也请您多多关照。"}],"事件":[{"label":"学生生日","jp":"…私の誕生日ですか?\n業務に追われすぎて、完全に頭から抜けておりました。\n覚えていてくださってありがとうございます、先生。","zh":"今天是我的生日？\n因为工作太忙了，我完全忘记了，谢谢您还记得，老师。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\n今日という日を先生と迎えられてとても嬉しく思います。\n…何か欲しいものでもありますか？","zh":"祝您生日快乐，老师，我很高兴能和老师一起度过这样的日子。\n您有什么想要的礼物吗？"},{"label":"万圣节","jp":"この格好もハロウィンの仮装…に見えるでしょうか。\n先生がそう思うのでしたら、私からは何も…ええ。","zh":"这身衣服看起来像万圣节装扮吗？\n如果老师这么认为，那我也就……"},{"label":"新年","jp":"明けましておめでとうございます、先生。\n今年も運動を重ねて身体を鍛え、健康な一年を\n過ごせるよう努力いたします。","zh":"新年快乐，老师，今年我也会继续通过运动，锻炼身体，争取度过健康的一年。"},{"label":"圣诞节","jp":"メリークリスマスです、先生。\nもしよろしければ、一緒にお出かけでもいかがでしょう？","zh":"圣诞快乐，老师方便的话要和我一起出去逛逛吗？"},{"label":"春节","jp":"","zh":"老师，祝您新春快乐。\n您说既然是新春就要吃些好的，不行，我的计划会被打乱。\n好好香，那那我就恭敬不如从命。"},{"label":"中秋","jp":"","zh":"老师，祝您中秋快乐。\n您想和我一起吃月饼？为什么每次说起节日您总是能拿出各种美食？"}],"活动":[{"label":"活动登陆1","jp":"お待ちしておりました、先生。準備はよろしいですか？","zh":"您来了，老师，准备好了吗？"},{"label":"活动登陆2","jp":"ちょうど試合が始まるところです。一緒に参りましょうか。","zh":"正好比赛要开始了，我们一起去吧。"},{"label":"活动大厅1","jp":"せ、先生……？","zh":"老师。"},{"label":"活动大厅2","jp":"そ、そんなに見つめられても……。","zh":"您这么盯着我看。"},{"label":"活动大厅3","jp":"そろそろ出発のお時間ですよ……。","zh":"好像是时候出发了。"},{"label":"活动大厅4","jp":"何か必要なものでもありますか？","zh":"是还需要什么吗？"},{"label":"活动事件1","jp":"結構盛り上がっていますね。\nこれなら、「晄輪大祭」は成功……と考えてもいいですね。","zh":"现场气氛很热烈呢，这样的话也能说明晄轮大会成功了吧。"},{"label":"活动事件2","jp":"「晄輪大祭」も大詰めを迎えていますね。\n最後まで頑張りましょう。","zh":"晄轮大会也已经进入尾声了，让我们努力到最后一刻吧。"},{"label":"活动结束","jp":"先生のおかげで、「晄輪大祭」は大成功を収めることができました。\n本当にお疲れ様でした。","zh":"多亏了老师，晄轮大会才能大获成功，真的辛苦您了。"},{"label":"活动任务1","jp":"えっと……現在お見せできるのはこれで全てです。","zh":"现在能给您看的就是这些了。"},{"label":"活动任务2","jp":"他に確認したいことでもありますか……?","zh":"您还有什么想确认的吗？"},{"label":"活动任务每日结束","jp":"本日の記録は以上です。","zh":"这些是今天的记录。"},{"label":"活动任务登录1","jp":"試合の記録を確認しますか？","zh":"您要确认一下比赛记录吗？"},{"label":"活动任务登陆2","jp":"進行状況を整理しました。確認しますか？","zh":"我整理了比赛目前为止的进行情况，你要看看吗？"},{"label":"活动任务获取1","jp":"確認しました。素晴らしい記録ですね。","zh":"我已经确认过了，十分精彩的记录。"},{"label":"活动任务获取2","jp":"これは……新記録かもしれません。","zh":"说不定这会打破纪录。"}]},"stats":{"init":[{"name":"攻击力","value":"305"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2219"},{"name":"治愈力","value":"1419"},{"name":"命中值","value":"912"},{"name":"闪避值","value":"197"},{"name":"暴击值","value":"202"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1972"},{"name":"射程","value":"850"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8592"},{"name":"防御力","value":"108"},{"name":"生命值","value":"46125"},{"name":"治愈力","value":"5936"},{"name":"命中值","value":"912"},{"name":"闪避值","value":"197"},{"name":"暴击值","value":"832"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1972"},{"name":"射程","value":"850"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"586"},{"name":"生命值","value":"2153"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"774"},{"name":"攻击力","value":"139"},{"name":"治愈力","value":"199"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg