el":"回忆大厅4","jp":"すみません、ちょっと\n混乱してしまったのですが……。\nありがとうございます、\nとっても嬉しいです……！","zh":"对不起，我刚刚有点混乱……。\n谢谢你，我真的很高兴……!"},{"label":"回忆大厅5","jp":"……先生のおかげです。\n……先生のおかげなんです、この気持ちは。","zh":"芹奈现在的这份心情，\n都是多亏了老师呢。"},{"label":"咖啡馆1","jp":"たまにはこうして、余裕を楽しむのも悪くないですね。","zh":"偶尔享受一下这种悠闲时光，也蛮好的。"},{"label":"咖啡馆2","jp":"あ…綺麗なピンク色…。","zh":"哇..好看的粉红色。"},{"label":"咖啡馆3","jp":"ここに、体調が\n悪い人はいませんか?","zh":"这里有人身体不舒服吗？"},{"label":"咖啡馆4","jp":"見ているだけで心が\n温かくなる空間ですね。","zh":"我只是看着这个地方就感觉心里暖暖的。"},{"label":"咖啡馆5","jp":"こういうところなら、\n患者さんたちも早く\n完治できると思います。","zh":"在这种地方，患者应该也能更快痊愈吧！"}],"好感度":[{"label":"好感度1","jp":"先生と一緒にいると、私の心が癒されるようです。","zh":"和老师在一起，就会感觉心灵得到了治愈！"},{"label":"好感度2","jp":"ふふふ。幸せですね。","zh":"哼哼，好幸福啊！"},{"label":"好感度3","jp":"先生だけの主治医にはなれないですけど。\nいつでも先生のことを考えています！","zh":"我不能只当老师一个人的主治医生，不过我会一直想着老师的！"},{"label":"好感度4","jp":"私たちで、平和な世界を作っていきましょう。","zh":"让我们创造一个和平的世界吧！"}],"战斗":[{"label":"编入队伍1","jp":"ま、任せてください。","zh":"请交给我吧！"},{"label":"编入队伍2","jp":"頑張ります。","zh":"我会尽全力的！"},{"label":"拎起","jp":"具合の悪い方はいませんか?","zh":"有哪位身体不舒服吗？"},{"label":"普通技能","jp":"痛いの痛いの～飛んでけ～。","zh":"痛痛，痛痛，飞走了~"},{"label":"EX动画1","jp":"ふぅ…。皆さんのために準備しました。","zh":"我已经为大家准备好了！"},{"label":"EX动画2","jp":"よいしょ…補給品が届きましたよ！","zh":"好嘞，补给送到了！"},{"label":"EX动画3","jp":"皆さんのための補給品です。","zh":"这是给大家的补给品！"},{"label":"EX技能1","jp":"補給品を受け取ってください！","zh":"请领取补给！"},{"label":"EX技能2","jp":"具合の悪い方から順番に。","zh":"请负伤的人先领！"},{"label":"EX技能3","jp":"大事に使ってくださいね。","zh":"请谨慎使用哦！"},{"label":"战斗开始1","jp":"皆さん、気をつけてください。","zh":"请大家小心！"},{"label":"战斗开始2","jp":"怪我しないように、\n気をつけてくださいね。","zh":"请注意不要受伤了！"},{"label":"特殊载具","jp":"今すぐ向かいます。","zh":"我现在就出发！"},{"label":"特殊载具","jp":"救護騎士団です！","zh":"我们是，救护骑士团！"}],"成长":[{"label":"升级1","jp":"もっと健康になった感じです。","zh":"我感觉，自己更健康了！"},{"label":"升级2","jp":"この力は……体調が悪い人たちに分けてあげられたら良いのに。","zh":"真希望能和受病痛折磨的人分享这种力量。"},{"label":"升级3","jp":"体調が悪い人たちのために、もっと努力します！","zh":"为了受病痛折磨的人们，我要继续努力！"},{"label":"升级4","jp":"私も少しは成長したんでしょうか。えへへへ。","zh":"我是不是也成长了一点点？欸嘿嘿。"},{"label":"获得专武","jp":"注射が痛いからって\n逃げたらだめですよ！","zh":"因为打针会疼就逃跑可不行哦！"}],"事件":[{"label":"学生生日","jp":"祝ってくださってありがとうございます。\n誕生日プレゼント、ですか?\n先生の笑顔だけでも十分ですよ！","zh":"谢谢你祝我生日快乐，您问我想要什么生日礼物是吗？嘿嘿，只要能看到老师的笑容就足够了。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\n今日一日が、\n幸せでいっぱいであることを願ってます！","zh":"老师，生日快乐，祝愿您今天一整天都充满幸福！"},{"label":"万圣节","jp":"ハロウィンの飴をいただきました！\n飴は甘くて美味しいけど\n食べ過ぎるときっと\n虫歯になっちゃいます…。","zh":"我收到了万圣节的糖果，糖果虽然甜甜的很好吃，但是吃太多肯定会蛀牙的.."},{"label":"新年","jp":"明けましておめでとうございます！\n新年から風邪ひかないように、\nしっかり暖かく着込んでくださいね！","zh":"恭祝新春快乐，请一定要注意新年不要感冒，记得多穿点衣服哦！"},{"label":"圣诞节","jp":"メリークリスマス、先生。\n今日ぐらいは皆さんケンカしないで、\n平和な一日になるといいですね。","zh":"老师，圣诞快乐，今天是大好的日子，希望大家不要打架，可以度过和平的一天！"},{"label":"春节","jp":"","zh":"老师，新春快乐。今天是大家尽情玩耍的日子，但也要注意安全，不要受伤哦。"},{"label":"中秋","jp":"","zh":"在这个团圆的日子里，我衷心的希望：不再有人遭受病痛。"}]},"stats":{"init":[{"name":"攻击力","value":"167"},{"name":"防御力","value":"24"},{"name":"生命值","value":"2482"},{"name":"治愈力","value":"2431"},{"name":"命中值","value":"704"},{"name":"闪避值","value":"805"},{"name":"暴击值","value":"201"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1596"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4756"},{"name":"防御力","value":"135"},{"name":"生命值","value":"50168"},{"name":"治愈力","value":"17202"},{"name":"命中值","value":"704"},{"name":"闪避值","value":"805"},{"name":"暴击值","value":"351"},{"name":"暴击伤害","value":"200"},{"name":"稳定值","value":"1596"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"322"},{"name":"生命值","value":"2356"},{"name":"治愈力","value":"1247"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"