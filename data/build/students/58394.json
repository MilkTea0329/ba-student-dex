":{"attrs":[{"name":"生命值","value":"738"},{"name":"攻击力","value":"126"},{"name":"治愈力","value":"234"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/873344.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/81014.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 日富美","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/972177.png","url":"https://www.gamekee.com/ba/66256.html"},{"name":"★3 日富美（赛车）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_503/h_503/408107/2026/9/28/72247981mvs62rlc.png","url":"https://www.gamekee.com/ba/725713.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive~"},{"label":"卡池抽取","jp":"あ、相変わらず地味めな私ですが……よろしくお願いします！","zh":"我还是那么不起眼呢……如果您不介意的话，就请多指教啦~！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！海ですよ、海！海が私たちのことを待ってます！","zh":"老师！大海，是大海啊！大海正等着我们呢！"},{"label":"登陆2","jp":"今日は良い天気ですね、先生。一緒に海沿いで、お散歩でもしませんか？","zh":"老师，今天天气真好呀！要不要一起去海边散步呀？"},{"label":"大厅1","jp":"海に行くとのことで、少しおしゃれをしてみたんですが……","zh":"听说要去海边……我就稍微打扮了一下。"},{"label":"大厅2","jp":"い、いかがでしょう？地味、ですかね……？","zh":"您……觉得怎么样？看起来会不会太普通了？"},{"label":"大厅3","jp":"夏の海でバカンスとはいっても、ペロロ様のぬいぐるみは欠かせません！","zh":"在夏日海边享受度假，怎么能少了佩洛洛大人的玩偶呢？"},{"label":"大厅4","jp":"ペロロ様の羽が濡れてしまわないように防水対策も徹底してます！","zh":"为了防止佩洛洛大人柔软的羽毛被水浸湿，要做好万全的防水工作。"},{"label":"大厅5","jp":"……あれ？先生、シャーレの前に駐車していたはずのクルセイダーちゃん、どこに行ったかご存知ですか？","zh":"老，老师……您看到停在沙勒大楼前的十字军坦克了吗？"},{"label":"回忆大厅1","jp":"ふんふん～♪隅々までキレイに～♪","zh":"哼哼~边边角角全都变干净~！"},{"label":"回忆大厅2","jp":"クルセイダーちゃんを、錆びさせるわけにはいきませんからね。\nそもそもみんなで使うものですし、キレイな状態で学園に戻さないと。","zh":"小小十字军可不能生锈哦。\n毕竟是大家共用的东西，得洗干净了再放回去才行。"},{"label":"回忆大厅3","jp":"あ、先生。あまり近くにいると、水がかかってしまうかもしれませんよ？","zh":"老师小心点，离得太近可能会被水淋湿哦。"},{"label":"回忆大厅4","jp":"水着だから、濡れても平気……ですか？","zh":"您说……穿着泳装淋湿了也没关系？"},{"label":"回忆大厅5","jp":"確かにそうですね。\nあ、ではせっかくですし、この後は一緒に泳ぎにも行きましょう！","zh":"确实如此呢……对了，机会难得，之后我们一起去游泳吧！"},{"label":"咖啡馆1","jp":"カフェでこの格好は……ちょっと恥ずかしいですね。","zh":"在咖啡厅里穿成这样……感觉有些不好意思呢。"},{"label":"咖啡馆2","jp":"夏っぽい家具がたくさん！","zh":"好多充满夏日氛围的家具哦……"},{"label":"咖啡馆3","jp":"（な、なんだか注目されてるような……？）","zh":"（怎么感觉大家都在关注我……）"},{"label":"咖啡馆4","jp":"（夏の暖かい日差し……気持ち良い……）","zh":"（夏日温暖的阳光……好舒服啊~）"},{"label":"咖啡馆5","jp":"（夏限定のペロロ様グッズは無いのかな……？）","zh":"（有没有夏日限定的佩洛洛大人周边呢？）"}],"好感度":[{"label":"好感度1","jp":"こうして先生と一緒にいられて、今年の夏は最高の思い出になりそうです。","zh":"因为和老师在一起，这个夏天一定会成为我最珍贵的回忆！"},{"label":"好感度2","jp":"先生と一緒なら深い海の底でも怖くありません。","zh":"和老师在一起，就算到深海也不害怕！"},{"label":"好感度3","jp":"なんだか……胸がドキドキします。","zh":"总觉得……心脏怦怦直跳……"},{"label":"好感度4","jp":"先生、来年の夏もまた私と一緒にいてくださいね。","zh":"老师，明年夏天也请和我一起度过吧！"}],"战斗":[{"label":"编入队伍1","jp":"今から泳ぎに行くんですか？！","zh":"现在要去游泳吗？"},{"label":"编入队伍2","jp":"バカンスにはピッタリの日ですね。","zh":"是个适合度假的好日子呢~"},{"label":"拎起","jp":"ひゃあっ！？","zh":"咿呀！？"},{"label":"普通技能","jp":"期間限定ペロロ様爆弾です！","zh":"限定版，佩洛洛大人炸弹！"},{"label":"EX动画1","jp":"お、落ち着いてください、クルセイダーちゃん！","zh":"小小十字军……请冷静点！"},{"label":"EX动画2","jp":"……わぁ、うわぁぁ！","zh":"哇……哇？！"},{"label":"EX动画3","jp":"……うわぁ、落ちる！","zh":"要……要掉下来啦！"},{"label":"EX技能1","jp":"うえぇ、行きます！","zh":"好，我要上啦！"},{"label":"EX技能2","jp":"あ、あれぇ、操縦桿が……","zh":"啊，那个……操纵杆……！"},{"label":"EX技能3","jp":"せ、戦車前進です！","zh":"坦克，前进！"},{"label":"EX技能-召唤物NS","jp":"危険ですので、皆さん戦車から離れてください！","zh":"危险！请大家远离！"}],"成长":[{"label":"升级1","jp":"えへへ……。これで私も少しくらい地味ではなくなったでしょうか？","zh":"啊哈哈，这样是不是就没那么贫乏了呢？"},{"label":"升级2","jp":"私、もっと頑張ります！","zh":"我会更加努力的！"},{"label":"升级3","jp":"泳ぎの練習でしたら、いっぱいしてきました！","zh":"我已经练过很多次游泳啦！"},{"label":"升级4","jp":"ペロロ様のためなら……！","zh":"为了佩洛洛大人……"},{"label":"获得专武","jp":"この銃器、防水加工はされてるんでしょうか……？","zh":"这把枪……应该是防水的吧。"}],"事件":[{"label":"学生生日","jp":"何か誕生日に欲しいもの……ですか？\n……ありがとうございます、でも大丈夫です。先生と一緒に過ごすこのバカンスが、私にとっては最高の誕生日プレゼントですから！","zh":"我的……生日礼物？\n不用了，没关系的！可以跟老师一起度假，对我来说就是最好的礼物。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！お祝いに私のこの、ペロロ様の浮き輪をプレゼントします！","zh":"老师，生日快乐！为了表示祝贺，我要把我最爱的佩洛洛泳圈送您当礼物！"},{"label":"万圣节","jp":"え、ハロウィンの衣装？あ、いえ、これは普通に水着で……\nあはは、ちょっと季節違いかもですが……","zh":"万，万圣节服装……？这只是很普通的泳衣啊？啊哈哈……不过确实跟季节有些不搭。"},{"label":"新年","jp":"明けましておめでとうございます、先生。今年の夏も、楽しみにしてますね！","zh":"新年快乐，老师！今年夏天我也很期待啊~"},{"label":"圣诞节","jp":"さっきシャーレの建物の前で、雪に埋もれたペロロ様を見かけまして……。\n裸の状態で、サンタさんの帽子だけを被っていたのですが、寒くないのでしょうか……？","zh":"刚刚在沙勒大楼前面，我看到了一个被雪埋没的佩洛洛……\n这么冷的天，它只戴了个圣诞帽……会不会冷呢？"},{"label":"春节","jp":"","zh":"老师，祝您新春快乐。今年夏天我能再和老师一起去海边吗？"},{"label":"中秋","jp":"","zh":"老师，中秋节快乐！这是我抢到的佩洛洛限定月饼，老师要一起尝尝吗？"}],"活动":[{"label":"活动登陆1","jp":"爽やかの海の香りがしますね！","zh":"哇~是大海清爽的味道！"},{"label":"活动登陆2","jp":"楽しいバカンスになるどいいですね！","zh":"希望大家能度过一个快乐的假期！"},{"label":"活动大厅1","jp":"準備万端です！ペロロ様の浮き輪もしっかり持ちましだ！","zh":"万无一失！游泳时需要的佩洛洛泳圈也准备好啦~"},{"label":"活动大厅2","jp":"あれ？脱衣所の鍵、確かここ置いだはず……","zh":"嗯？刚才明明把更衣室的钥匙放到这里了呀……"},{"label":"活动大厅3","jp":"あの……えっと……そんなにジーど見られると、恥ずかしです","zh":"啊哈哈……请别这样看着我，我会不好意思的……"},{"label":"活动大厅4","jp":"ついに来ましだ！海ですよ！海！","zh":"终于坐上电车来到海边啦~！"}]},"stats":{"init":[{"name":"攻击力","value":"337"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2424"},{"name":"治愈力","value":"1964"},{"name":"命中值","value":"726"},{"name":"闪避值","value":"769"},{"name":"暴击值","value":"259"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1546"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"9269"},{"name":"防御力","value":"105"},{"name":"生命值","value":"47339"},{"name":"治愈力","value":"8802"},{"name":"命中值","value":"726"},{"name":"闪避值","value":"769"},{"name":"暴击值","value":"889"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1546"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}