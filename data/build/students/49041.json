/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/411538.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/3/163810.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"优香（体操服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_270/h_270/829/737047/2025/5/3/786193.png","url":"https://www.gamekee.com/ba/170295.html"},{"name":"优香（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/737047/2025/5/3/470337.png","url":"https://www.gamekee.com/ba/643617.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"条件はクリアされました。\n私たちは今日この瞬間を絆と定義し、証明することになるでしょう。","zh":"条件都已达成，我们就把今天这一刻定义为缘分，并努力去证明它吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生。今日も全力であなたをアシストしますね。","zh":"老师，今天我也会全力协助您的！"},{"label":"登陆2","jp":"ようこそ、先生。今から反省会を始めます。あっ、どこに行くんですか？","zh":"欢迎您，老师。我们来开反省会吧！……诶？您要去哪儿？"},{"label":"登陆3","jp":"\\","zh":"\\"},{"label":"大厅1","jp":"せ～ん～せ～い～。もう少し頑張ってください！","zh":"老、师、啊……！请您再上进一点好吗！"},{"label":"大厅2","jp":"先生。今、先生の行動について言いたいことが34個あります。","zh":"老师，针对您刚才的这种行为，我想说的话有34句。"},{"label":"大厅3","jp":"（…そのうちの一つは特別な言葉だけど）","zh":"（不过其中有一句……是特别的。）"},{"label":"大厅4","jp":"でも最近は先生らしくなった気がします。\nはい？私のおかげ、ですか？うえぇっ？…も、もちろんです！","zh":"但是，我发现您最近越来越有老师的样子了。……什么？您说都是托我的福？……那、那还用说！"},{"label":"大厅5","jp":"先生。お仕事を始める前にまず、これからの目標と方向性を策定してください。","zh":"老师，在开始工作之前，请先定好将来的目标和工作方针吧。"},{"label":"回忆大厅0","jp":"まったく…大人なんですから、しっかりと大人らしく計画的な消費をしてください。お小遣いをもらってパーッと使っちゃう子供じゃないんですよ？","zh":"真是的，您好歹是大人，就要有大人的样子，平时消费一定要有计划。……又不是一拿到零花钱，转头就全~部花光的小孩子！"},{"label":"回忆大厅1","jp":"それに、こうして領収証の整理を手伝ってくれるのなんて、\n私くらいなんですから…。\n次はもう、絶対に手伝いませんからね！","zh":"再说，能像这个样子，过来帮您好好整理收据的，也就……只有我了。……下一次，我可绝对不会再帮您了！"},{"label":"回忆大厅2","jp":"15日前にコンビニで購入したチキンサンド500円…\n新刊の漫画購入で450円…。\nん…？一昨日の夜、「クラブ・ふわりん」で2万円…？","zh":"15天前在便利店买的鸡肉三明治500联合币，买新一期的漫画花了450……嗯？前天晚上，在【软绵绵俱乐部】花了……两……两万？！"},{"label":"回忆大厅3","jp":"せ、先生！いったい何ですか、この領収証は！\n生徒たちの模範となるべき教育者が、\nこんな、い、いかがわしいお店に行くだなんて…！\n信じられません！最低です！","zh":"呃，老师……！这、这什么啊，这个收据……！老师您应该是大家的榜样才对啊，怎、怎么可以去这种低、低级的地方！……真是难以置信，太差劲了！"},{"label":"回忆大厅4","jp":"え、「クラブ・ふわりん」っていう名前の、スマホゲームのガチャ…？\n…ふぅ。てっきり私、その…。","zh":"嗯？【软绵绵俱乐部】是手机游戏，那只是在抽卡……？唉……我还以为那是……那是……"},{"label":"回忆大厅5","jp":"って、いやいや！それでも一回で2万円は課金しすぎです！\n衝動買いは禁止！消費はちゃんと計画的にっ！","zh":"嘛……不对！那也不行！一次就课了两万也太多了吧！……禁止冲动消费！今后花钱要有计划性！"},{"label":"回忆大厅6","jp":"\\","zh":"\\"},{"label":"回忆大厅7","jp":"\\","zh":"\\"},{"label":"回忆大厅8","jp":"\\","zh":"\\"},{"label":"回忆大厅9","jp":"\\","zh":"\\"},{"label":"咖啡馆1","jp":"うん？少し休んでいきますか？私も、約1890秒くらいの余裕はありますから。","zh":"嗯？要稍微休息一下嘛？我也还有大约1890秒的空闲时间。"},{"label":"咖啡馆2","jp":"なんだか今日は楽しいことがありそうな気がする。確率的に～。","zh":"总感觉……今天会有好事，从概率上讲。"},{"label":"咖啡馆3","jp":"あれ？こんな空間あったっけ？","zh":"嗯？竟然还有这样的一块地方。"},{"label":"咖啡馆4","jp":"このままだと破産する…。出費を減らさないと…。","zh":"再这样下去就要破产了……必须要减少支出……"},{"label":"咖啡馆5","jp":"もしこれを購入したら、私は十三日間、学食の基本メニューだけを食べるしかない。それはつらいけど、買わなきゃ！","zh":"如果买了这个，接下来的13天内我在食堂能吃的就只有最便宜的套餐了。好难啊……但我买定了！"}],"好感度":[{"label":"好感度1","jp":"体力も時間も、たくさん使っちゃった気がしますけど、先生といると得した気分です！","zh":"虽然我感觉自己耗费了很多体力和时间，但是和老师在一起……我又觉得自己赚了。"},{"label":"好感度2","jp":"計算が出来ません…。今、この気持ちがですよ…！","zh":"我是说……我现在的心情……"},{"label":"好感度3","jp":"いつも測定や、計算だけを考えてたけど、今は…ただこの瞬間を感じていたい。","zh":"平时我的大脑一直在测定啊、计算啊……但是现在，我只想感受这一刻。"},{"label":"好感度4","jp":"どうしてかな…説明できない感覚だけど…嫌いじゃない。","zh":"为什么呢……这种感觉，我无法用语言解释。但也……不讨厌。"}],"战斗":[{"label":"编入队伍1","jp":"合理的な選択ね。","zh":"合理的选择。"},{"label":"编入队伍2","jp":"これ、報酬は出るんです？","zh":"这……有报酬吗？"},{"label":"拎起","jp":"ふーん……やっぱり先生は賢いですね。","zh":"啊……果然还是老师聪明。"},{"label":"任命队长1","jp":"敵の位置を確認。先生、指揮をお願いします。","zh":"敌人位置已确认。老师，拜托您指挥了。"},{"label":"任命队长2","jp":"敵の位置を確認。距離、至近。戦力、計算完了。","zh":"已确认敌人位置。极近距离。战斗力计算完毕。"},{"label":"普通技能","jp":"まだ終わらないわよ！","zh":"还没结束呢！"},{"label":"EX动画1","jp":"悲しみも怒りも、全て因数分解してやるわ！","zh":"悲伤也好，愤怒也罢。我都会把它们因数分解掉"},{"label":"EX动画2","jp":"現在の状況と条件。よし、これは勝ちね！","zh":"现在的状况和条件……好，肯定能赢！"},{"label":"EX动画3","jp":"攻撃が私に命中する確率は…極めて低い！","zh":"你打中我的概率……极低！"},{"label":"EX技能1","jp":"単なる計算結果に過ぎないわ。","zh":"单纯的计算结果罢了。"},{"label":"EX技能2","jp":"合理と理性は無慈悲よ。","zh":"合理与理性是无情的。"},{"label":"EX技能3","jp":"勝利、証明するわ。","zh":"我会求证，得出胜利的答案！"},{"label":"战斗开始1","jp":"計算は完璧。落ち着いて行こう。","zh":"我的计算很完美，保持理性行动吧！"},{"label":"战斗开始2","jp":"私たちの勝率はかなり高い。自信を持って行こう。","zh":"我们的胜率相当高。自信点，上吧！"},{"label":"获得BUFF","jp":"ありがとう。","zh":"谢谢！"},{"label":"施放BUFF","jp":"私の計算は完璧よ。","zh":"我的计算是完美的。"},{"label":"掩体","jp":"隠れるわ。支援をお願い。","zh":"我躲好了，请求支援！"},{"label":"被CC1","jp":"-","zh":"呃"},{"label":"被CC2","jp":"-","zh":"呃哼哼"},{"label":"被CC3","jp":"痛い！","zh":"好疼啊！"},{"label":"回避","jp":"無駄よ。","zh":"没用的！"},{"label":"队伍移动1","jp":"ま、ここまでは計算通りね。","zh":"嗯，到目前为止都和预计一样。"},{"label":"队伍移动2","jp":"計算が合っていれば、すぐに次の目標が見えてくるはず。","zh":"如果我的计算没错，下一个目标就在前方！"},{"label":"回复","jp":"うん、丁度いい量ね。","zh":"嗯，量正好。"},{"label":"中途退出","jp":"変数が……多すぎる……","zh":"变量……太多了……"},{"label":"战斗喊叫","jp":"-","zh":"哈"},{"label":"战斗喊叫","jp":"-","zh":"哈"},{"label":"战斗喊叫","jp":"-","zh":"嘿"},{"label":"角色移动","jp":"行くわよ。","zh":"上吧！"},{"label":"战斗胜利1","jp":"計算通り。完璧～。","zh":"和我的计算一致。完美！"},{"label":"战斗胜利2","jp":"数学は真実を導く。私たちの勝ちよ。","zh":"数学通向真理，我们赢了！"},{"label":"关卡完成1","jp":"スマートに勝利～。","zh":"一场聪明的胜仗！"},{"label":"关卡完成2","jp":"運が良かった？いいえ、計算通りです。","zh":"运气好？并不是。都在预料之中。"},{"label":"战斗失败1","jp":"問題設計の方が、間違ってましたからぁ……","zh":"是……设问的方式有问题啦……"},{"label":"战斗失败2","jp":"計算機が…故障していたとは…","zh":"计算器……居然出问题了……"}],"成长":[{"label":"升级1","jp":"成果を見せるチャンス、待ってました！","zh":"展示成果的机会终于来啦，我等很久了！"},{"label":"升级2","jp":"数値で感じられる結果というのは、人をドキドキさせますね。","zh":"可以用数值来表现的结果，可真令人心跳加速！"},{"label":"升级3","jp":"次の任務は、黒字を期待してくださいね。","zh":"下一次的任务，您应该可以看到盈余了！"},{"label":"升级4","jp":"こんな表現はあまり好きじゃないけど…今の私、測定不能です！","zh":"我不太喜欢这种表达方式……但是……现在的我……无法测定！"},{"label":"获得专武","jp":"これは……ものすごいプラスになるやつだ！","zh":"这东西……带来的提升真是难以估量！"}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日です。プレゼントは、私が選びますね。さあ、出かけませんか？高い物じゃなくてもいいので！","zh":"今天是我的生日。礼物嘛……我自己来挑吧。来，出去逛逛吧！呃……不用买很贵的也行啦！"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。今日で先生が生まれてから約…はい？計算しちゃダメですか？","zh":"祝您生日快乐，老师！今天是老师出生后的第……诶？不能算嘛……？"},{"label":"万圣节","jp":"学園都市の人口に比例してみると、現在のキヴォトスに流通している飴の数とそのカロリーは…（ぶつぶつ）","zh":"如果和这个都市的总人口成比例的话，目前在基沃托斯流通的糖果数量及其卡路里是……"},{"label":"新年","jp":"数学でも初めが肝心です。今年の始まりを、一緒に始めましょうか？","zh":"在数学里，开头也是很重要的。新年伊始，让我们一同前进吧！"},{"label":"圣诞节","jp":"クリスマスか…。普段こういう日はちっとも楽しくないけど。今は先生がいてくれて、少しは楽しいですね。","zh":"圣诞节啊……换作以前，我对这种日子真没什么感觉。不过现在有老师在，还是有点开心的。"},{"label":"春节","jp":"","zh":"老师，祝您新春快乐！……经过我的计算，今年您遇到好事的概率很大呢！"},{"label":"中秋","jp":"","zh":"今天就不要计较卡路里了！……老师，我们一起来分享这些月饼怎么样？"}]},"stats":{"init":[{"name":"攻击力","value":"119"},{"name":"防御力","value":"29"},{"name":"生命值","value":"3147"},{"name":"治愈力","value":"1505"},{"name":"命中值","value":"100"},{"name":"闪避值","value":"1440"},{"name":"暴击值","value":"200"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1396"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"350"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"2884"},{"name":"防御力","value":"664"},{"name":"生命值","value":"138479"},{"name":"治愈力","value":"7097"},{"name":"命中值","value":"100"},{"name":"闪避值","value":"1890"},{"name":"暴击值","value":"500"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1396"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"27 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"135%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"234"},{"name":"生命值","value":"6969"},{"name":"治愈力","value":"808"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"徽章","grade":"T10","attrs":[{"name":"生命值","value":"16000"},{"name":"受恢复率","value":"3500"},{"name":"生命值","value":"25%"}]},{"slot":"3号装备","name":"护符","grade":"T10","attrs":[{"name":"暴击抵抗值","value":"420"},{"name":"暴伤抵抗率","value":"3000"},{"name":"暴击值","value":"300"}]}],"giftDetail":{"t1V