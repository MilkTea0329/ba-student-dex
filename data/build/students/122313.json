.0/images/w_304/h_240/829/157597/2025/5/13/846047.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/41172.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/546670.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/239763.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/157597/2025/5/13/486625.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/846047.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/41172.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/546670.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/239763.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"775"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"199"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/175604.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/13/436818.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 美游","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/13/748107.png","url":"https://www.gamekee.com/ba/153606.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue A...Archive..."},{"label":"卡池抽取","jp":"ラ、ラビット４…準備完了しました…\n本当に、こんな格好でいいのですか…？","zh":"R...Rabbit4...准备就绪。穿成这样，真的不要紧吗……"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"うぅふ、せ、せんせい、待ってました","zh":"啊，老，老师。我一直……在等您呢。"},{"label":"登陆2","jp":"あの、実は先からここにいたんのですが…\nわ、わたしのこと、忘れてませんか…？","zh":"其实我，从刚才就一直在这里……您，您该不会把我给忘了吧……"},{"label":"大厅1","jp":"海の思い出…あ…あまりいいものはないです","zh":"说到关于大海的回忆……好，好像没什么美好的回忆呢……"},{"label":"大厅2","jp":"何か、お手伝い出来ることはないでしょうか？\n飲み物買ってきるとか？\nうえぇ…？この格好で外に行くのが問題が？\nどう、どうして…？","zh":"有什么，需要我帮忙的事情吗……？比如买点喝的回来之类的……\n嗯？……穿着这身衣服去不太好？为，为什么……"},{"label":"大厅3","jp":"か、かわいいですか…？ありがとうございます！…\n私のようないも娘には、身に余るお言葉です。别抄了哥","zh":"你，你是说我可，可爱吗……？谢，谢谢……\n您太过奖了……我只是个不起眼的普通女生而已……"},{"label":"大厅4","jp":"釣りは…狙撃手にピッタリの趣味かもしれません…！\n準備をして、待ち続けるところとか…仕組みも、大体同じですし","zh":"钓鱼，大概是最适合狙击手的兴趣爱好了……\n它们的原理也差不多……就是做好准备以后，一直等待下去……"},{"label":"大厅5","jp":"水泳は少しだけ…できます。\nバタフライはまだ…苦手ですが…","zh":"游泳我还是……会一点的。不过，蝶泳还不太会……"},{"label":"回忆大厅1","jp":"えへへ…せんせいもすぐに気づかないなんで…\n今回も完璧みたいです","zh":"诶嘿嘿……竟然连老师也没有马上发现我。看来这次的伪装也很成功呢。"},{"label":"回忆大厅2","jp":"木を隠すには森のなかというように\n釣り人のなかに溶け込むには…釣りをするのが自然ですから。","zh":"俗话说：“藏木于林”……要混进垂钓者中间，最自然的方式，就是自己也去钓鱼……"},{"label":"回忆大厅3","jp":"カモメや海鳥がずっと頭に乗ろうとするのは、ちょっと困りますが…\nこういうの、慣れてますから…えへへ…エヘヘへ…","zh":"虽然总有海鸥这类的海鸟想要落在我的头上，让我有点困扰……\n但这种事情，我早就习以为常了……诶嘿，嘿嘿嘿……"},{"label":"回忆大厅4","jp":"丁度釣り道具あったから、ここにしましたが…\n潜伏するには、ピッタリの場所ですね。\n别抄了見晴らしもいいですし、周辺を監視するのにも最適…！\n風が涼しいから、熱くもなくて、日除けの麦わら帽子もありますし…","zh":"其实是因为正好有渔具所以才选了这个地方，没想到这里还蛮适合伪装潜伏呢……\n这里视野开阔，很适合监视周围的情况……有徐徐凉风吹过，很凉快……\n还有用来遮阳的草帽……"},{"label":"回忆大厅5","jp":"そ…そして、今日は…？せ、せん、せんせいも…\n側にいますから…","zh":"而，而且……今天……\n老，老，老师也……和我，在一起……"},{"label":"咖啡馆1","jp":"素敵な格好の人がいっぱい...","zh":"穿的光鲜亮丽的人好多……"},{"label":"咖啡馆2","jp":"うぅ…うぅぅぅ……","zh":"呜，呜呜呜呜……"},{"label":"咖啡馆3","jp":"水着なのに、誰にも気づかれないのです","zh":"就算穿着泳装，也没人在意我……"},{"label":"咖啡馆4","jp":"いたいどうな話をしているのでしょか","zh":"（她们在聊什么呢……？）"},{"label":"咖啡馆5","jp":"皆...どこに行ったの？","zh":"大家都去哪里了……"}],"好感度":[{"label":"好感度1","jp":"せんせいの為なら、何だて出来ますから！","zh":"只要是为了老师，我什么都可以做到！"},{"label":"好感度2","jp":"先生と一緒なら…私も、ここにでもいいんだて、思えます…！","zh":"只要有老师在身边，我就会觉得，自己也可以呆在这里……！"},{"label":"好感度3","jp":"せんせいー、今夜、パットロルに付き合ってくれませんか？","zh":"老师……今晚可以请您陪我一期巡逻吗……？"},{"label":"好感度4","jp":"狙撃手としてだめなのに…\nどうしても、せんせいの方に目が行ってしまいます","zh":"身为狙击手，是不可以这样的……但不知怎么的，我都视线，总是会跑到老师那里去……"}],"战斗":[{"label":"编入队伍1","jp":"は、はうう…！","zh":"呜，呜呜呜……！"},{"label":"编入队伍2","jp":"い…今から始まるのですか？","zh":"现，现在就开始吗……？"},{"label":"拎起","jp":"ぼ、帽子が……ひぃん。","zh":"啊……我，我的帽子……"},{"label":"普通技能","jp":"ヒット、です","zh":"命，命中目标……！"},{"label":"EX动画1","jp":"え？ふえ？ふえ！！","zh":"呜，呜，呜呜呜呜呜！！"},{"label":"EX动画2","jp":"嫌…辞めて！！","zh":"不，不要……！！"},{"label":"EX动画3","jp":"と、鳥…どうして！","zh":"是，是鸟……！什么情况……！"},{"label":"EX技能1","jp":"あぁ、あっち行って！","zh":"走，走开呀！！"},{"label":"EX技能2","jp":"ふええぇ！","zh":"呜——！！"},{"label":"EX技能3","jp":"す、好きにしてください","zh":"都，都给你——！！"}],"成长":[{"label":"升级1","jp":"い…いいのでしょうか？\nそ、その、あまり上手く、出来なかったなのに…","zh":"我，我可以收下吗……？可，可我的表现明明不是很好……"},{"label":"升级2","jp":"私なんかに、勿体無いです…いいえ、頑張ります…！","zh":"给我这种人太浪费了……\n不过……我会更加努力的……！"},{"label":"升级3","jp":"いい支給品ですね～…で、でも、私には相応しくない、かも","zh":"这些物资真不错……但对我这种人来说，可能太奢侈了……"},{"label":"升级4","jp":"わ、私、せんせいの期待に、答えられるのでしょうか","zh":"我，我能满足，老师的期待吗……？"},{"label":"获得专武","jp":"ラビット39式照準、う、受け取りました。\n海辺での狙撃は、風も、湿気も強くて、色々と難しいのですが…\nそれでも、1キロまででしたら、何とかなりそうです！","zh":"RABBIT 39式步枪……我，我收到了……\n虽然海边风大，湿气又重，狙击起来很有难度……\n但一千米以内的话，努努力还是办得到的……"}],"事件":[{"label":"学生生日","jp":"あたしの誕生日…！覚えて居てくださだのですね…！\n本当に、ありがとうございます…！","zh":"您记得，我的生日啊……！真是太感谢您了！"},{"label":"老师生日","jp":"お、お誕生日おめでとうございます！せんせい\n今日…もしいいものが釣れたら、必ず先生にプレゼントしますね…！","zh":"生，生日快乐，老师……今天，如果能钓到什么好东西，我一定会送给老师的！"},{"label":"万圣节","jp":"少し肌寒くなって来ましたね…\n温かいカボチャのお茶でも飲みたい気分です","zh":"不知道是不是因为天气转凉了，想喝杯热腾腾的南瓜茶呢……"},{"label":"新年","jp":"明けましておめでとうございます、せんせい\nその、おせち料理も、廃棄分があったりするでしょうか…？","zh":"新年快乐，老师。那个……年节菜，会不会也有过期的要处理掉呢……？"},{"label":"圣诞节","jp":"今年のクリスマスは、モエちゃんが大きな七面鳥焼いてくれみたいで…\n少し、楽しみです。\nよ…良かったら先生も一緒にいかがですか？","zh":"萌绘说，今年圣诞节会给我烤大火鸡，我有点期待……\n如，如果可以的话，老师，要来和我们一起吗……？"},{"label":"春节","jp":"","zh":"新春快乐……老师。\n今天钓到的鱼被乌鸦抢走了……就当作是给它的新年礼物吧……呜……"},{"label":"中秋","jp":"","zh":"听说中秋是团聚的日子……\n能在这一天和RABBIT小队的大家，还有老师在一起，我真的很幸福……嘿嘿。"}],"活动":[{"label":"活动登陆1","jp":"ヒィィィ…ホラー小説に出てくる郷村みたい…","zh":"噫……像恐怖小说里的渔村一样……"},{"label":"活动登陆2","jp":"早く学園に戻りたい\nうぅ…私たちの学園は…もう…","zh":"好想快点回学院……\n不对，我们的学院已经不在了……"},{"label":"活动大厅1","jp":"も、も、もしかしてお呼びですか？","zh":"那，那个……你，叫我了嘛？"},{"label":"活动大厅2","jp":"どうしてもこんな偏僻の村まで来てしまたのかな","zh":"（我为什么会跑到这么偏僻的村子来……）"},{"label":"活动大厅3","jp":"この髪型…宮子ちゃんが作戦に出る直前に選んでくれだんです。\nへへ…これ可愛いかも别抄了","zh":"这个发型，是出来执行任务之前，小宫（宫子）帮我编的。\n嘿嘿……感觉还挺可爱的。"},{"label":"活动大厅4","jp":"スズメも、イタチも、カモメも…野生の動物たちが。\n私を寄ってくるの理由は何なんでしょ…？","zh":"麻雀，鼬鼠，还有海鸥……\n也不知道这些野生动物，为什么总是靠近我呀……"},{"label":"活动事件1","jp":"ここの住民は凄く怖くて…調査のために話すと…\nに、逃げてしまいたくなるのです","zh":"这里的居民都好可怕……\n每次为了调查和他们说一会话，就，就会好想逃跑……"},{"label":"活动事件2","jp":"先程、船長さんから温かいコーヒーをいただきました。\n思ったより…怖くない人なのかも","zh":"刚才船长给了我一杯热咖啡……\n也许他并没有我想象的……那么可怕。"},{"label":"活动结束","jp":"この村にも、少し愛惜が湧いてきました。","zh":"在这个村子待久了，好像也对它有一点感情了呢……不过，最让我安心的地方，依然还是小兔公园。"},{"label":"活动结束2","jp":"でも、やっぱり…あたしにとっては…\n小兎公園が一番落ち着く場所です","zh":"但是，果然…对我来说…小兔子公园才是最安心的地方"},{"label":"活动商店1","jp":"へ？あの、その…私が小石ほど存在感が薄いのはわかりますが…","zh":"诶，那，那个……我确实没什么存在感，就像一块小石头……但是……"},{"label":"活动商店2","jp":"そんなに触っても…存在感が強くなることはないと思いますよ","zh":"就算您这样摸，我的存在感也不会变强的……"},{"label":"活动商店关闭","jp":"そろそろ、帰る時間みたいですが…\n小石集め、戻ってもまだ、付き合ってくださいね","zh":"好像已经到该回去的时间了……\n老师，下次……也来陪我一起捡石头吧。"},{"label":"活动商店登陆1","jp":"あの綺麗な石とか、貝殻を見つけたら、私に持って来てください","zh":"如果，发现漂亮的石头或者贝壳……请拿给我哦。"},{"label":"活动商店登陆2","jp":"うえぇ？せんせい、私と一緒に小石集めをしませんか？","zh":"啊，老师……要和我一起，去捡石头嘛？"},{"label":"活动商店购买1","jp":"この小石、本当に綺麗ですねー","zh":"这颗小石头……真漂亮。"},{"label":"活动商店购买2","jp":"すみません、これぐらいしかなくで","zh":"抱歉……只能给您这些了。"},{"label":"活动商店购买3","jp":"白くて、キラキラしてる","zh":"白白的，亮闪闪的……"},{"label":"活动商店购买4","jp":"細やかですが、これも、受け取ってくれますか？","zh":"您愿意收下吗？虽然也不是什么了不起的东西……"}]},"stats":{"init":[{"name":"攻击力","value":"232"},{"name":"防御力","value":"103"},{"name":"生命值","value":"3093"},{"name":"治愈力","value":"1625"},{"name":"命中值","value":"504"},{"name":"闪避值","value":"198"},{"name":"暴击值","value":"252"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2277"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"防御无视值"},{"name":"0","value":"受恢复率"},{"name":"100%","value":"COST恢复力"}],"max":[{"name":"攻击力","value":"6270"},{"name":"防御力","value":"566"