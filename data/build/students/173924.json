,"zh":"Blue Archive~!"},{"label":"卡池抽取","jp":"ご主人さ...お、今は先生って呼んだほうがいいかな、楽しいこといっぱいしようね","zh":"主人~啊不对，应该叫老师来着……？是在等我吗？嘿嘿，明日奈，要登场啦！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生お手伝いできることある？なんでも言ってね","zh":"老师，明日奈会努力协助你的，尽管交给我吧！"},{"label":"登陆2","jp":"今日は何しようか？先生は何して遊びたい？","zh":"今天要做什么呢……？老师想玩什么呀？"},{"label":"大厅1","jp":"制服どうかな、ごしょ...うんん、先生の感想聞きたいな","zh":"这身制服怎么样？我想听听主人……不对，我想听听老师的想法！"},{"label":"大厅2","jp":"任務は楽しいけど、こうして先生といるのも好き","zh":"虽然在外面执行任务也不错，但是明日奈也很喜欢像这样，和老师待在一起！"},{"label":"大厅3","jp":"先生、お散歩行かない？私がワンちゃんになるから、うえ?だめ？何で？","zh":"老师，想要遛狗狗吗？这次明日奈想当狗狗！……嗯，不必了？为什么，为什么嘛！哎呀，来嘛老师！"},{"label":"大厅4","jp":"先生はいつもどんなお仕事してるの？それで私も手伝えるやつ?お掃除なら得意だよ","zh":"老师平时都在忙些什么呢？我能帮的上忙吗？打扫卫生的话，我可拿手了！"},{"label":"大厅5","jp":"ほあ、漫画発見!これ先生の？えぃ?違う？先生の匂いがするのに","zh":"发现漫画书啦！是老师的吗？……嗯？不是？奇怪了……明明有老师的味道呀？"},{"label":"回忆大厅1","jp":"じゃん!先生とアスナが繋がちゃいました。\nどう？これならどこにいるのか分かるじゃない","zh":"锵~就用这个，把主人和明日奈连在一起！怎么样？有了这个，就能知道对方在哪里了吧~？"},{"label":"回忆大厅2","jp":"どうしたの？そんな顔して\nん?逆だっけ？私に巻いたほうがよかった？","zh":"怎么啦？怎么露出这种表情！嗯……？不对吗？应该要反过来系吗？"},{"label":"回忆大厅3","jp":"あれ、あ、ああ、確かに\nあは、あはははっ!変なの","zh":"嗯……？诶，啊啊……是啊！诶嘿，啊哈哈哈，什么呀，好奇怪~！"},{"label":"回忆大厅4","jp":"これ、ホントに\nワンちゃんと散歩してるみたい","zh":"这个，真的……感觉像是在遛狗狗一样！"},{"label":"回忆大厅5","jp":"じゃあー、今の先生はアスナのワンちゃんだね\nアスナのワンちゃんはワンワンって言えるかな\nふふっ、ちゃんと言えるならご褒美あげるから、ね!","zh":"老师，现在变成明日奈的狗狗了吗？明日奈的狗狗，会汪汪的叫吗？嘿嘿，乖乖地叫的话，会奖励你的哟~好不好呀~？"},{"label":"咖啡馆1","jp":"ここ広いね、私が案内してあげようか？","zh":"这可真大呀，我来带路吧~！"},{"label":"咖啡馆2","jp":"ひひぃ、せっかく制服に着替えたし、遊んじゃおかな","zh":"诶嘿嘿，难得穿上了制服，心情很不错！要玩些什么好呢~？"},{"label":"咖啡馆3","jp":"お腹空いてきちゃた、お菓子食べちゃおう","zh":"肚子饿了……把小饼干吃掉吧？"},{"label":"咖啡馆4","jp":"皆可愛い、一緒に写真撮りたい","zh":"大家都好可爱啊……！好想一起拍照！"},{"label":"咖啡馆5","jp":"先生、どこ?視線は感じるんだけどなあ、ちょっと探して見ようかな","zh":"老师~在吗？嗯？好像感觉到老师的视线了！来找找老师在哪吧！"}],"好感度":[{"label":"好感度1","jp":"呼んだ？アスナはここにいるよ","zh":"老师叫我了吗？明日奈在这里呢~！"},{"label":"好感度2","jp":"やっぱ先生といると楽しいな","zh":"待在老师身边最开心啦~！"},{"label":"好感度3","jp":"なんでも聞いて先生のためならいつでも駆けつけるよ","zh":"什么都可以问我，我随时都可以为了老师飞奔过去！"},{"label":"好感度4","jp":"先生のそばに居られて、私まあ、すっっっごく幸せなんだ、これからもずっっっど一緒にいよね","zh":"能和老师待在一起，明日奈好幸福！以后，我也要一~直，陪在老师身边！"}],"战斗":[{"label":"编入队伍1","jp":"しゅっぱつ","zh":"出发啦~！"},{"label":"编入队伍2","jp":"手伝えばいいの","zh":"需要帮助吗？"},{"label":"拎起","jp":"あはは、どうしたの","zh":"啊哈哈，什么嘛什么嘛？"},{"label":"任命队长1","jp":"私が案内するよ","zh":"我会好好给老师带路的！"},{"label":"任命队长2","jp":"うんん、ワクワクしてきた","zh":"嗯~！心跳扑通扑通的！"},{"label":"普通技能","jp":"みんな、こっちこっち","zh":"大家看这边~！"},{"label":"EX动画1","jp":"おん?はあ、いった!","zh":"嗯？啊，找到啦！"},{"label":"EX动画2","jp":"はあ、やっぱり","zh":"啊哈，我就知道！"},{"label":"EX动画3","jp":"あれあれ、もしかして","zh":"诶~难道说！"},{"label":"EX技能1","jp":"そこにいったんだ","zh":"原来在那里！"},{"label":"EX技能2","jp":"あはは、見つけた","zh":"啊哈哈，找到啦~！"},{"label":"EX技能3","jp":"見逃さないよ","zh":"不会让你跑掉的！"},{"label":"战斗开始1","jp":"みんな、ちゃんとついてきてね","zh":"好，大家都跟着我走啊~！"},{"label":"战斗开始2","jp":"あはは、いこう、いこう","zh":"啊哈哈，走吧走吧~！"},{"label":"获得BUFF","jp":"おおう、今のどうやったの?","zh":"哇，刚才是怎么回事！"},{"label":"施放BUFF","jp":"あはは、楽しいね","zh":"啊哈哈，好开心啊~！"},{"label":"掩体","jp":"余裕、余裕","zh":"小意思小意思~"},{"label":"被CC1","jp":"やぁあ","zh":"啊？！"},{"label":"被CC2","jp":"痛っ","zh":"哇？！"},{"label":"被CC3","jp":"わぁ","zh":"哇？！"},{"label":"回避","jp":"ん？どうしたの？","zh":"嗯，出什么事了吗？"},{"label":"队伍移动1","jp":"皆、次行くよお","zh":"就这样继续前进！"},{"label":"队伍移动2","jp":"クリア、let's go","zh":"通关！我们走吧！"},{"label":"回复","jp":"ありがとう","zh":"谢谢~嘿嘿~！"},{"label":"中途退出","jp":"わぉ、ごめん","zh":"哇？！失误了……"},{"label":"战斗喊叫","jp":"やぁ","zh":"呀！"},{"label":"战斗喊叫","jp":"いやぁ","zh":"咿呀！"},{"label":"战斗喊叫","jp":"あは、あ","zh":"啊哈！"},{"label":"角色移动","jp":"行こうか","zh":"走吧！"},{"label":"战斗胜利1","jp":"大勝利、いつも通りだね","zh":"果然，我就知道会这样！"},{"label":"战斗胜利2","jp":"あああ、楽しかった、ねえ、もう回しない？","zh":"啊哈哈，好开心啊！老师觉得怎么样？"},{"label":"关卡完成1","jp":"任務完了、みんなお疲れ","zh":"任务完成！大家辛苦啦！"},{"label":"关卡完成2","jp":"次も私に任せて","zh":"下个任务也交给明日奈吧？"},{"label":"战斗失败1","jp":"うぇえ、ちょっと失敗しちゃったかも","zh":"嗯……我好像有一点点失误……"},{"label":"战斗失败2","jp":"ちょっと難しかったかも","zh":"好像有点麻烦……"}],"成长":[{"label":"升级1","jp":"はあ、なんかちょっと強かなったかも","zh":"明日奈，感觉自己变强了！"},{"label":"升级2","jp":"えへ、ありがとう先生、優しい","zh":"诶嘿，谢谢老师的关心！"},{"label":"升级3","jp":"なんか力が涌いてくるよな、この感覚好きかも","zh":"诶嘿嘿，变强的感觉就是好！"},{"label":"升级4","jp":"先生のことは私が守るからね、ずっと一緒だよ","zh":"明日奈会一直保护老师的，永远！"},{"label":"获得专武","jp":"やった!これでもっと楽しく遊べるね、ありがと先生","zh":"有了这个，就能玩的更开心啦！谢谢你，老师！"}],"事件":[{"label":"学生生日","jp":"ふはあ、私の誕生日覚えてたんだ、すごい嬉しい、先生大好き","zh":"啊，老师居然记得明日奈的生日吗？不愧是老师呢，真的真的太喜欢你啦——！"},{"label":"老师生日","jp":"問題っ！今日は何の日でしょ～？\n…正解は～私の大好きな、先生のお誕生日～！\nぱちぱちぱち！あははっ、ハッピーバースデー！先生！","zh":"请回答，今天是什么日子呀~？正确答案是……是我最喜欢的老师的生日，鼓掌鼓掌！生日快乐，老师！"},{"label":"万圣节","jp":"街中が面白い仮装の人で賑わってるね！\nこんな楽しい日に出かけないなんて、もったいないよ～！\nさあ先生！一緒にいこ～！","zh":"今天是特别有意思的日子，街上也很热闹，还有很多人穿着新奇的衣服！所以老师，和我一起出去玩吗？"},{"label":"新年","jp":"明けましておめでとう～！先生！\n今年も私とた～くさん、遊んでくれるんでしょ？\n楽しみにしてるね、あはっ！","zh":"老师，新年快乐！今年也会和明日奈一起开心地玩吧，请多多关照！"},{"label":"圣诞节","jp":"メリークリスマ～ス！\n先生！サンタさんからプレゼントはもらった？\nえ…大人はもらえない？じゃあ、私があげよっか？何でも言って！","zh":"圣诞节到了呀老师~怎么样，收到圣诞老人的礼物了吗？……嗯？老师是大人所以收不到礼物？嗯……那明日奈送你！嘿嘿~"},{"label":"春节","jp":"","zh":"老师，新春快乐！可以带我去山海经转转吗？我一定不会乱跑的！"},{"label":"中秋","jp":"","zh":"嗯……我在等月亮出来呢，嘿嘿，其实也在等老师哦？真巧呀，中秋快乐~"}],"活动":[{"label":"活动登陆1","jp":"はあ、先生、こっちだよ","zh":"啊，老师！在这边！"},{"label":"活动登陆2","jp":"ご主人様、じゃなくて、先生やっと会えた","zh":"主人，啊不对，老师，终于见面啦？"},{"label":"活动大厅1","jp":"先生、どこか行きたい所ある？案内するよ","zh":"老师，想去什么地方？我来带路！"},{"label":"活动大厅2","jp":"うん?どうしたの？何か頼み方？","zh":"嗯？怎么了？老师有事要拜托明日奈吗？"},{"label":"活动大厅3","jp":"あはは、擽ったい、もしかして先生遊びたい？","zh":"啊哈哈哈，好痒啊哈哈……老师，这是在和我玩点什么吗？"},{"label":"活动大厅4","jp":"じゃあー、私も先生をごちゃごちゃしちゃおう！逃がさないよ!あはは","zh":"诶嘿嘿，那么明日奈，也要来挠老师的痒痒了哦？你跑不掉的哦~嘿嘿~！"},{"label":"活动事件1","jp":"やほ、先生楽しんでる？","zh":"呀吼~老师，玩的开心吗？"},{"label":"活动事件2","jp":"えへ、最後まで遊び尽くそう!ご主人様、うんん先生","zh":"诶嘿嘿，我们尽情玩到最后吧，主人~啊不对，老师~"},{"label":"活动结束","jp":"ふああ、終わちゃった、あっというまだったね、もちろんすっっっごく楽しかったよ","zh":"嗯……居然已经结束了，时间过得也太快了吧……但是，我非常，非常开心~！"}]},"stats":{"init":[{"name":"攻击力","value":"288"},{"name":"防御力","value":"17"},{"name":"生命值","value":"2275"},{"name":"治愈力","value":"1618"},{"name":"命中值","value":"688"},{"name":"闪避值","value":"812"},{"name":"暴击值","value":"196"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1420"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value"