s":[]}},"profile":{"fullName":"豊見 コトリ（応援団）","kana":"豊見 とよみ","twName":"亚都梨（应援团）","cnName":"琴里（应援团）","age":"15岁","birthday":"12月31日","height":"151cm","hobby":"滔滔不绝","designer":"-","artist":"MISOM150","cv":"日 | 篠原なるみ\n中 | 竹子\n韩 | 비주언（丕株言）","hallLevel":"2","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"健全的知识寄于健康的身体！","bio":"为了在大运动会中给大家加油，换上了啦啦队服的千年科学学园所属，工程部的部员。\n在用她那活泼明快的声音加油的同时，平时一直在做的解说似乎也没落下。\n“需要解说或者加油的话，就交给我吧！”","sourceUrl":""},"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"885"},{"name":"攻击力","value":"145"},{"name":"治愈力","value":"196"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 琴里","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/10/196216.png","url":"https://www.gamekee.com/ba/67655.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"解説や応援が必要なら、私に任せてください！","zh":"需要说明或者应援的话， 就请交给我吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生！今日も一日「頑張れ！頑張れ！」っですよ！","zh":"老师，您好！ 今天也要 “加油！加油！”呀！"},{"label":"登陆2","jp":"お待ちしておりました、先生！この私の応援が必要ですか？ひ…必要ですね…","zh":"老师，我正等您呢！ 您一定需要我的应援吧？"},{"label":"大厅1","jp":"お？チア衣装ですか？どうですか？可愛い…ですか？","zh":"嗯？应援服吗？怎么样？可爱……吗？"},{"label":"大厅2","jp":"うん…理由は分かりませんが…ちょっど、恥ずかしい気もします…","zh":"嗯…… 不知道为什么，但总觉得…… 有些害羞呢……"},{"label":"大厅3","jp":"そ…そんなにじっど見てないで！何か言ってください…！","zh":"别，别这样盯着我看呀！ 请说点儿什么吧！"},{"label":"大厅4","jp":"今はシャーレの当番中ですから…先生のためのエールです！","zh":"因为我现在是沙勒的值日员…… 所以我的应援，都是给老师的！"},{"label":"大厅5","jp":"チアリーダーの起源をご存知ですか？あっ、そうでしたか…","zh":"您知道拉拉队长的起源吗？……啊啊 ……您知道啊。"},{"label":"回忆大厅1","jp":"あ、あれ…\nむ…むむ…腕が…届くはず…なのに…！","zh":"不，不对……？\n呜，呜呜…… 胳膊…… 应该碰得到才对啊……？"},{"label":"回忆大厅2","jp":"そんな…ここで…力をグっと…！\n…ひぃぃ、いたたたた―！","zh":"怎么会这样……！ 在这里一鼓作气的话——？！\n啊噫？！ 痛，痛痛痛痛痛痛……！"},{"label":"回忆大厅3","jp":"お、おかしいです！調べた通りにやってるのに！\n人によって差があるのは知ってましたが、ここまでとは…","zh":"好，好奇怪啊……！ 我明明是，按照书上做的……\n虽然我知道人和 人之间会有些差异， 但没想到会这样……"},{"label":"回忆大厅4","jp":"…もう一回！…いたたたた―！もう、もう無理…うぅ...あ、あの、先生、これは…","zh":"再，再来一次…… 啊……啊！ 痛，痛痛痛痛痛痛痛……！！\n已，已经不行了…… 呜呜呜……呜…… 老，老师……这，这……"},{"label":"回忆大厅5","jp":"こんな姿を見せるつもりじゃ…なかったんです…\nダメダメな姿を、見られてしまいました…うぅぅ…","zh":"我本来不想让老师， 看到我这个样子的……\n结果…… 还是让您看到了 我笨手笨脚的样子……\n呜呜呜呜……"},{"label":"咖啡馆1","jp":"おぉ、こんなにたくさんの人が…","zh":"哦，这里这么多人啊？！"},{"label":"咖啡馆2","jp":"ここなら講演もできるかも！","zh":"应该可以在这里演讲吧？"},{"label":"咖啡馆3","jp":"先生のインテリア、興味深いです！","zh":"老师的装潢…… 我很感兴趣！"},{"label":"咖啡馆4","jp":"おや？あれは…！","zh":"哦呀， 那个是……？！"},{"label":"咖啡馆5","jp":"せっかくですから、応援ステーじを探してみしょうか。","zh":"机会难得， 让我看看这里有没有应援舞台吧？"}],"好感度":[{"label":"好感度1","jp":"先生、その…応援はいりませんか…？あの、私でよければ…！","zh":"老师，就是……您需不需要应援呀？如果需要的话，我可以为您……"},{"label":"好感度2","jp":"いつだって準備はできています！必要の時は、何なりとおしゃってください！","zh":"我时刻准备着，你需要的时候就开口吧。"},{"label":"好感度3","jp":"これで日頃のお礼になれば、嬉しいですわ。","zh":"您平时那么照顾我，如果能把这当作回礼的话，我会很开心。"},{"label":"好感度4","jp":"チア衣装？あっ！お好きなんですか？なら毎日着ますよ！","zh":"应援服？您喜欢吗？\n喜欢的话那我天天都穿！"}],"战斗":[{"label":"编入队伍1","jp":"はい！私にお任せください！","zh":"好！就请交给我吧！"},{"label":"编入队伍2","jp":"応援が必要なら、私の出番ですね！","zh":"需要应援的话，就轮到我出场啦！"},{"label":"拎起","jp":"フレ！フレ！あっ！まだでしたか？あはは…","zh":"加油！加油！哈？还没到应援的时候吗？哈哈……"},{"label":"任命队长1","jp":"うむ、これは長期戦になりそうですね！","zh":"嗯？看来会是一场持久战啊！"},{"label":"任命队长2","jp":"うん？これは応援が必要です！","zh":"应援的时候到了！"},{"label":"普通技能","jp":"お、それはですね、説明しましょう！","zh":"哈？那个的话，就交给我来说明吧！"},{"label":"EX动画1","jp":"こちらをご覧ください！行きますよ！","zh":"各位请看这里，我要上喽！"},{"label":"EX动画2","jp":"フレ！フレ！今です！","zh":"加油！加油！就是现在！"},{"label":"EX动画3","jp":"コトリの応援、行きます！はー！","zh":"琴里来应援啦！"},{"label":"EX技能1","jp":"華麗に参ります！","zh":"闪亮登场！"},{"label":"EX技能2","jp":"す…少しやりすぎてしまいましたか！？","zh":"是、是不是闹得有些大了？"},{"label":"EX技能3","jp":"あ―！なんですかこれ！ごめんなさい―","zh":"呜啊啊啊啊——这什么情况啊？对不起！"},{"label":"战斗开始1","jp":"え！？私が最前列ですか！？応援するのに！？","zh":"诶？我站在最前面吗? 可我只是负责应援的呀！"},{"label":"战斗开始2","jp":"先頭に立ちます！あぁ、これは違いますかね…","zh":"我来打头阵！诶？！不是这样的吗？"},{"label":"获得BUFF","jp":"これは…お気遣いありがとうございます！","zh":"这是…… 感谢您的关心！"},{"label":"施放BUFF","jp":"どうやら説明が必要なようですね！","zh":"看来有必要说明一下！"},{"label":"掩体","jp":"","zh":"这里看起来不错！"},{"label":"被CC1","jp":"-","zh":"-"},{"label":"被CC2","jp":"-","zh":"-"},{"label":"被CC3","jp":"-","zh":"-"},{"label":"回避","jp":"無駄です！","zh":"没用的！"},{"label":"队伍移动1","jp":"はい！次へ行きましょう！","zh":"好！继续前进吧！"},{"label":"队伍移动2","jp":"休憩はまだ先みたいですね。","zh":"离休息时间还早呢。"},{"label":"回复","jp":"ありがとうございます！","zh":"非常感谢！"},{"label":"中途退出","jp":"体...体力が..限界です…","zh":"体……体力已经到极限了……"},{"label":"战斗喊叫","jp":"-","zh":"接招！"},{"label":"战斗喊叫","jp":"行きます！","zh":"接招！要上啦！"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗胜利1","jp":"応援の効果があったのでしょうか。","zh":"应援有起到作用吗？"},{"label":"战斗胜利2","jp":"皆さん、お疲れ様でした！","zh":"各位，辛苦喽~"},{"label":"关卡完成1","jp":"ふふ...素晴らしい試合でした、お疲れ様でした！","zh":"比赛很精彩，各位辛苦啦！"},{"label":"关卡完成2","jp":"...なん、何とか無事で終わった良かったです！","zh":"哈——哈——总之，顺利结束真是太好了。"},{"label":"战斗失败1","jp":"応援が足りなかったのでしょうか...","zh":"是我应援得还不够吗？"},{"label":"战斗失败2","jp":"うう...すみません、もっとお腹から声を出しますね...","zh":"呜——对不起，下次我会尝试腹部发声的！"}],"成长":[{"label":"升级1","jp":"これも全部応援のため、皆さんのためですよね！","zh":"这些都是为了应援，为了大家！"},{"label":"升级2","jp":"ありがとうございます！先生！目をかけていただいた分、努力します！","zh":"谢谢您老师，您如此关照我，我会努力的！"},{"label":"升级3","jp":"応援するのは私の方なのに…何だか照れますね。","zh":"虽然正在为大家应援的是我……但，总觉得有些害羞呢……"},{"label":"升级4","jp":"私ばかり応援してもらっている気がします…私も、いつかは先生のために…！","zh":"仔细想想，一直以来似乎都是老师在为我应援，\n总有一天我也会为老师应援的。"},{"label":"获得专武","jp":"この銃について説明していたしましょう！…ふふ、冗談です！先生はすでにご存知ですからね！…こういうことが、どんどん増えていったら、いつかは…","zh":"我来为您讲解一下这把枪吧……！\n ……呵呵，开玩笑的，老师对它肯定了如指掌呢！ \n如果老师了解的事情越来越多的话，那总有一天……"}],"事件":[{"label":"学生生日","jp":"わ…私の誕生日？ま…まさか覚えてくれているとは思えませんでした…\n嬉しいです、えへへ！","zh":"我，我的生日……？！ 您，您竟然还记得啊……好开心啊，诶嘿嘿。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！今日は特別な日なので、特別なパフォーマンスで送りします！","zh":"老师，祝您生日快乐！\n在今天这个特别的日子里， 就由我为您献上特别的表演！"},{"label":"万圣节","jp":"おお、外が騒がしいですね。ふむ、皆さん、ハロウィーンがどんな日なのかは、ご存知でしょうか？","zh":"哦，外面好热闹呀！嗯~大家知道 万圣节是什么日子吗？"},{"label":"新年","jp":"明けましておめでとうございます！先生が辛い時には、いつだって応援に行きますよ！","zh":"老师，祝您新年快乐！老师觉得辛苦的时候， 无论何时， 我都会来为您应援的！"},{"label":"圣诞节","jp":"メリークリスマス！あっ！クリスマスの由来なのですが…","zh":"祝您——圣诞快乐！ 啊，顺便一提， 圣诞节的起源是……"},{"label":"春节","jp":"","zh":"老师，新春快乐！ 既然穿上了这身衣服， 接下来的一年里， 就都让我来为老师加油打气吧！ 加油！加油！努力！努力！"},{"label":"中秋","jp":"","zh":"本来上次想向老师讲解一下 中秋节的由来与习俗，结果被一 块五仁月饼打断了……说起五仁 月饼，它指的是馅料含有五种果 仁的月饼，至于这五仁是哪五 种，则根据地区风俗不同……"}],"活动":[{"label":"活动登陆1","jp":"応援と説明なら、お任せください！","zh":"说明或者应援就交给我吧！"},{"label":"活动登陆2","jp":"フレ！フレ！先～生、頑張れ頑張れ先生！どうですか？元気いてましたか？","zh":"加油~！加油~！ 老~师~！ 努力努力！老师！怎么样？ 打起精神了吗？"},{"label":"活动大厅1","jp":"あれ？どうかされましたか？","zh":"啊？有什么事吗？"},{"label":"活动大厅2","jp":"何か気になることでもありましたか？それなら、この私が…！","zh":"您有什么想要了解的吗？如果有的话， 那就由我来……"},{"label":"活动大厅3","jp":"そ…そんなに何度もつつかれると…ちょっど恥ずかしいですね…","zh":"总，总是这样 戳我的话……我，我也是会害羞的……"},{"label":"活动大厅4","jp":"えぇ…！あ…先…先生でしたか…","zh":"诶？！ 是，是老师啊……？"},{"label":"活动事件1","jp":"盛り上がってますね！頑張ってください！","zh":"热血沸腾了起来！加油！"},{"label":"活动事件2","jp":"あと少しです！最後まで応援しています！","zh":"只差最后一点了！ 我会应援到最后的！"},{"label":"活动结束","jp":"ふぅ…大変でしたね！でもやり切った気持ちです！","zh":"呼——！好累啊，不过有种爽快感！"}]},"stats":{"init":[{"name":"攻击力","value":"390"},{"name":"防御力","value":"79"},{"name":"生命值","value":"2512"},{"name":"治愈力","value":"1650"},{"name":"命中值","value":"100"},{"name":"闪避值","value":"199"},{"name":"暴击值","value":"200"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1392"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8714"},{"name":"防御力","value":"438"},{"name":"生命值","valu