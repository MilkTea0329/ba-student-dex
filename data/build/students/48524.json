mekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/447283.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/526975.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 日富美（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/672642.png","url":"https://www.gamekee.com/ba/83596.html"},{"name":"★3 日富美（赛车）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_503/h_503/408107/2026/9/28/09143613mvs600lf.png","url":"https://www.gamekee.com/ba/725713.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"あはは…至らない私ですが、よろしくお願いします。","zh":"啊哈哈~我还有很多不足，请多多指教。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生、よろしくお願いします。","zh":"老师，请多多关照。"},{"label":"登陆2","jp":"あぁ、先生、行ってきましたか？","zh":"哦，老师，您回来了吗？"},{"label":"大厅1","jp":"最善を尽くします。","zh":"我会尽全力的。"},{"label":"大厅2","jp":"これですか？これはペロロ様です。\nカワイイでしょう？","zh":"这个啊，是佩洛洛大人啦，可爱吧？"},{"label":"大厅3","jp":"…悩みですか？そうですね…。私はその、他の人と比べて平凡すぎなように思いませんか…？","zh":"问我有什么烦恼？我跟别人比起来，是不是太普通了呢？"},{"label":"大厅4","jp":"私に何かできることはありませんか？","zh":"有什么我能做的吗？"},{"label":"大厅5","jp":"あはは…そんなに振っても何も出ませんから…。","zh":"啊哈哈，再摇也摇不出东西的啦。"},{"label":"回忆大厅1","jp":"次はどこに行ってみましょうが？あっち？ん～～、でしたらあちらはどうですが？","zh":"接下来我们要去哪呢？那边？要不到那边去看看怎么样？"},{"label":"回忆大厅2","jp":"はい、どこでも大丈夫です。先生と一緒にいられるなら！","zh":"嗯，只要是和老师一起，去哪都可以。"},{"label":"回忆大厅3","jp":"先生、あそこを見てください！あっちも、あっ！こっちも！","zh":"老师，您快看那边，还有那里，啊，这边也是。"},{"label":"回忆大厅4","jp":"いつも見てる街なのに、何でこんなに違って見えるんでしおうか？","zh":"这个街区我明明再熟悉不过了，可为什么，看起来却那么不一样呢？"},{"label":"回忆大厅5","jp":"ん？いつまでここで休憩するつもりですか？さぁ！もっと色々見て回りましょうよ","zh":"嗯？您到底还想要在这里歇多久啊？来！还有好多好多地方没去呢。"},{"label":"回忆大厅6","jp":"はい？その角度から見える景色がいいんですか？","zh":"嗯？您说从您那角度看到的景色更美吗？"},{"label":"咖啡馆1","jp":"ペロロ様のグッズ…。","zh":"佩洛洛大人的周边~"},{"label":"咖啡馆2","jp":"あはは…。どうかな。","zh":"啊哈哈，怎么说呢.."},{"label":"咖啡馆3","jp":"今度はみんなと一緒に来るのもいいかも。","zh":"下次，叫上大家一起来吧！"},{"label":"咖啡馆4","jp":"こういうのも楽しそうですね。","zh":"这样好像也挺有意思的。"},{"label":"咖啡馆5","jp":"んん…。どうなんでしょう。","zh":"嗯，会怎么样呢？"}],"好感度":[{"label":"好感度1","jp":"先生、いつも頼りにしてます。","zh":"老师，我一直非常信赖您。"},{"label":"好感度2","jp":"あの、その…。もうちょっとだけ、そばにいてください…","zh":"嗯..那个，能不能再陪我一会儿？"},{"label":"好感度3","jp":"今の私なら、もっと勇気を出せるかもしれません。","zh":"我现在，也许能更勇敢一些了。"},{"label":"好感度4","jp":"先生は本当に、特別な人です。","zh":"老师，真的是个很特别的人。"}],"战斗":[{"label":"编入队伍1","jp":"さ、最善を尽くします。","zh":"我、我会尽全力的。"},{"label":"编入队伍2","jp":"こ、怖くない…怖くない…。","zh":"不害怕..不害怕！"},{"label":"拎起","jp":"ふあっ！","zh":"啊！"},{"label":"任命队长1","jp":"みんなで頑張りましょう！","zh":"大家一起加油吧！"},{"label":"任命队长2","jp":"みんな、ファイトですよ！","zh":"各位，一起努力！"},{"label":"普通技能","jp":"えぇーい！","zh":"欸~！"},{"label":"EX动画1","jp":"えぇっ！あれっ？どこ？！","zh":"在哪？"},{"label":"EX动画2","jp":"み、見つからない。どうしよう？","zh":"找、找不到了，怎么办？"},{"label":"EX动画3","jp":"ここに入れてたはずなのに...？","zh":"明明有放进去的呀。"},{"label":"EX技能1","jp":"ペロロ様の出番です！","zh":"佩洛洛大人该出场了！"},{"label":"EX技能2","jp":"うわぁ作動しちゃいました！","zh":"动起来了！"},{"label":"EX技能3","jp":"ペロロ様！お願いします！","zh":"佩洛洛大人，拜托了。"},{"label":"战斗开始1","jp":"さ、作戦スタートです！","zh":"行动开始！"},{"label":"战斗开始2","jp":"一緒なら大丈夫です！","zh":"和大家一起上，就不用怕！"},{"label":"获得BUFF","jp":"ありがとうございます！","zh":"非常感谢。"},{"label":"施放BUFF","jp":"はぁ！","zh":"哈！"},{"label":"掩体","jp":"か、隠れました！","zh":"我藏好了！"},{"label":"被CC1","jp":"ぐぅ…ご、ごめんなさい…。","zh":"（喘息）"},{"label":"被CC2","jp":"ふわぁっ…","zh":"（喘息）"},{"label":"被CC3","jp":"ひゃぁ！い、痛いです…","zh":"啊，好疼啊！"},{"label":"回避","jp":"あぁ…危ないところでした。","zh":"真是太险了。"},{"label":"队伍移动1","jp":"ペロロ様はどこにいるんだろう？","zh":"佩洛洛大人在哪里呀？"},{"label":"队伍移动2","jp":"この先は一体どんな所なのでしょう？","zh":"接下来，会去什么样的地方呢？"},{"label":"回复","jp":"ありがとうございます。","zh":"非常感谢。"},{"label":"中途退出","jp":"ま、まだやれるのに……","zh":"我，我还能坚持 。。。"},{"label":"战斗喊叫","jp":"えぇーい！","zh":"嘿！"},{"label":"战斗喊叫","jp":"ヤ！","zh":"（喊叫）"},{"label":"战斗喊叫","jp":"ひゃ！","zh":"（喊叫）"},{"label":"特殊载具","jp":"私に任せてください！","zh":"请交给我吧！"},{"label":"特殊载具","jp":"補習授業部の備品クルセイダーちゃん、よろしくお願いします！","zh":"训导加强部的备用品，小小十字军，拜托你了。"},{"label":"角色移动","jp":"よしょ！","zh":"嘿咻！"},{"label":"战斗胜利1","jp":"みんなの勝利です！","zh":"这是大家共同的胜利。"},{"label":"战斗胜利2","jp":"やり遂げました！","zh":"我们做到了！"},{"label":"关卡完成1","jp":"ふわぁ…先生のおかげで勝てました！","zh":"哇！多亏老师，我们赢了。"},{"label":"关卡完成2","jp":"最高の戦いでした。","zh":"真是场精彩的战斗！"},{"label":"战斗失败1","jp":"力不足でごめんなさい…","zh":"大概，是因为我太紧张了.."},{"label":"战斗失败2","jp":"肩に力が入りすぎた…かもしれないです…","zh":"我的能力还不够，对不起。"}],"成长":[{"label":"升级1","jp":"一歩、前進できた感じがします！","zh":"感觉自己又向前迈了一步。"},{"label":"升级2","jp":"ふわぁ…変われたみたいです！","zh":"哇！好像脱胎换骨了一样！"},{"label":"升级3","jp":"これも全部、先生のおかげです！","zh":"这也都是多亏了老师帮忙！"},{"label":"升级4","jp":"ありがとうございます、先生。","zh":"老师，非常感谢您。"},{"label":"获得专武","jp":"この……この武器は……まさか？！\nこれで私はもう少し自信を持っても大丈夫ですよね？！","zh":"这，这个武器，难道是？有了这个，我应该能更自信一点了吧。"}],"事件":[{"label":"学生生日","jp":"先生！誕生日をお祝いしてくれてありがとうございます！\n私、本当に嬉しいです！","zh":"老师，谢谢您的生日祝福，我真的特别特别开心。"},{"label":"老师生日","jp":"先生に色んな事を教えていただいて、本当に幸せです。\nこれからも頑張ります！それが私にできる、最高のプレゼントだから！","zh":"老师教会了我很多，我真的感觉很幸福，今后我会再接再厉的，因为这是我能够给您的最好的礼物！"},{"label":"万圣节","jp":"わあっ！びっくりした。あ、今日はハロウィンですね。","zh":"哇！吓我一跳！啊，今天是万圣节啊！"},{"label":"新年","jp":"あ、明けましておめでとうございます！\n今年も先生と一緒に…一生懸命頑張ります！","zh":"祝您新年快乐，今年我也会和老师一起拼命努力工作的！"},{"label":"圣诞节","jp":"メリークリスマス～聖誕祭です。\nトリニティでは一番の特別な日です。\nそして…私にとっても、一番特別です。","zh":"圣诞快乐，今天是圣诞庆典哦，对崔尼蒂来说是最特别的日子，而且对我来说也是最特别的.."},{"label":"春节","jp":"","zh":"老师，过去一年……像我这么平凡的女生，你也尽心尽力的照顾，\n真是太感谢您了，祝您新春快乐。"},{"label":"中秋","jp":"","zh":"老师，您看！\n那个……那个难道是佩洛洛大人联名款月饼？"}]},"stats":{"init":[{"name":"攻击力","value":"238"},{"name":"防御力","value":"20"},{"name":"生命值","value":"2520"},{"name":"治愈力","value":"1644"},{"name":"命中值","value":"699"},{"name":"闪避值","value":"799"},{"name":"暴击值","value":"199"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1400"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6451"},{"name":"防御力","value":"110"},{"name":"生命值","value":"58682"},{"name":"治愈力","value":"8314"},{"name":"命中值","value":"699"},{"name":"闪避值","value":"799"},{"name":"暴击值","value":"349"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1