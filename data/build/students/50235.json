https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/199149.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/877500.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/375374.png","name":"百夜堂限定甜點","desc":"百夜堂為迎接情人節所販售的特別甜點。沒有公告也沒有出現在菜單上，至於實際上想賣給誰，靜子不願透露"},"ability":{"attrs":[{"name":"生命值","value":"1471"},{"name":"攻击力","value":"77"},{"name":"治愈力","value":"226"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/150138.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/588376.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 静子（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/12/591721.png","url":"https://www.gamekee.com/ba/162572.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","zh":"蔚蓝档案"},{"label":"卡池抽取","jp":"えへへ、お祭り運営委員会のシズコです～。\nこれからよろしくお願いしますね、先生？え？\n……ああ、はいはいそうですよ、営業用の台詞です！","zh":"诶嘿嘿~我是庆典运营管理部的镜子，以后请多多关照~老师\n诶……啊……对对对，这是营业用的台词。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あっ、おかえりなさい先生！にゃんにゃん！\n……うん、今のは完璧。","zh":"欢迎回来老师~喵喵。\n刚才的很完美。"},{"label":"登陆2","jp":"うう……疲れた…。\nあっ、先生、おかえりなさい！さあさあこちらへ、遠慮なさらず～！","zh":"啊……累死了……\n老师您回来了，快来快来这边请，不用客气。"},{"label":"大厅1","jp":"お呼びでしょうか？今日はどんな仕事のお手伝いをします？何でもお任せあれですよ～！","zh":"您叫我了吗？今天需要帮您做什么呢？不管是什么，尽管交给我吧！"},{"label":"大厅2","jp":"最近そばにいるだけで、知らず知らずのうちに気が緩んでしまうんですよね～。\n……先生のせいですよ？","zh":"最近只是待在老师身边而已，可经常不知不觉就松懈下来了。\n嗯。这都要怪老师哦。"},{"label":"大厅3","jp":"あ、帰ったらまだ百夜堂の仕事があるんでした。\n……大変だね、ですか？\nいえいえ、大したことでは無いですよ〜。これも私がやるべきことですから。","zh":"回去还有百夜堂的工作要做呢，你问我是不是很累？\n不累不累，没什么大不了的啦，这都是我应该做的。"},{"label":"大厅4","jp":"え？可愛い、ですか？\nはあ、揶揄わないでください、先生は私の素顔を知ってるじゃないですか……\n……それが可愛い？う、ぐっ……。","zh":"您说我很可爱？啊……请您别损我了，老师又不是不知道我本来什么样子。\n……那样才最可爱？……呜……"},{"label":"大厅5","jp":"先生財布の紐は固い方ですか？気を付けた方が良いですよ、\n百鬼夜行のお祭りと百夜堂のあんみつは、それをこじ開けてしまうほど魅力的ですからね？","zh":"老师~有看好自己的钱包吗？要时刻小心哦。\n因为百鬼夜行的庆典和百夜堂的馅蜜可是魅力十足，足以把紧闭的钱包撬开哦。"},{"label":"回忆大厅1","jp":"ふふっ、お帰りなさいませ～ご主人様～？","zh":"嘿嘿~欢迎你回来，主~人~"},{"label":"回忆大厅2","jp":"そうですよぉ～。見ての通り、現在進行形でおサボり中で～す。","zh":"对的呀，你没看错，我现在摸鱼摸得正开心呢。"},{"label":"回忆大厅3","jp":"……不思議ですね。こういうことはしちゃいけないって、気を張ってなきゃって、ずっと思ってたはずなんですが……。\n先生と一緒にいると……。\nなんだか、気が抜けちゃうって言うか……。","zh":"真不可思议啊，明明知道自己不能偷懒，明明知道要打起精神来，明明一直都是这么想的来着。但是只要和老师在一起。总感觉一点干劲都没有了。"},{"label":"回忆大厅4","jp":"ほら、先生？こっちに来てください。\n……私をこんな風にした責任、取ってくれますよね？","zh":"来呀老师，请您到这边来。\n是您让我变成这个样子的，您会负责的吧。"},{"label":"咖啡馆1","jp":"萌え萌えきゅ～ん……これで合ってるかな？","zh":"萌萌比心~\n我做的对不对？"},{"label":"咖啡馆2","jp":"次のお祭りに向けて、しっかりと計画を立てなくちゃ。","zh":"要给下次的庆典制定一个详细的计划了。"},{"label":"咖啡馆3","jp":"百夜堂の新メニュー、何にしようかな……？","zh":"百夜堂的新菜单该怎么安排呢？"},{"label":"咖啡馆4","jp":"次のお祭りに、何か新しくて大胆な試みを……全員で着物風バニーガール、とか？","zh":"下次的庆典，我想大胆一点，搞点不一样的，比如让所有人穿上和风兔女郎。"},{"label":"咖啡馆5","jp":"ここ、百夜堂の出張店舗の場所に良さそう！","zh":"把这里当成百夜堂的临时店铺，好像不错"}],"好感度":[{"label":"好感度1","jp":"（ち、近い！せ、先生との距離がこんな！大丈夫かな！大丈夫なのかな！！）","zh":"（——好近！老师，他今天也在！可以吗？真的可以吗！）"},{"label":"好感度2","jp":"この甘い気持ち、百夜堂のあんみつを口いっぱいに頬張った時みたいな……。","zh":"这种甜蜜的感觉，简直就像我嘴里面填满了百叶堂的馅蜜一样。"},{"label":"好感度3","jp":"先生と一緒にいると、いつも……まるでお祭りの日みたいな気分になります。本当に不思議ですね。","zh":"每次我和老师在一起，感觉就像在过节一样呢，真的很奇怪诶"},{"label":"好感度4","jp":"楽しいお祭りもいつかは終わるもの、と言いますね……。でもせめて、本当にその時が来るまで……もう少し、そばにいても……いいですか？","zh":"有句话说，天下没有不散的宴席，\n但是至少，在宴席散去之前，能在我身边多待一会儿吗？"}],"战斗":[{"label":"编入队伍1","jp":"流石先生、お目が高いですね。","zh":"不愧是老师，很有眼光嘛。"},{"label":"编入队伍2","jp":"よし、お祭りの予算稼ぐチャンス、じゃなくて、っが、頑張ります。","zh":"好耶，这是提高庆典预算的好机会。\n啊……不……不对，我会加油的~"},{"label":"拎起","jp":"サービス料は別ですよ？","zh":"服务费另算哦？"},{"label":"普通技能","jp":"邪魔はさせません！","zh":"不许碍事！"},{"label":"EX动画1","jp":"百夜堂出張販売です！うわあっ！","zh":"百夜堂出摊啦~哎？？"},{"label":"EX动画2","jp":"百夜堂はどこへでも出張販売します！わっ、茶器がー！","zh":"无论顾客在哪儿，百叶堂都能为您服务！\n哎——我的家具！"},{"label":"EX动画3","jp":"ここで活動資金を稼がないと……うわーっ！","zh":"一定要在这里赚点活动经费……\n啊——"},{"label":"EX技能1","jp":"こ、こんなことではめげません","zh":"我才不会这样放弃呢！"},{"label":"EX技能2","jp":"ちょっ、激しすぎます！","zh":"太激烈了吧"},{"label":"EX技能3","jp":"うぇ、お店の物なのに……","zh":"这个都是店里的东西啊——"}],"成长":[{"label":"升级1","jp":"えへへ、シズコは～先生がシズコのこと大切にしてくれてと～っても嬉しいです～。にゃんにゃん！……うん、私可愛い！","zh":"诶嘿嘿~老师对静子~这么照顾，静子真的超级开心。\n喵喵~唔，我真可爱。"},{"label":"升级2","jp":"わ～い、成長しました～！ブイ！","zh":"哇~我成长啦~"},{"label":"升级3","jp":"ま、まあ？期待に応えられるようには頑張りますけど……？","zh":"行……行吧，既然您这么期待，那我就努力一下下了。"},{"label":"升级4","jp":"先生にこんなに良くしてもらって……シズコ、改めて頑張ります！百夜堂の店主兼看板娘として！","zh":"老师对静子这么好，静子一定会加倍努力的，\n毕竟静子可是百夜堂的店长兼看板娘啊。"},{"label":"获得专武","jp":"これ、どんなお祭りでも手に入らない非売品……ですね、えへへ、大切にします！先生。","zh":"这可是任何庆典上都买不到的非卖品，\n嘿嘿，我会好好珍惜的，老师。"}],"事件":[{"label":"学生生日","jp":"えっ、わ、私の誕生日を祝ってくださるんですか？\n……っ！あ、み、見ないでください！今、多分見せられない顔になってますから……！\n……っ、えへっ、えへへっ……！","zh":"您祝我生日快乐？……\n请别看我，我的表情现在肯定没法见人……诶嘿嘿……"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\nさ、百夜堂に行きましょう。お祭り運営委員会の委員長権限で、お祭りみたいなお誕生日会を開きますから！","zh":"老师~祝你生日快乐。来，我们去百叶堂吧，\n我会用庆典运营管理部部长的权力，开一场像庆典一样的生日宴会。"},{"label":"万圣节","jp":"トリックオアトリート！さあ先生、やって来た生徒には、百夜堂のあんみつを押し売りしてやりましょう！\nえ、ダメなんですか？どうして！？","zh":"不给糖就捣蛋！\n老师老师，如果有人过来就强迫他，来买百夜堂的馅蜜吧！\n不行吗？……为什么？"},{"label":"新年","jp":"ハッピーニューイヤー！お正月ですし、こたつの中でぬくぬくするとしましょう～\nちょっ、あ、あと5分だけ……！","zh":"新年快乐~\n既然是新年，就在被炉里暖暖和和的待着吧~\n——再让我待五分钟就行。"},{"label":"圣诞节","jp":"今日はクリスマス！お祭りの日です！私たちお祭り運営委員会はもちろん見逃しませんよ！さあいきましょう、先生！","zh":"今天是圣诞节，是举办庆典的日子，\n我们庆典运营管理部肯定不能缺席。好了，老师快走。\n春节"},{"label":"春节","jp":"","zh":"老师，新春快乐~\n才不是营业状态，刚刚的新春祝福是认真的。"},{"label":"中秋","jp":"","zh":"百夜堂今日限定独家配方月饼，老师您快尝尝吧。\n吃完之后记得代表沙勒找我们订购月饼礼盒哦~"}],"活动":[{"label":"活动登陆1","jp":"百夜堂の出張販売です、さあご主人様、必要なものは何でしょうか？","zh":"百夜堂出摊啦~\n来来来，主人~需要什么呢？"},{"label":"活动登陆2","jp":"あっ、先生、いらしゃいませ、さあさあ、お好きなだけ見ていてください","zh":"老师，欢迎光临。\n来来来，你随便看，随便挑。"},{"label":"活动商店1","jp":"お祭りでも、いえ、お祭りだからこそ、百夜堂は止まりませんよ、まあ、私たちは同時にお祭り運営委員会でもあるので。当たり前なんですけどね。えへ。","zh":"就算是庆典……不对，\n正因为是庆典，百夜堂才不会休息。\n不过因为我们也是庆典运营管理部，不休息也是理所当然的。诶嘿嘿~"},{"label":"活动商店2","jp":"よし、ここは萌え萌えキュン、え？これちょっとふるいですか？そうなんですか？","zh":"好，这里应该~萌萌比心。\n诶？这个已经过时了吗？真的假的？"},{"label":"活动商店关闭","jp":"お祭りは終わってしまいましたが、まだまだ営業中です、残り物には福があるっていますから、さあ先生、どうぞ。","zh":"虽然庆典结束了，但我们仍然在营业。\n据说大家分享之后剩下的部分叫做福根儿~老师可别错过呦~。"},{"label":"活动商店购买1","jp":"あっそれ！いえいえ、どうぞどうぞ、別に甘えたら貰おうとか思ていたわけではなく。","zh":"没……没事没事，你请你请，\n绝对不是因为我想把卖剩下的给吞了。"},{"label":"活动商店购买2","jp":"それは選ぶとは流石先生、お目が高いです。","zh":"真是会选，不愧是老师，眼光独到。"},{"label":"活动商店购买3","jp":"お買い上げありがとうございます！ご主人様。","zh":"感谢您的购买。主人。"},{"label":"活动商店购买4","jp":"あ、それ、やぱりいい品だと思いますよね。えへへ。","zh":"啊，你也觉得这是好东西，对吧？"}]},"stats":{"init":[{"name":"攻击力","value":"185"},{"name":"防御力","value":"119"},{"name":"生命值","value":"2351"},{"name":"治愈力","value":"1739"},{"name":"命中值","value":"602"},{"name":"闪避值","value":"200"},{"name":"暴击值","value":"200"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2286"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4868"},{"name":"防御力","value":"656"},{"name":"生命值","value":"4868"},{"name":"治愈力","value":"11653"},{"name":"命中值","value":"602"},{"name":"闪避值","value":"200"},{"name":"暴击值","value":"350"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2286"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"364"},{"name":"生命值","value":"4531"},{"name":"治愈力","value":"934"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"项链","grade":"T10","attrs":[{"name":"治愈力","value":"42%"},{"name":"群控强化力","value":"38%"},{"name":"攻击力","value":"18%"}]}],"giftDetail":{"t1Value":[{"name":"生命值","val