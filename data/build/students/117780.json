237/829/72324/2025/4/29/779752.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/26/558677.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/825207.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/120648.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/517636.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/782939.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/599527.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/555870.png","name":"秘密讯息","desc":"小雪送给老师的手工巧克力。虽然看起来是普通送礼用的巧克力，但是似乎暗藏着其他的意思。"},"ability":{"attrs":[{"name":"生命值","value":"845"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"205"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/748233.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/4/29/130529.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"小雪（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/759520.png","url":"https://www.gamekee.com/ba/tj/643792.html"},{"name":"NPC 小雪（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_275/h_275/829/191981/2025/11/3/6604.png","url":"https://www.gamekee.com/ba/684614.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー！アーカイブ！","zh":"Blue Archive"},{"label":"卡池抽取","jp":"なんか面白いことないですか～？\n黒崎コユキ、来ちゃいました！！\nに・は・は・は！！","zh":"有没有什么好玩的事情啊？黑崎小雪来了，捏哈哈哈。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰りなさい、先生！\n待ちくたびれましたよ～！","zh":"老师，欢迎回来，我等的好辛苦呀。"},{"label":"登陆2","jp":"にはは、先生！\n……え？いえ？何も触ってませんよ？\n多分……？","zh":"捏哈哈，老师……\n没有，我什么都没碰，大概。"},{"label":"大厅1","jp":"なにかお役に立ちたいです～\nもしかして……じっとしているほうが役に立ったり？","zh":"我想帮您些忙！\n还是说，我安静的坐着就算帮忙了？"},{"label":"大厅2","jp":"計算……ですか？\n楽勝ですよ！好きじゃないだけで。","zh":"计算轻轻松松，虽然我不太喜欢。"},{"label":"大厅3","jp":"もしかして、パスワードを確認するために呼びました？\n私はメモ帳じゃないですよ～？","zh":"难道您是想确认密码才把我叫过来的吗？我可不是记事本。"},{"label":"大厅4","jp":"あ、私がここにいるって先輩たちに言ってくれました？\nちゃんと連絡してないと、あとで怒られちゃうから……。","zh":"我在这里的事情，老师已经给前辈们说过了吗？\n如果不好好说清楚的话，我后面会挨骂的。"},{"label":"大厅5","jp":"え？退屈じゃないですよ～？\n……うん？……さあ？なんででしょう？","zh":"才不无聊啊。\n对啊，为什么呢？"},{"label":"回忆大厅1","jp":"先生！見てください！！四葉のクローバーですよ！！\nどういうこと！？さっきまでなかったのに！\nもしかして……いきなり生えたとか？","zh":"老师快看，是四叶草。\n这是怎么回事？明明刚才都没有的，难道是突然长出来的？"},{"label":"回忆大厅2","jp":"や、そんなのありえないか……。\n見落としてたのかな……？\n先生はいつ気づいたんですか？","zh":"不对，这未免也太离谱了。\n是我看漏了吗？老师是什么时候发现的？"},{"label":"回忆大厅3","jp":"それに、どうやって、こんな……\nタイミングよく…\n見つかる、なんて……？","zh":"而且怎么会这么巧？\n竟然刚好在这个时候找到了。"},{"label":"回忆大厅4","jp":"……！！！\n……なるほど……！\nそうですね……！！","zh":"啊！\n对哦，原来如此。"},{"label":"回忆大厅5","jp":"……はい！\nそう考えたほうが、きっと……。\n……楽しいですもんね！！","zh":"嗯……\n这么想的话，肯定会……\n更加开心！"},{"label":"咖啡馆1","jp":"うわぁ！なんだか不思議なものがいっぱいですね！","zh":"这里好像有很多神奇的东西。"},{"label":"咖啡馆2","jp":"こ、ここって安全地帯ですよね！？\n誰かに連れていかれたりとかしませんよね！？","zh":"这里应该很安全吧？我应该不会突然被人抓走吧？"},{"label":"咖啡馆3","jp":"へぇ、ここが噂の……。","zh":"这里就是传说中的……"},{"label":"咖啡馆4","jp":"もしかしてここって……\n騒がしい人は追い出されるシステムだったりします！？","zh":"难道这里装了能把吵闹的人踢出去的系统？"},{"label":"咖啡馆5","jp":"はっ……！！\n……お腹空いたぁ。","zh":"肚子饿了。"}],"好感度":[{"label":"好感度1","jp":"え？なんですか？プレゼント？！私に？先生から？！","zh":"这是什么？礼物？给我的？老师送的？"},{"label":"好感度2","jp":"プレゼント、誠にありがとうございます！\n大人相手には礼儀正しく、ね！","zh":"我真的很感谢老师送的礼物，对大人应该有礼貌，对吧？"},{"label":"好感度3","jp":"私今日、何かしましたっけ。","zh":"我今天做什么了吗？"},{"label":"好感度4","jp":"ありがとうございます～大切にします。本当に…","zh":"谢谢你，我会好好珍惜的，真的。"}],"战斗":[{"label":"编入队伍1","jp":"やってみよう！","zh":"来试试吧。"},{"label":"编入队伍2","jp":"面白いこと、起きますように！","zh":"希望能有好玩的事情。"},{"label":"拎起","jp":"うわわー","zh":"哇哇哇哇~"},{"label":"任命队长1","jp":"ゲッ、ちょっと多くないですか？","zh":"你不觉得要做的有些多了吗？"},{"label":"任命队长2","jp":"本当…それ、全部やるんですか。","zh":"这些真的都要我做吗？"},{"label":"普通技能","jp":"にはははは！","zh":"捏哈哈哈！"},{"label":"EX动画1","jp":"ど·れ·に·し·よ·う——うえ！","zh":"点兵点将——喂！"},{"label":"EX动画2","jp":"こういう状況なら…うわ！","zh":"这种时候的话——喂！"},{"label":"EX动画3","jp":"こんな時のために…うわ！","zh":"就是为了这时候才——喂！"},{"label":"EX技能1","jp":"まぁ、これでいいですよね！","zh":"这样就好了吧。"},{"label":"EX技能2","jp":"鉄火良ければ全てオーケーってね！","zh":"只要结果好，就OK了，对吧？"},{"label":"EX技能3","jp":"これぞ醍醐味ってやつ？","zh":"这就叫做精髓？"},{"label":"战斗开始1","jp":"今は私が！隊長なんだから！","zh":"现在开始，我就是队长。"},{"label":"战斗开始2","jp":"愚図愚図してる暇はないです！","zh":"没有磨磨蹭蹭的时间了。"},{"label":"获得BUFF","jp":"はっ！私にくれるんですか？","zh":"是给我的吗？"},{"label":"施放BUFF","jp":"ちゃんとやりますよ～だ！","zh":"要好好干。"},{"label":"掩体","jp":"おっとと…間一髪。","zh":"好险好险，就差一点儿。"},{"label":"被CC1","jp":"ギョア―！","zh":"-"},{"label":"被CC2","jp":"-","zh":"好ten——"},{"label":"被CC3","jp":"あーいたたたたた！","zh":"疼疼疼疼"},{"label":"回避","jp":"にゃははは！させませんよ～だ！","zh":"啊哈哈哈，我才不会让你得逞的。"},{"label":"队伍移动1","jp":"追い込めー！","zh":"继续前进。"},{"label":"队伍移动2","jp":"このまま行きますよ！","zh":"就这样一鼓作气。"},{"label":"回复","jp":"ありがとうございます！","zh":"非常感谢。"},{"label":"中途退出","jp":"うー！伐倒…","zh":"啪嗒——"},{"label":"战斗喊叫","jp":"ビュービュービュー～","zh":"biubiubiubiubiu——"},{"label":"战斗喊叫","jp":"ウララララ！","zh":"欧啦啦啦啦啦——"},{"label":"战斗喊叫","jp":"バキュン、バキュン！","zh":"biangbiangbiangbiang——"},{"label":"角色移动","jp":"はっちゃあ！","zh":"哈呀！"},{"label":"战斗胜利1","jp":"楽勝楽勝！バン！","zh":"轻轻松松~bang~"},{"label":"战斗胜利2","jp":"ちょろいちょろい！バン！","zh":"简简单单~bang~"},{"label":"关卡完成1","jp":"私を呼んだがやったでしょう！","zh":"找我找对了吧？"},{"label":"关卡完成2","jp":"次も呼んでくださいねー！","zh":"下次也要叫上我哦。"},{"label":"战斗失败1","jp":"はぁ～はぁ～ま、まずい…","zh":"好难受。"},{"label":"战斗失败2","jp":"思ってたのと違う…","zh":"和我想的不一样。"}],"成长":[{"label":"升级1","jp":"え？…私に？本当ですか？渡す人を間違えたとかじゃなくて？","zh":"给我的？真的吗？不是搞错人了吗？"},{"label":"升级2","jp":"にははは～大きな力だ！え？大いなる責任？なんですかそれ？","zh":"喂哈哈哈，更大的力量。诶？更大的责任？那是什么？"},{"label":"升级3","jp":"誰にも私は止められない。先生は除く！先輩たちも除く！","zh":"谁也阻止不了我啊~\n除了老师，还有前辈们。"},{"label":"升级4","jp":"あ？これはちょっと…いくら何でも流石に…いや…むしろいいのかも…？には！こんなにしてもらちゃっていいんですか？","zh":"这个有点……再怎么说都有点……\n不，说不定也挺好。老师对我这么好，真的没关系吧。"},{"label":"获得专武","jp":"え？ん？いいんですか？これ、本当に大丈夫ですか！？先生、もしかして私のこと、本当に信じてくれるんですか？","zh":"可以吗？这样做真的没问题吧？难道老师真的很信任我吗？"}],"事件":[{"label":"学生生日","jp":"はいっ！今日は私の誕生日です！\nにははっ！今日は運がいい日だといいなぁ～\nそうじゃないと困ります！","zh":"是的，今天是我的生日，哈哈，希望今天运气不错，不然我会很为难的。"},{"label":"老师生日","jp":"ハッピーバースデー！せ・ん・せ・い！\n今日は先生のお願い、なんでも聞いてあげちゃいますよ！","zh":"生日快乐，老师，今天老师提出的心愿我都会满足哦。"},{"label":"万圣节","jp":"今日はなんだか、変な格好をした人が多いですね～。\n……私ですか？わ、私～は～そんなこと～\nないような～そうでもない……ような？にはは……？","zh":"不知道怎么回事，今天有很多穿着奇怪服装的人。\n我吗？我……我没有过那种时候吗？有过那种时候吗？捏哈哈……"},{"label":"新年","jp":"あけましておめでとうございます～！\nうあ～もう1年が過ぎちゃった……！\n……あれ？年って過ぎるもの？それとも来るもの？\nどっちだと思います？","zh":"祝你新年快乐。又一年过去了。\n等等年是过去了还是过来了？老师是怎么想的？"},{"label":"圣诞节","jp":"メリークリスマース！\n今日はたくさん遊んで良い日！\nそうですよね？","zh":"圣诞快乐，今天是可以玩个痛快的好日子，对吧？"},{"label":"春节","jp":"","zh":"老师，新春快乐，您知道吗？听说新春放鞭炮能带来好运气，我从工程部那里拿来了好多好多鞭炮，我们快出发。"},{"label":"中秋","jp":"","zh":"老师，我刚刚听说了，如果在中秋节当晚对着月亮吃下十个月饼的话，就能有一整年的好运气。你说这是骗人的是什么意思？可我刚刚才买了十个月饼回来。"}]},"stats":{"init":[{"name":"攻击力","value":"424"},{"name":"防御力","value":"76"},{"name":"生命值","value":"2398"},{"name":"治愈力","value":"1724"},{"name":"命中值","value":"104"},{"name":"闪避值","value":"190"},{"name":"暴击值","value":"209"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1332"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"25 (5)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"10277"},{"name":"防御力","value":"418"},{"name":"生命值","value":"48565"},{"name":"治愈力","value":"6139"},{"name":"命中值","value":"324"},{"name":"闪避值","value":"190"},{"name":"暴击值","value":"1339"},{"name":"暴击伤害","value":"226%"},{"name":"稳定值","value":"1332"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"25 (5)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"832"},{"name":"生命值","value":"2927"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":