5/11/911084.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/82376.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/448592.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/778649.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/123636.png","name":"无须多言巧克力","desc":"估计是夏亲手制作的巧克力。跟夏善于雄辩的口才相比之下显得简约，也因此能从设计中感受到其美妙之处。"},"ability":{"attrs":[{"name":"生命值","value":"1916"},{"name":"攻击力","value":"64"},{"name":"治愈力","value":"212"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/404626.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/11/965119.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 夏（乐队）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_300/829/86082/2025/5/11/615509.png","url":"https://www.gamekee.com/ba/664782.html"},{"name":"NPC 夏（鬼屋）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/11/808123.png","url":"https://www.gamekee.com/ba/639201.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー～アーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"やあやあ、会えて嬉しいよ先生。今日もキャンディーみたいな、甘ーい1日になりそうだぁ。","zh":"老师你好，今天也像糖果一样甜蜜。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生。とりあえず何か食べる？","zh":"老师，你来了。要先吃点什么吗？"},{"label":"登陆2","jp":"にひ、待ってたよ～","zh":"我正等着你。"},{"label":"大厅1","jp":"どうしたの、先生？……口寂しい？飴ちゃんでもあげようか。","zh":"怎么了？老师。\n嘴馋了吗？要不要给你吃个糖？"},{"label":"大厅2","jp":"ところで先生、お口直しには何が好き？","zh":"有点好奇老师平时喜欢吃什么，来换换口味。"},{"label":"大厅3","jp":"別に私だって、いっつもお菓子の話ばっかりしてるわけじゃないよ～。","zh":"我也不是只想着吃零食了。"},{"label":"大厅4","jp":"先生……別腹、って知ってる？","zh":"饭和零食进的不是同一个胃，知道吗？"},{"label":"大厅5","jp":"これもまた、スイーツに込められた哲学……\nどう、感動した？","zh":"甜点中蕴含着哲学。\n怎么样？感动了吗？"},{"label":"回忆大厅1","jp":"見て見て先生！すごい…！こんなにたくさん！！","zh":"快看，这个老师好厉害，有这么多。"},{"label":"回忆大厅2","jp":"それに、どれもこれも見たことない！初めて見たお菓子ばっかり…！！","zh":"这个是第一次见，那个也是第一次见。\n全都是没见过的点心。"},{"label":"回忆大厅3","jp":"…あはっ。ごめんごめん。何だか急に気が抜けちゃって。","zh":"抱歉抱歉，感觉突然松了一口气呢。"},{"label":"回忆大厅4","jp":"ありがとね、先生。こうして付き合ってくれて。","zh":"谢了，老师。能这样陪着我。"},{"label":"回忆大厅5","jp":"ほんと、感謝してるんだ。先生とこうしていられて、嬉しいし、楽しいの。","zh":"真的很感谢。跟老师在一起我真的好开心啊。"},{"label":"咖啡馆1","jp":"何か、おやつは…","zh":"有没有零食呢？"},{"label":"咖啡馆2","jp":"うん、良い雰囲気だね～。","zh":"好有活力呀，气氛真好。"},{"label":"咖啡馆3","jp":"ひーまーだー。","zh":"好无聊。"},{"label":"咖啡馆4","jp":"あれ、先生は……？","zh":"老师也在这儿吗？"},{"label":"咖啡馆5","jp":"おお……！これは……！","zh":"那个是……"}],"好感度":[{"label":"好感度1","jp":"ほんと、一緒にいると楽だなぁ～。…ん、先生の話だよ。","zh":"和老师在一起真的很舒服啊。老师你觉得呢？"},{"label":"好感度2","jp":"どんなことでもいいから、もっといろいろと話してみたいな～。","zh":"不管什么话题都可以，我想跟老师聊更多更多。"},{"label":"好感度3","jp":"貰った分はお返しするから、心配しなくていいよ～。…ん、まあいろいろとね。","zh":"别担心，我会尽我所能回报你的。嗯，没错，用各种方式。"},{"label":"好感度4","jp":"うん、トクベツ…だなぁ。","zh":"感觉好特别。"}],"战斗":[{"label":"编入队伍1","jp":"ん～、あとで私に文句とか言わないでよ。","zh":"之后可别抱怨。"},{"label":"编入队伍2","jp":"これが終わったら、おいしいスイーツ買ってね。","zh":"结束以后要请我吃好吃的甜点哦。"},{"label":"拎起","jp":"ん？私？","zh":"我吗？"},{"label":"任命队长1","jp":"さぁ、この戦いの果てにはいったい何が？","zh":"这场战斗的尽头究竟是什么呢？"},{"label":"任命队长2","jp":"さ～て。始めますか。","zh":"那就开始吧。"},{"label":"普通技能","jp":"一緒に食べる？","zh":"一起吃不？"},{"label":"EX动画1","jp":"仕方ないなぁ。","zh":"没办法。"},{"label":"EX动画2","jp":"こんなときは？","zh":"这种时候就要。"},{"label":"EX动画3","jp":"必殺～","zh":"必杀技。"},{"label":"EX技能1","jp":"牛乳の時間！","zh":"牛奶时间。"},{"label":"EX技能2","jp":"水分補給！","zh":"补充水分。"},{"label":"EX技能3","jp":"うん、これこれ。","zh":"就是这个。"},{"label":"战斗开始1","jp":"さぁ～て。しゅっぱ～つ。","zh":"好，我们走吧。"},{"label":"战斗开始2","jp":"さぁ報酬のために、ゴーゴ～。","zh":"为了奖励，go. go."},{"label":"获得BUFF","jp":"お～、すご～い。","zh":"真厉害。"},{"label":"施放BUFF","jp":"さぁ～て、これからこれから。","zh":"现在要动真格的喽。"},{"label":"掩体","jp":"いや、まいたまいた。","zh":"不好办。"},{"label":"被CC1","jp":"ぅ……","zh":"-"},{"label":"被CC2","jp":"うぁ。","zh":"-"},{"label":"被CC3","jp":"うぅ……","zh":"-"},{"label":"回避","jp":"問題な～し。","zh":"没问题。"},{"label":"队伍移动1","jp":"オッケーオッケー。","zh":"OK OK."},{"label":"队伍移动2","jp":"つぎつぎ～。","zh":"下一个"},{"label":"回复","jp":"感謝！","zh":"谢谢"},{"label":"中途退出","jp":"と、糖分が足りない……","zh":"糖分不足"},{"label":"战斗喊叫","jp":"やぁ","zh":"-"},{"label":"战斗喊叫","jp":"おぃ","zh":"-"},{"label":"战斗喊叫","jp":"はぁー！","zh":"-"},{"label":"角色移动","jp":"よ～い、ちょっと。","zh":"哎呦"},{"label":"战斗胜利1","jp":"楽勝だよ～。","zh":"轻轻松松"},{"label":"战斗胜利2","jp":"ではご褒美タイム～。さて、先生は何をくれるのかな？","zh":"奖励时间到。\n老师。会给我什么呢？"},{"label":"关卡完成1","jp":"はい終わり。さ、お菓子お菓子～。","zh":"我到位了，甜点甜点"},{"label":"关卡完成2","jp":"帰っておいしいものでも食べよっか。","zh":"回去吃点好吃的吧。"},{"label":"战斗失败1","jp":"うーん……あれ？","zh":"-"},{"label":"战斗失败2","jp":"先生ごめん。糖分が足りなかった……","zh":"对不起老师，糖分不足。"}],"成长":[{"label":"升级1","jp":"ちょうどお腹すいてたとこー。","zh":"正好肚子饿了。"},{"label":"升级2","jp":"おーこれこれ、これが欲しかったの。","zh":"就是这个，我想要的就是这个。"},{"label":"升级3","jp":"ありがとう先生、私のこと分かってるじゃん。","zh":"谢谢老师，还是你等我。"},{"label":"升级4","jp":"おー、すごいすごーい。","zh":"厉害。"},{"label":"获得专武","jp":"おー、すごいねこれ。私でいいの？ひんぴんとかなしだからね。","zh":"很厉害，确定要给我吗？送了就不退了。"}],"事件":[{"label":"学生生日","jp":"先生、先生。今日が何の日か、もちろん知ってるよね？\nすっっっごいの期待してるよ？","zh":"老师老师，你知道今天是什么日子吧？我非常期待哟。"},{"label":"老师生日","jp":"先生のお誕生日……\n仕方ない、今日は私が奢ってあげよう！","zh":"老师的生日，没办法了，今天我请客。"},{"label":"万圣节","jp":"今日はキャンディーがたくさん貰える日……！\n行くよ、先生！あ、そこのスペースは空けといて！今日からしばらくキャンディー置き場になるから！","zh":"今天是可以收到好多糖果的日子。\n要上了！老师口袋的容量足够吗？、\n今天老师的口袋要用来放很多很多糖果。"},{"label":"新年","jp":"さあ、今年の新作はどんな感じかな～一緒に買えに行こう、先生。","zh":"今年会出什么新品呢？老师我们一起去买吧。"},{"label":"圣诞节","jp":"果たして今年もサンタさんは、私のことを見捨ててしまうのか！\nそれとも今年のサンタさんは先生！？","zh":"圣诞老人今年也会抛弃我吗？不对，说不定老师就是我的圣诞老人。"},{"label":"春节","jp":"","zh":"新春快乐，老师，新年可是甜点爱好者的大日子啊，快一起去外面探店吧。"},{"label":"中秋","jp":"","zh":"老师知道月饼中蕴含的哲学吗？我也不太清楚，那就一起研究一下吧。"}]},"stats":{"init":[{"name":"攻击力","value":"173"},{"name":"防御力","value":"165"},{"name":"生命值","value":"2836"},{"name":"治愈力","value":"1781"},{"name":"命中值","value":"108"},{"name":"闪避值","value":"220"},{"name":"暴击值","value":"216"},{"name":"暴击伤害",