5/12/698948.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/820828.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/546208.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/161621.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/721251.png","name":"好美的限定巧克力","desc":"好美亲手制作的手工巧克力。从各方面看来，都是其他地方找不到的限定版中的限定版。"},"ability":{"attrs":[{"name":"生命值","value":"761"},{"name":"攻击力","value":"122"},{"name":"治愈力","value":"227"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/862595.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/768419.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 好美（乐队）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_637/h_625/829/86082/2025/5/12/81115.png","url":"https://www.gamekee.com/ba/620883.html"},{"name":"NPC 好美（鬼屋）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/283650.png","url":"https://www.gamekee.com/ba/639189.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"小さいからって舐めないで！将来性はものすっごいんだから！","zh":"别因为我个子小就看不起我，我的潜力可是很大的！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"頭撫でないでっ！もうっ…子ども扱いは嫌なの。","zh":"别摸我的头！真是的，我讨厌别人把我当小孩。"},{"label":"登陆2","jp":"私も…あと何年か経ったら…妹じゃなくて、恋人に見えるかな？","zh":"如果再过几年，我会不会看起来，就不止像你的妹妹了呢？"},{"label":"大厅1","jp":"牛乳なら1L飲んでる。仕方なく、毎日、毎日、毎日ね！","zh":"牛奶我每天都要喝一升，有什么办法？每天喝每天喝每天喝！"},{"label":"大厅2","jp":"と、当番になれば、先生と美味しいお菓子を食べる時間があるはずよね？","zh":"如果我值日，就有时间和老师一起吃好吃的零食了吧！"},{"label":"大厅3","jp":"ほら、今日も頑張って！私が手伝ってあげるから！","zh":"好啦，今天也加油吧，我也会帮你的！"},{"label":"大厅4","jp":"あの、先生、疲れてない？\nお、美味しいスイーツでも食べに行く？","zh":"那个，老师你累不累呀，要不要一起去吃好吃的甜点啊？"},{"label":"大厅5","jp":"ほら！私がいる限りサボろうとするのは諦めなさい！さ、仕事の時間よ！任務を始めましょう！","zh":"喂！我在这盯着你还想偷懒啊？来，该干活了，开始执行任务吧。"},{"label":"回忆大厅1","jp":"ほんと、先生には驚かされっぱなしっていうか、\n振り回されっぱなしっていうか……","zh":"……真是的，老师总喜欢吓唬人呢……真是，让人捉摸不透。"},{"label":"回忆大厅2","jp":"……ん？何をそんな、じっと見てるわけ？\nねぇ、まさかまた変なこと考えてないでしょうね？","zh":"嗯？你直勾勾地盯着我干什么……啊，一看就知道，你一定又在想什么奇怪的事吧！"},{"label":"回忆大厅3","jp":"私は先生のオモチャじゃないんだから、いい加減やめないと本当に怒るよ。","zh":"哼，我可不是老师的玩具！要是不适可而止的话，我就真生气啦！"},{"label":"回忆大厅4","jp":"……いやまあ、別に心の底から嫌、って\nわけじゃないけど……。……ふふっ。","zh":"虽然，其实也没有那么讨厌……诶嘿嘿。"},{"label":"回忆大厅5","jp":"（いつか……）\n（いつかこうやって隣に……堂々と、並んで歩ける日が……）","zh":"（早晚……早晚有一天，我和你并肩散步时，能被称赞“很般配”的日子，也会到来吧。）"},{"label":"咖啡馆1","jp":"美味しいスイーツが食べたーい、あっ！先生！","zh":"我想吃好吃的点心！啊，老师！"},{"label":"咖啡馆2","jp":"ん？えー…牛乳は、嫌い。飲まなきゃいけないって分かってるから、尚更！えっ？それ、い、イチゴ牛乳？","zh":"嗯？我讨厌牛奶！因为我知道必须要喝，所以更讨厌了，嗯？是草莓牛奶吗？"},{"label":"咖啡馆3","jp":"…私の成長はまだ終わってないの！信じて！","zh":"我还没有发育完呢！真的！"},{"label":"咖啡馆4","jp":"ふふっ。一眠りしていこっかな。","zh":"要不要打个盹呢？"},{"label":"咖啡馆5","jp":"はあ…先生はなんであんなに空気が読めないんだろう。","zh":"老师为什么这么不会看人脸色呢？"}],"好感度":[{"label":"好感度1","jp":"な、なんて言うかその……は、恥ずかしいんだけど！","zh":"怎么说呢？那个，太尴尬了吧！"},{"label":"好感度2","jp":"今日は…楽しかった。う、嘘じゃない！","zh":"今天，很开心，是真的！"},{"label":"好感度3","jp":"か、勘違いしないで！先生との時間が楽しすぎただけだから！……はっ、何か言い間違えた気がする！？","zh":"别误会了。我只是觉得和老师在一起很开心而已，嗯…感觉说错话了！"},{"label":"好感度4","jp":"あ、あ…ありがと！い、今はこの言葉しか浮かばないの。でも…次はその…","zh":"谢、谢、谢谢，现在我只能想到这些话了，但是，下次，那个…"}],"战斗":[{"label":"编入队伍1","jp":"私が合流したことに感謝しなさい。","zh":"我可是专程过来和大家汇合的，还不快谢谢我？"},{"label":"编入队伍2","jp":"仕様がないわね、行くわよ。","zh":"真没办法，走吧！"},{"label":"拎起","jp":"ひゃっ！？き、急になによ！？","zh":"啊？！搞什么啊！"},{"label":"普通技能","jp":"これはどう！？","zh":"这招如何？"},{"label":"EX动画1","jp":"くらえっ！","zh":"吃我一发！"},{"label":"EX动画2","jp":"ふんっ、やっつけてやる！","zh":"干掉你！"},{"label":"EX动画3","jp":"覚悟しなさい！","zh":"给我死心吧！"},{"label":"EX技能1","jp":"はあぁぁ！","zh":"嗨！"},{"label":"EX技能2","jp":"これでどう！？","zh":"这发怎么样？"},{"label":"EX技能3","jp":"これでもくらえ！","zh":"再吃一发！"},{"label":"战斗开始1","jp":"ぶっ壊してやるわ。","zh":"打垮他们！"},{"label":"战斗开始2","jp":"許せない。","zh":"饶不了你！"}],"成长":[{"label":"升级1","jp":"あ、あ…ありがとう！","zh":"谢、谢、谢谢！"},{"label":"升级2","jp":"ふふーん、先生！もっと私に頼ってもいいのよ！","zh":"哼哼，老师，尽管放心交给我吧！"},{"label":"升级3","jp":"よぉーし！私、これでもっと強くなった！きっと背も伸びたよね！","zh":"太好了，这样我就更强了，个子也会长高吧！"},{"label":"升级4","jp":"ありがとう先生。…いつか恩返しするから。","zh":"谢谢老师，总有一天我会回报你的！"},{"label":"获得专武","jp":"こんなの貰っちゃったら……\n本気で頑張るしかないじゃん！","zh":"收下这种东西，就只能尽全力了吗！"}],"事件":[{"label":"学生生日","jp":"お、お祝いしてくれてありがとう。\n（あと誕生日が何回来たら…そばにいた時に、お似合いって思ってもらえるのかな？）\nべ、別に何も、変なことは考えてないけど？何をそんなにじっと見つめてるのよ？！","zh":"谢谢你的祝福，还得过多少生日，才能让大家觉得我们站在一起比较相称呢，干嘛！我又没胡思乱想，一直盯着我干什么！"},{"label":"老师生日","jp":"誕生日おめでとう、先生！近くに良いスイーツ屋さんがあるの、行こ！","zh":"老师，生日快乐。附近有家很棒的便利店，走吧！"},{"label":"万圣节","jp":"Trick or Treat～放課後スイーツ部には特別な日、ハロウィーンよ！外に行こう！\n幽霊には興味ないけど、飴は大事だからね！","zh":"不给糖就捣蛋，对甜点部来说，万圣节是个很特别的节日，我们出去吧，我对幽灵没兴趣。但是吃糖要紧！"},{"label":"新年","jp":"明けましておめでとう！今年の目標？そんなの決まってるでしょ！ナイスバディになることよ！！","zh":"新年快乐，今年的目标那还用问吗？肯定是练成完美身材啊！"},{"label":"圣诞节","jp":"メリークリスマス！クリスマスって大好き！街が、私の好きな色でいっぱいになるから！","zh":"圣诞快乐！我喜欢圣诞节，因为街上到处都是我喜欢的颜色！"},{"label":"春节","jp":"","zh":"新春快乐！今年一定能长得更高，绝对不会再被当成小孩子了！"},{"label":"中秋","jp":"","zh":"月饼也算一种甜点吧……？喏，分你一块！"}]},"stats":{"init":[{"name":"攻击力","value":"268"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2232"},{"name":"治愈力","value":"1622"},{"name":"命中值","value":"705"},{"name":"闪避值","value":"806"},{"name":"暴击值","value":"201"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1596"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8007"},{"name":"防御力","value":"109"},{"name":"生命值","value":"45955"},{"name":"治愈力","value":"8196"},{"name":"命中值","value":"705"},{"name":"闪避值","value":"806"},{"name":"暴击值","value":"831"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1596"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"140"},{"name":"群控抵抗力","value"