m/ba/620813.html"},{"name":"NPC 爱莉（鬼屋）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/119198.png","url":"https://www.gamekee.com/ba/639198.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案"},{"label":"卡池抽取","jp":"お会いできて嬉しいです、先生～\n先生はどんなアイスが好きですか？","zh":"很开心能认识您，老师，老师喜欢什么口味的冰淇凌呢 ？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生～、お帰りなさい。\n今日も一緒にスイーツ食べに行きますよね？","zh":"老师，您回来啦。今天也会一起去吃甜点对吧！"},{"label":"登陆2","jp":"先生、遅いですよ～\n一緒にアイス買いに行きましょう！","zh":"老师，您来的好晚啊，我们一起去买冰淇淋吧！"},{"label":"大厅1","jp":"ルンルン～甘いの大好き～","zh":"啦啦，最喜欢甜食啦！"},{"label":"大厅2","jp":"先生もアイスクリーム好きですよね？ね？","zh":"老师，您也喜欢冰淇淋吧，对吧？"},{"label":"大厅3","jp":"放課後はスイーツタイム～","zh":"回家路上，就是甜点时间~"},{"label":"大厅4","jp":"おいしいスイーツのため～今日も一緒に、頑張りましょう！","zh":"为了好吃的甜点，今天也一起加油吧！"},{"label":"大厅5","jp":"ん？先生。何か悩みがありそうな顔ですね。","zh":"嗯..老师，看您好像有什么心事？"},{"label":"大厅6","jp":"そういう時は、さあさあ！美味しいスイーツを食べに！一緒に行きましょう！","zh":"这种时候啊，来来，一起去吃美味的甜点吧！"},{"label":"回忆大厅1","jp":"-","zh":"（嘶溜~）"},{"label":"回忆大厅2","jp":"私の分も買っていただいてありがとうございます、先生。\nあ、甘くて美味しいです！","zh":"非常感谢您，连我的份，也一起买了……老师，甜甜的好好吃啊~！"},{"label":"回忆大厅3","jp":"カフェではなく、外で食べるアイスクリームってすごく久しぶりな気がします。\nそれに、先生と一緒ですし。えへへっ。","zh":"平常都是在咖啡厅吃冰淇淋，感觉，好久好久没在外面吃了……而且，还是跟老师一起，诶嘿嘿~"},{"label":"回忆大厅4","jp":"い、いえ、全然そんなことは。むしろ懐かしくて、嬉しいです。","zh":"啊，不，没有……完全没有啦！反而有种很怀念的感觉……好开心！"},{"label":"回忆大厅5","jp":"嬉しいですし、その…。\n何と言えばいいんでしょう、周りに人も少ないですし…。\nすごく、ドキドキすると言いますか…。\n…な、なっ、なんでもありません！\n今のは忘れてください！はは、あはは…","zh":"不仅开心，而且……感觉，真安静啊……周围也没有什么人……不知道该不该说，我感觉，心在砰砰乱跳……啊，没，没有没有！请您，当我什么都没说吧！诶嘿嘿，啊哈哈哈……"},{"label":"回忆大厅6","jp":"…ありがとうございます、先生。\n今日も先生のおかげで、もうすでに幸せな一日になりました。","zh":"……谢谢您，老师。多亏有老师在，今天，真的好幸福！"},{"label":"咖啡馆1","jp":"放課後にはやっぱりスイーツ！","zh":"在回家路上，就该吃甜点！"},{"label":"咖啡馆2","jp":"いちごとミントは最高！","zh":"嗯！薄荷搭草莓最棒了。"},{"label":"咖啡馆3","jp":"んー、何を食べようかな…","zh":"嗯~吃什么好呢？"},{"label":"咖啡馆4","jp":"今日もやっぱりいちご＆ミント～","zh":"今天也还是吃，薄荷草莓口味吧！"},{"label":"咖啡馆5","jp":"アイス、アイス～アイスクリーム～","zh":"冰淇淋，冰淇淋，真好吃?"}],"好感度":[{"label":"好感度1","jp":"えへへっ、少し照れちゃいますね、先生。","zh":"老师，我有点不好意思欸.."},{"label":"好感度2","jp":"先生と一緒にいられて、私本当に…嬉しいです！","zh":"能和老师在一起，我真的好高兴！"},{"label":"好感度3","jp":"先生ー！今日も明日も明後日も、ずっと私と一緒にいてくれますよね！","zh":"老师，今天明天还有后天，您都可以一直和我在一起吧！"},{"label":"好感度4","jp":"スイーツもいいですけど、やっぱり先生と一緒にいる方が好きです。","zh":"甜食虽然很棒，但是我觉得还是跟老师在一起更开心！"}],"战斗":[{"label":"编入队伍1","jp":"全力でお手伝えします！","zh":"我会全力帮忙的！"},{"label":"编入队伍2","jp":"今日も頑張ります！","zh":"今天也要加油！"},{"label":"拎起","jp":"あーん……先生も食べますか？","zh":"啊——嗯？老师也要吃吗？"},{"label":"普通技能","jp":"みんな、ファイトです！","zh":"大家，加油！"},{"label":"EX动画1","jp":"ふんふん♪ん、へっ？投げるのぉ！？","zh":"要扔出去吗！？"},{"label":"EX动画2","jp":"いただきま…ん、へっ？ええっ！？","zh":"我要开吃，欸欸欸！？"},{"label":"EX动画3","jp":"あーん…あ、ちょっ！そんなぁ…","zh":"怎么这样…."},{"label":"EX技能1","jp":"あっ、あああぁ…","zh":"呜呜呜…"},{"label":"EX技能3","jp":"もったいない…","zh":"好浪费！"}],"成长":[{"label":"升级1","jp":"ありがとうございます、先生！","zh":"老师，谢谢您！"},{"label":"升级2","jp":"えへへっ、もっと私に頼ってもいいんですよ～。","zh":"可以多依靠我一点哦！"},{"label":"升级3","jp":"じゃーん！強くなりました！","zh":"锵！我变强了！"},{"label":"升级4","jp":"いつもありがとうございます～先生、えへへっ。","zh":"老师，谢谢您一直都那么照顾我。"},{"label":"获得专武","jp":"……この武器は……。ありがとうございます。先生。\n強くなるのは、少し怖いことですが……。先生と一緒なら、大丈夫です！","zh":"这件武器..老师，谢谢您，一想到会变强就有点怕怕的，不过只要能跟老师一起就行！"}],"事件":[{"label":"学生生日","jp":"先生～ 今日は私の誕生日です！一緒にアイス食べに行きましょう！\nん？プレゼントですか？\n大丈夫ですよ～先生が私のプレゼントですから！","zh":"老师，今天是我生日，一起去吃冰淇淋吧！礼物？不用啦，老师就是我的礼物嘛！"},{"label":"老师生日","jp":"先生！お誕生日おめでとうございます！\n私が特別に！おいしいスイーツ屋さんを予約しておきましたよ！\nさあさあ、急いで！先生！","zh":"老师，祝您生日快乐，为了这一天，我可是特意为您预约了好吃的甜品店呢！来吧来吧，快走吧老师！"},{"label":"万圣节","jp":"えへへっ、今日はハロウィーンですね。\n一緒にお化けのコスプレして甘いものを貰いに行ってみましょうか？\nTrick or Treat～","zh":"欸嘿，今天是万圣节欸，一起打扮成妖怪然后去要糖果吧！不给糖就捣蛋！"},{"label":"新年","jp":"先生～明けましておめでとうございます～\n今年も美味しいスイーツのため！一緒に頑張りましょう！","zh":"老师，祝您新年快乐，为了美味的甜品，今年也一起加油吧！"},{"label":"圣诞节","jp":"わーい、先生～！クリスマスですよ！\nこういう日にはやっぱりアイスが似合いますよね！\n一緒に買いに行きましょうか？","zh":"哇，老师，圣诞节到喽，这种日子就适合吃冰淇淋对吧！我们一起去买吧！"},{"label":"春节","jp":"","zh":"虽然外面有些冷，但老师要不要和我一起吃薄荷巧克力冰激凌呀？\n毕竟今天可是新年呀！"},{"label":"中秋","jp":"","zh":"老师，今晚的月亮很圆很白呢，就像甜品一样！\n让人很有食欲！"}]},"stats":{"init":[{"name":"攻击力","value":"184"},{"name":"防御力","value":"20"},{"name":"生命值","value":"2369"},{"name":"治愈力","value":"1726"},{"name":"命