.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/10/661945.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/10/778603.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"一花（西装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/10/894038.png","url":"https://www.gamekee.com/ba/639194.html"},{"name":"★1 一花（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/43637/2025/6/24/3760.png","url":"https://www.gamekee.com/ba/tj/671014.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive~"},{"label":"卡池抽取","jp":"あれっ、迎えに来てくれたっすか？言ってくれたらこっちから向かったのに～。改めまして、トリニティ総合学園、正義実現委員会のイチカっす。よろしくっす！","zh":"诶，您来接我了吗？……跟我说一声我过来就好了嘛这样子~重新自我介绍一遍，我是崔尼蒂综合学院正义实现部的一花，请多指教这样子~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりっす、先生！今日も一日、頑張っていくっすよ～！","zh":"老师，您来啦~我今天也会加油这样子！"},{"label":"登陆2","jp":"じゃじゃーん！イチカ、登場っす！……じゃなく、先生の、登場っす！","zh":"锵锵~一花登场！……啊不对，是老师登场这样子~"},{"label":"大厅1","jp":"いや～ここの仕事は楽っすね！\nあ、簡単って意味じゃなくて、方向性の話っすよ。","zh":"呀~这里的工作真轻松。啊，我并不是说工作简单，而是指工作的方向这样子。"},{"label":"大厅2","jp":"一番大変なのは……ケンカの仲裁っすかね。お、先生もっすか？仲間っすね。","zh":"最累人的工作……应该是劝架吧这样子。哦？老师也是？那我们就是同志啦~"},{"label":"大厅3","jp":"みんなも全力でやらないで、そこそこで留めればいいのに……。","zh":"大家明明不用这么全力以赴，应付一下就好的……"},{"label":"大厅4","jp":"私も先生みたいに、背負うものができたら……\n何かに夢中になれるんすかね？","zh":"如果我也像老师一样，有需要承担的东西……我会不会也能全心投入呢？"},{"label":"大厅5","jp":"頼み事っすか？なんでもするっすよ！\n言われた通りに何かをするのは、自信あるっす！","zh":"需要我帮忙吗？\n什么忙都可以这样子。在完成别人的吩咐这件事上，我可是很有自信这样子~"},{"label":"回忆大厅1","jp":"はは！先生、こっちっす！こっち！\n見えるっすか？あーこれはただの風船っすけど……。","zh":"啊哈哈~老师，我在这这样子！这边！看得到我吗？哦，虽然这只是个普通的气球……"},{"label":"回忆大厅2","jp":"なんだか、コレ持ってると遊園地ではしゃぐ子供みたいに\n見えちゃうっすね……はは。\nあ！私のじゃないっすよ！……その、成り行きで、ちょっと。","zh":"但总觉得，只要拿着它，看起来就像在游乐园里兴奋玩耍的孩子一样呢。诶嘿嘿……\n啊，这个可不是我的哦这样子！呃……是因为别的一些原因，才会……"},{"label":"回忆大厅3","jp":"あ、あれっ……そうなんすけど……\nどうして分かるんすか？なんでだろ……？\n顔に出ちゃってたとか……？","zh":"啊，啊……嗯，是的……您是怎么知道的？到底为什么呢，难道是表情出卖了我……？"},{"label":"回忆大厅4","jp":"まぁいいや……この角度から先生を見るのは、初めてっすね。\n視点が違うと、見え方も違ってくる気がするというか……","zh":"不过也无所谓啦，我还是第一次，从这个角度看老师这样子。\n视角不同的话，看东西的方式也会跟着改变……"},{"label":"回忆大厅5","jp":"……なんだか、面白いっす。\nこの感じ、気に入ったっす！\n……はは！","zh":"……突然感觉很有意思的样子~我喜欢这种感觉的样子~诶嘿嘿~"},{"label":"咖啡馆1","jp":"おっ、ここっすか？先生のカフェ！","zh":"哦，这里就是老师的咖啡厅这样子？"},{"label":"咖啡馆2","jp":"なるほど、こういう趣味だったんすね……。","zh":"原来，老师喜欢这种风格的样子……"},{"label":"咖啡馆3","jp":"ここ、平和でいいっすね！","zh":"这里一片祥和，真不错的样子~"},{"label":"咖啡馆4","jp":"落ち着く……。","zh":"放松多啦……"},{"label":"咖啡馆5","jp":"片付けでも手伝いますか……。","zh":"稍微帮忙整理一下吧……"}],"好感度":[{"label":"好感度1","jp":"その、困りました、なんとお礼を言えば。","zh":"这可真是……不知道该怎么报答才好了。"},{"label":"好感度2","jp":"こういう時で、素直に喜んでいいんです...よね？","zh":"这种时候，老老实实地开心就……行了吧，这样子？"},{"label":"好感度3","jp":"この御恩は、いつか必ず返すっす、どういうふうに返すかは、その時までのお楽しみ、ってことで。","zh":"总有一天，我会报答这份恩情的这样子~至于具体要怎么报答……就敬请期待吧！"},{"label":"好感度4","jp":"何だか，こそばゆいっというか、妙な感じがするっす、気のせいっすかね？","zh":"总感觉，有点不自在……是我的错觉吗，这样子？"}],"战斗":[{"label":"编入队伍1","jp":"了解っす！","zh":"收到~这样子。"},{"label":"编入队伍2","jp":"私っすか？","zh":"是叫我吗？"},{"label":"拎起","jp":"あぁれ、出番、間違えたっすか","zh":"诶？顺序不对吗这样子？"},{"label":"任命队长1","jp":"いよいよ始まるっすね！","zh":"终于要开始了这样子~"},{"label":"任命队长2","jp":"やあ、やることがいっぱいっす。","zh":"哎呀，要做的事情很多的样子~"},{"label":"普通技能","jp":"うまくいったんすかね？","zh":"哦？成功了吗？"},{"label":"EX动画1","jp":"あぁあぁー、またっすか？","zh":"啊……又来这样子……"},{"label":"EX动画2","jp":"は、もう勘弁してほしいっす。","zh":"啊，真希望能适可而止这样子……"},{"label":"EX动画3","jp":"今取り込み中っす。","zh":"我现在正忙着呢这样子！"},{"label":"EX技能1","jp":"じゃ、頼んだっすよ。","zh":"那就拜托了这样子~"},{"label":"EX技能2","jp":"今度奢るんで！","zh":"回头我请客！"},{"label":"EX技能3","jp":"あとでいいっすか、今取り込みでー","zh":"可以先等等吗这样子……我现在有点忙~"},{"label":"战斗开始1","jp":"私についてこぉぉぉぉいーーこれで、いいっすか？","zh":"跟我上——\n……这样就行了吧？"},{"label":"战斗开始2","jp":"さぁ、行くっすよ。","zh":"好，出发~这样子！"},{"label":"获得BUFF","jp":"助かったっす！","zh":"多亏有你这样子，太感谢啦！"},{"label":"施放BUFF","jp":"本気で行くっすよ！","zh":"那我就认真了哦？"},{"label":"掩体","jp":"おっと","zh":"哦呀……"},{"label":"被CC1","jp":"おぉー","zh":"哦哦！"},{"label":"被CC2","jp":"あぁれえ？","zh":"诶？"},{"label":"被CC3","jp":"あ...はは","zh":"啊哈哈……"},{"label":"回避","jp":"無駄っすよ。","zh":"没用的样子~"},{"label":"队伍移动1","jp":"さっさと終わらせるっす。","zh":"快点搞定吧这样子~"},{"label":"队伍移动2","jp":"この調子で行くっすよ！","zh":"继续前进吧这样子~"},{"label":"回复","jp":"やほぉぉぉー","zh":"呀吼~"},{"label":"中途退出","jp":"ちぇっ","zh":"切……"},{"label":"战斗喊叫","jp":"やっ！","zh":"呀！"},{"label":"战斗喊叫","jp":"ほぉぉ","zh":"哦哦……？"},{"label":"战斗喊叫","jp":"よいしょっと","zh":"嘿咻！"},{"label":"角色移动","jp":"よっ！","zh":"哟！"},{"label":"战斗胜利1","jp":"皆さんほんっとすごいっすね。","zh":"大家都好厉害这样子~"},{"label":"战斗胜利2","jp":"いやー、なんとかなるもんっすね","zh":"哎呀，总算搞定了这样子~"},{"label":"关卡完成1","jp":"皆さん、お疲れ様っす！","zh":"大家都辛苦啦这样子~"},{"label":"关卡完成2","jp":"へっ、ひと段落ついたっし、帰るっすよ！","zh":"呼，事情已经告一段落，那我就回去啦~"},{"label":"战斗失败1","jp":"...ん...","zh":"哼……"},{"label":"战斗失败2","jp":"なるほど、こういう感じだったんっすね。","zh":"原来如此，是这种感觉的样子……"}],"成长":[{"label":"升级1","jp":"おぉ、くれるんっすか？ありがとうっす、先生。","zh":"哦，给我的这样子……？谢谢老师！"},{"label":"升级2","jp":"そんなことしても、別に何も出ないっすよ。","zh":"老师您给我这么多，也没用好处的哦这样子~"},{"label":"升级3","jp":"っはは、こんだけもらっちゃたら、めちゃくちゃ頑張るしかないっすね。","zh":"啊哈哈，您给我这么多，看来我必须好好努力了这样子~"},{"label":"升级4","jp":"ええと、光栄っすけど、その、へへっ。","zh":"诶……我很荣幸……不过怎么说呢……诶嘿嘿。"},{"label":"获得专武","jp":"なんというか……ええっと……こんなに良くしてもらえるのは、\nとてもありがたいのですけど、私にそんな価値があるかどうかは……。\nでも……嬉しいです。本当に。","zh":"怎么说呢……真伤脑筋。……老师如此关照我，我当然很感激。可我不知道自己是否值得老师这么对我……\n不过，我还是，很开心……真的。"}],"事件":[{"label":"学生生日","jp":"…ええと、誕生日に、わざわざここに来た理由、っすか……？\nそっすねぇ……誕生日だからこそ、来てみた……てきな？ひひ。","zh":"呃……您是问我为什么要在自己的生日这天跑到这里来？这个嘛……因为是生日，所以就……来了，这样子？嘿嘿……"},{"label":"老师生日","jp":"お誕生日おめでとうっす、\n先生！！何かいいことあったんすか？なかったら、\n今から一緒に作りにいくっす！","zh":"生日快乐老师~！今天有遇到什么好事吗？\n如果没用，现在就一起去创造吧这样子！"},{"label":"万圣节","jp":"なんか嫌な予感がするっす……。\nでもまあ、別に大丈夫じゃないっすかね？はは！","zh":"莫名，有种不妙的预感这样子……不过，嘛，应该没什么吧~诶嘿嘿。"},{"label":"新年","jp":"明けましておめでとうっす、先生！\n今年こそ、のんびりできるといいっすね！","zh":"新年快乐，老师！\n希望今年能过得轻松一点这样子！"},{"label":"圣诞节","jp":"今日は朝からバタバタしちゃってすみません！\n正義実現委員会はあっちこっちから呼ばれることが多くて……目が回るっす～！","zh":"今天从一大早开始就忙的不可开交真的很抱歉……！\n毕竟正义实现部总有这里那里的事情要处理……头都忙晕了这样子~"},{"label":"春节","jp":"","zh":"老师，新春快乐~！\n哎呀，祥和的日子真好啊……大家都很开心，也没有人闹事，应该没有正义实现部出场的机会了吧。\n……啊，不过要小心火烛这样子！"},{"label":"中秋","jp":"","zh":"听说今天是团圆的日子呢这样子~\n老师，也祝您节日快乐！……哦，这是给我的？噢，这就是叫作月饼的特色点心吗？\n谢谢您！我会分给手下的孩子们的这样子！"}],"活动":[{"label":"活动登陆1","jp":"ようこそ！こっちは準備万端っすよ！","zh":"欢迎~我已经整装待发了这样子！"},{"label":"活动登陆2","jp":"さて、ぼちぼち始めるっす！","zh":"来，差不多该开始咯这样子~！"},{"label":"活动大厅1","jp":"はい、私はここっすよ。","zh":"嗯，我在这里哦。"},{"label":"活动大厅2","jp":"ん……？さっきからどうしたんすか？","zh":"嗯？您怎么了这样子？"},{"label":"活动大厅3","jp":"そんなイタズラ、よくないっすよ～ひひっ。","zh":"开那种玩笑可不好哦~嘿嘿~"},{"label":"活动大厅4","jp":"はは、先生、そんな何度も呼ばなくても。\n私はここで常時待機してるっすよ。","zh":"诶嘿嘿，老师，不用一直叫我啦。我就在这里，随时待命的样子。"},{"label":"活动事件1","jp":"これであと半分、っすかね？","zh":"看来，还剩一半的样子？"},{"label":"活动事件2","jp":"あと少しっすね。\n手伝えるものがあれば、なんでも言ってほしいっす！","zh":"还差一点啦~\n如果有我帮得上忙的地方，请尽管说这样子~"},{"label":"活动结束","jp":"じゃ、さーっと見てみるっす！","zh":"那，我去逛一圈这样子~"},{"label":"活动任务1","jp":"おっと！なんすか、先生。\n同じこと、やり返しちゃってもいいんすか？","zh":"啊，老师您干什么呀！我可要，以其人之道还置其人之身了哦？"},{"label":"活动任务2","jp":"……今度、覚悟しておくっすよ！","zh":"下次，您可要做好心理准备哦这样子~？"},{"label":"活动任务每日结束","jp":"今日はこれで終わりっと！\nははっ！先生、この後は何するんすか？","zh":"今天就到这里吧~\n诶嘿，老师，接下来要做什么？"},{"label":"活动任务登录1","jp":"はっ！先生！ちょうどいいところに！","zh":"啊，老师~时机正好！"},{"label":"活动任务登陆2","jp":"リストのチェックっすね？\nこっちに用意してありますんで！","zh":"要检查清单是吧~我已经准备好了这样子！"},{"label":"活动任务获取1","jp":"はい！確認完了っす～！","zh":"是！检查完毕这样子~"},{"label":"活动任务获取2","jp":"それっすか？押さえておくっす！","zh":"是这样吗？那我来整理一下这样子！"}]},"stats":{"init":[{"name":"攻击力","value":"342"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2490"},{"name":"治愈力","value":"1664"},{"name":"命中值","value":"708"},{"name":"闪避值","value":"790"},{"name":"暴击值","value":"202"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1380"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"20 (4)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"7724"},{"name":"防御力","value":"108"},{"name":"生命值","value":"54,902"},{"name":"治愈力","value":"5925"},{"name":"命中值","value":"708"},{"name":"闪避值","value":"790"},{"name":"暴击值","value":"832"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1380"},{"name":"射程","valu