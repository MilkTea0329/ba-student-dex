742263.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/5/432678.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/5/102912.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/5/793248.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/5/742263.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/5/432678.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/5/394202.png","name":"零食负责人的工作","desc":"阿拜多斯的零食负责人野乃美准备的巧克力组合。为了让老师和个性鲜明的对策委员会成员都能开心享用，聚集了各式种类的巧克力。"},"ability":{"attrs":[{"name":"生命值","value":"894"},{"name":"攻击力","value":"120"},{"name":"治愈力","value":"1195"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 野宫（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/5/111989.png","url":"https://www.gamekee.com/ba/159935.html"},{"name":"NPC 野宫（1年级）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/5/680802.png","url":"https://www.gamekee.com/ba/619743.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive~!"},{"label":"卡池抽取","jp":"うんうん、やっと到着！\nよろしくお願いします、先生！","zh":"嗯嗯~终于到啦~！嘿嘿，那就请多关照啦，老师~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"うんうん～！ようこそ先生。いらっしゃるのを待ってました。","zh":"嗯嗯~！您来啦老师，我一直都在等着您呐！"},{"label":"登陆2","jp":"今日も良い一日を～先生！何でも私にお任せください。","zh":"希望今天也是美好的一天！老师，有什么问题都可以交给我哦~"},{"label":"大厅1","jp":"今日もお疲れ様でした～☆","zh":"今天也辛苦您啦"},{"label":"大厅2","jp":"うん？膝枕ですか？\nそれはもうちょっと暗くなってから。","zh":"嗯……？想在腿上躺一会？那个……等晚一点再说吧~"},{"label":"大厅3","jp":"ダメです、甘えるのは仕事が終わってからですよ～","zh":"不行哦~想撒娇，要等所有工作做完之后才可以哦~"},{"label":"大厅4","jp":"えぇとぉ…。先生、代わりにマッサージしてあげましょうか？","zh":"嗯……老师，要不……我来给您捶捶背吧~"},{"label":"大厅5","jp":"先生がそばにいると、なんだか安心します。","zh":"只要老师在身边，就会感觉很安心……"},{"label":"回忆大厅1","jp":"さあ、耳掃除の時間ですよ。\n大人しくしてくださいね、先生？","zh":"来，掏耳朵的时间到啦~请您乖乖躺好不要动哦，老师~"},{"label":"回忆大厅2","jp":"もぞもぞしちゃダメです。\n今からこれが入るんですからね？","zh":"都说了不要乱动啦~我现在要把挖耳勺伸进去啦~"},{"label":"回忆大厅3","jp":"くすぐったかったら言ってくださいね？うんうん。いい子ね、よしよし。","zh":"如果您觉得痒痒，就请说一声。嗯嗯~好孩子，乖乖哦~"},{"label":"回忆大厅4","jp":"えっと…考えてみるとこれちょっと…恥ずかしいんですけど？\nなんか先生の顔が近過ぎて…えっと…。","zh":"诶……？啊，仔细想想，心里好像……有点不好意思。因为……老师您的脸和我靠的好近，所以……\n回忆大厅5"},{"label":"回忆大厅5","jp":"これは先生だけへのサービスですから、二人だけのひ・み・つですよ？","zh":"这是为了让老师放松才特意准备的。我们两个人的小、秘、密、哦~"},{"label":"回忆大厅6","jp":"うん？そうやって横になったら先生の背中しか見えないので…\nえっと…そうしちゃうと…鼻息が…。\nダメです、先生！ちゃんと横になっててください！","zh":"啊，老师，您要是这样躺着，那我就只能看见您的后脑勺了。啊……而且这样，您的呼吸……别这样嘛老师，请您乖乖躺好！"},{"label":"咖啡馆1","jp":"楽しい～☆","zh":"好开心啊~！"},{"label":"咖啡馆2","jp":"うん？あれは何でしょう？","zh":"嗯……？那是什么呀~"},{"label":"咖啡馆3","jp":"キレイな物ですね。みんなにプレゼントしようかな…。","zh":"这个真好看呐。要不就把这个，当成礼物送给大家吧~"},{"label":"咖啡馆4","jp":"やっぱりアビドスアイドルプロジェクトは復活させましょう～☆","zh":"看来，还是有必要筹集阿拜多斯的偶像计划呀~"},{"label":"咖啡馆5","jp":"うちの子たちはみ～んな可愛いから。","zh":"因为我们家的孩子们个个都很可爱嘛~"}],"好感度":[{"label":"好感度1","jp":"先生との距離がさらに近くなった気がします。","zh":"感觉和老师的距离更近啦~！"},{"label":"好感度2","jp":"なんだか……ドキドキします。","zh":"感觉，心头小鹿乱撞……"},{"label":"好感度3","jp":"先生、見ていてください。私、一生懸命頑張りますから。","zh":"老师，请您看着我。我会……拼命努力的！"},{"label":"好感度4","jp":"はい、わかりました先生。それでは……あれ、してあげましょうか？","zh":"好的老师，我明白啦~！那……我就帮您，做那件事情吧！"}],"战斗":[{"label":"编入队伍1","jp":"はい！お任せください。","zh":"好的，请交给我吧~"},{"label":"编入队伍2","jp":"ええ、先生をお手伝いします。","zh":"嗯！我会帮老师忙的！"},{"label":"拎起","jp":"あぁ、私を選んでくださるのですか？","zh":"啊……您选的，是我嘛？"},{"label":"任命队长1","jp":"さぁみなさん、よろしくお願いしますー。","zh":"好啦各位，请多多关照哦~"},{"label":"任命队长2","jp":"うんうん、みんなで頑張りましょうね。","zh":"嗯嗯~大家一起加油吧！"},{"label":"EX动画1","jp":"うんうん、準備かんりょー！","zh":"嗯嗯~准备好啦！"},{"label":"EX动画2","jp":"あら、私の番ですねー？","zh":"哎呀，轮到我了呀~"},{"label":"EX动画3","jp":"ノノミー、いきまーす！","zh":"野宫，出击！"},{"label":"EX技能1","jp":"お仕置きの時間ですよー？","zh":"惩罚的时间到啦！"},{"label":"EX技能2","jp":"全弾はっしゃー！","zh":"全弹发射~！"},{"label":"EX技能3","jp":"覚悟してくださいねー？","zh":"还请想开点哦~"},{"label":"战斗开始1","jp":"今日もファイト！","zh":"今天也要加油！"},{"label":"战斗开始2","jp":"最善を尽くしますぅー。","zh":"我会做到最好的！"},{"label":"获得BUFF","jp":"","zh":"-"},{"label":"施放BUFF","jp":"","zh":"-"},{"label":"被CC1","jp":"うぅ……","zh":"啊……"},{"label":"被CC2","jp":"おっとっと……！","zh":"哎哟哟……"},{"label":"被CC3","jp":"ひゃぁ！","zh":"诶！"},{"label":"回避","jp":"-","zh":"-"},{"label":"队伍移动1","jp":"-","zh":"-"},{"label":"队伍移动2","jp":"-","zh":"-"},{"label":"回复","jp":"うわぁ、さいこー！","zh":"啊~好棒~！"},{"label":"中途退出","jp":"うぅ……ごめんなさい……","zh":"啊……对不起……"},{"label":"战斗喊叫","jp":"あ？髪が乱れしちゃいました…","zh":"啊……？头发乱了……"},{"label":"战斗喊叫","jp":"ふふん、では、真面目に行きますよー！","zh":"……那我要认真了哦~"},{"label":"战斗喊叫","jp":"いいですよ。準備は終わりました","zh":"可以啦，我准备好啦~"},{"label":"角色移动","jp":"-","zh":"-"},{"label":"战斗胜利1","jp":"ふふーん、最高の戦いでしたー。","zh":"……好精彩的战斗啊~"},{"label":"战斗胜利2","jp":"みんなー、お疲れさまでしたー。","zh":"各位，辛苦啦~"},{"label":"关卡完成1","jp":"先生のおかげです！","zh":"多亏了老师！"},{"label":"关卡完成2","jp":"最高の指揮でした！","zh":"指挥太精彩啦~！"},{"label":"战斗失败1","jp":"うーん……ちょっと無理みたい……","zh":"啊……好像有点不行了……"},{"label":"战斗失败2","jp":"惜しかったねー、次こそは絶対に。","zh":"有点可惜……下次，一定！"}],"成长":[{"label":"升级1","jp":"先生、いつも気にかけてくださって嬉しいです。","zh":"老师，您一直这么关心我，我很开心！"},{"label":"升级2","jp":"ふふ、一歩前進しました！","zh":"……又前进了一步！"},{"label":"升级3","jp":"私、もっと頑張ります！","zh":"我，会更加努力的！"},{"label":"升级4","jp":"今この瞬間にも、成長してますから！","zh":"每分每秒，我都在成长呢！"},{"label":"获得专武","jp":"うんうん。力というのは諸刃の剣だと思いますけど、\n先生とみんなの為なら必要だと思います。\n大切に使うから、見守ってくださいね。先生。","zh":"嗯嗯，我认为力量是把双刃剑。那为了老师和大家，力量是必须的。我会抢先使用它的，老师，就请您见证吧。"}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日なんです。\n先生、私へのプレゼントは用意してくれました？\nえぇ、何でも大丈夫です。先生が選んだ物なら。","zh":"天是我的生日~老师，你准备好生日礼物了嘛？嗯……只要是老师您送的，什么都可以啦~"},{"label":"老师生日","jp":"お誕生日おめでとうございます！\n先生がアビドスに来てなかったら…。\nなんて想像もつきません！\n先生！来てくださって、本当にありがとうございます！","zh":"祝您生日快乐！如果老师没来阿拜多斯的话，我真的没办法想象会变成什么样……老师，真是太感谢您能来这里啦！"},{"label":"万圣节","jp":"うわっ！びっくりした！\n先生～あまり驚かさないでくださいよ～","zh":"诶？！吓我一跳……老师~！请您别这么吓我好不好"},{"label":"新年","jp":"明けましておめでとうございます。\n今年は…先生と…ふふっ☆","zh":"祝您新年快乐！今年，我要和老师一起……诶嘿嘿~"},{"label":"圣诞节","jp":"先生、新年のためにショッピングにでも行きましょう？\n私がサンタクロースになってあげますから～☆","zh":"老师，新年快到了。一起去买些年货吧，我会做您的圣诞老人的~"},{"label":"春节","jp":"","zh":"师~新春快乐！我准备去给对策委员会的大家，买过年吃的零食。要不要一起去呢~"},{"label":"中秋","jp":"","zh":"啊，是团圆的日子呢。希望今后也能一直和老师，还有阿拜多斯的大家，待在一起！"}]},"stats":{"init":[{"name":"攻击力","value":"290"},{"name":"防御力","value":"80"},{"name":"生命值","value":"2378"},{"name":"治愈力","value":"1495"},{"name":"命中值","value":"99"},{"name":"闪避值","value":"198"},{"name":"暴击值","value":"198"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1408"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"50 (5)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"7959"},{"name":"防御力","value":"442"},{"name":"生命值","value":"49862"},{"name":"治愈力","value":"5818"},{"name":"命中值","value":"299"},{"name":"闪避值","value":"198"},{"name":"暴击值","value":"828"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1408"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"50 (5)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"567"},{"name":"生命值","value":"2786"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[{"name":"攻击力","value":"500"},{"name":"命中值","value":"200"}]},"abi