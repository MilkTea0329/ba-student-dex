s/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"932"},{"name":"攻击力","value":"51"},{"name":"治愈力","value":"213"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/9/201052.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/9/94216.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 千夏","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_226/h_226/829/43637/2025/5/9/997812.png","url":"https://www.gamekee.com/ba/58280.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"過ぎたるは猶及ばざるが如し……\n今日だけは仕事を忘れて、私とひと休み、しませんか？","zh":"俗话说，过犹不及，今天就先忘掉工作，和我一起好好休息怎么样？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生お待ちしておりました。","zh":"老师，您来了，我正等着您呢。"},{"label":"登陆2","jp":"お疲れ様です、先生まずはバイタルチェックから始めましょう。","zh":"老师，您辛苦了，先来检查一下生命体征吧。"},{"label":"大厅1","jp":"休憩中は業務のことを忘れるようにしているのですが……\nそう思えば思うほど、脳裏に仕事のことが浮かんで……","zh":"休息的时候，我尽量让自己不去想工作，但越是如此，就越会想起工作。"},{"label":"大厅2","jp":"何だかここでこのような格好をしていると、その……\n少し、緊張してしまいますね。","zh":"在这里穿着这样的衣服，总觉得有点紧张。"},{"label":"大厅3","jp":"時には休息も必要……私もですが、先生にも伝えておきたいですね。","zh":"偶尔的休息也是必要的，老师的这句话，我想也应该适用于老师自己。"},{"label":"大厅4","jp":"温泉……。私には縁がないところだと思っていました。","zh":"温泉啊，我还以为自己和这种地方没什么缘分呢。"},{"label":"大厅5","jp":"自身の体調管理もまた、お仕事の一部ですよね。\n……少し、疎かにしてしまっていたかもしれません。","zh":"保证自己的身体健康也是工作的一部分，我好像有点疏忽了。"},{"label":"回忆大厅1","jp":"こんなに豪華な温泉をふたりだけでだなんて……\n人生、何が起こるか分からないものですね。","zh":"居然可以两人独享这么豪华的温泉，人生有些时候真是难以预料啊。"},{"label":"回忆大厅2","jp":"いつかは……もしかしたら、こんな未来も……","zh":"未来有一天，也许真的会。"},{"label":"回忆大厅3","jp":"あ、い、いえ！\n気にしないでください……！","zh":"不，没什么，请不用在意。"},{"label":"回忆大厅4","jp":"いえその、もし本当にそうなれたら、と……\nそんな素敵な日々のことを、想わないわけでは、ないのですが…………。","zh":"其实我之前也不是没想过。像今天这样美好的日子，将来是不是会变成现实？"},{"label":"回忆大厅5","jp":"生徒と先生で、今は、十分すぎるほど幸せなんです。本当に……","zh":"不过现在我打心底觉得，能和老师这样待在一起，已经足够幸福了。"},{"label":"咖啡馆1","jp":"身体が少しポカポカします……","zh":"身上有点热乎乎的。"},{"label":"咖啡馆2","jp":"頭がスッキリした感じです。","zh":"我感觉头脑轻松畅快。"},{"label":"咖啡馆3","jp":"この格好、もしかして浮いてますか……？","zh":"这身打扮是不是有点太大胆了？"},{"label":"咖啡馆4","jp":"みなさん、楽しそうですね","zh":"大家都很开心呢。"},{"label":"咖啡馆5","jp":"どこかに、座って休めそうな場所は……？","zh":"有没有可以坐下来休息一会儿的地方呢？"}],"好感度":[{"label":"好感度1","jp":"衣服を変えると、やはり気持ちにも影響が出るのでしょうか？少し、困りましたね。","zh":"换了衣服，好像心情也有点被影响了，感觉有点为难呢。"},{"label":"好感度2","jp":"もう少しだけ、ここで、休んでいきませんか？","zh":"可以再这样休息一会儿吗？"},{"label":"好感度3","jp":"あまりだらけるわけにはいかないのですが、先生と一緒だと、つい…","zh":"我不能太懒散，但只要和老师在一起，不知不觉就。"},{"label":"好感度4","jp":"先生はちゃんと休息は取られていますか？少しでいいですから、私とひと休みしません？","zh":"老师有好好休息吗？我们一起休息一下，就一会儿也可以的。"}],"战斗":[{"label":"编入队伍1","jp":"先生のためなら、いつでも力になりますよ。","zh":"为了老师，我随时都乐意帮忙。"},{"label":"编入队伍2","jp":"はい、お任せください、先生。","zh":"好的，老师就交给我吧。"},{"label":"拎起","jp":"え、えっと、その……。","zh":"那个。"},{"label":"任命队长1","jp":"始めましょう。","zh":"开始吧。"},{"label":"任命队长2","jp":"ご心配なさらず。私がいますから。","zh":"您不必担心，有我在呢。"},{"label":"普通技能","jp":"バイタル、問題ありません。進撃してください。","zh":"生命体征一切正常。出击。"},{"label":"EX动画1","jp":"まったく…。","zh":"真是的。"},{"label":"EX动画2","jp":"発見しました。","zh":"发现了。"},{"label":"EX动画3","jp":"はぁ…。","zh":"-"},{"label":"EX技能1","jp":"仕方ありませんね…。","zh":"没办法。"},{"label":"EX技能2","jp":"行きます。","zh":"我要上了。"},{"label":"EX技能3","jp":"お任せください。","zh":"请交给我吧。"},{"label":"战斗开始1","jp":"前線でも、やるべきことは変わりません。","zh":"哪怕是在前线，我要做的事也不会改变。"},{"label":"战斗开始2","jp":"この位置での支援は、少し不思議な感じですね。","zh":"在这个位置支援，感觉有点新奇呢。"},{"label":"获得BUFF","jp":"期待に応えてみせます！","zh":"我一定不辜负您的期待。"},{"label":"施放BUFF","jp":"ここからです。","zh":"现在才是开始。"},{"label":"掩体","jp":"隠れます。","zh":"隐蔽。"},{"label":"被CC1","jp":"-","zh":"-"},{"label":"被CC2","jp":"-","zh":"-"},{"label":"被CC3","jp":"-","zh":"-"},{"label":"回避","jp":"無駄です。","zh":"没用的。"},{"label":"队伍移动1","jp":"行きましょう。","zh":"出发吧。"},{"label":"队伍移动2","jp":"気を緩めないように、進みましょう。","zh":"不要松懈，继续前进。"},{"label":"回复","jp":"支援、ありがとうございます。","zh":"多谢支援。"},{"label":"中途退出","jp":"す、すみません……。","zh":"对不起。"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"角色移动","jp":"今行きます。","zh":"我这就出发。"},{"label":"战斗胜利1","jp":"皆さん、お疲れさまでした。","zh":"大家辛苦了。"},{"label":"战斗胜利2","jp":"引き続き、この調子で進んでいきましょう。","zh":"继续保持这个势头吧。"},{"label":"关卡完成1","jp":"しっかりとした準備の賜物です。","zh":"这是充分准备的结果。"},{"label":"关卡完成2","jp":"先生の指揮のおかげです。ありがとうございます。","zh":"多亏了老师的指挥，谢谢。"},{"label":"战斗失败1","jp":"もう一度、一からチェックしないと","zh":"再来一次，从头确认一遍。"},{"label":"战斗失败2","jp":"私のミスです。すみません…","zh":"是我的疏忽，对不起。"}],"成长":[{"label":"升级1","jp":"いつもありがとうございます、先生。","zh":"老师一直以来都很感谢您。"},{"label":"升级2","jp":"先生からの期待に、必ず応えてみせます。","zh":"我一定会回应您的期待。"},{"label":"升级3","jp":"えっと、嬉しいのですが、今気を緩めるわけには…","zh":"虽然我很开心，但现在还不是放松的时候。"},{"label":"升级4","jp":"どうして、こんな私に？","zh":"为什么……\n我这是何德何能？"},{"label":"获得专武","jp":"この重みに、責任を感じます……。\nきちんと応えられるように、ベストを尽くしますね。","zh":"我能感受到责任重大，为了好好报答您的信任，我一定全力以赴。"}],"事件":[{"label":"学生生日","jp":"え……？私の誕生日、ですか……？\nそうですね……先生とこうしていられることが、私にとってはプレゼントです。","zh":"什么，我的生日？\n这样，能这样见到老师已经是很好的礼物了。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\n特別な日ですから、その……\n先生のためになるのでしたら、なんでも……","zh":"老师，祝您生日快乐。今天是个特别的日子，只要是为了您什么，什么都可以。"},{"label":"万圣节","jp":"にぎやかな日ですね。先生。\n飴……は無いのですが、温泉卵などいかがでしょう……？","zh":"今天可真热闹啊，老师，糖果倒是没有，但您觉得温泉蛋怎么样？"},{"label":"新年","jp":"今年も一年、よろしくお願いします。先生。\nこれからも、その……一緒にいてくださると、嬉しいです。","zh":"今年也请多多关照。老师，如果以后也能一直和您在一起，那我会很开心的。"},{"label":"圣诞节","jp":"クリスマス、ですね。\nえ？寒くないの、ですか……？\nふふっ……はい、身体は温まっているので大丈夫です。","zh":"圣诞节到了，什么？您问我冷不冷不冷的，我的身子很暖和。"},{"label":"春节","jp":"","zh":"老师，恭祝您新春快乐。要来温泉里洗净去年的疲惫吗？"},{"label":"中秋","jp":"","zh":"不仅晴朗的夜空中有一轮圆月，水汽氤氲的温泉中也有。老师您看见了吗？"}],"活动":[{"label":"活动登陆1","jp":"はい、準備はできています。","zh":"老师，我准备好了。"},{"label":"活动登陆2","jp":"サポートはお任せください。","zh":"辅助工作就请交给我吧。"},{"label":"活动大厅1","jp":"せ、先生……！？\nぎょ、業務に集中してください……！","zh":"老师请专心工作。"},{"label":"活动大厅2","jp":"ここで無意味に時間を過ごすのは、その……\nい、いえ、私は嫌ではないのですが……","zh":"在这里毫无意义的消磨时间，有点虽然我也不讨厌。"},{"label":"活动大厅3","jp":"何をお手伝いすればよろしいですか、先生？","zh":"老师有什么可以帮上忙的吗？"},{"label":"活动大厅4","jp":"じょ、冗談はやめてください……","zh":"请不要开玩笑。"},{"label":"活动事件1","jp":"そろそろ追い込みをかけても良いタイミングかもしれませんね、先生。","zh":"老师，是时候加快速度了。"},{"label":"活动事件2","jp":"ラストスパートですね、お手伝いしますよ。","zh":"是最后冲刺了，我来帮您。"},{"label":"活动结束","jp":"後片付けは、準備と同じくらい大切ですからね。","zh":"善后和准备同样重要。"},{"label":"活动1","jp":"ここの温泉、どうしてこんなに素敵なのに…\n料理だけは…あ","zh":"为什么这么豪华的温泉饭菜却这么便宜呢？"},{"label":"活动2","jp":"こうしてこんなに美しい庭園を目にすると、それだけで心が落ち着けますね。","zh":"欣赏着这么美丽的庭院，感觉心情都舒畅了。"}]},"stats":{"init":[{"name":"攻击力","value":"136"},{"name":"防御力","value":"18"},{"name":"生命值","value":"2296"},{"name":"治愈力","value":"1791"},{"name":"命中值","value":"108"},{"name":"闪避值","value":"1002"},{"name":"暴击值","value":"217"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"908"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"10 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"2911"},{"name":"防御力","value":"100"},{"name":"生命值","value":"67953"},{"name":"治愈力","value":"8248"},{"name":"命中值","value":"108"},{"name":"闪避值","value":"1452"},{"name":"暴击值","value":"517"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"908"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"10 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"135%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"267"},{"name":"生命值","value":"3216"},{"name":"治愈力","value":"977"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"徽章","grade":"T10","attrs":[{"name":"生命值","value":"16000"},{"name":"受恢复率","value":"3500"},{"name":"生命值","value":"25%"}]},{"slot":"3号装备","name":"护符","grade":"T10","attrs":[{"name":"暴击抵抗值","value":"420"},{"name":"暴伤抵抗率","value":"3000"},{"name":"暴击值","value":"300"}]}],"giftDetail":{"t1Value":[]