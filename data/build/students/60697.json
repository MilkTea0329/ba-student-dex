s://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/555949.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"瞬","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/269505.png","url":"https://www.gamekee.com/ba/68522.html"},{"name":"雪玲(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/21663711mqrzl03w.png","url":"https://www.gamekee.com/ba/tj/709617.html"},{"name":"瞬","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/269505.png","url":"https://www.gamekee.com/ba/68522.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"こっ、子供扱いしないでください……！\nこれでも心は変わらず、みんなのお姉さんですから！","zh":"请不要把我当作小孩子，即使身体变小，心理层面上我还是大家的姐姐哦"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、です！先生！今日の授業もよろしくお願いします！","zh":"老师您来啦，今天的课程也拜托您啦。"},{"label":"登陆2","jp":"むにゃ……んん……\nラムレーズン入りの苺チョコは、ちょっと……。","zh":"……藏着葡萄干的草莓巧克力。\n登陆3"},{"label":"登陆3","jp":"……んん、あっ、わわっ！先生！？\nい、居眠りなんて、してませんよ……？","zh":"老师，我没打瞌睡。\n大厅1"},{"label":"大厅1","jp":"大人しく、良い子にして待ってますから","zh":"我会像个好孩子一样乖乖等着老师。\n大厅2"},{"label":"大厅2","jp":"はい！こんな体ですが私はシュンですよ！","zh":"虽然变成这个样子了，不过我还是瞬啊。"},{"label":"大厅3","jp":"先生、先生！「ロジス」のラムレーズンチョコを頂いてしまいました！\nい、一個だけ、今食べても良いですか……？","zh":"师，我收到了罗杰斯的朗姆葡萄干巧克力，我能尝一块吗？就一"},{"label":"大厅4","jp":"食事前だからおやつはダメ……？\nで、でも……こんなに美味しそうなのに……。","zh":"饭前不能吃零食吗？可是看起来这么好吃。"},{"label":"大厅5","jp":"……い、一個だけなので……ダメ、ですか？","zh":"就吃一个，行吗？"},{"label":"回忆大厅1","jp":"この中はほとんど変わっていませんね。私が書いた自分との約束も、あの時のものです。","zh":"这个地方一点都没变呢。\n我写在墙上的，与自己的约定也都还在。"},{"label":"回忆大厅2","jp":"懐かしい…この約束今こうしてみってみるとほとんど守ることができましたね","zh":"好怀念呐。现在看来，这些约定其中大部分都已经做到啦。"},{"label":"回忆大厅3","jp":"では、せっかくですし、今度はここに将来の夢でも書いてみましょうか！","zh":"机会难得，要不要在这里写下对未来的愿望"},{"label":"回忆大厅4","jp":"そ、それは教えられません。秘密です。","zh":"不能告诉老师，因为这是秘密。"},{"label":"回忆大厅5","jp":"大人には教えられない子供だけの秘密…ですから！","zh":"不能告诉大人的只属于小孩子的秘密。"},{"label":"咖啡馆1","jp":"（この視線で見るカフェは、何だか不思議ですね……）","zh":"从这个角度看咖啡厅感觉很新奇呢。"},{"label":"咖啡馆2","jp":"うーん……この身長だと、みんなにとっても少し不便かもしれません。","zh":"这个高度对梅花园的孩子们来说应该不太方便吧"},{"label":"咖啡馆3","jp":"（も、もう少し……背伸びをすれば、何とか……","zh":"只要踮起脚就一定能碰到。"},{"label":"咖啡馆4","jp":"んん……眠くなってきました……","zh":"好困呐。"},{"label":"咖啡馆5","jp":"今はせっかくこういう身体ですし…お昼寝、しても良いですよね？","zh":"因为是小孩子，所以午睡一会儿也没关系吧。"}],"好感度":[{"label":"好感度1","jp":"この体だったら……いくら泣いても変に思われないですよね……？えへへ…","zh":"现在这个身体不管怎么撒娇都不会奇怪吧。"},{"label":"好感度2","jp":"今はこんな体ですが、よろしくお願いします。","zh":"虽然是这副模样，但还是请多关照啦。"},{"label":"好感度3","jp":"えへへ、また一緒に遊びましょうね、先生！","zh":"下次再一起玩吧，老师"},{"label":"好感度4","jp":"あ、もう帰られてしまうんですか……？も、もう少し、遊びません？","zh":"这么快就要走了，要不要再玩一会儿？"}],"战斗":[{"label":"编入队伍1","jp":"面倒を見ることにはなれていますので！","zh":"我很擅长照顾人哦。"},{"label":"编入队伍2","jp":"準備はもうできていますよ～。","zh":"我准备好啦。"},{"label":"拎起","jp":"わぁ、すごい！高いです～！","zh":"哇，好厉害，好高啊。"},{"label":"任命队长1","jp":"さて、どこに隠れているのでしょうか？","zh":"躲在哪里了呢？"},{"label":"任命队长2","jp":"鬼ごっこなら任せてください。","zh":"捉迷藏就交给我吧。"},{"label":"普通技能","jp":"よいしょ！","zh":"好咧！"},{"label":"EX动画2","jp":"お、重いです…。","zh":"好重"},{"label":"EX动画3","jp":"お、落としちゃいそうです…。","zh":"好像要掉了。"},{"label":"EX技能1","jp":"わぁ！びっくりしました……。","zh":"吓了我一跳。"},{"label":"EX技能2","jp":"わっ、わぁ！","zh":"哇，哇！"},{"label":"EX技能3","jp":"ば、ばーん！","zh":"砰，砰—！"},{"label":"战斗开始1","jp":"えへへ、遠足の時間ですね！","zh":"现在是郊游时间。"},{"label":"战斗开始2","jp":"さあ、出発しましょ！","zh":"好，出发吧。"},{"label":"获得BUFF","jp":"ありがとうございます。","zh":"谢谢啦。"},{"label":"施放BUFF","jp":"体がごっと軽くなりました！","zh":"身体轻松多啦。"},{"label":"掩体","jp":"隠れます。","zh":"藏起来。"},{"label":"被CC1","jp":"あっ！","zh":"啊！"},{"label":"被CC2","jp":"いたっ！","zh":"好疼。"},{"label":"被CC3","jp":"むー、私だって怒るんですからね。","zh":"我可要生气啦。"},{"label":"回避","jp":"えへへ、このサイズも時には便利ですね。","zh":"这个身体有时也很方便呐。"},{"label":"队伍移动1","jp":"移動しましょう。","zh":"继续前进。"},{"label":"队伍移动2","jp":"えっと…この道にあっていますね。","zh":"是这条路吗？"},{"label":"回复","jp":"ありがとうございます！","zh":"谢谢。"},{"label":"中途退出","jp":"もう少し、体が大きければ…。","zh":"如果个子再高一点…"},{"label":"战斗喊叫","jp":"まずは一発。","zh":"先来一发。"},{"label":"战斗喊叫","jp":"行きます。","zh":"去吧"},{"label":"战斗喊叫","jp":"やー！","zh":"呀！"},{"label":"角色移动","jp":"ここはもう大丈夫そうです","zh":"这里已经安全啦。"},{"label":"战斗胜利1","jp":"みんな良い子ばかりですね！","zh":"大家都是好孩子。"},{"label":"战斗胜利2","jp":"また一緒に遊びましょうね。","zh":"下次再一起玩吧。"},{"label":"关卡完成1","jp":"「よくできました」のスタンプを押してあげます。ぽんっ！","zh":"奖励一个小红花印章。"},{"label":"关卡完成2","jp":"銃を使った後は、手洗いも忘れちゃダメですよ。","zh":"使用枪支后不要忘了洗手哦。"},{"label":"战斗失败1","jp":"うぅ…。すみません…。","zh":"对不起。"},{"label":"战斗失败2","jp":"私の…ミスです…！","zh":"是我的问题。"}],"成长":[{"label":"升级1","jp":"あれ？背が少し伸びたような……？","zh":"好像长高了一点。"},{"label":"升级2","jp":"ふふっ、ありがとうございます、先生！","zh":"哈哈，谢谢你，老师。"},{"label":"升级3","jp":"また一つ、新しいことを知りました！","zh":"我又学到了新知识。"},{"label":"升级4","jp":"こういう成長ならいつでも歓迎です！","zh":"像这样的成长，我随时欢迎"},{"label":"获得专武","jp":"今の私には少し大きい気がしますが…でも、やっぱりこの武器が一番です！","zh":"虽然对于现在的我来说有点大，不过还是最熟悉这把武器啊。"}],"事件":[{"label":"学生生日","jp":"あっ、今日って私の誕生日、でしたっけ……？\nすっかり忘れてしまっていました……。えっと、ということは今年で……この場合、いくつになるのでしょうか？","zh":"今天是我的生日吗？完全忘了这回事呢。\n对了，这么说来，现在的我算是几岁呢？"},{"label":"老师生日","jp":"ハッピーバースデートゥーユー♪ハッピーバースデートゥハッピーバースデーディアしぇっ……\nううっ、噛んでしまいました……。ーユー♬","zh":"happy birthday to you~\nhappy birthday to you~\nhappy birthday dear 老……\n不小心咬到舌头了。"},{"label":"万圣节","jp":"ふふ、今の私なら飴をもらえそうですね！","zh":"今年我也能收到糖果啦。"},{"label":"新年","jp":"あけましておめでとうございます、先生！以前行った神社へ、甘酒を飲みに行きましょう！","zh":"新年快乐，老师去前面的庙会，一起喝点甜酒吧。"},{"label":"圣诞节","jp":"サンタさんは……私のところにはきっと来てくれないですよね……。それでも大丈夫です。今年のクリスマスは、先生と一緒ですから！","zh":"圣诞老人不会来找我吧？\n不过没关系，因为今年的圣诞节可以跟老师在一起。"},{"label":"春节","jp":"","zh":"老师，新春快乐，新的一年万事顺意，我也会一直陪在老师身边的。"},{"label":"中秋","jp":"","zh":"中秋节的月饼，只吃一块就感觉饱了呢。不过这样倒是不用担心热量了。"}],"活动":[{"label":"活动登陆1","jp":"お散歩にぴったりのお天気ですねっ。","zh":"天气真好，正适合去散步。"},{"label":"活动登陆2","jp":"今日は私が、山海経を案内しますねっ！","zh":"今天，由我来亲自为您介绍山海经！"},{"label":"活动大厅1","jp":"しゅ、シュンお姉さんはどこに行ったんでしょうね…？","zh":"瞬，瞬姐姐去哪里了呢……"},{"label":"活动大厅2","jp":"（ま、まだバレてませんよね……？）","zh":"（应该……还没被发现吧？）"},{"label":"活动大厅3","jp":"先生、あそこに美味しそうなお菓子がいっぱいあります！","zh":"老师，那边有很多看起来就很好吃的饼干诶！"},{"label":"活动大厅4","jp":"（ふふっ。この身体も、それほど悪くないですね）","zh":"（呵呵，变成小孩子或许也不错……）"}]},"stats":{"init":[{"name":"攻击力","value":"512"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2514"},{"name":"治愈力","value":"