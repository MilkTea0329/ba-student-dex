04/829/43637/2025/4/30/398191.png","url":"https://www.gamekee.com/ba/628376.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー アーカイブ。","zh":"Blue archive."},{"label":"卡池抽取","jp":"ふぁあ～…あ、先生\nせっかくなんだし、のんびり行こうよ～","zh":"老师，难得来一次，别着急嘛，放轻松点啦。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようよう、先生。お疲れ様。今日ぐらいのんびりしない？","zh":"哎呀呀，老师辛苦啦，今天就轻松一点过吧。"},{"label":"登陆2","jp":"先生お帰り。ん？私？ずっとここで休憩してたよ～","zh":"老师你来啦，咦？我一直在这休息。"},{"label":"大厅1","jp":"まさかこの格好で、働かせるつもりかー？なんて","zh":"不会想让我穿成这样去工作吧，真的假的？"},{"label":"大厅2","jp":"相変わらず先生はお忙しいそうだね。…これを手伝えばいい？","zh":"老师还是这么忙，这个要我帮帮你吗？"},{"label":"大厅3","jp":"んー？まあ、確かに休みたい気持ちはやまやまだけど…先生が働いているなのに、その横で休むのもねぇ？","zh":"我确实很想歇着，但是老师在工作，我在旁边摸鱼，好像有点。"},{"label":"大厅4","jp":"疲れたらいつでも言ってね、先生。枕代わりに、この浮き輪とかどう？","zh":"老师累了说一声哦，用这个游泳圈当枕头怎么样？"},{"label":"大厅5","jp":"今日はどんなことが起きるのかな～？","zh":"今天会有什么事儿呢？"},{"label":"回忆大厅1","jp":"いやぁ、たまんないねぇ……これぞまさに楽園……","zh":"这谁顶得住啊，这里简直就是天堂。"},{"label":"回忆大厅2","jp":"涼しい日陰……心地よい海風……穏やかな波の音……\nいやぁ、ここに来られて良かった～\n最高だねぇ、まるで夢みたいな場所だー……","zh":"凉爽的树荫，舒适的海风，还有舒缓的海浪声。这里真是来对了，太棒了，简直就像做梦一样。"},{"label":"回忆大厅3","jp":"……先生もそんなことにずっと立ってないで、横になったら？\nあんまり広くないけど、どう？いい感じだよ～？","zh":"老师也别在那里傻站着了，来和我一起躺着。\n虽然有点挤，要试试吗？很舒服的哦。"},{"label":"回忆大厅4","jp":"うへー、なるほどそう来たか……。\nまあ、何となく予想はしてたけどね。","zh":"就知道你会这么说。\n也算在我意料之中吧。"},{"label":"回忆大厅5","jp":"別にいいのに……まあ、そういうところ嫌いじゃないけど……えへへ","zh":"明明没关系的，不过我也不讨厌老师这一点。"},{"label":"咖啡馆1","jp":"微笑ましい光景だねぇ～まあ、余裕があるのはいいことだ。","zh":"真好啊，大家平平安安就是福啊。"},{"label":"咖啡馆2","jp":"さ~て~どこに横になれるところは？","zh":"该找个地方躺下眯一会儿喽。"},{"label":"咖啡馆3","jp":"どこか～寛ぎそうな場所は～","zh":"那儿能舒舒服服的休息一下呢。"},{"label":"咖啡馆4","jp":"お？良さそうだね","zh":"唔？看起来很不错。"},{"label":"咖啡馆5","jp":"何これ？","zh":"这是什么？"}],"好感度":[{"label":"好感度1","jp":"まったくもう…先生はいつもそういうことばっかり","zh":"哎呀，老师老是这样。"},{"label":"好感度2","jp":"いや、おじさんはさあ…お、今のなし、素直に受け取れよ。ありがとうね、先生。","zh":"大叔我呀，饿，算了，恭敬不如从命，那我就收下了。老师，谢谢你。"},{"label":"好感度3","jp":"おじさんに一体何ができるんだろうね","zh":"大叔，我到底还能干点啥呢？"},{"label":"好感度4","jp":"何かあったら、いつでも言ってね。私も先生のことを手伝いたいからさあ","zh":"有什么事随时跟我说，我也想帮老师。"}],"战斗":[{"label":"编入队伍1","jp":"うへへ、ここでも出番かぁ","zh":"唔嘿嘿，怎么到了这儿也要打？"},{"label":"编入队伍2","jp":"先生がそういうなら、仕方ないなぁ","zh":"既然老师这么说，那就没办法了。"},{"label":"拎起","jp":"おぉ…？あれ、間違えた？","zh":"哦~你是不是搞错了？"},{"label":"任命队长1","jp":"んじゃ、スパッと終わらせてこようか～","zh":"那就速战速决搞定吧。"},{"label":"任命队长2","jp":"じゃ、行ってみよう～","zh":"那出发喽。"},{"label":"普通技能","jp":"こ～んなのはどうかな～？","zh":"尝尝这个。"},{"label":"EX动画1","jp":"せっかくなんだし～","zh":"来都来了。"},{"label":"EX动画2","jp":"ほらほら、そんな固くならないで","zh":"好啦，别崩这么紧嘛。"},{"label":"EX动画3","jp":"まあまあ～","zh":"好热好热"},{"label":"EX技能1","jp":"もっと気楽に～","zh":"再放松一点。"},{"label":"EX技能2","jp":"楽しんで行こう～","zh":"愉快的出发吧。"},{"label":"EX技能3","jp":"どう？涼しい～？","zh":"怎么样？很凉快吧。"},{"label":"战斗开始1","jp":"早く終わらせて、休むとしようか～","zh":"快点完事去休息吧。"},{"label":"战斗开始2","jp":"じゃ、ついてきて","zh":"那就跟着我吧。"},{"label":"获得BUFF","jp":"ありがとう","zh":"谢谢喽。"},{"label":"施放BUFF","jp":"さて、じゃやりますか","zh":"好，那就动真格了。"},{"label":"被CC1","jp":"ほっ！","zh":"-"},{"label":"被CC2","jp":"かー","zh":"-"},{"label":"被CC3","jp":"いたたた…","zh":"-"},{"label":"回避","jp":"無駄無駄～","zh":"没门。没门儿。"},{"label":"队伍移动1","jp":"さーて、次々～","zh":"好，继续前进。"},{"label":"队伍移动2","jp":"さあ、次へ行こう","zh":"向下个目标前进。"},{"label":"回复","jp":"わぁ、ありがとう","zh":"谢谢你。"},{"label":"中途退出","jp":"うへへ、調子に乗りすぎちゃったかな…","zh":"是不是冲过头了？"},{"label":"战斗喊叫","jp":"はっ！","zh":"-"},{"label":"战斗喊叫","jp":"ふっ！","zh":"-"},{"label":"战斗喊叫","jp":"やぁ！","zh":"-"},{"label":"角色移动","jp":"よいしょっと","zh":"嘿咻"},{"label":"战斗胜利1","jp":"みんなのおかげだよ～","zh":"多亏大伙啦。"},{"label":"战斗胜利2","jp":"ありがとうねぇ。先生、おかげで楽勝だったよ","zh":"老师，谢了，有你在才能这么轻松。"},{"label":"关卡完成1","jp":"よーし！じゃ、またのんびりにしていいよねぇ","zh":"好耶，那现在可以去休息了吧。"},{"label":"关卡完成2","jp":"よかった、よかった","zh":"很好。很好。"},{"label":"战斗失败1","jp":"ありゃ？おかしいなぁ～？","zh":"唔诶。好奇怪啊。"},{"label":"战斗失败2","jp":"気にしない、気にしない。大丈夫～ね","zh":"没关系，没关系，别往心里去哈。"}],"成长":[{"label":"升级1","jp":"うへ、こんなにもらちゃっていいの？先生","zh":"老师，我真的能收下吗？"},{"label":"升级2","jp":"ありがとう～大事に使うね","zh":"谢谢，我会珍惜的。"},{"label":"升级3","jp":"いつもありがとうねぇ","zh":"多谢你一直关照。"},{"label":"升级4","jp":"ま～強くなった気がする～","zh":"感觉又变厉害了。"},{"label":"获得专武","jp":"ここまでしてくれるとか…本当、変わってるね、先生も。まあ、いいけど。\nうん…じゃ私も、今まで以上に頑張らないとね","zh":"居然为了我做到这个地步，老师可真是个怪人。没事，那我就再加把劲了。"}],"事件":[{"label":"学生生日","jp":"…あ、そっか…私の誕生日か。\nえへへ、ありがとう先生…\n覚えてってもられるのは、嬉しいことだね。えへへ…","zh":"对啊，今天是我的生日诶。老师，谢谢你了，\n你能记住我的生日，我真的很开心，嘿嘿嘿。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生\n何かほしいものでもある？私にできる範囲なら、何でもいいけど","zh":"老师，祝你生日快乐，有什么想要的吗？只要在我能力范围内都可以啊。"},{"label":"万圣节","jp":"色んな仮装の人が沢山だぁ\nえっ？何その視線？ これは仮装じゃないてば～","zh":"穿奇装异服的人好多啊，看我干什么，都说了，这不是变装啦。"},{"label":"新年","jp":"明けましておめでとう、先生\n今年のたくさん楽しいことがあるといいね","zh":"老师祝你新年快乐，要是今年也有很多好事就好了。"},{"label":"圣诞节","jp":"なんか騒がしいと思ったら、クリスマスか～\nまあ、おじさんも別に、この空気を嫌いじゃないけどね\nだた、丁度この格好が外には出られないかなぁ","zh":"怪不得外面这么热闹，原来今天是圣诞节。\n大叔我其实也不讨厌这种氛围，不过我这身打扮应该不适合出门。"},{"label":"春节","jp":"","zh":"大家都在热火朝天的为新春做准备。老师，要不咱们两个偷偷去摸会儿鱼？"},{"label":"中秋","jp":"","zh":"一到这种节日，大叔我总觉得有点头疼。\n不过既然是团圆的日子，和老师待在一起也不坏。"}],"活动":[{"label":"活动登陆1","jp":"やー先生、お疲れ様ー","zh":"老师，辛苦，辛苦。"},{"label":"活动登陆2","jp":"あっつい…暑くて干からびそう…動いていないのに暑いよ～…","zh":"好热，热的我都要被晒干了，就算没动也好热。"},{"label":"活动大厅1","jp":"先生、おじさんに構ってて良いの？怒られちゃうよ？","zh":"老师啊，这么关心大叔我，合适吗？会挨骂的。"},{"label":"活动大厅2","jp":"うーん…そんなにつつかれても、おじさんからは何も出て来ないけど…","zh":"呜呼，就算你这样戳我，但是我也什么都没有哦。"},{"label":"活动大厅3","jp":"もしかして、先生も疲れた？それなら、一緒に向こうで一眠りする？","zh":"老师也累了么，那我们一起去那边休息一下吧。"},{"label":"活动大厅4","jp":"ねーむい…","zh":"好困。"},{"label":"活动事件1","jp":"そろそろ行かなきゃダメ？うへー、面倒くさいなぁ…。","zh":"差不多该行动了。唔诶，好麻烦哪。"},{"label":"活动事件2","jp":"もうあんまり時間が無さそうだし、そろそろ動くとしょうか～","zh":"时间好像不多了，快抓紧时间吧。"},{"label":"活动结束","jp":"先生、まだやることが残ってるの？仕方ないなあ、おじさんが手伝ってあげよう","zh":"老师，活还没干完吗？真没办法，那大叔就来帮你吧。"}]},"stats":{"init":[{"name":"攻击力","value":"243"},{"name":"防御力","value":"123"},{"name":"生命值","value":"2554"},{"name":"治愈力","value":"1789"},{"name":"命中值","value":"717"},{"name":"闪避值","value":"164"},{"name":"暴击值","value":"271"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1824"},{"name":"射程","value":"450"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"5111"},{"name":"防御力","value":"2505"},{"name":"生命值","value":"83394"},{"name":"治愈力","va