iki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"樱子(礼服)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/10/139518.png","url":"https://www.gamekee.com/ba/581924.html"},{"name":"★3 樱子（偶像）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_699/h_698/829/86082/2025/5/10/474762.png","url":"https://www.gamekee.com/ba/68786.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"トリニティー総合学園、シスターフッド所属の歌住サクラコです。日々に安寧があらんことを。","zh":"我是崔尼蒂综合学院姐妹会的成员歌住樱子，愿安宁常伴您左右。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしておりました、先生。今日も祝福があらんことを。","zh":"我正等着您呢，老师，愿今日祝福已与您同在。"},{"label":"登陆2","jp":"あ、先生…。ちょうど、先生のために祈りを捧げていたところです。","zh":"老师，我正好在为您祈祷。"},{"label":"大厅1","jp":"シャーレで先生の補佐を…普段の仕事と違うので、少し緊張します。","zh":"在沙勒辅佐老师和平时的工作不太一样，稍微有些紧张呢。"},{"label":"大厅2","jp":"聖堂の仕事、ですか？大丈夫ですよ、日程の調整は済ませております。","zh":"您是说圣堂的工作吗？没关系的，我把日程都安排好了。"},{"label":"大厅3","jp":"はい、先生。私にできることがありましたら、なんなりと…。","zh":"老师，如果有什么我能做的，请您尽管吩咐。"},{"label":"大厅4","jp":"聖堂に関することも、一般的な業務も、それ以外でも…なんなりとお申し付けくださいね。","zh":"不管是和圣堂有关的工作，还是普通的工作，或者其他工作，您都可以吩咐我。"},{"label":"大厅5","jp":"お疲れのご様子ですね。私にお手伝いできることはありますか？","zh":"您看起来很累呢，有什么我能帮上忙的吗？"},{"label":"回忆大厅1","jp":"先生に対して、あまり隠し事をしたくはないのですが…\n私の立場上、全てを明かすことは難しく——","zh":"虽然我原本不想对老师有所隐瞒。\n但站在我的立场上，很难去把这一切说的明明白白。"},{"label":"回忆大厅2","jp":"ですが、私に「秘密があるという事実」だけでも…\nお伝えすることができて、良かったです。","zh":"可是只要能把我怀揣着秘密这件事告诉老师。\n我就很满足了。"},{"label":"回忆大厅3","jp":"理解を得られるとは思っておりません。\nそれを望むことも…\nそれでも、私の素顔をお見せしたいという気持ちは…あるのです。","zh":"我很清楚，你恐怕无法理解我，我也没有对此抱有奢望。\n但就算如此，我也想向你展现出自己真实的一面。"},{"label":"回忆大厅4","jp":"その…そのような私でも良いのか、不安ではあったのですが。","zh":"其实。\n我一直很不安，少年看见这样的我，这真的好吗？"},{"label":"回忆大厅5","jp":"思っていたよりも早く、答えを頂いてしまいましたね。\n本当に…ありがとうございます、先生。","zh":"但没想到您这么快就给出了答案。\n真的非常感谢您，老师。"},{"label":"咖啡馆1","jp":"ここが、先生が飾りつけているという…。","zh":"听说这里都是老师亲手布置的。"},{"label":"咖啡馆2","jp":"いろんな方がいらしていますね。","zh":"这里有形形色色的人呢。"},{"label":"咖啡馆3","jp":"聖堂とは雰囲気が随分と違いますね。","zh":"和圣堂的氛围完全不一样啊。"},{"label":"咖啡馆4","jp":"たまには…こういう場所にいるのも良いものです。","zh":"偶尔待在这种地方也不错。"},{"label":"咖啡馆5","jp":"形は違いますが、穏やかな気持ちになります。","zh":"这里能让我感到另一种平静。"}],"好感度":[{"label":"好感度1","jp":"先生、そのっ…何でもありません…","zh":"老师，你……\n不没什么。"},{"label":"好感度2","jp":"先生に何かをお伝えするたびに、このような言葉で良いのだろうかと悩んでしまいます。","zh":"每次想对老师说些什么的时候，我都会苦恼那些话是否合适。"},{"label":"好感度3","jp":"先生ほど私を理解して下さる方も、あまりおりませんでしたので…。","zh":"能像老师这样理解我的人很少。"},{"label":"好感度4","jp":"一応皆のためのシスター…ですから、ですが…その…","zh":"我首先是一名为大家服务的修女。可是。"}],"战斗":[{"label":"编入队伍1","jp":"かしこまりました。","zh":"明白了。"},{"label":"编入队伍2","jp":"お呼びでしょうか？","zh":"您叫我吗？"},{"label":"拎起","jp":"あ、あら…？これは…？","zh":"您这是。"},{"label":"任命队长1","jp":"幸いがあらんことを。","zh":"愿幸运与我们同在。"},{"label":"任命队长2","jp":"皆様、何卒よろしくお願いします。","zh":"诸位拜托你们了。"},{"label":"普通技能","jp":"結局、こうなってしまうのですね。","zh":"结果还是变成这样了。"},{"label":"EX动画1","jp":"この弾丸に祝福を。","zh":"为这枚子弹献上祝福。"},{"label":"EX动画2","jp":"我らを恵みを与えたまえ。","zh":"请赐予我们恩惠。"},{"label":"EX动画3","jp":"恩寵に感謝を。","zh":"感谢您的恩宠。"},{"label":"EX技能1","jp":"悔い改めてください！","zh":"忏悔吧。"},{"label":"EX技能2","jp":"貴方のためなのです！","zh":"这发子弹是送给你的。"},{"label":"EX技能3","jp":"受け止めてください！","zh":"收下吧。"},{"label":"战斗开始1","jp":"共に参りましょう。","zh":"一起前进吧。"},{"label":"战斗开始2","jp":"これも一つの試練なのですね。","zh":"这也是一种试炼。"},{"label":"获得BUFF","jp":"助かります。","zh":"多谢。"},{"label":"施放BUFF","jp":"私に力を！","zh":"赐予我力量吧。"},{"label":"掩体","jp":"無駄です。","zh":"没用的。"},{"label":"被CC1","jp":"-","zh":"-"},{"label":"被CC2","jp":"-","zh":"-"},{"label":"被CC3","jp":"-","zh":"-"},{"label":"被CC4","jp":"\\","zh":"\\"},{"label":"被CC6","jp":"\\","zh":"\\"},{"label":"回避","jp":"信仰心が足りていませんよ。","zh":"你们的信仰还不够虔诚。"},{"label":"队伍移动1","jp":"続けて参ります。","zh":"继续前进吧。"},{"label":"队伍移动2","jp":"まだ終わっておりません！","zh":"还没有结束。"},{"label":"回复","jp":"感謝します。","zh":"十分感谢。"},{"label":"中途退出","jp":"私が至らないばかりに…","zh":"都怪我实力不足。"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"角色移动","jp":"-","zh":"-"},{"label":"战斗胜利1","jp":"皆様に恩寵があらんことを。","zh":"感谢各位。"},{"label":"战斗胜利2","jp":"平和でありますように。","zh":"能顺利解决就好。"},{"label":"关卡完成1","jp":"皆様に感謝を。","zh":"愿恩宠与诸位同在。"},{"label":"关卡完成2","jp":"解決できて何よりです。","zh":"愿和平永在。"},{"label":"战斗失败1","jp":"私の、失態です…","zh":"是我疏忽了。"},{"label":"战斗失败2","jp":"面目ありません……","zh":"我很惭愧。"}],"z'd":[{"label":"被CC5","jp":"\\","zh":"\\"}],"成长":[{"label":"升级1","jp":"あっ、ありがとうございます。こうして目をかけていただくのは、あまり…慣れませんね。","zh":"谢谢你，像这样被人关心，我还有些不习惯呢。"},{"label":"升级2","jp":"このご恩をどう返していけばよいのでしょう？","zh":"真不知该如何报答您的恩情。"},{"label":"升级3","jp":"その行いに、祝福があらんことを。","zh":"愿祝福与您的善行同在。"},{"label":"升级4","jp":"施しを遠慮するものではありませんね。ありがとうございます。","zh":"我不会拒绝您的好意，谢谢。"},{"label":"获得专武","jp":"私に慈悲を与えてくださるのですね。有難く頂戴いたします。\nいつか、このご恩をお返しできる日が訪れますように。","zh":"感谢您的慈悲，总有一天我会报答您的恩情。"}],"事件":[{"label":"学生生日","jp":"ありがとうございます、先生。誕生日を祝ってもらうのは、やはり、幸せのことですね。","zh":"谢谢你，老师，能在生日得到祝福，果然是一件幸福的事。"},{"label":"老师生日","jp":"感謝に満ちた特別の日ですね。私にとっても、そう。","zh":"对我来说，今天也是一个值得感恩的特别日子。"},{"label":"万圣节","jp":"祝祭の日の前日、一番騒がしい日ですね。いいえ、嫌いわけではありません。喜びは、分け合うほど大きくなりますから。","zh":"万圣节的前夜总是最热闹的时候。不，我并不讨厌他，因为越是分享快乐就会变得越多。"},{"label":"新年","jp":"一年が過ぎ、新たな年を迎えることが出来ました。今年も、先生にとって幸せな年でありますよう。","zh":"今天是辞旧迎新的日子，愿老师今年也度过幸福的一年。"},{"label":"圣诞节","jp":"はい。今日は間違いなく特別な日です！先生にも、伝わるとよいのですが……","zh":"今天的确是个特殊的日子，希望老师也能感受到。"},{"label":"春节","jp":"","zh":"老师，祝您新春快乐，我会一直为您祈祷，愿祝福与您同在。"},{"label":"中秋","jp":"","zh":"愿所有漂泊的人都能团圆。"}]},"stats":{"init":[{"name":"攻击力","value":"327"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2517"},{"name":"治愈力","value":"1647"},{"name":"命中值","value":"700"},{"name":"闪避值","value":"799"},{"name":"暴击值","value":"200"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1396"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"20 (4)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"7448"},{"name":"防御力","value":"109"},{"name":"生命值","value":"55304"},{"name":"治愈力","value":"5864"},{"name":"命中值","value":"700"},{"name":"闪避值","value":"799"},{"name":"暴击值","value":"830"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1396"},{"name":"射程","value":"650"},{"name":"群控强化力",