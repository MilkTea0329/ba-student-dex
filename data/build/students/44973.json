_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/666301.png","name":"巧克力团子","desc":"和菓子店贩售的巧克力团子。虽然是个意外的组合，却非常符合淳子的喜好。"},"ability":{"attrs":[{"name":"生命值","value":"1029"},{"name":"攻击力","value":"125"},{"name":"治愈力","value":"195"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/546168.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/300200.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 纯子（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/13/573110.png","url":"https://www.gamekee.com/ba/579691.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"別に協力するつもりはないんだけど。\n…うん？食べ物くれるの？\nどんなの？どんなやつ？","zh":"我可没想要帮你？欸要给我吃的吗？什么吃的？什么好吃的？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ先生～。今日も頑張って働いて、 美味しい物を食べに行くんだからね！","zh":"老师，你来啦，今天也要努力工作，然后去吃好吃的。"},{"label":"登陆2","jp":"あ、来た来た！先生！今日はどんな任務をしに行くの?","zh":"啊，来了来了老师，今天要去做什么任务呀？"},{"label":"大厅1","jp":"趣味？読書よ。読書。…なによ、その顔！！","zh":"我的爱好？读书，读——书，干嘛呀？你那什么表情啊？"},{"label":"大厅2","jp":"私を食べるの大好きな子供だなんて思ってないわよね？\nもっと頼ってもいいのよ？","zh":"你不会觉得我只是个贪吃的小鬼吧？有什么事情尽管交给我就好了。"},{"label":"大厅3","jp":"お団子が好きなのかって？\n別に？安いから 食べてるだけだけど？","zh":"喜不喜欢糯米团子？也没有很喜欢啦，只是因为比较便宜才吃的。"},{"label":"大厅4","jp":"（先生と二人っきりで…？へ、へえ…）","zh":"只有我和老师两个人？这.."},{"label":"大厅5","jp":"な、なにい？！ケーキとパイが無制限に食べられるお店があるの？！\n先生！準備して！今すぐ出動するよ！","zh":"什、什么？有家蛋糕和馅饼畅吃的店？老师，快准备下，我们马上出发！"},{"label":"回忆大厅1","jp":"え、な、なに。なんでそんな目で見るの？\n（…もう、本当に…）","zh":"欸？干什么？你这个眼神是什么意思？"},{"label":"回忆大厅2","jp":"ちょっと休んで、また食べに行くんでしょ？次は何食べる？","zh":"嗯..真是的（心声）"},{"label":"回忆大厅3","jp":"おいしー。","zh":"稍微休息一下，然后咱们继续去吃吧！"},{"label":"回忆大厅4","jp":"なに？一緒に飲もうって！？変なこと言わないで！殺すよ！？\n（からかってるよね、これ？ \nそうだよね？ストロー、一本しかないのに…）\n（…でも先生なら…大丈…） \n…やっ！！ やっぱだめ！！","zh":"下一个吃什么去？"},{"label":"回忆大厅5","jp":"","zh":"好好喝啊！"},{"label":"回忆大厅6","jp":"","zh":"什么？想和我喝同一杯？你这家伙说什么呢？干掉你哦！"},{"label":"回忆大厅7","jp":"","zh":"是开玩笑的吧？刚才..肯定是，吸管可只剩一根了。（心声）"},{"label":"回忆大厅8","jp":"","zh":"但如果是老师的话，也可以（心声）"},{"label":"回忆大厅9","jp":"","zh":"嗯..还是不行！"},{"label":"咖啡馆1","jp":"クンクン。うん…？この匂いは…？\n何か美味しそうな匂いがする！","zh":"（嗅嗅）这个味道，是什么好吃的东西？"},{"label":"咖啡馆2","jp":"美味しそうな匂いにつられて、ここまで来ちゃった。\nここで私を待っているのはー…何かな～","zh":"闻着香味，不知不觉就过来了，会有什么好吃的在等着我呢？"},{"label":"咖啡馆3","jp":"ど、どこかに食べ物…\nないの？","zh":"吸溜，好好吃的样子，那就来一口，呜、呜哇！"},{"label":"咖啡馆4","jp":"そういえば前に、先生とカフェに行ったときの…美味しかったな…。へへ。","zh":"好好吃的样子，那我就不客气…怎么？呜哇！"},{"label":"咖啡馆5","jp":"百鬼夜行のお祭りで売ってるお団子が、すごく美味しいって噂なんだけど…。","zh":"欸？哪、哪里有好吃的呀？"},{"label":"咖啡馆6","jp":"-","zh":"-"},{"label":"咖啡馆7","jp":"-","zh":"-"}],"好感度":[{"label":"好感度1","jp":"食べ物を奢ってくれるからって別に好きになるとかじゃ……ほ、本当だって！","zh":"就算你请我吃饭，我也不会喜欢你..是、是真的啦"},{"label":"好感度2","jp":"また美味しいものを奢ってくれるなんて、先生はいい人だね！","zh":"居然又请我吃好吃的了，老师你真是个好人呐！"},{"label":"好感度3","jp":"可愛いって言われるのも嫌いじゃないけど……な、なんでもない！","zh":"夸我可爱我倒是不讨厌，我、我什么都没说。"},{"label":"好感度4","jp":"えっと…、必要な時は私を呼んでね！せ、先生のことならいつでも手伝うから！","zh":"那个，需要帮忙的话要叫我哦，老师的忙我随时都会帮的。"}],"战斗":[{"label":"编入队伍1","jp":"やってやろうじゃないの！","zh":"来大干一场吧！"},{"label":"编入队伍2","jp":"任せといて！","zh":"交给我吧！"},{"label":"拎起","jp":"はっ、放して～！","zh":"额..放开我！"},{"label":"任命队长1","jp":"私が先頭に立つ！","zh":"我来带头！"},{"label":"任命队长2","jp":"勝てば美味しい物が食べられる！","zh":"赢了就能吃好吃的！"},{"label":"普通技能","jp":"許さない！","zh":"饶不了你！"},{"label":"EX动画1","jp":"ふふーん、えぇっ！？あーん","zh":"哼哼~欸？嗯哼——"},{"label":"EX动画2","jp":"お団子お団子～♪うぇっ！？","zh":"团子团子~唔欸——"},{"label":"EX动画3","jp":"えへへ～、うわっ！あぁもう！","zh":"嘿嘿嘿~呜哇！讨厌！"},{"label":"EX技能1","jp":"まだ味見もしてないのに！","zh":"我还没尝过呢！"},{"label":"EX技能2","jp":"この野郎！","zh":"你这家伙！"},{"label":"EX技能3","jp":"ブッ壊してやるっ！","zh":"把你们都打烂！"},{"label":"战斗开始1","jp":"さぁ、行くよ！","zh":"我们走吧！"},{"label":"战斗开始2","jp":"早く終わらせてご飯食べに行こう！","zh":"我们早点结束去吃饭吧！"},{"label":"获得BUFF","jp":"うん、よし！","zh":"很好！"},{"label":"施放BUFF","jp":"よし！","zh":"好——嘞"},{"label":"掩体","jp":"隠れるね！","zh":"有地方能躲！"},{"label":"被CC1","jp":"いたい…","zh":"好疼~"},{"label":"被CC2","jp":"うわ！","zh":"呜哇！"},{"label":"被CC3","jp":"イタッ！","zh":"疼！"},{"label":"回避","jp":"この程度？","zh":"就这？"},{"label":"队伍移动1","jp":"はぁ、お腹すいてきたぁ。","zh":"我饿了~"},{"label":"队伍移动2","jp":"おやつでも持ってくればよかった。","zh":"我应该带点零食来的。"},{"label":"回复","jp":"サンキュー、この恩は返すよ。","zh":"Thank you 我会报答你的！"},{"label":"中途退出","jp":"お腹がすいてたから…ごめん。","zh":"我饿了嘛..对不起.."},{"label":"战斗喊叫","jp":"えい！","zh":"欸！"},{"label":"战斗喊叫","jp":"くらえ！","zh":"看招！"},{"label":"战斗喊叫","jp":"やぁ!","zh":"呀！"},{"label":"角色移动","jp":"移動しよう！","zh":"继续前进吧！"},{"label":"战斗胜利1","jp":"へへ…それじゃあ食べてみ…うわぁ…な、なんで！？","zh":"嘿嘿，那现在就来尝…呜哇！为什么？"},{"label":"战斗胜利2","jp":"じゃーん！私の最後の…う、えぇっ！？","zh":"锵！我最后的..欸、欸？"},{"label":"关卡完成1","jp":"どお！完璧な勝利でしょ？","zh":"怎么样？完美的胜利吧？"},{"label":"关卡完成2","jp":"先生！本当にご飯奢ってくれるんだよね？","zh":"赢了就能吃好吃的！×（编者注：此处应为任命队长）"},{"label":"战斗失败1","jp":"びえぇーん！悔しいっ！","zh":"欸嘿嘿——我好气——"},{"label":"战斗失败2","jp":"これは…急にお腹がすくから…","zh":"这是因为..我突然饿了.."}],"成长":[{"label":"升级1","jp":"ち、小さくないから！また成長期で！これから大きくなるの！","zh":"才不小好不好，我还在发育呢，以后还会长的！"},{"label":"升级2","jp":"よくわがらないけど、ちょっと強くなっだ予感する！","zh":"不知道怎么回事..好像变强了一点！"},{"label":"升级3","jp":"いっぱい食べて、\nいっぱい強くなって、\nそれでいっぱいいろんな所に行こうね、先生！","zh":"老师，我们一起去吃好多好多东西，变得好强好强，然后去好多好多的地方吧。"},{"label":"升级4","jp":"まだまだ大丈夫。いくらでも食べられそう。","zh":"没事没事，再多我都吃得下！"},{"label":"获得专武","jp":"あ、ありがとう、先生……。\nその……だ、大事にする！絶対！","zh":"谢、谢谢老师，我会好好珍惜的，绝、绝对！"}],"事件":[{"label":"学生生日","jp":"今日は私の誕生日なの！分かってるよね？\nやっぱり誕生日にはお 肉がいいかな！\nそれかビュッフェでもいいよ！ \nなんでもいいから食べに行こ、先生！","zh":"今天是我的生日欸，你知道的吧，过生日肯定得去吃肉吧？或者自助也行啊，其实吃什么都成，快走啦老师！"},{"label":"老师生日","jp":"お誕生日おめでとう先生！\n今日は特別に \n私が遊んであげる！\nそれじゃあ何食べに行く？ \nお肉？お魚？\nそれともチキン？？","zh":"生日快乐，老师，我今天可是特意来陪你玩的，那吃什么好呢？吃肉，吃鱼，还是......吃鸡?"},{"label":"万圣节","jp":"うん？あ、飴は私のものだよ。\n…で、でも先生にだったら、 \nす、少しなら分けて\nあげてもいいよ。","zh":"哦？啊，这个糖是我的，不过老师想吃的话，分你一点也可以哦！"},{"label":"新年","jp":"明けましておめでとう、先生！\n早く新年最初の\n買い食いに行こう！\n甘酒とお餅が \n待ってるよ！","zh":"新年快乐啊老师，去吃新年的第一口零食吧，甜酒和打糕在等着我呢！"},{"label":"圣诞节","jp":"メリークリスマス！\n街に行かない？先生！\nイルミネーションで\nキラキラしてるよ！","zh":"圣诞快乐~不去街上看看吗？有好多好多灯，闪闪发光的好好看啊！"},{"label":"春节","jp":"","zh":"新春快乐啊，老师快一起去吃好吃的吧。老师喜欢什么馅儿的饺子？"},{"label":"中秋","jp":"","zh":"中秋节当然要吃月饼，听说这是山海经的传统，那分你一块，老师一起看着月亮吃月饼。"}]},"stats":{"init":[{"name":"攻击力","value":"302"},{"name":"防御力","value":"20"},{"name":"生命值","value":"2378"},{"name":"治愈力","value":"1496"},{"name":"命中值","value":"695"},{"name":"闪避值","value":"794"},{"name":"暴击值","value":"198"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1408"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8726"},{"name":"防御力","value":"110"},{"name":"生命值","value":"55147"},{"name":"治愈力","value":"5819"},{"name":"命中值","value":"695"},{"name":"闪避值","value":"794"},{"name":"暴击值","value":"828"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1408"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"591"},{"name":"生命值","value":"3196"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[{"name":"攻击力","value":"800"}]},"abilityDetail":{"attrs":[{"name":"生命值","value":"1029"},{"name":"攻击力","value":"125"},{"name":"治愈力","value":"195"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_29