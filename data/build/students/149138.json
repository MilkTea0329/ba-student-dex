.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/3/901206.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/3/647803.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 伊织（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/3/980865.png","url":"https://www.gamekee.com/ba/83867.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"あなたが先生か？今日から私が一緒にいてあげる。\n任務なら、私に任せて。","zh":"你就是老师？今天开始我和你搭档，有任务就交给我吧。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"や、お帰り。先生、今日の任務は何？","zh":"啊！你回来了，老师，今天有什么任务？"},{"label":"登陆2","jp":"サボろうとするなよ。私がいつも見守ってるからな。\n…いや、変な意味じゃないから！","zh":"别偷懒哦，我可一直看着你呢，不对，不是你想的那种意思啦！"},{"label":"大厅1","jp":"しばらくは余裕があるから…少しは手伝うよ。","zh":"我暂时比较闲，可以稍微帮你一下。"},{"label":"大厅2","jp":"問題を起こす奴らって、なんでこんなに多いんだ。","zh":"爱捣乱的家伙，怎么这么多！"},{"label":"大厅3","jp":"まあ、絶対に規則に従えとは言わない。従わない場合、責任を取らせるだけだ。","zh":"这个嘛，也不是说非得遵守规定，只不过违规，就要负责罢了。"},{"label":"大厅4","jp":"誰もが納得できる規則なんてない。\nだからこそ、強制する必要がある。","zh":"没有什么规定是所有人都能接受的，所以有时候才需要强制执行。"},{"label":"大厅5","jp":"先生、あなたの指揮力は信頼してるよ。","zh":"老师，我相信你的指挥能力。"},{"label":"回忆大厅1","jp":"なに、その表情は。変なこと考えてないよな？","zh":"干嘛！你那什么表情啊，不会在想什么不正经的事吧！"},{"label":"回忆大厅2","jp":"いつまで見てるんだ？早くして。","zh":"你要看到什么时候，快点！"},{"label":"回忆大厅3","jp":"んんっ…んぅっ、はうっ…。\n痛かったか、って？げ、ゲヘナの風紀委員がこれぐらいで痛がるはずないだろ！\nただ…少し、くすぐったかっただけ。","zh":"嗯…嗯…啊…\n你问疼不疼？就这点小伤怎么可能疼到歌赫娜的风纪委员啊！就，就是有点痒而已.."},{"label":"回忆大厅4","jp":"何やってるんだ、包帯がほつれる。","zh":"你干嘛呢？绷带都松开了。"},{"label":"回忆大厅5","jp":"先生だったら…手が触れるぐらいなら気にしないから。\nちゃんと、最後までやって。","zh":"因为是老师嘛，只是用手稍微碰一下的话，我不会介意的。\n给我好好做到最后啊…"},{"label":"咖啡馆1","jp":"まったく、仕方ないな。手伝うよ。","zh":"哎，这可真是没办法，我来帮你好了。"},{"label":"咖啡馆2","jp":"はあ、どうしてこうなったんだ。まあ…別に悪くはないけど。","zh":"哎，怎么会变成这样，算了，倒也不是坏事。"},{"label":"咖啡馆3","jp":"へえ、なかなかいい感じ。","zh":"嗯？挺不错嘛。"},{"label":"咖啡馆4","jp":"少し休んでから行くとしよう。","zh":"休息会再过去吧。"},{"label":"咖啡馆5","jp":"正義実現委員会のやつらは、めんどくさいんだよな…。","zh":"正义实现部的那帮人真让人头疼。"}],"好感度":[{"label":"好感度1","jp":"少しは頼れそうな先生になったかな…。","zh":"多少有点老师的样子了，比以前可靠了。"},{"label":"好感度2","jp":"ずっと、風紀委員会のことだけで頭がいっぱいだったけど…最近は少し、別のことに夢中になってる…。\nせ、先生じゃなくて！シャーレのことっ！","zh":"我以前脑子里装的都是风纪委员会的事情，但是最近，开始整天琢磨别的了，不、不是老师，是说沙勒！"},{"label":"好感度3","jp":"新しい任務が入った。一緒にそれを遂行して、その…帰り道にちょっと遊んでくるってのはどう…？","zh":"新的任务下来了，一起去执行吧，然后回来的路上去玩玩..怎么样?"},{"label":"好感度4","jp":"きゅっ、急に近寄るなっ！なっなんでって…その…心の準備が必要だから！","zh":"别，别突然靠这么近啊，还、还问为什么，我得做好心理准备啊.."}],"战斗":[{"label":"编入队伍1","jp":"私に任せて。","zh":"交给我吧。"},{"label":"编入队伍2","jp":"それが命令なら。","zh":"既然是命令，我会遵守的。"},{"label":"拎起","jp":"まぁ一応従うけど…しっかり頼むよ、先生。","zh":"好吧，就先听你的，好好干哦，老师。"},{"label":"任命队长1","jp":"異議なし、出発する。","zh":"我没意见，出发吧。"},{"label":"任命队长2","jp":"殲滅させてやる！","zh":"把你们全数歼灭！"},{"label":"普通技能","jp":"くらえ！","zh":"吃我一发！"},{"label":"EX动画1","jp":"リロード完了。覚悟しろ！","zh":"装弹完毕，受死！"},{"label":"EX动画2","jp":"射程距離に入った、行くぞ！","zh":"进入射程了，上吧！"},{"label":"EX动画3","jp":"ゲヘナ風紀委員会のスナイパーを、舐めるな！","zh":"别把歌赫娜风纪委员会的狙击手给看扁了！"},{"label":"EX技能1","jp":"逃げても無駄だ！","zh":"逃也没用！"},{"label":"EX技能2","jp":"これでトドメだ！","zh":"一击毙命！"},{"label":"EX技能3","jp":"覚悟しろ、規則違反者どもめ！","zh":"觉悟吧，你们这些违规者！"},{"label":"战斗开始1","jp":"さあ、行くぞ！","zh":"好，走吧！"},{"label":"战斗开始2","jp":"指示に従う。前進！","zh":"听从指示。前进！"},{"label":"获得BUFF","jp":"サンキュー。","zh":"谢了。"},{"label":"施放BUFF","jp":"覚悟しろ！","zh":"受死吧！"},{"label":"掩体","jp":"準備完了。","zh":"准备完毕。"},{"label":"被CC1","jp":"くそ……","zh":"混蛋！"},{"label":"被CC2","jp":"負けたくない……！","zh":"不想输......！"},{"label":"被CC3","jp":"ありえない……！","zh":"不可能……！"},{"label":"回避","jp":"ふん。","zh":"哼"},{"label":"队伍移动1","jp":"さて、さっさと片付けよう。","zh":"好，麻利点解决掉吧！"},{"label":"队伍移动2","jp":"次っ！","zh":"下一个！"},{"label":"回复","jp":"ありがたい。感謝する。","zh":"有劳了，谢谢你。"},{"label":"中途退出","jp":"やられたか…くそっ！","zh":"被摆了一道，该死！"},{"label":"战斗喊叫","jp":"へぇ！","zh":"嗬！"},{"label":"战斗喊叫","jp":"遅い！","zh":"太慢了！"},{"label":"战斗喊叫","jp":"行くぞ！","zh":"上吧！"},{"label":"角色移动","jp":"移動する。","zh":"继续前进！"},{"label":"战斗胜利1","jp":"これがゲヘナ風紀委員会の力だ。","zh":"这就是歌赫娜风纪委员会的实力。"},{"label":"战斗胜利2","jp":"私一人でも十分だ。","zh":"其实我一个人就够了。"},{"label":"关卡完成1","jp":"油断はしない。","zh":"保持警惕。"},{"label":"关卡完成2","jp":"当たり前の結果だ。","zh":"理所当然的结果。"},{"label":"战斗失败1","jp":"諦めない…。","zh":"我不会放弃.."},{"label":"战斗失败2","jp":"ちっ、悔しい…。","zh":"我不服…."}],"成长":[{"label":"升级1","jp":"へぇー、確かに強くなった気分。","zh":"欸，确实感觉变强了。"},{"label":"升级2","jp":"これからも、大変な任務なら私に任せて。","zh":"以后也继续把困难的任务交给我吧！"},{"label":"升级3","jp":"ベストを尽くして成果を得る…。当たり前のようだけど…叶うと本当にうれしい。","zh":"尽力而为，取得成果，听上去好像是理所当然的，但真的做到以后，还是很开心。"},{"label":"升级4","jp":"ありがとう、先生。これからもよろしく。","zh":"老师，谢谢你，以后也请多关照了。"},{"label":"获得专武","jp":"成果で応える。今の私の気持ちを証明できるのは、それしかないから。","zh":"我会用成果回应您，这是唯一一个可以用来表明我此时感受的办法。"}],"事件":[{"label":"学生生日","jp":"祝ってくれてありがとう。\n私も少しは成長したんだし…。これからはもうちょっと、真面目になってみようかな…？","zh":"谢谢你的祝福，我也算是成熟了一点，以后要不要再认真一些呢？"},{"label":"老师生日","jp":"ん？！な、なに？！今日が誕生日？\nし、仕方ないな。今日は、その、どんな任務でも協力するから！","zh":"嗯？什么？你今天过生日？\n那就没办法了，今天无论有什么任务，我都会协助你的。"},{"label":"万圣节","jp":"Trick or Treat、か。まあ、面白い日ではある。\nどう、先生？一緒に、外に出てみない？","zh":"不给糖就捣蛋啊，哼，是个有趣的日子，怎么样老师，要不要一起去外面看看？"},{"label":"新年","jp":"先生。新年も、一緒に頑張ろう。","zh":"老师，新的一年也一起加油吧！"},{"label":"圣诞节","jp":"クリスマスか。今となっては元の意味を失ってるけど。\nまあ、今のも悪くはない。","zh":"圣诞节啊，现在的圣诞节已经失去原来的意义了，\n算了，现在这样也不错。"},{"label":"春节","jp":"","zh":"啊，老师你来啦。祝你新春快乐。希望那些爱惹事的笨蛋们，至少今天能安分一些……"},{"label":"中秋","jp":"","zh":"我还是第一次看到这样的月饼……应该不是供餐部的朱莉做的吧。"}]},"stats":{"init":[{"name":"攻击力","value":"391"},{"name":"防御力","value":"20"},{"name":"生命值","value":"2591"},{"name":"治愈力","value":"1597"},{"name":"命中值","value":"874"},{"name":"闪避值","value":"194"},{"name":"暴击值","value":"194"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2056"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8286"},{"name":"防御力","value":"113"},{"name":"生命值","value":"53922"},{"name":"治愈力","value":"5687"},{"name":"命中值","value":"874"},{"name":"闪避值","valu