%"},{"lv":9,"text":"增益持续力增加1700，生命值增加23.8%"},{"lv":10,"text":"增益持续力增加1900，生命值增加26.6%"}]},"star3":"屋内适应性强化至SS","star3Icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/673843.png","star4":"振动克制率增加10%"},"favoriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"橘 ヒカリ","kana":"橘 たちばな","twName":"光","cnName":"","age":"15岁","birthday":"6月14日","height":"147cm","hobby":"（古怪的）驾驶练习、观察蚂蚁","designer":"-","artist":"CHILD","cv":"日 | 石见舞菜香\n中 | 江雨轩\n韩 | 방연지(房莲知)","hallLevel":"6","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"↑↑↓↓←→←→","bio":"海兰德铁道学园所属，CCC（中央管制中心）的干部。在列车驾驶方面拥有卓越才能，与双胞胎妹妹望一同被选为干部。然而，对于文书和管理工作一窍不通。因忠于当下的欲望且我行我素，总是引发各种事件。\n“选手光，登场——！”","sourceUrl":""},"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/191981/2026/1/18/59181.png","name":"超——新作巧克力球！！","desc":"光送的热腾腾的巧克力。她想吃但忍住当作了礼物。"},"ability":{"attrs":[{"name":"生命值","value":"971"},{"name":"攻击力","value":"109"},{"name":"治愈力","value":"169"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/10/669361.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/10/863520.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue- Archive-"},{"label":"卡池抽取","jp":"ハイランダー鉄道学園、橘ヒカリ、参上～","zh":"海兰德铁道学院——橘光——登场——"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生、いらっしゃい～舞ってたよぉ。","zh":"老师——你来啦——小光等你好久了——"},{"label":"登陆2","jp":"うぅ、給湯室のお菓子なくなっちゃた…うん？いいの？","zh":"啊……茶水间的点心——都被我吃光了——嗯——？没关系——？"},{"label":"大厅1","jp":"こちらヒカリ、暇を持て余しています。どうぞ～えぇ～事務作業？うぅ、つまんない…","zh":"老师，小光好无聊——需要一点刺激——嗯——？文书工作……？噗——那太无聊了——"},{"label":"大厅2","jp":"先生、お菓子要る？はい、激辛ーヒカリには無理だったからあげる。","zh":"老师——要吃点心吗——？这个超级辣……小光吃不了——给老师吧——"},{"label":"大厅3","jp":"これはヒカリはやっとくねぇ。出来るよ、当番だし。うぅ…んっ！寝てった…！","zh":"老师——这份文件小光来处理吧——？我能做到的——再说今天是我值日——……啊——不小心睡着了——"},{"label":"大厅4","jp":"先生、膝の上いい？返事は待たずに動く、それが橘ヒカリ～","zh":"老师——可以坐到你的腿上吗——？想做什么就先做了再说——这就是小光——"},{"label":"大厅5","jp":"見て見て先生！影絵のワンちゃん！おぉ、それ雕？他は？","zh":"看这个，老师——用手影变出小狗——……哦——？这是老鹰？还有别的吗——？"},{"label":"回忆大厅1","jp":"ここ、ここ…","zh":"这里——这里——"},{"label":"回忆大厅2","jp":"そう、奥の方…歯が痛い…先生、見える？","zh":"嗯~再往里一点——牙齿好痛——老师——能看见吗？"},{"label":"回忆大厅3","jp":"右の奥歯がねぇ、痛いの…","zh":"右边——臼齿那里——"},{"label":"回忆大厅4","jp":"うぅ、そこ、ズキズキ…","zh":"呜呜……一抽一抽地疼——"},{"label":"回忆大厅5","jp":"えぇ、そうすればいいの？ヒカリ死亡フラグ─？助けてぇ、先生","zh":"诶——那怎么办——小光要领便当了吗——？老师——救命——"},{"label":"咖啡馆1","jp":"おぉ~一杯遊びそう～","zh":"唔哦——感觉这里超好玩的……"},{"label":"咖啡馆2","jp":"先生、どこ？","zh":"老师——你在哪——？"},{"label":"咖啡馆3","jp":"今日はおサボリデーに決定~","zh":"今天是摸鱼模式——就这样决定了——"},{"label":"咖啡馆4","jp":"お菓子ないの？ジュースは？","zh":"这里没有点心吃吗——？果汁呢——？"},{"label":"咖啡馆5","jp":"おもしろいことない~?","zh":"就没有什么好玩的事吗——？"}],"好感度":[{"label":"好感度1","jp":"先生、呼んだ？遊ぼう～","zh":"老师——叫我了吗？一起玩吧——"},{"label":"好感度2","jp":"やって欲しい亊ある？","zh":"老师——有什么想让小光做的事情吗——？"},{"label":"好感度3","jp":"これからもずっと遊んで。","zh":"老师以后也要一直和小光玩哦——知道了吗——？"},{"label":"好感度4","jp":"いつも遊んでくれて有難う～先生大好き～","zh":"谢谢老师一直陪小光玩——最喜欢老师了——"}],"战斗":[{"label":"编入队伍1","jp":"出動～","zh":"出动——"},{"label":"编入队伍2","jp":"ヒカリ、合流～","zh":"小光——加入队伍——"},{"label":"拎起","jp":"ヒカリ選手の飛行モード行こう～ププン～","zh":"小光选手飞行模式——咻咻——"},{"label":"任命队长1","jp":"全速前進─！","zh":"全速——前进——"},{"label":"任命队长2","jp":"ヒーロー参上─！","zh":"英雄——登场——"},{"label":"普通技能","jp":"","zh":"嘿——嘿——"},{"label":"EX动画1","jp":"シュポォポォポォ～格好いいでしょう～","zh":"咻叭叭叭叭——帅吧——？"},{"label":"EX动画2","jp":"イエス～パチパチ～はいどうぞ～","zh":"Yes——咔嚓咔嚓咔嚓喏，给你——"},{"label":"EX动画3","jp":"失礼します～シュポポ～コンプリート～","zh":"稍等哦——咻咻咻咻咻——Complete——"},{"label":"EX技能1","jp":"必殺～高速入鋏～","zh":"必杀！高速检票——"},{"label":"EX技能2","jp":"可愛くしてあげるねぇ。","zh":"帮你装饰得——漂漂亮亮——"},{"label":"EX技能3","jp":"確認完了！","zh":"车票——确认完毕——"},{"label":"战斗开始1","jp":"戦闘モード、行こう─","zh":"进入——战斗模式——"},{"label":"战斗开始2","jp":"","zh":"Go——Go——"},{"label":"获得BUFF","jp":"パワーチャージ！","zh":"Power——Charge——！"},{"label":"施放BUFF","jp":"無敵モード─","zh":"无~敌~模式——"},{"label":"掩体","jp":"","zh":"危险危险——"},{"label":"被CC1","jp":"","zh":"哦——？"},{"label":"被CC2","jp":"","zh":"啊……！"},{"label":"被CC3","jp":"","zh":"呃……"},{"label":"队伍移动1","jp":"全力ダッシュ─","zh":"猛烈Dash——"},{"label":"队伍移动2","jp":"","zh":"叭兵——"},{"label":"回复","jp":"","zh":"唔哦——"},{"label":"中途退出","jp":"危険、危険！デンジャラス！","zh":"危险——Dangerous——"},{"label":"战斗喊叫","jp":"喰らえ～","zh":"噢——"},{"label":"战斗喊叫","jp":"パン！パン！","zh":"接招——"},{"label":"战斗喊叫","jp":"","zh":"邦邦——"},{"label":"角色移动","jp":"シュ~シュ~ポォ~ポォ","zh":"咻咻——咻咻——"},{"label":"战斗胜利1","jp":"楽勝～ヴィヴィ~","zh":"小菜一碟——耶耶——"},{"label":"战斗胜利2","jp":"頑張ったよ～褒めて褒めて～","zh":"小光很努力了哦——干得不错吧——快夸夸我！"},{"label":"关卡完成1","jp":"ビクトロー讃えるがよい～","zh":"胜利啦——快表扬我——"},{"label":"关卡完成2","jp":"勝利のポーズ、ヴィヴィ","zh":"看我的——胜利姿势——"},{"label":"战斗失败1","jp":"ヘルプミ─","zh":"Help me~"},{"label":"战斗失败2","jp":"損傷大きめ？","zh":"中招了——哐当"}],"成长":[{"label":"升级1","jp":"ヒカリ、進化中～","zh":"小光——进化——"},{"label":"升级2","jp":"おぉ、成長している～","zh":"唔哇——小光还在成长——"},{"label":"升级3","jp":"ヒカリが最強になったらどうする？","zh":"小光要是变得太强了——可怎么办呀——？"},{"label":"升级4","jp":"今なら何でもできそう～","zh":"小光现在——好像无所不能——"},{"label":"获得专武","jp":"くれるの？有難う～代わりに先生の亊守ってあげる~","zh":"这是——给小光的吗——？谢谢——小光会变得更强，来保护老师的——"}],"事件":[{"label":"学生生日","jp":"クイズー、今日は何の日でしょ~正解~ヒカリとノゾミの誕生日—。プレゼント求む~何でも歓迎~","zh":"提问——今天是什么日子——？回答正确——是小光和小望的生日——我要礼物——什么都可以哦——"},{"label":"老师生日","jp":"シャーレ乗務員、応答願う─じゃーん！今日は先生のお誕生日、おめでとう。ケーキ一緒に食べよぉ。","zh":"沙勒乘务员，请回答——锵！今天是老师的生日——生日快乐——一起吃蛋糕吧——"},{"label":"万圣节","jp":"トリックーオアートレーイン。うん、適当に言っただけー。お菓子ちょうだい～","zh":"不给糖——不进站——嗯——随便喊着玩的啦——给我糖——"},{"label":"新年","jp":"今年の抱負が決まったのだぁ！お菓子の量を減らす…！ん…やっぱり来年頑張る。","zh":"今年的目标我想好了——那就是——少吃一点零食……！……唔，算了——还是明年再努力吧——"},{"label":"圣诞节","jp":"先生は今年泣いた？ヒカリは泣いてないよ、我慢した。だからプレゼントもらえるかなぁ？いい子にしてたのだ。","zh":"老师——你今年哭过吗——？小光没有哭过——都努力忍住了——小光这么乖——肯定会收到礼物吧——？"},{"label":"春节","jp":"","zh":"这几天坐车去山海经的学员变多了呢——老师你有什么头绪吗——？是那边的新年——？这样啊——那小光就负责把大家平安送回家——是不是很了不起——？那就快夸夸我吧——"},{"label":"中秋","jp":"","zh":"今晚的月亮好亮好亮——这样夜间行车就方便多啦——如果——铁道一直延续下去——说不定有一天真能开到月亮上去呢——"}],"活动":[{"label":"活动登陆1","jp":"ようこそ～準備完了～","zh":"欢迎——老师——小光准备好了——"},{"label":"活动登陆2","jp":"先生ピンチ！ヘルプミ～助けて～","zh":"老师——危险了——帮帮我——Help me——"},{"label":"活动大厅1","jp":"えぇ～ヒカリと遊びたいの~?","zh":"嗯——？怎么了——？想跟小光一起玩吗——？"},{"label":"活动大厅2","jp":"くすぐったい～うぅ～やり返してやる～","zh":"好痒——呜呜，我要报仇——"},{"label":"活动大厅3","jp":"撫で撫でプリーズ～褒めて褒めて～褒めてぇ～何もしてないけど～","zh":"摸摸我的头——夸夸我——虽然我也没做什么——但是想要夸夸——"},{"label":"活动大厅4","jp":"お菓子食べる~?ちょっと待ってねぇ。うぅ、全部食べちゃった、ソーリ─","zh":"要吃零食吗——？等等哦——啊……全吃光了——Sorry——"},{"label":"活动事件1","jp":"走行準備～問題無し～先生、スピード上げるよ～","zh":"运行准备——一切正常——怎么样，老师——？快点出发吧——？"},{"label":"活动事件2","jp":"もう終わり？もっと遊びた","zh":"差不多快结束了——还想再多玩一会儿呢——"},{"label":"活动结束","jp":"楽しかったねぇ、まだ遊ぼう～","zh":"真好玩——下次再一起玩吧——老师——"},{"label":"活动商店1","jp":"お勧め？うんん…自分で選ぶのだ—","zh":"推荐——？唔……不行——得自己去挑——"},{"label":"活动商店2","jp":"ヒカリも遊びたいけど我慢してる、先生も我慢して─","zh":"小光也想玩但努力忍着——老师也忍耐一下吧——"},{"label":"活动商店关闭","jp":"線路はどこまでも続くよ、お店もいっしょ─","zh":"只要轨道不断延伸——商店就会一直存在——"},{"label":"活动商店登陆1","jp":"トレインショップ、何が欲しい？","zh":"有需要的东西吗——？随便挑——"},{"label":"活动商店登陆2","jp":"いらしゃい～見ていてください～だって~?","zh":"欢迎——想买点什么——？"},{"label":"活动商店购买1","jp":"おぉ、それいいよねぇ！","zh":"哦——这个不错呀——"},{"label":"活动商店购买2","jp":"センスある！シュ~シュ~","zh":"很有品味——咻——咻——"},{"label":"活动商店购买3","jp":"先生、賢い！","zh":"这个选得不错——老师真聪明——"},{"label":"活动商店购买4","jp":"ヒカリの分も、ヒカリの分も！","zh":"小光也有份吗——？"},{"label":"迷你小游戏完成","jp":"よしよし、いい子いい子～","zh":"干得好~表扬你~"},{"label":"迷你小游戏火车开动","jp":"シュシュポォポォ─出発信号─","zh":"轰隆隆隆~出发——"}]},"stats":{"init":[{"name":"攻击力","value":"238"},{"name":"防御力","value":"16"},{"name":"生命值","value":"1846"},{"name":"治愈力","value":"1205"},{"name":"命中值","value":"107"},{"name":"闪避值","value":"1015"},{"name":"暴击值","value":"215"},{"name":"暴击伤害","val