e.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/797802.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/748241.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 小春（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/987922.png","url":"https://www.gamekee.com/ba/595927.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"下江コハル…。\nい、言っとくけど、ここに長くいるつもりはないから…！","zh":"我是下江小春，丑话说在前头，我我可不打算在这里待很久。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あ、先生、おかえり。","zh":"老师，你回来了。"},{"label":"登陆2","jp":"待ってたよ、先生。","zh":"老师，正等你呢。"},{"label":"大厅1","jp":"わ、私の前で、素行不良とか許さないから！","zh":"在，在我面前，绝不允许品行不端。"},{"label":"大厅2","jp":"成績のことは言わないで！ど、努力もしているも…","zh":"别提成绩好不好，我已经在努力了。"},{"label":"大厅3","jp":"頑張って、早く補習授業部を卒業してやるんだから","zh":"我一定要好好努力，早点离开补习部"},{"label":"大厅4","jp":"え、エッチなもの？そ、そういうのはダメ！見つけたった全部没収！焼却！","zh":"色色的东西，绝对不行，别让我看见，否则统统没收，全部烧掉。"},{"label":"大厅5","jp":"が、学生の身分で交際とかダメだから！そんなの不健全よ！\nキヴォトスではいけないことなの！","zh":"还……还没毕业就想交往，太不纯洁了，在基沃托斯绝不允许发生这种事。"},{"label":"回忆大厅1","jp":"な、何…！？(あ、あれっ……これって、まさか……！？)","zh":"干……干嘛？\n（这……莫非是）"},{"label":"回忆大厅2","jp":"、別に私、何も間違ったことは言ってないでしょ！？(待って、もしかしてこのままだと私、先生と……！？)","zh":"我……我说的……我说的那些都没有什么错吧！\n（等等，照这样下去，我和老师难道要……）"},{"label":"回忆大厅3","jp":"(こ、こういう展開、本で何度も見たことある……！本当に、本当にあの流れに入っちゃうの！？)","zh":"（这样的剧情发展，我在书上看到过好几次……\n不会吧，我会真的要走那个流程吧？）"},{"label":"回忆大厅4","jp":"(あ、あんなこととか、こんなこと、とか…)(っ！？ま、まさか、そんなことまで……！？)","zh":"（是这样这样……还是那样那样？\n难道还要变那样？？）"},{"label":"回忆大厅5","jp":"つ、ついに本性を表したわね、先生……！\n(やばいやばい……！ま、まだ覚悟とか、全然できてないんだけど……！？)","zh":"你……你终于还是露出真面目了吧，老师。\n（要命要命要命，我完全没有一丁点心理准备呀）"},{"label":"咖啡馆1","jp":"エッチなものとかがあったら、全部没収するからな！","zh":"色色的东西让我看到就全部没收。"},{"label":"咖啡馆2","jp":"みんな楽しいそうだね…","zh":"大家看起来都好开心啊。"},{"label":"咖啡馆3","jp":"うう……リア充め……","zh":"……可恶的现充。"},{"label":"咖啡馆4","jp":"あううう……","zh":"-"},{"label":"咖啡馆5","jp":"な、馴れ合うつもりはないから","zh":"谁要跟你好啊——"}],"好感度":[{"label":"好感度1","jp":"私はまだまだできないことだらけだけど……で、でもこれから努力するから！","zh":"我还有很多不会做的事情，但是我以后会努力的啦。"},{"label":"好感度2","jp":"もう！いつもそうやってからかって…でも、応援してくれてありがとう。","zh":"真是的，就知道开我玩笑，不过还是谢谢你帮我。"},{"label":"好感度3","jp":"エッチなのはダメ……って……えぇっと……や、やっぱりダメっ！","zh":"不可以色色，但是……我……还是不行！"},{"label":"好感度4","jp":"た、ただ生徒だから先生と仲が良いだけで他の意味はないんだから！ふん！","zh":"因为是老师嘛，关系很好也很正常吧，没有其他的意思……"}],"战斗":[{"label":"编入队伍1","jp":"ああ…","zh":"-"},{"label":"编入队伍2","jp":"仕方ないなぁ…","zh":"算了算了。"},{"label":"拎起","jp":"な、何するつもり?!!","zh":"你要干嘛？"},{"label":"任命队长1","jp":"こ、これぐらいなら……。","zh":"就干这个的话……"},{"label":"任命队长2","jp":"わ、私にだってできるってば！","zh":"我也是可以的。"},{"label":"普通技能","jp":"待ってて！","zh":"稍等一下。"},{"label":"EX动画1","jp":"えーっと、あれ！？","zh":"…………不对！"},{"label":"EX动画2","jp":"あれ？はぁ、ひゃー！","zh":"……不是这个"},{"label":"EX动画3","jp":"うーん……ひゃあ！","zh":"……拿错了"},{"label":"EX技能1","jp":"こ、これは没収したやつだから～！","zh":"这个是没收来的！"},{"label":"EX技能2","jp":"私のじゃないから誤解しないで！","zh":"这不是我的，不用误会"},{"label":"EX技能3","jp":"なんで持っているかって.......うるさいー！","zh":"为什么我要带着？要你管！"},{"label":"战斗开始1","jp":"さあ、行くわよ。","zh":"来，我们走吧。"},{"label":"战斗开始2","jp":"出発！","zh":"出发。"},{"label":"获得BUFF","jp":"オッケー！","zh":"ok"},{"label":"施放BUFF","jp":"行くわよ","zh":"要上了"},{"label":"掩体","jp":"遮蔽物確保っ！","zh":"占领掩体。"},{"label":"被CC1","jp":"きゃあ！","zh":"-"},{"label":"被CC2","jp":"痛い…","zh":"好疼"},{"label":"被CC3","jp":"うぅ！","zh":"-"},{"label":"回避","jp":"こ、これくらいなら！","zh":"这样我还可以"},{"label":"队伍移动1","jp":"楽勝だったよね。","zh":"很轻松。"},{"label":"队伍移动2","jp":"ほら、私の活躍のおかげよ","zh":"怎么样？多亏我吧"},{"label":"回复","jp":"まあ、ありがとう…","zh":"谢谢"},{"label":"中途退出","jp":"へん、まだ100%の実力を見せていないのに…","zh":"我还没有展现出百分之百的实力呢"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"特殊载具","jp":"元々乗っていたのは違うけど、しょうがない！","zh":"虽然说和之前坐过的不一样的，但是没办法了！"},{"label":"特殊载具","jp":"これもそんなに悪くないから、行くわよ。","zh":"也没那么糟嘛，出发吧。"},{"label":"角色移动","jp":"今行くわ。","zh":"我这就去。"},{"label":"战斗胜利1","jp":"これぐらい…大したことじゃないし…","zh":"这点小事，没什么大不了的"},{"label":"战斗胜利2","jp":"これでいいのよね","zh":"这样就可以了"},{"label":"关卡完成1","jp":"","zh":"赢了"},{"label":"关卡完成2","jp":"","zh":"看到啦？这就是我的实力哦"},{"label":"战斗失败1","jp":"う、うぅ……負けちゃった……","zh":"输了"},{"label":"战斗失败2","jp":"うぅ……ごめんなさい……","zh":"对不起"}],"成长":[{"label":"升级1","jp":"こ、ここまでしてくれなくてもいいのに…","zh":"对我不用这么上心的。"},{"label":"升级2","jp":"成長を見守ってるなんて、なんかいやらしい…","zh":"见证我的成长？说什么呢，听着怪怪的。"},{"label":"升级3","jp":"ほら、私もこんなに成長できるのよ！","zh":"怎么样，我成长的厉害吧。"},{"label":"升级4","jp":"ふふっ。悪くない結果でしょ？","zh":"成果还不错。"},{"label":"获得专武","jp":"私もここまで来られた。先生、見てる？ここからがスタートだから。これからも、見守っててよね。","zh":"我也成长到这种程度了，老师看到没？\n这才刚刚开始呢，以后也要看着我。"}],"事件":[{"label":"学生生日","jp":"わ、私の誕生日、覚えてたの？あ、ありがとう……。\nまさか覚えてると思わなかった……ちょ、ちょっと嬉しいかも？","zh":"你知道是我生日？\n谢谢，真没想到你会记着，好像有点开心。"},{"label":"老师生日","jp":"先生の誕生日なんでしょう。今日くらい少しゆっくりしても……。\nや、やっぱり今の無し、ちゃんと真面目に仕事して！","zh":"今天是老师的生日吧？那稍微放松一下也……\n算了，当我没说，还是好好干活吧。"},{"label":"万圣节","jp":"飴？そんなのとっくに卒業したけど？わ、私はもっと大人の……\nな、なんでもない。","zh":"糖？我早就过了那个岁数了好吧，\n我想要更成熟的……没事！"},{"label":"新年","jp":"お正月なのに、私と居ていいの？\nわ、私は別に構わないけど……？","zh":"大过年的跟我在一起，\n我……我倒是无所谓。"},{"label":"圣诞节","jp":"せ、聖なる夜を汚すような、不埒な行為は全部禁止よ！先生、聞いてる！？","zh":"禁止一切玷污神圣夜晚的不纯洁行为，老师听见没有？"},{"label":"春节","jp":"","zh":"老师，你可不要因为今天是特殊的日子就想入非非啊。"},{"label":"中秋","jp":"","zh":"这……这个月饼是给我的吗？你可别想就这样让我放松警惕。"}]},"stats":{"init":[{"name":"攻击力","value":"254"},{"name":"防御力","value":"24"},{"name":"生命值","value":"2729"},{"name":"治愈力","value":"2530"},{"name":"命中值","value":"923"},{"name":"闪避值","value":"194"},{"name":"暴击值","value":"205"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1948"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6325"},{"name":"防御力","value":"134"},{"name":"生命值","value":"45919"},{"name":"治愈力","value":"15675"},{"name":"命中值","value":"923"},{"name":"闪避值","value":"194"},{"name":"暴击值","value":"355"},{"name":"暴击伤害","value":"220%"},{"name":"稳定值","value":"1948"},{"name":"射程","value":"750"},{"na