/72324/2025/5/5/652921.png","url":"https://www.gamekee.com/ba/89274.html"},{"name":"★3 妮露","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/5/696400.png","url":"https://www.gamekee.com/ba/67012.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive!"},{"label":"卡池抽取","jp":"ミレニアムサイエンススクールの美甘ネル、\nただいま参上したぜ、っと……。\nあぁ？この服？なにかおかしいっていうのか？","zh":"千禧年科技学院的美甘妮露，现在抵达……啊？这身衣服？很怪吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"よ、先生！\nあぁ？べ、別に待ってた\nわけじゃねぇぞ！？","zh":"老师！你可算来啦！啊？我才没特意等你呢！"},{"label":"登陆2","jp":"何しょぼくれてんだよ。\nあたしがそばに居るだろ！","zh":"怎么愁眉苦脸的？给我支棱着点！有我在呢！"},{"label":"大厅1","jp":"なーんか、\nムズムズするんだよな……\n普段と違うからだろうけどさ。\nはぁ……上着が恋しいぜ。","zh":"总感觉手痒得很哪……应该是因为和平时不太一样吧。\n唉……还是想念我的刺绣夹克呀。"},{"label":"大厅2","jp":"あぁ？制服を着て\n大人しくなった？\nんなわけあるか！\n今日はちょっと\n元気がないだけだ。","zh":"啊啊？说我穿上制服好像变文静了？\n少啰嗦！只是今天状态不好而已！"},{"label":"大厅3","jp":"なっ……制服、\nよく似合ってるね……！？\nほ、褒めても何も出ねぇぞ！","zh":"什……？！你说制服很适合我……？！夸我也没你的好处，老师！"},{"label":"大厅4","jp":"先生、得意な教科はあるか？\nいや……なんだ？\nせっかく制服着てることだし、\n勉強でもしようかと。","zh":"没啥事差遣我吗？不是……既然都穿上制服了嘛，总觉得好像应该去课桌前坐坐。"},{"label":"大厅5","jp":"今一番落ち着ける場所……\nここじゃねぇか？","zh":"穿着这身衣服在哪儿最自在……？不就是这儿吗？"},{"label":"回忆大厅1","jp":"お！見ろよ先生！\n色んなもんがあるぞ！\nん？どうかしたのか？","zh":"喔哦，这儿什么都有！我还挺喜欢这儿的，老师。\n啊，干嘛这么盯着我看......"},{"label":"回忆大厅2","jp":"あ～、まぁ……\nそりゃあな。\n今はC＆Cでもないし、\n先生とは先輩後輩の\n関係でもないだろ。","zh":"啊，我还当你要说什么呢，那当然啦。\n现在嘛，我既不是C&C的人，也不用摆什么前辈架子。"},{"label":"回忆大厅3","jp":"ここに知り合いなんて\nいねぇしさ。\n今くらい、許してくれよ。","zh":"反正周围也没熟人，除了老师。\n你说是不是。"},{"label":"回忆大厅4","jp":"というか、やっぱ……\n普段みたいな方がいいか？","zh":"那不然呢，难道说？\n你觉得我还是平时那样更好？"},{"label":"回忆大厅5","jp":"ははっ！\nそう言うと思った！\nまあ、そんなに時間に\n余裕があるわけじゃねえし……\nそろそろ行こうぜ！\n次はあっちだ！","zh":"啊哈哈，我就知道你会这么说。\n嗯，那咱们就别在这废话了。\n那边好像有什么新鲜玩意儿，走，咱们接着逛。"},{"label":"咖啡馆1","jp":"（なんだあれ？カッケェ！）","zh":"（那是什么？也太帅了吧？！）"},{"label":"咖啡馆2","jp":"まあ悪くねえな。ちっと一休みするっか。","zh":"嗯，还行。稍微歇会儿吧。"},{"label":"咖啡馆3","jp":"なんか落ち着かねんだよな…上着がないからか？","zh":"肩上空落落的，还真不习惯啊。"},{"label":"咖啡馆4","jp":"先生はいつ来るんだ……？","zh":"老师什么时候才来啊……"},{"label":"咖啡馆5","jp":"お、これいいな！部室に飾りたいくらいだ。","zh":"哦？这家具不错嘛？要不搬活动室去？"}],"好感度":[{"label":"好感度1","jp":"どんな格好だろうと、あたしはあたしだ。\n先生もいつも通りに接してくれよな？","zh":"不管穿成什么样子，我就是我。老师你也像平常那样对我就行"},{"label":"好感度2","jp":"うーん、なんか胸がポカポカするっていうか、ムズムズするっていうか……。\nいや！別に嫌じゃねぇんだけど……。","zh":"呃……总觉得心里痒痒的，又有种很温暖的感觉……啊不是，也没有不喜欢啦……"},{"label":"好感度3","jp":"な、なんかいつもより恥ずかしい気が……。\nクソッ、なんだよこれ！","zh":"怎，怎么感觉比平时还害羞……见鬼，这是什么情况？！"},{"label":"好感度4","jp":"よかったら、散歩でも行かねぇか？\n案内するぜ。","zh":"老师……要去散个步吗？难得穿成这样……"}],"战斗":[{"label":"编入队伍1","jp":"しゃあねえなぁ。","zh":"真拿你没办法。"},{"label":"编入队伍2","jp":"あ？また仕事か？","zh":"怎么了？又出什么事了？"},{"label":"拎起","jp":"はぁ、上着がねぇとなんか微妙なんだよなぁ。","zh":"唉……少了它还真不习惯。我说刺绣夹克啊。"},{"label":"任命队长1","jp":"案内するのも楽じゃねぇな。","zh":"这向导的活儿可真够呛。"},{"label":"任命队长2","jp":"ちっと多すぎねぇか？","zh":"怎么有这么多破事儿？"},{"label":"普通技能","jp":"おぉ、なんか凄いな！おっ、よっ、おぉ！","zh":"嚯，这玩意儿够带劲啊？"},{"label":"EX动画1-1","jp":"あーめんどくせぇなぁ……おい、そこ動くなよ！","zh":"唉，真麻烦。在原地等着别动啊。"},{"label":"EX动画1-2","jp":"てめぇら、歯ぁ食いしばってろよ！","zh":"被我逮了个正着。咬紧牙关接招吧。"},{"label":"EX动画1-3","jp":"悪気？あるに決まってんだろ！","zh":"觉得不爽……？那当然了！"},{"label":"EX技能1-1","jp":"手間掛けさせやがって……。","zh":"该收尾了吧？"},{"label":"EX技能1-2","jp":"すぐに終わらせてやる。","zh":"就这？轮到我了！"},{"label":"EX技能1-3","jp":"これで終わりだ。","zh":"没用没用没用没用！"},{"label":"EX动画2-1","jp":"そろそろケリつけようぜ！","zh":"净会给我找麻烦！"},{"label":"EX动画2-2","jp":"そうかよ、んじゃこっちの番だな！","zh":"马上就能搞定。"},{"label":"EX动画2-3","jp":"無駄無駄！","zh":"这下就完事了。"},{"label":"EX技能2-1","jp":"オラオラァ！","zh":"看招——！！"},{"label":"EX技能2-2","jp":"-","zh":"呜哈哈——！！！"},{"label":"EX技能2-3","jp":"無駄なんだよ！","zh":"都说了没用的——！"},{"label":"战斗开始1","jp":"おっし、行くぞ！","zh":"好——！开工吧——！"},{"label":"战斗开始2","jp":"んだよ、この量は。","zh":"这都什么乱七八糟的？"},{"label":"获得BUFF","jp":"おう、サンキュー！","zh":"呦，谢啦！"},{"label":"施放BUFF","jp":"じゃ行くか！","zh":"走啦！"},{"label":"掩体","jp":"ダリぃな！","zh":"就这点本事……！"},{"label":"被CC1","jp":"いってぇな！","zh":"疼死啦！"},{"label":"被CC2","jp":"くそ！","zh":"可恶！"},{"label":"被CC3","jp":"ちっ…","zh":"切！"},{"label":"回避","jp":"くすぐってぇな。","zh":"别挠我痒痒！"},{"label":"队伍移动1","jp":"次！","zh":"下一个！"},{"label":"队伍移动2","jp":"まだ残ってんのか？","zh":"还有不怕死的吗？"},{"label":"回复","jp":"ありがとよ！","zh":"漂亮！"},{"label":"中途退出","jp":"ちっ…","zh":"切！"},{"label":"战斗喊叫","jp":"は！","zh":"-"},{"label":"战斗喊叫","jp":"くらえ！","zh":"吃我这招！"},{"label":"战斗喊叫","jp":"どりゃ！","zh":"喝呀！"},{"label":"角色移动","jp":"-","zh":"哈啊！"},{"label":"战斗胜利1","jp":"こんなもんかよ…。","zh":"还以为有什么大阵仗呢……"},{"label":"战斗胜利2","jp":"相手があたしだって気付かなかったかよ。","zh":"看来你还没搞清楚，你的对手是谁啊。"},{"label":"关卡完成1","jp":"よし！綺麗になったな！","zh":"这下够利索了吧？"},{"label":"关卡完成2","jp":"足りないとこがあるなら言いな？一気に終わらせてやるよ。","zh":"还有多少？现在就告诉我，我一次性搞定。"},{"label":"战斗失败1","jp":"は～……我慢だ、我慢……。","zh":"诶，忍了，我忍！"},{"label":"战斗失败2","jp":"イライラさせやがって……！","zh":"在这样下去我可要发飙了！"}],"成长":[{"label":"升级1","jp":"悪い気はしねぇなぁ。サンキュー！","zh":"有两下子嘛！谢啦！"},{"label":"升级2","jp":"えっ？あぁ、まぁ、その……ありがとな。","zh":"诶？啊啊……呃，那个……谢了。"},{"label":"升级3","jp":"なんつーか、本当の生徒と先生みたいだよな。\nあいや、合ってるか。","zh":"这样还真像学员跟老师呢。……啊，不对哦？我们本来就是啊。"},{"label":"升级4","jp":"ありがとうございます、先生！\n……ってのはどうだ！変か？","zh":"……谢谢老师~！……这样你喜欢吗？"},{"label":"获得专武","jp":"考えてみたら全然普段と\n変わんねぇんだけど……\nなーんか、特別に感じるんだよな。\n……ま、あたしと先生の仲だし、\n気にしてもしょうがないか！","zh":"仔细想想其实也没什么，但总觉得有点不一样呢。……嗯，不过无所谓！反正老师和我谁跟谁嘛！"}],"事件":[{"label":"学生生日","jp":"ははっ！やっぱ覚えてて\nくれたのか！\nありがとな！","zh":"哈哈！果然记得啊！谢啦！"},{"label":"老师生日","jp":"今日は先生の誕生日だろ？\n誕生日おめでとさん！\nせっかくだし、\n遊びに行かねぇか？","zh":"老师，生日快乐！机会难得，我们出去玩玩？"},{"label":"万圣节","jp":"他の連中は毎日制服きてるけど\nあたしにとっては\n仮装みたいなもんなんだよな。","zh":"制服……对其他人来说是日常打扮，可对我来说跟万圣节变装差不多。"},{"label":"新年","jp":"明けましておめでとう、先生。\n今年もよろしくな。\nん？なんで制服なのかって？\nそりゃあ……\n先生が似合うって\n言ってくれたし……\n今日くらいは\n着てもいいかなって。","zh":"新年快乐啊，老师。嗯？这身衣服？\n唔，还不是因为你说合适……就想说新年偶尔穿穿看呗。"},{"label":"圣诞节","jp":"クリスマスか……\nあ、そうだ。\nプレゼントに\nあたしの上着はどうだ？\n今着てないし、\n羽織ってみろよ！","zh":"圣诞礼物啊……啊对了老师，要试试我的刺绣夹克吗？反正我现在穿制服，可以借你！"},{"label":"春节","jp":"","zh":"老师，新年好啊！红包拿来！嘿嘿，别说你没准备啊，我这儿可等着呢！"},{"label":"中秋","jp":"","zh":"月饼？呵，那种又甜又腻的东西……啊？我，我又没说不吃！老师要是非请我吃，那我勉为其难尝一口也行。"}],"活动":[{"label":"活动登陆1","jp":"よお、先生！\nこっち、こっち！","zh":"喂！老师！这儿，看这儿！"},{"label":"活动登陆2","jp":"あ、先生じゃん！\n遅いぞ！","zh":"啊，老师！怎么这么晚才来？"},{"label":"活动大厅1","jp":"なんだ？\n用事があるなら\nさっさと言ってくれ。","zh":"嗯？叫我？有事就说啊。"},{"label":"活动大厅2","jp":"はぁ？\nつついてみただけ？\nなんだそりゃ","zh":"啊啊？就是随便戳戳看？你这人真是……"},{"label":"活动大厅3","jp":"……はぁ、ガキみてぇな\nことしやが