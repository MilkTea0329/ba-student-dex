ng","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/4/977795.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/4/990430.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 妮露（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/4/693896.png","url":"https://www.gamekee.com/ba/89274.html"},{"name":"★3 妮露（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_100/h_81/829/86082/2025/6/17/592914.png","url":"https://www.gamekee.com/ba/tj/645823.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ！","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"あぁ？？？\nったく、結局見つかっちまったか。\nこうなった以上、手伝うしかねえな。","zh":"啊？哎还是被逮到了，没辙，那只能搭把手了。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"よお、先生！遅かったじゃん。","zh":"嘿老师，你来的也太晚了。"},{"label":"登陆2","jp":"ほら、先生！今日も楽しく行こうぜ！","zh":"好了老师，今天也痛痛快快上路吧。"},{"label":"大厅1","jp":"ったく、あたしを待たせるとは、呆れたもんだぜ。","zh":"受不了，居然让我等你？真无语。"},{"label":"大厅2","jp":"さあ～て、掃除でもしに行くか？","zh":"好嘞，去打扫一下吧。"},{"label":"大厅3","jp":"最高の奴と一緒に働く感覚、もう分かっただろ？","zh":"现在知道跟扛把子搭档是什么感觉了吧。"},{"label":"大厅4","jp":"仕事はきっちりやるぞ。","zh":"活要踏踏实实的干。"},{"label":"大厅5","jp":"助けが必要ならいつでも言えよ。何でもやってやる。","zh":"需要帮忙就别客气，直接说，什么事都能给你摆平。"},{"label":"回忆大厅1","jp":"ようこそ、先生。あたしだけの特等席、歓迎するぜ！","zh":"你来啦，老师，这可是我专属的特等席，欢迎你啊。"},{"label":"回忆大厅2","jp":"あたしはこの学園が好きだ。それに…この瞬間も。","zh":"我很喜欢这个地方，也很喜欢现在这个瞬间。"},{"label":"回忆大厅3","jp":"怖くないのかって？全然。ただ、ドキドキはしてる。","zh":"你问我怕不怕？不怕啊，就是心跳得有点快。"},{"label":"回忆大厅4","jp":"まあ、たまにはサボるのも悪くねぇな。ははは！","zh":"那啥，偶尔像这样偷偷来也不错嘛，哈哈哈哈。"},{"label":"咖啡馆1","jp":"えっと…だから…バ、バカ！先生のバカ野郎！","zh":"呃，就是，笨蛋，你这个笨蛋老师!"},{"label":"咖啡馆2","jp":"うぅ…恥ずかしい、けど。あ、ありがとな！","zh":"呃，有点不好意思，不过谢谢了。"},{"label":"咖啡馆3","jp":"なあ…だからその…い、一緒に行くぞ！","zh":"那什么，就是那个，一起去吧！"},{"label":"咖啡馆4","jp":"へぇ、なかなかいい場所だな。","zh":"欸？这个地方还挺不错嘛。"},{"label":"咖啡馆5","jp":"なんだ？応援でもしてくれてんのか？はっ！面白いじゃん。","zh":"怎么？你这是在鼓励我吗？有点意思。"},{"label":"咖啡馆6","jp":"一番面白い事？まあ、そりゃあ勝つことだな。","zh":"最喜欢什么样的感觉？这个嘛，当然是赢的感觉啦。"}],"好感度":[{"label":"好感度1","jp":"うあぁぁ！？あんまり近づくな！ぶっ殺すぞ、ぶっ殺すっての！","zh":"哇！别靠这么近，宰了你哦！真的宰了你！"},{"label":"好感度2","jp":"あのさ、先生が来てくれて悪くない気分だよ……。ああもう！今の私何言ってんだ！","zh":"那什么，老师能来，我心情还不错，啊！我到底在说什么东西啊！"},{"label":"好感度3","jp":"何でだろう……先生に会うと、変な気分になるんだよな……","zh":"怎么搞的，一见到老师就觉得怪怪的…"},{"label":"好感度4","jp":"ありがとう、先生。先生がいってくれて良かった。","zh":"老师，谢谢啦，有老师在真好。"}],"战斗":[{"label":"编入队伍1","jp":"はぁ…やるんだな？","zh":"哎，要干了是吧？"},{"label":"编入队伍2","jp":"面倒だけど、仕方ねぇ。","zh":"烦死了，哎，行吧。"},{"label":"拎起","jp":"あぁ？うざいんだよ。","zh":"啊？烦不烦呐！"},{"label":"任命队长1","jp":"へぇ、ここが今回の戦場か。","zh":"啊？这就是这次的战场啊。"},{"label":"任命队长2","jp":"逃げねぇのは褒めてやる。","zh":"没跑嘛，那表扬你一下！"},{"label":"普通技能","jp":"ああん、殺されてぇのか？","zh":"哈？活腻了吧你。"},{"label":"EX动画1","jp":"あぁ！？ぶっ殺すぞ！","zh":"嗯？宰了你信不信？"},{"label":"EX动画2","jp":"ふざけてんのか！！","zh":"跟我逗闷子吗你？"},{"label":"EX动画3","jp":"舐めんな！","zh":"找k是吧！"},{"label":"EX技能1","jp":"おらおらおらおらあぁぁぁぁぁぁ！！！","zh":"我打我打我打！"},{"label":"EX技能2","jp":"戦う相手を間違えたなぁっ！！","zh":"你挑错对手了！"},{"label":"EX技能3","jp":"ゴミは掃除しねぇとなぁぁぁぁぁぁ！！！！","zh":"垃圾就要扫干净了！"},{"label":"战斗开始1","jp":"てめぇら、ぶっ壊しに行くぞ！","zh":"小的们，拆场子去了！"},{"label":"战斗开始2","jp":"コールサインダブルオー、掃除を始める。","zh":"呼号DOUBLE O 开始清扫！"},{"label":"获得BUFF","jp":"別にいらねってのに……","zh":"都说了不用了！"},{"label":"施放BUFF","jp":"イライラさせやがって！","zh":"越看你越不爽！"},{"label":"掩体","jp":"うっし、行くぞ！","zh":"好，冲吧！"},{"label":"被CC1","jp":"くっそ……！","zh":"（消音）（根据日配来说这里可能是一种植物）"},{"label":"被CC2","jp":"めんどくせぇなぁ……","zh":"麻烦死了！"},{"label":"被CC3","jp":"ちっ……","zh":"嘁.."},{"label":"被CC4","jp":"\\","zh":"\\"},{"label":"被CC6","jp":"\\","zh":"\\"},{"label":"回避","jp":"そんなもんかよ？","zh":"就这点本事？"},{"label":"队伍移动1","jp":"大方片付いたなぁ、次！","zh":"差不多收拾干净了，继续！"},{"label":"队伍移动2","jp":"ちったぁ暴れがいあるじゃねぇか。","zh":"挺过瘾嘛，有点意思。"},{"label":"回复","jp":"へぇ？なかなかセンスあるじゃねぇか！","zh":"嚯！你还挺有眼力见的嘛。"},{"label":"中途退出","jp":"みっとも、ねぇ……","zh":"真是，丢人…"},{"label":"战斗喊叫","jp":"-","zh":"嗨！"},{"label":"战斗喊叫","jp":"-","zh":"哈！要上了！"},{"label":"战斗喊叫","jp":"-","zh":"我打我打！"},{"label":"角色移动","jp":"はっ、そっちか！","zh":"哼，在那啊！"},{"label":"战斗胜利1","jp":"てめぇらの最大のミスは、あたしの行く手を塞いだってことだ。","zh":"一帮杂碎，你们最大的失误就是挡了我的道。"},{"label":"战斗胜利2","jp":"清掃完了だ。","zh":"清扫完成啦！"},{"label":"关卡完成1","jp":"こういう戦いはあたしの得意分野だからな。","zh":"这么打，我可擅长了！"},{"label":"关卡完成2","jp":"はっ、先生。思ったよりやるねぇ。","zh":"哼，老师，你比我想的能干多了。"},{"label":"战斗失败1","jp":"負けた？ちげぇよ、まだ勝ってねぇだけだ。","zh":"输了？才怪，只是还没赢罢了。"},{"label":"战斗失败2","jp":"大丈夫だ、次はぶっ壊してコナゴナにしやっからよ。","zh":"没事，下回给他轰成渣！"}],"z'd":[{"label":"被CC5","jp":"\\","zh":"\\"}],"成长":[{"label":"升级1","jp":"ははっ！先生、いい選択だな！期待してろよ！","zh":"哼，老师，挺会选的嘛，你就瞧好吧！"},{"label":"升级2","jp":"へぇ、いい感じじゃねぇか。何でも任せろ！","zh":"嘿？感觉挺像样嘛，我办事你放心！"},{"label":"升级3","jp":"いやぁ、うきうきするな！始めようぜ、先生！","zh":"嘿！给我俩造起来了，还不赶紧走，老师？"},{"label":"升级4","jp":"先生、自信を持て。あたしがそばにいるからよ。","zh":"老师，自信点，你身边可有我呢！"},{"label":"获得专武","jp":"鬼に金棒、龍に翼。\nそしてあたしには二丁のサブマシンガン！","zh":"什么叫如鱼得水，如虎添翼啊？那就是给我两挺冲锋枪！"}],"事件":[{"label":"学生生日","jp":"はは、先生！今日が何の日か分かるか？\n別に知らなかった、でもいいけど、あたしはプレゼントをもらうからな。\nほら、い・ま・す・ぐ！","zh":"嘿嘿，老师，你知道今天是什么日子吗？\n不知道也没事，但礼物我必须得收，快点儿！一！二！三！"},{"label":"老师生日","jp":"よお、先生。ハッピーバースデー！\nあのさ…。偶然…もらったケーキがあるんだけど……食べるか？","zh":"嘿..老师..生日快乐..那什么碰巧有人送我一个蛋糕…吃吗？"},{"label":"万圣节","jp":"よお、先生。トリックオアトリートだよ。\n…はぁっ？どんな意味か知らねえのか？","zh":"嘿老师，不给糖就捣蛋喽，啊？你不懂什么意思？"},{"label":"新年","jp":"よお、先生。ハッピーニューイヤーだな。\n今年も…だから…。あぁもう！よろしくってことだよ！！","zh":"嘿老师，新年快乐啊，今年，呃啊，烦死了！总之多关照！"},{"label":"圣诞节","jp":"よお、先生。メリークリスマス…だろ？\n…ないのか？プレゼントだよ！","zh":"嘿老师，怎么说来着，圣诞快乐？没有，我说礼物！"},{"label":"春节","jp":"","zh":"说了多少次了，我们Ｃ&Ｃ一般不帮人扫地！新春大扫除不要找……原来是老师啊……那，那也……"},{"label":"中秋","jp":"","zh":"呀，老师～就是……啊，就是那个……中秋快乐！嗯？要给我月饼？啊……要是太多了老师吃不了，那我就拿一个！"}]},"stats":{"init":[{"name":"攻击力","value":"254"},{"name":"防御力","value":"17"},{"name":"生命值","value":"2523"},{"name":"治愈力","value":"1643"},{"name":"命中值","value":"99"},{"name":"闪避值","value":"847"},{"name":"暴击值","value":"274"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1400"},{"name":"射程","value":"450"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"24 (6)"},{"nam