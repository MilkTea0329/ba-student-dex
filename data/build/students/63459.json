ame":[{"name":"★3 玛丽（体操服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/10/72608.png","url":"https://www.gamekee.com/ba/170297.html"},{"name":"★3 玛丽（偶像）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_606/h_605/829/86082/2025/5/10/426173.png","url":"https://www.gamekee.com/ba/68790.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"全ての出会いは必然……\nこれからどうぞよろしくお願いします、先生。","zh":"一切相遇，皆是必然。老师，请多关照。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生。\n今日もお会いできて嬉しいです。","zh":"您来了，老师，今天你也依然那么耀眼呢。"},{"label":"登陆2","jp":"今日も良い一日になりますように、祈っておりますね。","zh":"愿恩典常伴您左右，希望您今天也能度过美好的一天。"},{"label":"大厅1","jp":"少し、お話を聞いていかれませんか？","zh":"有一句良言你想听吗？"},{"label":"大厅2","jp":"ふ、不埒なことは駄目ですよ……？","zh":"不不敬之事，请您克制。"},{"label":"大厅3","jp":"（私の祈りが、先生を守ってくれますように……）","zh":"希望我的祈祷能守护老师。"},{"label":"大厅4","jp":"辛いときは、私に頼ってくださっても良いのですよ。","zh":"疲惫的时候可以依赖我哦。"},{"label":"大厅5","jp":"先生でしたら……いえ、きっと大丈夫です。","zh":"如果是老师的话，或许一定没关系的。"},{"label":"回忆大厅1","jp":"……来ていただいてありがとうございます、先生。\nはい、先生のことを 祈っておりました。","zh":"感谢您的到来，老师。我正在为老师祈祷。"},{"label":"回忆大厅2","jp":"このように静かな場所は、お祈りにピッタリです。\n祈っているはずの私の心も、 まるで洗われていくようで……。","zh":"像这种肃静的地方，正适合祈祷。\n祈祷的时候，我的心灵也会变得沉静。"},{"label":"回忆大厅3","jp":"先生がこれまで積み上げてきた道、そしてこれから選ばれる道……。\nそこにどうか、 できるだけ多くの平和と、幸せがありますように……。","zh":"我祈愿老师在至今为止走过的道路上，还有未来选择的道路上。\n愿您在每一条路上都有和平相随，与幸福相伴。"},{"label":"回忆大厅4","jp":"え、自分のことも祈らないの……ですか？\nそれは…… いえ、大丈夫なんです。","zh":"我有没有为自己祈祷过？这个没关系。"},{"label":"回忆大厅5","jp":"先生が幸せでしたら、私も幸せですので。\nつまりこれは、 私たちのための祈り……なのかもしれません。","zh":"因为看到老师幸福，我也会感到幸福。\n也可以说，这就是为了我们两个人的幸福而祈祷呢。"},{"label":"咖啡馆1","jp":"これから先ずっと、この場所に祝福がありますように","zh":"愿祝福降临此处。"},{"label":"咖啡馆2","jp":"この世が、少しでも平和でありますように……","zh":"愿这个世界得到片刻宁静。"},{"label":"咖啡馆3","jp":"神聖な気配が感じられます、素晴らしい場所ですね","zh":"我感受到了神圣的气息。"},{"label":"咖啡馆4","jp":"今日も良いお天気ですね","zh":"今天天气很好呢。"},{"label":"咖啡馆5","jp":"少しくらいでしたら……\nここで、休憩していっても良いでしょうか？","zh":"只是一小会儿的话，在这稍微歇一歇再走也没关系。"}],"好感度":[{"label":"好感度1","jp":"なんだか、心が安らぐようです。","zh":"不知为何，有种安心的感觉。"},{"label":"好感度2","jp":"先生、私、先生のことを心から尊敬しております。","zh":"老师，我真心的尊敬你。"},{"label":"好感度3","jp":"愛とは崇高なもの。ですが…困りましたね。","zh":"爱是崇高的，但是。真是苦恼。"},{"label":"好感度4","jp":"どうしましょう……。この気持ちは……。","zh":"该拿这种心情如何是好呢？"}],"战斗":[{"label":"编入队伍1","jp":"これが、私に与えられた運命でしたら","zh":"如果这就是我的命运。"},{"label":"编入队伍2","jp":"はい、喜んで","zh":"非常荣幸。"},{"label":"拎起","jp":"この祈りが、皆さんのお役に立てますよう……","zh":"愿这份祈祷，能够帮到大家……"},{"label":"普通技能","jp":"安らぎがあらんことを。","zh":"愿和平与你同在。"},{"label":"EX动画1","jp":"聖なる力よ……","zh":"神圣之力啊……"},{"label":"EX动画2","jp":"祈りを…そして…","zh":"首先献上祈祷"},{"label":"EX动画3","jp":"心から祈ります。","zh":"衷心祈愿"},{"label":"EX技能1","jp":"すべての方に、祝福を！","zh":"为诸位献上祝福。"},{"label":"EX技能2","jp":"すべての方に、救いを！","zh":"为诸位带来救赎。"},{"label":"EX技能3","jp":"すべての方に、ご加護を！","zh":"为诸位施以加护。"},{"label":"战斗开始1","jp":"どうか、我々の行く先にご加護がありますように。","zh":"请保佑我们一路平安。"},{"label":"战斗开始2","jp":"体には十分気を付けていきましょう","zh":"注意安全，不要受伤。"}],"成长":[{"label":"升级1","jp":"そのお気持ちに応えられるよう、誠心誠意、努力いたしますね。","zh":"为了回应您的信任，我将尽我所能。"},{"label":"升级2","jp":"聖なる力が、体の中にあふれて……","zh":"神圣的力量溢满全身。"},{"label":"升级3","jp":"今後も、より一層精進して参ります。","zh":"今后我也将继续精进。"},{"label":"升级4","jp":"こんなに素敵なものを、私に……これを、私がいただいてしまっても、良いのでしょうか？","zh":"这么美好的东西，我真的可以收下吗？"},{"label":"获得专武","jp":"あまり、武器は使いたくないのですが……\n平和のためでしたら。","zh":"虽然我不想使用武器，但这是为了和平。"}],"事件":[{"label":"学生生日","jp":"お誕生日にこうして、先生と一緒にいられるだなんて……\n幸せ過ぎてなんだか、 あとで罰が下ってしまわないか心配です。","zh":"既然能这样跟老师一起过生日，我都有些担心了。\n收到了这么棒的礼物，我不会因此受到惩罚。"},{"label":"老师生日","jp":"今日この日に先生が生を受けたからこそ、\n私たちはこうして出会うことができました。\n今日という日に、 心からの感謝を。","zh":"正因为老师在这一天诞生了，我们才能像这样相遇。\n在今天这个特殊的日子里，我将送上衷心的感谢。"},{"label":"万圣节","jp":"飴さん……あ、いえ、大丈夫です。\nシスターとして、 節制は大切ですので。","zh":"糖果就不用了，毕竟禁欲是姐妹会的美德之一。"},{"label":"新年","jp":"あけましておめでとうございます。\n今年はどんな素敵なことが待っているのか……\n今から楽しみですね。","zh":"新年快乐，今年又会有什么开心的事在等着我们呢？\n我已经开始期待了。"},{"label":"圣诞节","jp":"今日は、偉大なる方の降誕祭……。\n敬虔に、 この聖なる一日を過ごすとしましょう。","zh":"今天是伟大的圣子诞生的祝日，希望今天能度过虔诚神圣的一天。"},{"label":"春节","jp":"","zh":"老师，新春快乐。愿和平与安宁今年也与您同在。"},{"label":"中秋","jp":"","zh":"在这样的节日，能和老师一起仰望明月，我感到无比安宁。"}]},"stats":{"init":[{"name":"攻击力","value":"162"},{"name":"防御力","value":"18"},{"name":"生命值","val