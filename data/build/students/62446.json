nimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"1705"},{"name":"攻击力","value":"69"},{"name":"治愈力","value":"214"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/5/967544.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/5/357999.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 妮露","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/5/781761.png","url":"https://www.gamekee.com/ba/67012.html"},{"name":"★3 妮露（制服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_100/h_81/829/86082/2025/6/17/592914.png","url":"https://www.gamekee.com/ba/tj/645823.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"ったく、なんでこんな変な服を…\nま、意外と動きやすいから良いけどな、ははっ！","zh":"真是的，为什么要穿这么奇怪的衣服，\n不过活动起来倒是很方便，哈哈。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おっ、先生じゃねぇか！待ってたぜ、ちょっと面貸せよ","zh":"这不是老师吗？正等你呢。"},{"label":"登陆2","jp":"良いタイミングで来たじゃねぇか！おら、一緒に行くぞ先生！","zh":"老师，你来的正是时候，我们去热闹一下吧。"},{"label":"大厅1","jp":"何でそんなじっと見てんだよ……。何か変か、これ？","zh":"干嘛盯着我看？\n这衣服有什么奇怪的吗？"},{"label":"大厅2","jp":"……あん？スカジャン？これは譲れねぇんだよ、どんな格好でもな。","zh":"外套这个可不能脱，去哪儿我都要穿着。"},{"label":"大厅3","jp":"あー、暇だ……何でも良いから仕事させてくれ。暇なのは性に合わねえ……。","zh":"无聊死了，不管什么都可以，随便给我安排点工作，我一闲下来就浑身难受。"},{"label":"大厅4","jp":"先生は何か欲しいもんとかねぇのか？\n……いや、別に、何かあんなら協力してやろうかと思って","zh":"老师没什么想要的吗？没事，我只是想问问要不要我帮忙。"},{"label":"大厅5","jp":"ちょっ、耳は触んな！？\n……や、よく考えたら別にこれ、あたしの耳じゃねーな……？","zh":"别摸我耳朵！\n不对，仔细想想，这好像也不是我的耳朵。"},{"label":"回忆大厅1","jp":"い、でぇ…","zh":"恩...呃啊"},{"label":"回忆大厅2","jp":"はぁ……な、何だよその目は。","zh":"干嘛？为什么这样看着我？"},{"label":"回忆大厅3","jp":"……ん、OK。ちゃんと貼れたか？\nああ、大丈夫だな、サンキュ。","zh":"OK，\n贴好了吗？没问题了，谢了。"},{"label":"回忆大厅4","jp":"……言っとくけどあたし、普段はこういうこと誰かにやってもらったりしねぇから。先生だからお願いしたんであって……。","zh":"话说在前头，一般来说，这种事我可不会随便让别人帮忙。\n因为是老师，所以才拜托你的。"},{"label":"回忆大厅5","jp":"……まあ良いや。相変わらず、先生は変なやつだな。","zh":"算了，老师你还是这么奇怪。"},{"label":"回忆大厅6","jp":"ま、だからこそ……ってな。\n……もう分かってるだろうけど、こういうの、他のやつには言うんじゃねーぞ？","zh":"所以怎么说呢？\n你应该明白吧，这件事可千万不能告诉别人哦"},{"label":"咖啡馆1","jp":"何だか、いつも以上に視線が……この服のせいか？","zh":"感觉盯着我的家伙比平时还多，是因为这件衣服吗？"},{"label":"咖啡馆2","jp":"メイド服よりも動きやすいな、悪くねぇ","zh":"比女仆装方便多了，还不错。"},{"label":"咖啡馆3","jp":"あぁん？何見てんだこら？やる気か？あん？","zh":"看什么？要干架吗？"},{"label":"咖啡馆4","jp":"……ふん、悪くねぇ場所だなまた今度来てやるとするか","zh":"这地方不错，以后可以经常来。"},{"label":"咖啡馆5","jp":"先生は……いねぇのか、出張中か？い、いや、別にどうでも良いけど……","zh":"老师不在吗？在出差吗？不不不，这和我又没关系。"}],"好感度":[{"label":"好感度1","jp":"おい、覚悟しとけよ。ここまで付き合っておいて、冗談でしたじゃ済まねぇからな。","zh":"做好心理准备，都到这一步了，可别说你在开玩笑。"},{"label":"好感度2","jp":"悪くねぇ気分だ……。はっ、やっ、なんでもねぇよ！","zh":"感觉心情还不错，我什么都没说。"},{"label":"好感度3","jp":"はぁ……これは参ったな……。あぁ？なんだよ。こっち見んな！","zh":"真是的，干什么别看我。"},{"label":"好感度4","jp":"おかしいな……なんだか先生といると調子が狂っちまう。","zh":"感觉怪怪的，不知道为什么和老师在一起我就会很奇怪。"}],"战斗":[{"label":"编入队伍1","jp":"ま、あたしがいた方が良いだろう。","zh":"看还是有我在比较好吧。"},{"label":"编入队伍2","jp":"見る目あるじゃねえか。","zh":"很有眼光。"},{"label":"拎起","jp":"おいこら、放せバカ！","zh":"喂喂，给我放手。"},{"label":"任命队长1","jp":"さぁ、早く始めようぜ！","zh":"好了，快点开始吧。"},{"label":"任命队长2","jp":"こうゆうのは任せとけ！","zh":"这种事尽管交给我吧。"},{"label":"普通技能","jp":"こんなもんかよぉ！？","zh":"就这？"},{"label":"EX动画1","jp":"あん？何見てんだゴラ！","zh":"看什么呢？臭小子。"},{"label":"EX动画2","jp":"見せもんじゃねぇぞ！","zh":"看什么看？"},{"label":"EX动画3","jp":"打ちのめされたぇのか！？","zh":"想死吗？你。"},{"label":"EX技能1","jp":"おりゃぁ、くらえぇ！","zh":"吃我一招。"},{"label":"EX技能2","jp":"はっはっはっはっは！","zh":"哈哈哈哈哈哈哈哈哈。"},{"label":"EX技能3","jp":"うおりゃぁぁぁぁ！","zh":"我打。"},{"label":"战斗开始1","jp":"“待”ってたぜェ！！この“瞬間”をよォ！！","zh":"我等的就是现在。"},{"label":"战斗开始2","jp":"任せとけ、すぐに終わらせてやる！","zh":"交给我，马上解决。"},{"label":"获得BUFF","jp":"悪くねぇな！","zh":"不错嘛。"},{"label":"施放BUFF","jp":"さあ行くぜ！","zh":"上吧。"},{"label":"掩体","jp":"焦んなくても相手してやるよ。","zh":"别急，我出来就对付你。"},{"label":"被CC1","jp":"-","zh":"-"},{"label":"被CC2","jp":"くっ！","zh":"-"},{"label":"被CC3","jp":"がぁ！","zh":"-"},{"label":"被CC4","jp":"\\","zh":"\\"},{"label":"被CC6","jp":"\\","zh":"\\"},{"label":"回避","jp":"はは！","zh":"-"},{"label":"队伍移动1","jp":"さっさと行くぞ！","zh":"搞快点。"},{"label":"队伍移动2","jp":"まさかこんなもんじゃ終わらねぇよなぁ？","zh":"这就完了。"},{"label":"回复","jp":"悪くねぇタイミングだ！","zh":"时机不错。"},{"label":"中途退出","jp":"ぐぅ！","zh":"咳！"},{"label":"战斗喊叫","jp":"はっ！","zh":"哈！"},{"label":"战斗喊叫","jp":"ほら！","zh":"看招！"},{"label":"战斗喊叫","jp":"くらえ！","zh":"接招。"},{"label":"角色移动","jp":"うっし！","zh":"-"},{"label":"战斗胜利1","jp":"っは、ウォーミングアップにもなりゃしねぇ。","zh":"连热身都算不上。"},{"label":"战斗胜利2","jp":"楽勝楽勝！","zh":"轻轻松松。"},{"label":"关卡完成1","jp":"あったりめぇの結果だな、私を誰だと思ってやがる？","zh":"这不是理所当然的吗？也不看看我是谁。"},{"label":"关卡完成2","jp":"あたしに掛かれぇばこれくらい朝飯前だ！","zh":"只要我出手，这种事就是小菜一碟。"},{"label":"战斗失败1","jp":"ちっ、覚えとけよ、次は負けねぇ！","zh":"切，给我记着，下次我可不会再输了。"},{"label":"战斗失败2","jp":"信じらんねぇ、おかしいだろうがよぉ！？","zh":"不会吧，这不对头。"}],"z'd":[{"label":"被CC5","jp":"\\","zh":"\\"}],"成长":[{"label":"升级1","jp":"はっ、悪くねぇな。ちゃんとお返しはしてやるから、待ってろよ！","zh":"不错，我会好好回礼的，你就等着吧。"},{"label":"升级2","jp":"ははっ、良いじゃねえか！こういうのを待ってたんだ！","zh":"哈哈，真不错，我正想要这个呢。"},{"label":"升级3","jp":"やるじゃねぇか、先生。後悔はさせねぇからよ。","zh":"有两把刷子啊，老师你不会后悔的。"},{"label":"升级4","jp":"あぁ……これは悪くねぇ！おし、後は任せな！","zh":"这个可真不错。好，剩下的就交给我。"},{"label":"获得专武","jp":"はっ、ここまでおぜん立てしてもらったら、思いっきり派手にやらねーとな……\nさあ、どこまで耐えられる？","zh":"为我准备了这个，那我就必须全力以赴，华丽的大干一场了。来试试看能接我几招。"}],"事件":[{"label":"学生生日","jp":"よぉ、先生！知ってるよな、今日は特別な日だぞ！\nあん？誕生日でテンション上がって着替えたのって……？\nばっ、ちげぇよ！？","zh":"哈哈，老师知道吧？今天是个特别的日子……\n因为过生日特意换上了这件衣服？怎么可能？"},{"label":"老师生日","jp":"よぉ、先生！誕生日おめでとさん！\nは？お祝いのためにわざわざ着てくれたの……って？\nべっ、別にそういうわけじゃねぇから！？","zh":"老师生日快乐。\n为了给你庆生特意穿上这件衣服？当然不是！"},{"label":"万圣节","jp":"今日はどいつもこいつも変な服着てるから、合わせてやろうかなって\n思ってよ。これなら良いだろ、どうだ？","zh":"今天大家都穿着奇怪的衣服，所以我也想配合一下，这么穿应该没问题吧。你觉得怎么样？"},{"label":"新年","jp":"よぉ、今年もよろしくな、先生。\n……こちらこそ？あぁ、背中は任せとけ！","zh":"今年也多多关照了老师，嗯，彼此彼此，哼，包在我身上。"},{"label":"圣诞节","jp":"クリスマスプレゼントは子供がもらうもの……？\n馬っ鹿、知ってるっての！？\n別に欲しくてここに来たわけじゃねぇから！？","zh":"只有小孩子才有圣诞礼物，真的我当然知道了，我又不是为了礼物来的。"},{"label":"春节","jp":"","zh":"今天也拜托了老师，新春快乐。\n问我是不是特意穿了红色衣服？没……没那回事！"},{"label":"中秋","jp":"","zh":"哟，老师要去高处一起赏月吗？\n我知道一个地方的景色很不错。"}],"活动":[{"label":"活动登陆1","jp":"おらっ！仕事の時間だぞ、先生！","zh":"好，该干活了，老师。"},{"label":"活动登陆2","jp":"油を売ってる暇はねぇ、行くぞ！","zh":"别磨蹭了，马上开始吧。"},{"label":"活动大厅1","jp":"何か手伝うことでもあるか、先生？","zh":"还有什么事要干吗？老师。"},{"label":"活动大厅2","jp":"ははっ！悪くねぇな！","zh":"哈哈，不错嘛。"},{"label":"活动大厅3","jp":"さて、こうしてる場合じゃねぇな。","zh":"你不要磨磨唧唧的了。"},{"label":"活动大厅4","jp":"なっ、何をそんなじっと見てんだよ……。\nほら、さっさと仕事始めんぞ。","zh":"你看我干嘛？我脸上有活吗？快点干活。"},{"label":"活动事件1","jp":"やるからには徹底的にやるタイプでな。","zh":"我呀，习惯提前把事情处理好。"},{"label":"活动事件2","jp":"おらっ、片付け始めんぞ！","zh":"干净利落的收尾。"},{"label":"活动结束","jp":"後片付けなら任せとけ、あたしの専門分野だ！","zh":"收拾残局，我可是专家。"}]},"stats":{"init":[{"name":"攻击力","value":"185"},{"name":"防御力","value":"27"},{"name":"生命值","value":"3040"},{"name":"治愈力","value":"1802"},{"name":"命中值","value":"109"},{"name":"闪避值","value":"1303"},{"name":"暴击值","value":"219"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1264"},{"name":"射程","value":"450"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"40 (10)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4494"},{"name":"防御力","value":"1848"},{"name":"生命值","value":"91758"},{"name":"治愈力","value":"7559"},{"name":"命中值","value":"109"},{"name":"闪避值","value":"1303"},{"name":"暴击值","value":"519"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1264"},{"name":"射程","value":"450"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"40 (10)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"363"},{"name":"生命值","value":"5842"},{"name":"治愈力","value":"983"}]},"eq