8.png","url":"https://www.gamekee.com/ba/tj/714055.html?tab=4"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ～えへへ。","zh":"Blue Archive～欸嘿嘿。"},{"label":"卡池抽取","jp":"イブキ、登～場！先生、お待たせ～","zh":"伊吹来喽，老师等很久了吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あ、先生だ、おかえりなさい～","zh":"啊，是老师！老师回来啦！"},{"label":"登陆2","jp":"イブキ、大人しく待てたよ、褒めて褒めて！","zh":"伊吹乖乖等着老师呢，嘿嘿，快夸我快夸我！"},{"label":"大厅1","jp":"イブキ、お手伝いに来たよ、何すればいい？その前に、おやつタイムにしよう？\nん！イブキもそれがいい！","zh":"伊吹来帮忙啦，要我做什么呢？哦，先来吃点零食，嗯！伊吹也喜欢！"},{"label":"大厅2","jp":"「事業費執行精算内訳書」....って、どういう意味？","zh":"事业费用执行结算明细，这是什么意思？"},{"label":"大厅3","jp":"えへへ、イブキにお話があるの？","zh":"诶嘿嘿，有话要跟伊吹说吗？"},{"label":"大厅4","jp":"はい、イブキも、よろしくお願いします！","zh":"哼，伊吹也请老师多多关照！"},{"label":"大厅5","jp":"先生、お仕事大変って聞いたの。\nイブキも手伝う！イブキもできるよ！何でも言って～","zh":"老师，听说你工作很累，伊吹也来帮忙啦！伊吹也会的哦！需要什么尽管说吧！"},{"label":"回忆大厅1","jp":"今日は、イブキが先生だよ！今から、算数の授業をします。","zh":"今天伊吹来当老师，接下来我们来上算术课！"},{"label":"回忆大厅2","jp":"伊吹、算数は自信あるんだ。昨日テストで１００点取ったね　花丸もらったの","zh":"伊吹对算术很有自信，昨天的测试得了100分，还拿到了表扬的印章。"},{"label":"回忆大厅3","jp":"へへ...じゃあ 先生に伊吹先生から問題です！ここにアイスクリーム2個とプリン一個があります、全部で何個でしょうか？","zh":"诶嘿嘿，那接下来伊吹老师就来给老师出题吧！这里有两个冰淇淋和一个布丁，那么一共是几个呢？"},{"label":"回忆大厅4","jp":"ふん...残念...正解は...","zh":"噗噗很遗憾，正确答案是~"},{"label":"回忆大厅5","jp":"おやつが三個もあたら...すごく幸せ...だよ！あ..食べたあとは歯磨きを忘れないでね。伊吹はね...毎日三回ちゃんと歯磨きをしてるんだよ！","zh":"有3个零食简直太幸福啦！嘿嘿，吃过以后要记得刷牙！伊吹每天都会认认真真刷三次牙！"},{"label":"咖啡馆1","jp":"しちいちが...しち...\nしちに...じゅうし...","zh":"一七得七，二七......十四！"},{"label":"咖啡馆2","jp":"何ここ～イブキ、探検してもいい？","zh":"这里是哪里呀？伊吹可以探险吗？"},{"label":"咖啡馆3","jp":"先生と何して遊ぼうかな～","zh":"跟老师玩什么好呢？"},{"label":"咖啡馆4","jp":"大人ってこういうのが好きなの？う～よくわかんない。","zh":"大人喜欢这种东西啊，嗯~伊吹不懂。"},{"label":"咖啡馆5","jp":"イブキ、一人は詰まんない。","zh":"伊吹一个人很无聊。"}],"好感度":[{"label":"好感度1","jp":"イブキの秘密、1個教えてあげるね。\nあのね、イブキね、先生と一緒にいると、すごく楽しいの、二人だけの秘密だよ～","zh":"告诉你一个关于伊吹的秘密，伊吹跟老师在一起的时候真的好开心！嘿嘿，这是我们俩的秘密哦！"},{"label":"好感度2","jp":"えへ、えへへ、嬉しい～\nイブキ、もっといい子になるね。","zh":"诶嘿，诶嘿嘿，好开心！伊吹以后会更乖的！"},{"label":"好感度3","jp":"イブキも、先生みたいなかっこいい大人になりたい～","zh":"伊吹也想变成跟老师一样厉害的大人。"},{"label":"好感度4","jp":"イブキね、先生のこと考えてた。\nふぁ、先生もイブキのこと考えてたの？\nえひひ、イブキと先生は心が通じ合ってるんだね。","zh":"伊吹在想老师呢，老师也在想伊吹吗？诶嘿嘿，我们好像心有灵犀诶！"}],"战斗":[{"label":"编入队伍1","jp":"ふ、イブキも手伝うよ！","zh":"嗯！伊吹也来帮你！"},{"label":"编入队伍2","jp":"えへへ、分かった～","zh":"诶嘿嘿，知道了！"},{"label":"拎起","jp":"ふぁ～イブキと遊んでくれるの？","zh":"哇~要陪伊吹一起玩吗？"},{"label":"任命队长1","jp":"イブキ、いきます！","zh":"伊吹，出发！"},{"label":"任命队长2","jp":"教えてもらった通りに、頑張るね！","zh":"伊吹会按老师教的加油的！"},{"label":"普通技能","jp":"あ、悪い人だ。","zh":"啊，有坏人！"},{"label":"EX动画1","jp":"好きなものいっぱい！","zh":"把伊吹喜欢的都画上去！"},{"label":"EX动画2","jp":"これをこうして、チャン！","zh":"这样......然后这样......锵！"},{"label":"EX动画3","jp":"出来た！","zh":"画好啦！"},{"label":"EX技能1","jp":"これ、イブキが書いたんだ！","zh":"这个是伊吹画的哦！"},{"label":"EX技能2","jp":"みんなでお描きしよう！","zh":"一起画画吧！"},{"label":"EX技能3","jp":"この色を使いって～","zh":"用这个颜色~"},{"label":"载具普通技能","jp":"（イブキ）やーっ！ （イロハ）虎丸、発射。","zh":"（伊吹）呀—！\n（伊吕波）虎丸，发射！"},{"label":"载具EX动画1","jp":"（イブキ）あっ！イロハ先輩、あっち！ （イロハ）行きましょう、イブキ。","zh":"（伊吹）啊！伊吕波前辈，那边！\n（伊吕波）走吧，伊吹。"},{"label":"载具EX动画2","jp":"（イブキ）悪い人、見ーっけ！ （イロハ）はい、対処します。","zh":"（伊吹）发现坏家人~！\n（伊吕波）好，马上应对。"},{"label":"载具EX动画3","jp":"（イブキ）ねぇねぇ先輩、あそこ～！ （イロハ）万魔殿の出番ですね……面倒くさい。","zh":"（伊吹）那边、前辈、那边～！\n（伊吕波）轮到万魔殿出场了…… 真麻烦。"},{"label":"载具EX技能1","jp":"（イブキ）狙って～？ （イロハ）発射。","zh":"（伊吹）瞄准～？\n（伊吕波）发射。"},{"label":"载具EX技能2","jp":"（イブキ）逃がさないよー！ （イロハ）狙います。","zh":"（伊吹）不会放跑你的。\n（伊吕波）瞄准。"},{"label":"载具EX技能3","jp":"（イブキ）ばんば～ん！ （イロハ）外しません。","zh":"（伊吹）邦邦！\n（伊吕波）不会打偏的。"},{"label":"战斗开始1","jp":"終わったら、先生と遊ぼうと！","zh":"结束以后要和老师一起玩！"},{"label":"战斗开始2","jp":"イブキが通るよ！","zh":"伊吹来咯！"},{"label":"获得BUFF","jp":"えへへ、ありがとう！","zh":"诶嘿嘿，谢谢！"},{"label":"施放BUFF","jp":"イブキ、頑張る！","zh":"伊吹，会加油的！"},{"label":"掩体","jp":"シーー、隠れるね。","zh":"嘘，我藏起来咯！"},{"label":"被CC1","jp":"えっ、痛いよ！","zh":"诶，好痛！"},{"label":"被CC2","jp":"えへぃ～","zh":"诶嘿~"},{"label":"被CC3","jp":"ヤァーー！","zh":"呀！"},{"label":"回避","jp":"あれれ、もう痛くない~","zh":"诶！现在不疼啦！"},{"label":"队伍移动1","jp":"前進～","zh":"前进！"},{"label":"队伍移动2","jp":"ふぁ～面白そう！","zh":"哇，好像很好玩！"},{"label":"回复","jp":"えへへ、ありがとう！","zh":"诶嘿嘿，谢谢！"},{"label":"中途退出","jp":"え、こらんちゃった。","zh":"唔欸，摔倒了。"},{"label":"战斗喊叫","jp":"や！","zh":"呀！"},{"label":"战斗喊叫","jp":"ヤアー！","zh":"呀—！"},{"label":"战斗喊叫","jp":"え！！","zh":"嘿！"},{"label":"角色移动","jp":"こっち～！","zh":"走这边~"},{"label":"战斗胜利1","jp":"ねね、イブキ勝ったよ！","zh":"快看快看，伊吹赢啦！"},{"label":"战斗胜利2","jp":"勝った！！イブキ、偉い？","zh":"赢啦！伊吹厉害吧？"},{"label":"关卡完成1","jp":"見て見て、イブキ勝ったよ。","zh":"快看呀，伊吹赢啦！"},{"label":"关卡完成2","jp":"もう、先生と遊んでいい？","zh":"现在可以和老师玩了吗？"},{"label":"战斗失败1","jp":"え、ごめんね...イブキ、負けちゃった...","zh":"唔欸，对不起……伊吹输掉了……"},{"label":"战斗失败2","jp":"イブキが...悪い子だから？","zh":"是因为……伊吹不乖吗？"}],"成长":[{"label":"升级1","jp":"先生先生、イブキ背が伸びた気がする！","zh":"老师老师，伊吹好像长高了呢！"},{"label":"升级2","jp":"ありがとう先生、これからもお手伝い頑張るね。","zh":"谢谢老师，以后我也会多帮你的。"},{"label":"升级3","jp":"イブキも先輩たちみたいに、大きくなりたいな～","zh":"等伊吹长大了，也想像前辈们那样。"},{"label":"升级4","jp":"ありがとう先生！\nはい、お礼にイブキプリン、あげる～","zh":"这个布丁是伊吹送你的礼物！"},{"label":"获得专武","jp":"はあ？ああ～！\nこれ、イブキにくれるの？\n本当に？\nへ、イブキだから？\nはあ～先生、嬉しい、大事にするね！","zh":"哈？啊！\n这个，是给伊吹的吗？\n真的吗？\n诶，是专门送给伊吹的？\n哈~老师，伊吹好开心，我会好好珍惜的！"}],"事件":[{"label":"学生生日","jp":"あ、イブキの誕生日、覚えてくれたの？\nありがとう先生、すごく嬉しい。\n今なら、お空も飛べちゃうかも。","zh":"啊，老师竟然记得伊吹的生日？\n诶！谢谢！伊吹好开心！\n开心得要飞起来啦！"},{"label":"老师生日","jp":"先生、お誕生日おめでとう。\nプレゼントいっぱいもらったの？\nじゃ、イブキは、先生をぎゅっとしてあげるね～","zh":"老师，生日快乐！\n收到很多礼物了吗？\n那伊吹就给老师一个抱抱~"},{"label":"万圣节","jp":"あ～悪戯しなきゃ～お菓子を食べちゃうぞ～\nう、あれ、違う？","zh":"嗷呜！不来捣蛋的话，伊吹就把糖果都吃掉！诶？不是这样吗？"},{"label":"新年","jp":"明けましておめでとう先生。\nう？これは何？お年玉？\nイブキの欲しいものを買うのに使う...お小遣い？\nじゃ、イブキは先生が欲しい！\nはい、お年玉です、どうぞ～","zh":"新年快乐！老师！诶？这是什么？压岁钱！伊吹可以用来买自己喜欢的东西的零花钱。那......伊吹要买老师！给！这是压岁钱。"},{"label":"圣诞节","jp":"イブキ、ちゃんといい子にしてたよ。\nサンタさんからプレゼント、欲しいな...","zh":"伊吹一直都很听话，希望圣诞老爷爷能给伊吹礼物......"},{"label":"春节","jp":"","zh":"老师老师，听说今天是过年的日子！是不是会有很多好吃的和好玩的？诶？可以去看烟花？太好啦！那伊吹要老师举高高！"},{"label":"中秋","jp":"","zh":"伊吹知道哦！今天叫做中秋节，是跟月亮上的小兔子玩的节日，可是该怎么去月亮上呢？老师知道吗？"}],"活动":[{"label":"活动商店1","jp":"う？イブキは売ってないよ。","zh":"唔欸？这里不卖伊吹哦。"},{"label":"活动商店2","jp":"ええと、イブキはね、あれがいいと思う！","zh":"唔欸，伊吹觉得那个不错！"},{"label":"活动商店关闭","jp":"イブキ、先生とパーティーで踊るの、すごく楽しかった。\nまた一緒に来ようね、約束だよ。","zh":"伊吹跟老师一起在宴会上跳舞，很开心！下次还要一起来哟！说好啦！"},{"label":"活动商店登陆1","jp":"いらっしゃいませ、先生。えへへ","zh":"老师你来啦！\n诶嘿嘿~"},{"label":"活动商店登陆2","jp":"なんか探し物？イブキも手伝ってあげる。","zh":"在找什么呀？伊吹也来帮你！"},{"label"