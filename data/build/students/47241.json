ms":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/810281.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/640438.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/810281.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/640438.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/67283.png","name":"装着可可亚的马克杯","desc":"枫香为老师泡的可可亚。温暖而缱绻，就跟枫香温柔甜美的个性一样。因为注入了为老师的健康着想的心意，味道比实际上更香甜温暖。"},"ability":{"attrs":[{"name":"生命值","value":"868"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"332"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/523061.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/36111.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 枫香（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/11/13019.png","url":"https://www.gamekee.com/ba/579686.html"},{"name":"NPC 枫香（私服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/647982.png","url":"https://www.gamekee.com/ba/649439.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"給食部のフウカです。\n食べたいものがあったら、いつでも仰ってください。","zh":"我是供餐部的枫香，有什么想吃的东西请随时吩咐。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お疲れ様です！\n温かい食事をご用意しましたけど、今召し上がりますか？","zh":"辛苦了，我为您准备了热气腾腾的饭菜，您要现在就吃吗？"},{"label":"登陆2","jp":"先生、卵は半熟のままがいいですか？\nサニーサイドアップ？それとも卵焼き？","zh":"老师，您喜欢这样的半熟蛋呢还是太阳蛋？或者说，玉子烧？"},{"label":"大厅1","jp":"ご飯はちゃんと食べてますか？\n何か作りましょうか？","zh":"您有好好按时吃饭吗？要不要给您做点什么？"},{"label":"大厅2","jp":"皆のために料理を作るのは大変ですが、大丈夫です。","zh":"给大家做饭是很辛苦，不过没关系。"},{"label":"大厅3","jp":"あはは…。心配してくださるのですか？","zh":"哼哼哼，您这是在担心我吗？"},{"label":"大厅4","jp":"好きな食べ物、 気になります。 \nん？ 何でか、ですって？ 秘密です！","zh":"我想知道，您到底喜欢吃什么样的食物，为什么想知道？这是秘密哦。"},{"label":"大厅5","jp":"うーん…。先生がもっと元気になるような料理、何が良いかな…。","zh":"嗯，有没有什么好吃的能给老师补补身子呢？"},{"label":"回忆大厅1","jp":"こうなっていると思っていました…。\nまたインスタントばかり食べてましたね？","zh":"我就知道会变成这个样子，您是不是又整天吃方便食品了呀？"},{"label":"回忆大厅2","jp":"ダメですよ、食事はちゃんと取らないと。","zh":"这样可不行，饭一定要按时好好吃哦！"},{"label":"回忆大厅3","jp":"私がすぐ作りますから、ちょっと待っててください。","zh":"我这就去给您好好做顿饭，请您在这里好好等一下。"},{"label":"回忆大厅4","jp":"もう、健康に気を付けないのは先生の悪い癖ですよ。","zh":"老师，您一直这样不注意自己的健康可是不好的哦！"},{"label":"回忆大厅5","jp":"はい？ま、毎日私の作った料理が食べたい、ですか？\nあ、あはは…せ、先生さえよろしければ…。\nもちろん、私は構わないのですが…。","zh":"嗯？您说您想每天都能够吃上我做的饭？额..只要老师愿意的话，我当然完全不会介意的.."},{"label":"咖啡馆1","jp":"スーパーに寄らなきゃかも…。","zh":"说不定还得去趟超市。"},{"label":"咖啡馆2","jp":"料理を始めましょうか。","zh":"那就开始做饭吧。"},{"label":"咖啡馆3","jp":"ここでも料理ができるかな？","zh":"这个地方能不能做饭呀？"},{"label":"咖啡馆4","jp":"今日の夕食は何にしよう…。","zh":"今天的晚饭，做什么好呢？"},{"label":"咖啡馆5","jp":"このままじゃ、食材が足りないかも。","zh":"这样下去，食材就要不够了。"}],"好感度":[{"label":"好感度1","jp":"先生に美味しい料理を作って差し上げたいです。","zh":"我想为老师，做些美味的料理。"},{"label":"好感度2","jp":"食事はちゃんと摂れてますか、先生？","zh":"老师，您有没有好好吃饭呀？"},{"label":"好感度3","jp":"どんな料理がお好きなのか、気になります。","zh":"我想知道，老师最喜欢吃什么？"},{"label":"好感度4","jp":"先生に、その…朝ごはんを作ってさしあげたいのですが…","zh":"我在想，可不可以..那个，给老师做早饭？"}],"战斗":[{"label":"编入队伍1","jp":"はい。","zh":"到。"},{"label":"编入队伍2","jp":"準備完了です。","zh":"准备完毕。"},{"label":"拎起","jp":"お残しは許しませんよ！","zh":"不许剩饭哦！"},{"label":"普通技能","jp":"食事の効果ですね！","zh":"这就是用餐的效果哦！"},{"label":"EX动画1","jp":"よーし！","zh":"不错！"},{"label":"EX动画2","jp":"うんっ！完璧！","zh":"嗯，完美！"},{"label":"EX动画3","jp":"これわ、すてきな出来！","zh":"嗯，味道很棒！"},{"label":"EX技能1","jp":"栄養満点の料理です！","zh":"这道菜营养丰富哦！"},{"label":"EX技能2","jp":"食事の時間ですよ。","zh":"该吃饭啦！"},{"label":"EX技能3","jp":"おいしく召し上がれ。","zh":"尽情享用吧！"},{"label":"载具协同1","jp":"大変お待たせしました！給食部の配送者が到着しましたよ！","zh":"非常感谢您的耐心等待，后勤部的送货车已经到了！"},{"label":"载具协同2","jp":"お待たせしました！給食部の到着です！","zh":"让各位久等了，后勤部来了。"},{"label":"战斗开始1","jp":"給食部の支援、始めます。","zh":"供餐部，开始提供支援！"},{"label":"战斗开始2","jp":"準備できますだ。","zh":"我准备好了！"}],"成长":[{"label":"升级1","jp":"ありがとうございます、先生。","zh":"老师，非常感谢您。"},{"label":"升级2","jp":"料理の実力もさらに上がったのでしょうか？","zh":"不知道烹饪水平是不是也提高了呢？"},{"label":"升级3","jp":"これでもう少しお役に立てるように。","zh":"希望，能再多给您帮上一点忙。"},{"label":"升级4","jp":"え？私でいいのですか？","zh":"欸？把这些都给我，这样合适吗？"},{"label":"获得专武","jp":"あはは……こういった支援には慣れていませんが、\n先生のお役に立てるよう、最善を尽くします。","zh":"呵呵，我还真不习惯被这样支持，我会尽我所能帮助老师的。"}],"事件":[{"label":"学生生日","jp":"あれ…。私の誕生日ですか？\nあ、あはは…。いつも他の方のお誕生日ばかり気にしていたので…。\n…嬉しいです。ありがとうございます。","zh":"欸？我的生日？我平时尽是去注意别人的生日了，非常感谢您。"},{"label":"老师生日","jp":"先生。お誕生日おめでとうございます。\n今日みたいな日にはきっと、すごく特別なものを召し上がるかと思うのですが…。\nえっと、よ…よろしければ、私がお誕生日のお料理を作ってもいいでしょうか？","zh":"老师，祝您生日快乐，我想您在今天这样的日子，一定想吃一顿不同于往日的大餐，如果不介意的话，可以让我为您准备生日餐吗？"},{"label":"万圣节","jp":"カボチャのスープとか、カボチャパイとか、カボチャのグラタンとか、\n作れそうなものは全部作ってみようかと思いまして。\nハロウィーンですからね。先生はどんなのが好きですか？","zh":"南瓜汤呀、南瓜派呀、南瓜焗菜呀，能做的东西我全都想试着做一做，因为今天可是万圣节哦，老师，您喜欢什么样的饭菜呢？"},{"label":"新年","jp":"新しい一年が始まりますね！\nお雑煮を作ろうかと思うのですが、いかがでしょう？","zh":"新的一年开始了，我在想要不要做一些年糕汤，老师您意向如何呢？"},{"label":"圣诞节","jp":"クリスマス…。\n特別な夕食を作ろうかと思っているのですが…。\nも、もちろん、先生がよろしければ！","zh":"圣诞节..我在想要不要做一顿特殊的晚餐，当然，前提是老师觉得可以的话。"},{"label":"春节","jp":"","zh":"我准备了一桌年夜饭，\n不嫌弃的话，老师来尝尝吧。"},{"label":"中秋","jp":"","zh":"歌赫纳的大家会喜欢我做的月饼吗？\n哎？……您说您喜欢？真的是太好了。"}]},"stats":{"init":[{"name":"攻击力","value":"160"},{"name":"防御力","value":"25"},{"name":"生命值","value":"2674"},{"name":"治愈力","value":"2548"},{"name":"命中值","value":"98"},{"name":"闪避值","value":"1177"},{"name":"暴击值","value":"196"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1638"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4233"},{"name":"防御力","value":"139"},{"name":"生命值","value":"49