iki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 亚子 （礼服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/3/951866.png","url":"https://www.gamekee.com/ba/611610.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive"},{"label":"卡池抽取","jp":"ゲヘナ学園風紀委員会所属の行政官、天雨アコ。今後は業務提携とのことで、どうぞよろしくお願いいたしますね。","zh":"我是歌赫娜风纪委员会的行政官天雨亚子，今后的业务合作还请多多关照"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あら、おはようございます先生。ではお仕事を始めましょうか？ 終わるまで、帰れるとは思わないでくださいね？","zh":"啊，老师，您来了，那就开始办公吧\n完成所有工作前可不许回去哦~"},{"label":"登陆2","jp":"あら、先生。予定より早かったですね？それについては褒めてあげましょう。","zh":"老师，您好啊~\n今天您来的比预定时间还早呢~这一点倒是值得表扬"},{"label":"大厅1","jp":"先生？手が止まっていませんか？ 残業になると私の帰りも遅くなって、私が困るのですが。","zh":"老师，您是在偷懒吗？\n要是因为加班导致我晚归的话，我会很为难哦"},{"label":"大厅2","jp":"…進捗が良くないですね。 はあ、仕方ありません。 私も手伝います。","zh":"进展不顺啊……\n唉，没办法了，我也会帮忙的"},{"label":"大厅3","jp":"今からはお食事はもちろん、お手洗いなども含めて全部私が管理しますから、言った通りにしてください。 まさか、不満なんて無いですよね？","zh":"从现在开始，吃饭的时间自不必说，\n去卫生间的时间也都由我来管理，一切都请按我说的做\n哎呀？您该不会有什么不满吧？"},{"label":"大厅4","jp":"なんだ、やればできるじゃないですか？って先生、まさかとは思いますが… 先ほどまではサボっていたということですか…！？","zh":"啊呀，认真去做的话不是做的很好吗？\n等等，老师，别告诉我之前您是在偷懒！"},{"label":"大厅5","jp":"お疲れの時は言ってくださいね。それをケアするのもまた、私の役目ですので。","zh":"如果工作累了请随时告诉我，\n毕竟照顾老师也是我身为秘书的职责"},{"label":"回忆大厅1","jp":"うぅっ、こんな格好……っ！","zh":"竟然会变成这幅模样——"},{"label":"回忆大厅2","jp":"この屈辱、絶対に忘れませんからね……！","zh":"这份屈辱，我是绝对不会忘的！"},{"label":"回忆大厅3","jp":"えっ！？ま、待ってください！これ以上は約束と違うじゃないですか！？お、お散歩！？正気ですか！？このまま！？","zh":"等等，这跟说好的不一样吧\n什么？散步？认真的吗？就这么出去？"},{"label":"回忆大厅4","jp":"そ、それは流石に…。ご、ごめんなさい…少し調子に乗り過ぎました…","zh":"那也太……\n对不起……是我太得意忘形了"},{"label":"回忆大厅5","jp":"あ、あの……いつまでこうしていれば良いんですか……？","zh":"我……我说，要这样子呆到什么时候啊"},{"label":"咖啡馆1","jp":"なるほど……まあ、悪くない設備ですね。","zh":"嗯……这里的设备还不错"},{"label":"咖啡馆2","jp":"次のシャーレとの提携業務は…","zh":"下次和沙勒的合作……"},{"label":"咖啡馆3","jp":"委員長…きちんとお食事を取られてるでしょうか…？","zh":"会长有没有好好吃饭呢……"},{"label":"咖啡馆4","jp":"なんだかフワフワとした雰囲気ですね…まあ、どうでも良いのですが…","zh":"大家看起来全都一副悠闲的样子嘛……\n倒也无所谓"},{"label":"咖啡馆5","jp":"いざという時には…あ、いえ、それでは委員長が困ってしまいますね。やめておきましょう。","zh":"但紧急情况下……\n不，那样会长就该为难了，还是算了吧"}],"好感度":[{"label":"好感度1","jp":"あのう...ちょっと距離が近くないですか？い、いえ、意識しているとかではなく。","zh":"距离是不是有点太近了……不……我不介意"},{"label":"好感度2","jp":"業務外での関係でもお望みなんですか。そういうのは早いですよ、まだ…","zh":"您期待跟我有工作以外的关系吗？\n我觉得有点为时过早……还不是时候呢……"},{"label":"好感度3","jp":"これがどういう感情なのか…もう少し検討する時間をください。本当に…少しでいいので。","zh":"这种感情到底是什么？\n请给我一点时间考虑一下……真的，只要一点时间就好"},{"label":"好感度4","jp":"ああ…えっ？認めますよ。先生のことが嫌いだと思っていません。 で？それで？だたらなんなんですか？","zh":"哈……好吧，我承认，我不讨厌老师\n——所以呢？那又怎样？"}],"战斗":[{"label":"编入队伍1","jp":"お仕事ですね。はい、お任せください。","zh":"有工作是吗？好的，请交给我吧"},{"label":"编入队伍2","jp":"シャーレとしての業務上の指示ということでしょうか。でしたら仕方がありません。","zh":"您这是……以沙勒的名义分配任务吗？\n那就没办法了"},{"label":"拎起","jp":"本当は穏便に済ませたかったのですが……やるしか無さそうですね。","zh":"现在看来，也只能动手了吧？"},{"label":"普通技能","jp":"風紀委員会からの支給品です。","zh":"风纪委员会的补给来了！"},{"label":"EX动画1","jp":"判明しているデータをお送りします。","zh":"向您发送已解析的战斗数据"},{"label":"EX动画2","jp":"データは、これと、これと…","zh":"数据是这个……还有这个！"},{"label":"EX动画3","jp":"風紀委員の情報収集能力、お見せします。","zh":"让您见识一下风纪委员的情报收集能力吧"},{"label":"EX技能1","jp":"分析完了、弱点は把握済です","zh":"分析完毕，已掌握敌方弱点"},{"label":"EX技能2","jp":"後はお任せしますね。","zh":"之后就交给您了"},{"label":"EX技能3","jp":"ふふっ、準備は万全ですから。","zh":"万事俱备！"}],"成长":[{"label":"升级1","jp":"先生からのご支援、ありがたく頂戴しますね。","zh":"感谢老师的支援，我就收下了"},{"label":"升级2","jp":"成長…していますね。自分でもその、ビックリです。","zh":"我正在成长？\n就连我自己都有点惊讶呢"},{"label":"升级3","jp":"こういうことは気軽にすることではないでしょうに。何が狙いですか？何かして欲しいことでも？","zh":"这种事……不是随随便便就能做到的吧？\n您的目的是什么？或者说，您对我有什么期待呢？"},{"label":"升级4","jp":"その…ありがとうございます、先生。 まあ…何ですかその顔は。私だって何かをしてもらえば、感謝ぐらいします。まったく。","zh":"啊？谢谢老师……\n您那是什么表情？受到帮助我当然也会好好道谢！真是的……"},{"label":"获得专武","jp":"まったく、こういう大胆なアプローチを平然と……まあいいでしょう。あなたの目の前にいる生徒がどれだけ優秀なのか、骨の髄まで教えてあげます。","zh":"真是的……这么大胆的接近我……\n好吧，既然如此，那我会让老师知道我究竟有多么优秀"}],"事件":[{"label":"学生生日","jp":"私の、誕生日…？ …先生、今はそれより大事なお仕事がたくさん…え？私の誕生日より大事な仕事なんてない…？ またそういう…まあ、一応感謝はしておきます。","zh":"我的生日？老师，还有比这更重要的事呢……\n您说没什么比我的生日更重要？\n真是的，又说这种话……\n总之谢谢了"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。ふふっ、せっかくならと先週から完璧なスケジュールを立てておきました。 寸分の隙も無い、完璧な一日にしてあげましょう。","zh":"老师，生日快乐\n机会难得，我可是提前一周制定好了这份完美的日程\n保证让老师每一分钟都不浪费，度过完美的一天！"},{"label":"万圣节","jp":"ハロウィーン、お菓子を交換し合う日ですね。 まあ、お仕事に糖分摂取は必要ですし…先生も、いかがですか？","zh":"万圣节，是互送糖果的节日吗？\n工作也需要糖分，老师，您也来些糖果吧！"},{"label":"新年","jp":"明けましておめでとうございます、先生。 新年だからといって、仕事があることに変わりはありませんが。まあ、少しぐらいお手伝いしますよ。","zh":"新年快乐，老师\n当然了，虽说是新年，工作还是要做的\n不过，我会在一旁协助老师哦。"},{"label":"圣诞节","jp":"さあ先生、聖夜を共に過ごしましょうか？ ……この大量の仕事を片付けないことには、帰るに帰れませんからね。","zh":"老师，您要和我一起度过平安夜吧？\n如果不把这么多工作处理完的话，想回都回不去呢"},{"label":"春节","jp":"","zh":"老师，要处理完所有工作后才能开始您的新春假期哦\n别担心，我会协助您的"},{"label":"中秋","jp":"","zh":"您的请假申请我收到了，但您并没有提前一周向我申请呢\n算了，毕竟是团圆的日子呢，这次就例外吧"}]},"stats":{"init":[{"name":"攻击力","value":"180"},{"name":"防御力","value":"18"},{"name":"生命值","value":"2379"},{"name":"治愈力","value":"1997"},{"name":"命中值","value":"105"},{"name":"闪避值","value":"1039"},{"name":"暴击值","value":"211"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1086"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4558"},{"name":"防御力","value":"103"},{"name":"生命值","value":"51645"},{"name":"治愈力","value":"11898"},{"name":"命中值","value":"325"},{"name":"闪避值","value":"1489"},{"name":"暴击值","value":"711"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1086"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"135%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"354"},{"name":"生命值","value":"2521"},{"name":"治愈力","value":"1089"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"