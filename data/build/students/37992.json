""},"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/373176.png","name":"海里的朋友","desc":"于海洋博物馆当作纪念品贩售的鲸鱼造型巧克力。以远远胜过其他鱼类巧克力的尺寸为傲"},"ability":{"attrs":[{"name":"生命值","value":"2212"},{"name":"攻击力","value":"80"},{"name":"治愈力","value":"201"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/302888.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/259244.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 星野（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/86082/2025/5/13/922910.png","url":"https://www.gamekee.com/ba/621572.html"},{"name":"★3 星野（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/30/132299.png","url":"https://www.gamekee.com/ba/162560.html"},{"name":"NPC 星野(1年级)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/30/657785.png","url":"https://www.gamekee.com/ba/614051.html"},{"name":"NPC 星野（2年级）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/30/647552.png","url":"https://www.gamekee.com/ba/619744.html"},{"name":"星野 * 恐怖","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/30/398191.png","url":"https://www.gamekee.com/ba/628376.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"ふぁ～、適当にやろうよ～ゆとりが大事なんだから～","zh":"嗯哈...随便搞搞就行啦，适当咸鱼一下也是很重要的嘛。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"よく来たね、先生。相変わらず苦労が多そうだ～","zh":"你来啦老师，还是老样子，看起来一脸疲相啊。"},{"label":"登陆2","jp":"ああ、いらっしゃ～い。いろいろ仕事が溜まってるよ。","zh":"嗯哈~你来啦，要做的事情都堆成山啦。"},{"label":"大厅1","jp":"ここは涼しくていいよ～","zh":"这里好凉快~真好。"},{"label":"大厅2","jp":"色々お疲れ様、先生も。","zh":"老师你也是，真的辛苦了。"},{"label":"大厅3","jp":"私が必要って？へぇ、お世辞でもありがとう。","zh":"需要我？是客套话吧，不过还是谢谢你了。"},{"label":"大厅4","jp":"えっ？お世辞じゃないの？あ、う、うん…。…あ、ありがとう。","zh":"欸？不是客套话，嗯嗯嗯，谢、谢谢。"},{"label":"大厅5","jp":"あまり肩に力入れなくていいよ～リラックスが大事だし。","zh":"不用这么紧张拼命了嘛，休息也是很重要的。"},{"label":"回忆大厅1","jp":"あれあが、くじらのやつなの？","zh":"那个，就是鲸鱼吗？"},{"label":"回忆大厅2","jp":"へえ～すごい。こんなところ初めて。","zh":"欸嘿嘿嘿，厉害！我还是第一次来。"},{"label":"回忆大厅3","jp":"あれ見て！お魚だ！あははは、カワイイ！","zh":"啊，你看，是鱼欸~可爱欸~"},{"label":"回忆大厅4","jp":"私一人こんなに楽しんでていいのかな…。\n余計な心配だって？…そうかな？","zh":"我一个人这么开心真的好吗…。\n你说这是多余的担心？…是吗？"},{"label":"咖啡馆1","jp":"うん、いい所だね。気に入ったよ。","zh":"嗯~好地方，我喜欢。"},{"label":"咖啡馆2","jp":"お昼寝にちょうどいい場所はどこかな～","zh":"嗯哼哼，在哪里在哪里可以睡觉觉~？"},{"label":"咖啡馆3","jp":"適当に、適当に～","zh":"随便啦，随便啦~"},{"label":"咖啡馆4","jp":"うん、悪くないかもね。","zh":"嗯~应该还不错。"},{"label":"咖啡馆5","jp":"へぇ～いいんじゃないかな？","zh":"欸嘿，应该还行吧。"}],"好感度":[{"label":"好感度1","jp":"先生も変わってるね～。どうしてこんな私を。","zh":"老师也真是怪啊，为什么要对我这么好.."},{"label":"好感度2","jp":"一緒にのんびりしようよぉ〜。","zh":"一起咸鱼嘛~"},{"label":"好感度3","jp":"うへえ～、ありがとう先生。","zh":"欸嘿，谢谢..老师。"},{"label":"好感度4","jp":"えへへ～、私の心をこんなに動かすのは先生だけだぁ。","zh":"欸嘿嘿，能让我这么心动的，也只有老师你了。"}],"战斗":[{"label":"编入队伍1","jp":"まあ、仕事だし、やらしかないよね。","zh":"哈啊，工作嘛，还是得干的吧。"},{"label":"编入队伍2","jp":"はぁ～面倒くさいけど、しょうがないなぁ。","zh":"唔嘿，好烦人，但是没法子啊。"},{"label":"拎起","jp":"はぁ～面倒くさ～","zh":"呜啊，烦吸了…"},{"label":"任命队长1","jp":"さて、仕事だ。気合いれてこ～","zh":"好嘞，开工了，认真点喽。"},{"label":"任命队长2","jp":"はじめよ～か～","zh":"那开始呗~"},{"label":"普通技能","jp":"これで時間が稼げるよ。","zh":"这样可以争取一点时间。"},{"label":"EX动画1","jp":"こっちに集まて。","zh":"来这集合！"},{"label":"EX动画2","jp":"盾だよ。集まて","zh":"盾牌来喽，躲我后边。"},{"label":"EX动画3","jp":"前は私に任せて。","zh":"先头就交给我吧。"},{"label":"EX技能1","jp":"私が耐えてる間に、攻撃して","zh":"我撑住，你们打。"},{"label":"EX技能2","jp":"私に任せなって","zh":"交给我呗~"},{"label":"EX技能3","jp":"無駄だよ","zh":"没用的。"},{"label":"战斗开始1","jp":"さぁ、準備出来た？いくよ～","zh":"行啦，准备好了没，上喽~"},{"label":"战斗开始2","jp":"こっち、準備して～","zh":"这边，准备一下。"},{"label":"获得BUFF","jp":"Thank you~","zh":"Thank you~"},{"label":"施放BUFF","jp":"さあ、行ってみよう～","zh":"走吧~"},{"label":"掩体","jp":"-","zh":"（喘气）"},{"label":"被CC1","jp":"-","zh":"（喘气）"},{"label":"被CC2","jp":"-","zh":"（喘气）"},{"label":"回避","jp":"無駄だよ～","zh":"没用的哟~"},{"label":"队伍移动1","jp":"うへえ、面倒くさいなぁ","zh":"欸嘿，真麻烦啊"},{"label":"队伍移动2","jp":"うはあ、ねむい。","zh":"呜哇，困困的"},{"label":"回复","jp":"世話をかけるね～","zh":"多谢关照啦~"},{"label":"中途退出","jp":"ごめん、みんな…","zh":"大家，对不起..."},{"label":"战斗喊叫","jp":"-","zh":"（喊叫）"},{"label":"战斗喊叫","jp":"-","zh":"（喊叫）"},{"label":"战斗喊叫","jp":"-","zh":"（喊叫）"},{"label":"角色移动","jp":"こっちだよ～","zh":"这边哟~"},{"label":"战斗胜利1","jp":"ふぁあ～ぐぅ～、適当で勝っちゃったな","zh":"（伸懒腰）随随便便就赢了。"},{"label":"战斗胜利2","jp":"ふぁあ～、勝利勝利～","zh":"（伸懒腰）胜利胜利。"},{"label":"关卡完成1","jp":"まぁ、こんなもんだよね","zh":"嗨，就这样吧。"},{"label":"关卡完成2","jp":"当たり前の結果じゃなぁい～","zh":"必然的结果好吧~"},{"label":"战斗失败1","jp":"あれ、負けちゃった～","zh":"欸，我输了欸~"},{"label":"战斗失败2","jp":"こんなつもりじゃなかったけどな","zh":"还真没想到会这样啊~"}],"成长":[{"label":"升级1","jp":"ふぁ、もっと強くなっちゃったか","zh":"欸~我又变强了啊。"},{"label":"升级2","jp":"う～ん？悪くないぞ","zh":"唔？感觉不错哦。"},{"label":"升级3","jp":"うへぇ～、これでより丈夫になれたよ","zh":"唔嘿，这样我就更硬了。"},{"label":"升级4","jp":"うん、いい感じ～","zh":"嗯哼，爽耶。"},{"label":"获得专武","jp":"先生、これでもう一度頑張ってみるから。これからもよろしく～","zh":"老师，那我就再努力一下吧，以后请多指教。"}],"事件":[{"label":"学生生日","jp":"うん…？私の誕生日？ な、なに、このおじさんにそんなの気にしなくていいよ。 でも…ありがとう。ちょっと嬉しい。うへへ。","zh":"嗯？我的生日？不、不必了，不用特意给大叔我过生日的，不、不过，谢谢你，有点开心，嘿嘿。"},{"label":"老师生日","jp":"へぇ～誕生日なの？先生にも誕生日があったんだ～？\nあはは、冗談だよ、もちろんあるよね。おめでとう、先生。","zh":"欸？生日啊？老师你也有生日啊？哈哈，开玩笑的，当然有的吧，生日快乐，老师。"},{"label":"万圣节","jp":"ハロウィン、なんて別に関係ないんけど…。そういえば先生もハロウィンパーティーに行くの？　ん？私と一緒に行きたいの？うへへ～それは光栄だね～","zh":"万圣节，和我没什么关系，对了，老师也会参加万圣节派对吗，嗯？想和我一起去？那还真是荣幸啊。"},{"label":"新年","jp":"またこうして新しい一年が始まるんだね。今年もよろしくね、先生？","zh":"新的一年，也要开始了，今年也多多指教了，老师。"},{"label":"圣诞节","jp":"うへ～このおじさんはこういう日が苦手なんだよ～みんなキラキラ浮かれてて…。まあ、たまにはこういうのも悪くないけど。","zh":"唔嘿嘿嘿，大叔我最怕这种日子了，大家都打扮的漂漂亮亮，兴高采烈的样子，算了，偶尔这样，也不错啦。"},{"label":"春节","jp":"","zh":"呀~新春新气象，那大叔我，肯定要先睡个好觉啦"},{"label":"中秋","jp":"","zh":"一起看月亮？那我晚上不就……\n诶……偶尔一次也不错。"}]},"stats":{"init":[{"name":"攻击力","value":"213"},{"name":"防御力","value":"175"},{"name":"生命值","value":"3275"},{"name":"治愈力","value":"1687"},{"name":"命中值","value":"615"},{"name":"闪避值","value":"246"},{"name":"暴击值","value":"205"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1948"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4757"},{"name":"防御力","value":"2792"},{"name":"生命值","value":"111386"},{"name":"治愈力","value":"7077"},{"name":"命中值","value":"615"},{"name":"闪避值","value":"246"},{"name":"暴击值","value":"505"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1948"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"419"},{"name":"生命值","value":"7554"},{"name":"治愈力","value":"920"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"背包","grade":"T10","attrs":[{"name":"生命值","value":"14000"},{"name":"防御力","value":"1700"},{"name":"生命值","value":"5%"}]},{"slot":"3号装备","name":"护身符","grade":"T10","attrs":[{"name":"暴击抵抗值","value":"420"},{"name":"暴伤抵抗率","value":"3000"},{"name":"暴击值","value":"300"}]}],"giftDetail":{"t1Value":[{"name":"暴击伤害抵抗率","value":"2000"}]},"abilityDetail":{"attrs":[{"name":"生命值","value":"2212"},{"name":"攻击力","value":"80"},{"name":"治愈力","value":"201"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_400/h_400/829/103682/2025/6/18/227938.png","attrs":[{"name":"防御力","va