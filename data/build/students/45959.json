mg-v2.gamekee.com/wiki2.0/images/w_47/h_54/829/191981/2025/6/29/744832.png"}],"uniqueWeapon":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_793/h_246/829/236746/2025/5/12/571985.png","name":"理想化","desc":"晴奈使用的狙击步枪。\n她说：狙击镜所目及之处，是通往究极美食的道路。","table":{"cols":["Lv1","Lv30","Lv40","Lv50","Lv60"],"rows":[{"label":"攻击力","values":["165","599","748","898","1048"]},{"label":"生命值","values":["549","1995","2494","2992","3491"]}]},"skill":{"name":"被动技能强化为「美食家的气度+」","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_107/h_96/829/236746/2025/5/12/541314.png","description":"","levels":[{"lv":1,"text":"生命值增加3501，生命值增加14%"},{"lv":2,"text":"生命值增加3676，生命值增加14.7%"},{"lv":3,"text":"生命值增加3851，生命值增加15.4%"},{"lv":4,"text":"生命值增加4552，生命值增加18.2%"},{"lv":5,"text":"生命值增加4727，生命值增加18.9%"},{"lv":6,"text":"生命值增加4902，生命值增加19.6%"},{"lv":7,"text":"生命值增加5602，生命值增加22.4%"},{"lv":8,"text":"生命值增加5777，生命值增加23.1%"},{"lv":9,"text":"生命值增加5952，生命值增加23.8%"},{"lv":10,"text":"生命值增加6652，生命值增加26.6%"}]},"star3":"市街战适应性强化至SS","star3Icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/673843.png","star4":"神秘克制率增加10%"},"favoriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"黒舘 ハルナ","kana":"黒舘 くろだて","twName":"羽留奈","cnName":"晴奈","age":"17岁","birthday":"3月1日","height":"163cm","hobby":"探寻一切美味的食物","designer":"-","artist":"whoisshe","cv":"日 | 田所あずさ\n中 | MACE\n韩 | 이보희（李甫熙）","hallLevel":"6","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"EAT OR DIE","bio":"格黑娜学园所属，美食研究会的部长。虽然乍一看给人一种有钱大小姐那样高傲的气质，但只要跟美食扯上关系，就会变成不顾一切的热血属性美食家。跟贪吃的本性恰恰相反的是，就餐礼仪很细致，进食的量也不大。喜欢的是内脏杂锅和烤猪内脏之类的油腻食物。\n\"要一起启程前往，美食的世界吗？\"","sourceUrl":""},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/43637/2025/4/26/465835.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/12/87836.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/43637/2025/4/26/465835.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/12/87836.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/12/492792.png","name":"美食的证明（抹茶口味）","desc":"晴奈为了证明自己领悟到的美食假设，和老师一起制作的抹茶巧克力。深奥的苦味中渗透着蕴藏着感激之情的甜味。"},"ability":{"attrs":[{"name":"生命值","value":"864"},{"name":"攻击力","value":"170"},{"name":"治愈力","value":"201"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/12/178958.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/12/183306.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 晴奈（体操服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/12/567707.png","url":"https://www.gamekee.com/ba/578165.html"},{"name":"★3 晴奈（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/12/684884.png","url":"https://www.gamekee.com/ba/579682.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"美食研究会へようこそ。\n究極の味を求めて、共に冒険に出かけましょうか？","zh":"欢迎来到美食研究会，和我们一起去探险，寻求终极的美味吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ふふっ、何度お目にかかっても飽きないお顔をされてますわね。","zh":"哼哼，您的脸，还真是无论看多少次都看不腻呢。"},{"label":"登陆2","jp":"あら？褒め言葉ですわよ？好意的な意味ですわ、うふふっ…。","zh":"哎呀！我是在夸您啦，这话是褒义的哦。"},{"label":"登陆3","jp":"あら？ご機嫌よう。うふふっ…。","zh":"哎呀，贵安。"},{"label":"大厅1","jp":"それはわたくしも同じ…ですって？","zh":"你说我也一样？"},{"label":"大厅2","jp":"可愛い…？な、なななななんのことかしらっ！？","zh":"说我可爱？？你、你你你你在说什么呢！？"},{"label":"大厅3","jp":"高級料理店はお好きか、ですって？うふふっ、嫌いではありませんわ。","zh":"您问我喜不喜欢高级餐厅？倒是说不上讨厌。"},{"label":"大厅4","jp":"ただ、私が一番好きなのは、","zh":"只不过，我最喜欢的还是.."},{"label":"大厅5","jp":"愛する御方と一緒に頂く食事ですわ♡","zh":"和心上人一起享用美食哦。"},{"label":"大厅6","jp":"たい焼きですの？私の一番お気に入りの食べ物ですわ。うふふ。","zh":"您说鲷鱼烧是吗？那可是我最喜欢吃的食物了。"},{"label":"回忆大厅1","jp":"うふふ、こうやって一緒に帰宅できるだなんて、\nたい焼きもこんなにたくさん買ってしまいましたし。\nたい焼きだと少し質素じゃないか、ですって？\nいいえ.....私にっとっては最高に贅沢な瞬間でうわ。","zh":"哼哼，没想到可以和您一起回家，而且还买了这么多的鲷鱼烧，您说鲷鱼烧会不会有点朴素了？不会啊，对我来说这可是最奢侈的瞬间。"},{"label":"回忆大厅2","jp":"では、先生。これをさしあげますわ。\n......いいえ。あーん、でなくては。","zh":"来，老师，这个给您尝一下，不对，您应该像这样，张开嘴，啊~"},{"label":"回忆大厅3","jp":"一番好きな御方と一緒に、一番好きな食べ物を頂く。\nこれぞ正しく......。","zh":"和最喜欢的人一起，想用最喜欢的美食，这样正是.."},{"label":"回忆大厅4","jp":"うん？その表情、どうかなさいまして？\nうふふっ。そのような反応も、嫌いではありませんが。","zh":"嗯？您的表情是有那里感觉不对吗？您的这种反应，我也并不讨厌。"},{"label":"回忆大厅5","jp":"寒くないか、ですって？\nいいえ、暖かいですわよ。本当に。","zh":"您问我，冷不冷？不冷，我感觉很温暖，真的。"},{"label":"咖啡馆1","jp":"究極の味を追求させて頂くため、今日も一生懸命に…。","zh":"为了找到终极的美味，我今天也会竭尽全力。"},{"label":"咖啡馆2","jp":"食べ物に関して気になることがおありでしたら、いつでも私をお訪ねください。","zh":"如果对美食有兴趣的话，请随时来找我。"},{"label":"咖啡馆3","jp":"美食への道のりはやはり険しいものですわね。","zh":"果然，美食之路充满了艰险呢。"},{"label":"咖啡馆4","jp":"美味しいとは一体何なのでしょう？私たちにとってそれは、どのような意味なのかしら？","zh":"美味，究竟是什么呢？对我们来说又意味着什么呢？"},{"label":"咖啡馆5","jp":"美味しい。それは尊いものですわね。","zh":"唇齿间感受到的美味，是最珍贵的东西。"}],"好感度":[{"label":"好感度1","jp":"もう少し一緒にいていただきたいです。","zh":"希望，您可以再多陪我一会儿。"},{"label":"好感度2","jp":"美味しいものをいただきたいですわね。できればご一緒に。","zh":"真想品尝一些美味佳肴啊，您可以陪我一起吗？"},{"label":"好感度3","jp":"先生と一緒でしたら、夢に見た至高の味を…見つけられるかもしれませんわね。","zh":"和老师在一起，或许就能找到，在梦中见到的至高美味呢。"},{"label":"好感度4","jp":"先生とのお食事はいつも特別ですの。味とは関係なく……ですわ。","zh":"和老师一同用餐，总会有特别的感觉，这与味道无关啊。"}],"战斗":[{"label":"编入队伍1","jp":"私の出番ですわね。","zh":"看来该我出动了。"},{"label":"编入队伍2","jp":"よろしくってよ。お任せください。","zh":"如此甚好，请交给我吧。"},{"label":"拎起","jp":"うふふっ…","zh":"呵呵~"},{"label":"任命队长1","jp":"少しだけはしゃいでみましょうか。","zh":"略微奔放一些也无碍。"},{"label":"任命队长2","jp":"お相手して差し上げますわ。","zh":"就由我来奉陪吧。"},{"label":"普通技能","jp":"そちらですの？","zh":"在那边是吧？"},{"label":"EX动画1","jp":"うふふっ、参ります！","zh":"呵呵，献丑了。"},{"label":"EX动画2","jp":"優雅に参りましょうか！","zh":"优雅的向前推进吧。"},{"label":"EX动画3","jp":"さぁ、準備はよろしくって？","zh":"来，做好准备了吗？"},{"label":"EX技能1","jp":"お覚悟はできていらっしゃるのかしら？","zh":"您是否已经有所觉悟了吗？"},{"label":"EX技能2","jp":"スコヴィル値1000万級の激辛ですわ！","zh":"这可是超过一千万斯科维尔单位的辣度哦！"},{"label":"EX技能3","jp":"突き抜ける優雅さで！","zh":"用优雅贯穿一切。"},{"label":"战斗开始1","jp":"皆様、ご健闘をお祈りいたしますわ。","zh":"祝愿各位武运昌隆。"},{"label":"战斗开始2","jp":"あらまぁ、お出ましですわね。盛大にお出迎えして差し上げましょう。","zh":"哎呀呀，大驾光临，有失远迎，那我们就隆重的欢迎一番吧。"},{"label":"获得BUFF","jp":"あら？ありがとうございます。","zh":"哎呀，非常感谢。"},{"label":"施放BUFF","jp":"これはいかが？","zh":"这样如何？"},{"label":"掩体","jp":"御免あそばせ。","zh":"承让了。"},{"label":"被CC1","jp":"ッ…","zh":"（喘息）"},{"label":"被CC2","jp":"あぁ…","zh":"（喘息）"},{"label":"被CC3","jp":"くっ…","zh":"（喘息）"},{"label":"回避","jp":"うふっ、無駄ですわ。","zh":"白费力气。"},{"label":"队伍移动1","jp":"参りますわよ。","zh":"继续前进吧。"},{"label":"队伍移动2","jp":"前進いたしますわ。","zh":"要继续前进了。"},{"label":"回复","jp":"恐縮ですわ。","zh":"真是受宠若惊啊。"},{"label":"中途退出","jp":"お恥ずかしい…姿を…","zh":"让您，见笑了。"},{"label":"战斗喊叫","jp":"やっ！","zh":"（喊叫）"},{"label":"战斗喊叫","jp":"はぁ！","zh":"（喊叫）"},{"label":"战斗喊叫","jp":"参ります。","zh":"我要上了。"},{"label":"角色移动","jp":"ふぅん…","zh":"嗯？"},{"label":"战斗胜利1","jp":"(もぐもぐ)ん～！このお味たまりませんわ。","zh":"呜哇，这个味道真是让人难以抗拒。"},{"label":"战斗胜利2","jp":"(もぐもぐ)～～！勝利後のたい焼きは格別ですわね。","zh":"哇！胜利之后的鲷鱼烧，真是格外美味呀！"},{"label":"关卡完成1","jp":"うふふっ、祝勝のパーティーを開こうと思うのですが、御一緒しませんこと？","zh":"哼哼，我想办一场庆功宴，您可愿一同参加？"},{"label":"关卡完成2","jp":"あら、勝利ですわね。うふふっ。","zh":"哎呀，胜利了，哼哼~"},{"label":"战斗失败1","jp":"美食の道とは、こんなにも厳しいものなのですのね。","zh":"追求美食的道路上，真是充满了艰辛呢。"},{"label":"战斗失败2","jp":"困りましたわね…。ここでこんな困難に遭遇するだなんて…。","zh":"真是恼人，居然会在这里遇到如此的险阻。"}],"成长":[{"label":"升级1","jp":"あら、これは新しいお味ですわね。","zh":"哎呀，这味道可真是新鲜。"},{"label":"升级2","jp":"あら……わたくしの為にここまでして下さるなんて。","zh":"哎呀，您竟然为我做了这么多。"},{"label":"升级3","jp":"たまにはこういうのも悪くありませんわね。\n先生、私の成長きちんと見守っていてくださいね。","zh":"偶尔这样做，感觉也不错呢，老师，请您密切关注我的成长啊。"},{"label":"升级4","jp":"ふふ……感謝いたしますわ。","zh":"哼哼，非常感谢。"},{"label":"获得专武","jp":"美食家の道は、修行者の道と同じですわね。\n究極というものを追求し、探求し、そして前に進んで行くこと。\nうふふっ……これで私もまた少し、前に進めそうですわ。","zh":"美食家之道与修行者之道是一样的，两者都是在对极致的追求和探索的道路上不断前进，现在我也可以再向前迈进一步了吧。"}],"事件":[{"label":"学生生日","jp":"あら、私の誕生日を覚えててくださったんですの？うふふ、嬉しいですわ。\n今日はお洒落なお店で、美味しいものを一緒に頂けるのでしょうか？楽しみにしておりますわね。","zh":"哎呀，没想到您百忙之中还记得我的生日，我真的很开心，不如今天我们找一家分外优雅的餐厅一起享用写精致的食物，您意向如何呢？我对此不胜期待。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。誕生日にはやはりケーキですわ。\n新鮮な生クリームを乗せてもいいですし、濃厚なチーズをたくさん乗せても、新鮮なフルーツを乗せてもいいですわね。","zh":"祝您生日快乐，老师，过生日当然要吃蛋糕啦，蛋糕上可以放些新鲜的奶油，也可以放很多香味浓郁的芝士，又或者放些新鲜的水果也不错。"},{"label":"万圣节","jp":"キヴォトスで一番おいしい飴について、ご存じかしら？ご存じないですの？\n私は存じております。\nそれは、先生が持っていらっしゃる飴、ですわ。…私にくださる？","zh":"您知道，基沃托斯最好吃的糖果是什么吗？您不清楚是吗？但我知道啊，那就是老师您手上拿着的糖果，可否给我一颗呢？"},{"label":"新年","jp":"明けましておめでとうございます、先生。お正月といえば…やはりお雑煮ですわね。\nお餅は焼いてもいいですし、そのまま入れてもいいですし。\nジャガイモと鶏団子を入れて煮込んだ後、コタツの中で頂くそのお味といったら…うふふ。","zh":"恭祝您新春快乐，说到正月自然就要吃年糕汤了，年糕可以烤着吃，或者直接放进汤里吃，放点土豆和鸡肉丸煮一煮，然后在被炉里享用，那种味道，哼哼~"},{"label":"圣诞节","jp":"メリークリスマス。こんな日にはブッシュドノエルや、シナモンのクッキーが良いですわね。\nですが、キャンドルを灯して向かい合って頂くものでしたら、どんなものでも美味しそうですわ、フフフ。","zh":"圣诞快乐，今天比较适合吃圣诞树桩蛋糕或者是肉桂饼干这一类的东西呢。\n不过，假如能够面对面坐在烛光下，任何东西都会变的好吃呢，呵呵。"},{"label":"春节","jp":"","zh":"每逢新春时节，都会出现很多我未曾品尝过的美食。\n老师，有兴趣和我去一探究竟吗？"},{"label":"中秋","jp":"","zh":"听说山海经又推出了很多口味独特的新款月饼，\n真是让人心驰神往啊。"}]},"stats":{"init":[{"name":"攻击力","value":"457"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2451"},{"name":"治愈力","value":"1690"},{"name":"命中值","value":"924"},{"name":"闪避值","value":"205"},{"name":"暴击值","value":"205"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1944"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"10520"},{"name":"防御力","value":"106"},{"name":"生命值","value":"49107"},{"name":"治愈力","value":"6528"},{"name":"命中值","value":"924"},{"name":"闪避值","value":"205"},{"name":"暴击值","value":"835"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1944"},{"name":"射程","value":"750"},{"nam