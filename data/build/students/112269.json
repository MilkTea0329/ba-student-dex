/72324/2025/5/9/623874.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/628472.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★2 朱音","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/9/204800.png","url":"https://www.gamekee.com/ba/66752.html"},{"name":"★3 朱音（制服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/927668.png","url":"https://www.gamekee.com/ba/645973.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"ご主人様のメイド、アカネです。\nいえ…今はご主人様のウサギさん、と申し上げるべきでしょうか？","zh":"我是主人的女仆，茜。\n哦不，现在应该说我是主人的兔兔了吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お待ちしておりました、ご主人様。\nアカネはご主人様だけの忠実なウサギです。ぴょんぴょん！","zh":"我正等你呢。主人。\n茜是只属于主人的忠诚兔兔，蹦蹦。"},{"label":"登陆2","jp":"おかえりなさいませ、ご主人様。準備は全て終わっております…\n勤勉なウサギですから。","zh":"欢迎回来，主人，所有准备工作都已经完成了，因为我是一只勤劳的兔兔。"},{"label":"大厅1","jp":"ウサギになりきるのは楽しいか…ですか？\nうふふ、そうですね…どう見えます？","zh":"问我变成兔兔开不开心？这个，您觉得呢？"},{"label":"大厅2","jp":"ご要望がありましたら、いつでもお申し付けください。\nお待ちしておりますので。","zh":"如果你想要什么，请随时告诉我，我一直都在。"},{"label":"大厅3","jp":"ご主人様とのこの一瞬は、私にとってかけがえのない大切な時間です。","zh":"和主人一起度过的每个瞬间，对我来说都是无可替代的宝贵时光。"},{"label":"大厅4","jp":"爆弾は一番効率的な掃除道具なんですよ。\nじょ、冗談です…そんな目で見ないでください、ご主人様。","zh":"炸弹是最有效的打扫工具之一。\n我，我开玩笑的，请不要那样看着我，主人。"},{"label":"大厅5","jp":"ウサギになりきる事は、より完璧なエージェントに近づくための一歩。\nもしくは、より完璧なメイドに近づくための一歩かもしれませんね。","zh":"我认为成为兔兔是成为完美特工的一种方式，又或者是成为更完美女仆的一种方式。"},{"label":"回忆大厅1","jp":"申し訳ございません……\nこんな考え、メイドとしては失格のはずなのに。\n私……自信をなくしておりました。","zh":"非常抱歉，有这样的想法是我身为女仆的失职。我失去了自信。"},{"label":"回忆大厅2","jp":"ご主人様はいつも多くのものを背負っていて、\nそれなのに大丈夫だと笑っていて。","zh":"主人一直背负着很多重担，可即便如此，你还是会笑着说，没关系。"},{"label":"回忆大厅3","jp":"私は…全然その重荷を、代わりに持って差し上げられず…。","zh":"我没能替你背负那份重担。"},{"label":"回忆大厅4","jp":"ですが、ご主人様のお言葉で、再び前を向けそうです。","zh":"可是听了主人的话，我再一次找回了自信。"},{"label":"回忆大厅5","jp":"これからも、ふつつかものですが何卒よろしくお願いいたします。ご主人様。","zh":"虽然我还有很多不足之处，但今后还是请主人多多关照啦。"},{"label":"咖啡馆1","jp":"綺麗に整頓されていますね。掃除は…大切です。","zh":"收拾干净了，打扫卫生是很重要的。"},{"label":"咖啡馆2","jp":"いらっしゃいませ。ご注文は紅茶ですか？…ふふっ。","zh":"欢迎光临。要点一杯红茶吗？"},{"label":"咖啡馆3","jp":"ご主人様は本当に…特別なお方なのです。","zh":"主人真的是一个很特别的人。"},{"label":"咖啡馆4","jp":"もう少し整理できるところは…","zh":"哪里还需要再整理一下吗？"},{"label":"咖啡馆5","jp":"この際、ご主人様と一緒にウサギの道を歩んでみるのも…？","zh":"趁此机会，和主人一起漫步在兔兔之路上。"}],"好感度":[{"label":"好感度1","jp":"ウサギには愛が必要なんですよ。ぴょんぴょん！","zh":"兔兔需要爱哦，蹦蹦！"},{"label":"好感度2","jp":"ありがとうございます、ご主人様。これからもご期待ください。","zh":"多谢主人，今后也请拭目以待吧。"},{"label":"好感度3","jp":"全てご主人のおかげです。本当に全てが…","zh":"这一切都是主人的功劳。真的，所有一切。"},{"label":"好感度4","jp":"ウサギのアカネを、逃がさないでくださいね。","zh":"请不要错过兔兔茜啊~"}],"战斗":[{"label":"编入队伍1","jp":"さあ、それではお掃除を始めましょうか。","zh":"好了，那就开始打扫吧。"},{"label":"编入队伍2","jp":"普段より胸が高鳴って、これも、ご主人と一緒にいるからでしょうか。","zh":"感觉心跳得比平时更快呢，这是因为和主人在一起吗？"},{"label":"拎起","jp":"お掃除の視界がありますね。","zh":"清扫工作的视野已经确认了。"},{"label":"普通技能","jp":"ここに置いておきますね。","zh":"放在这里了。"},{"label":"EX动画1","jp":"こちらが本日の掃除対象でしょうか。","zh":"这是今天要打扫的目标吗？"},{"label":"EX动画2","jp":"こんなに散らかして…","zh":"弄得真乱。"},{"label":"EX动画3","jp":"綺麗に片付けてしまいましょう。","zh":"让我来收拾干净吧。"},{"label":"EX技能1","jp":"はい、どうぞ。","zh":"好了，请拿好。"},{"label":"EX技能2","jp":"私の気持ちを受け取ってくださいませ。","zh":"请收下我的心意。"},{"label":"EX技能3","jp":"どうぞご堪能ください。","zh":"来，请尽情享用哦。"},{"label":"被CC4","jp":"\\","zh":"\\"},{"label":"被CC6","jp":"\\","zh":"\\"}],"z'd":[{"label":"被CC5","jp":"\\","zh":"\\"}],"成长":[{"label":"升级1","jp":"少しは、お役に立てておりますでしょうか。","zh":"有没有稍微帮到您一点呢？"},{"label":"升级2","jp":"メイトとしても、ウサギとしても、ご主人様のお役に立てますように。","zh":"无论是身为女仆还是身为兔兔，我都希望能帮上主人的忙。"},{"label":"升级3","jp":"成長しましたよ。ぴょんぴょん！","zh":"兔兔成长了。"},{"label":"升级4","jp":"ご主人様のご期待にお答えできるように、洗練されてきました。","zh":"为了不辜负主人的期待，我一直在好好锻炼。"},{"label":"获得专武","jp":"これでもっと完璧な…「ウサギ」になれますね。","zh":"这样就能成为更完美的兔兔了呢。"}],"事件":[{"label":"学生生日","jp":"私の誕生日を覚えてくださっていたのですか？\nありがとうございます、ご主人様。これ以上に嬉しいことはございません。","zh":"您竟然记得我的生日，谢谢您。主人。茜实在太高兴了。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、ご主人様！\n本日は、ウサギからの特別なご奉仕を、期待していてくださいね？\nウサギの特別な奉仕、ですか？うふふ…さあ、何でしょうね？\n大丈夫。怖くないですよ～さあ、よしよし…。","zh":"生日快乐，主人，请期待兔兔今天的特别服务。\n你问兔兔的特别服务是什么？这个会是什么呢？\n没关系，不需要害怕。好啦，乖乖。"},{"label":"万圣节","jp":"あ、ハロウィーンですね。\n私のこの格好も、今日だけは普通に見えますね。\nそれで…どんなイタズラがいいですか？\nお菓子をくださっても、イタズラはしますからね？","zh":"今天是万圣节，我这身打扮在今天看起来应该很普通。\n对了，主人喜欢什么样的恶作剧？\n就算给我糖的话，我也会捣蛋的。"},{"label":"新年","jp":"あけましておめでとうございます、ご主人様。\n…もう新年ですね。今年は本当に良い事がたくさんありますように…。","zh":"新年快乐，主人新年到了，希望今年好事多多。"},{"label":"圣诞节","jp":"クリスマスですね、ご主人様。\nご主人様となら毎日が特別ですが…今日はとびきり特別な日です。\n寒がっているウサギのために…おそばにいてくださりませんか？","zh":"今天是圣诞节，主人。\n和主人在一起每天都很特别，但今天是更加特别的一天，\n您愿意留下来陪着怕冷的兔兔吗？"},{"label":"春节","jp":"","zh":"真是热闹的节日啊，今年的兔兔倩也会一如既往的为主人服务啊。"},{"label":"中秋","jp":"","zh":"今天是特别的一天呢，让兔兔倩为主人准备好月饼和茶水吧。"}]},"stats":{"init":[{"name":"攻击力","value":"353"},{"name":"防御力","value":"66"},{"name":"生命值","value":"2227"},{"name":"治愈力","value":"1902"},{"name":"命中值","value":"1131"},{"name":"闪避值","value":"1093"},{"name":"暴击值","value":"251"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1141"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8055"},{"name":"防御力","value":"364"},{"name":"生命值","value":"43212"},{"name":"治愈力","value":"7981"},{"name":"命中值","value":"1131"},{"name":"闪避值","value":"1093"},{"name":"暴击值","value":"881"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1141"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"694"},{"name":"生命值","value":"2358"},{"name":"治愈力","value":"1037"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},