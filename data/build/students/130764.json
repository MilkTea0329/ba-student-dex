/cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"碧蓝档案。"},{"label":"卡池抽取","jp":"こんにちは、先生！栅川中学一年、佐天涙子です。よろしくお願いします！","zh":"您好，老师！我是栅川中学一年纪的佐天泪子。请多指教！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！お待ちしてました！今日は何をするんですか？","zh":"老师！已经等你很久了！今天要去干什么呢？"},{"label":"登陆2","jp":"おかえりなさい、先生。私にできること、何かありますか？","zh":"欢迎回来，老师。有什么我能效劳的地方吗？"},{"label":"大厅1","jp":"ここって、私たちの世界に似ているようで全然違って…面白いんですよね。","zh":"这里和原来的世界完全不同…很有意思呢。"},{"label":"大厅2","jp":"え？今から散歩？…私も行きたいです！連れていってください、先生！","zh":"欸？现在要出去散步吗？…我也要去！带上我一起吧，老师！"},{"label":"大厅3","jp":"何から何まで、面白い世界ですね、ここ！","zh":"这里的一切都很有意思，真是个有趣的世界！"},{"label":"大厅4","jp":"偶然ではありましたけど…ここに来てよかったです！","zh":"虽然说来到这个世界不过是个偶然…但是我还是想说，能来到这里真是太好了！"},{"label":"大厅5","jp":"先生はどうですか？私たちが来てから…毎日がちょっとは楽しくなりました？","zh":"老师是怎么想的？从我们到来的那天开始…所度过的每一日，是否有增加些许欣喜呢？"},{"label":"回忆大厅1","jp":"ん～、特に変わったところは…なさそうかな。\n…先生、顔がこわばってません？ただのバッティングマシーンですって。","zh":"嗯，看起来也没什么奇怪的。\n…老师，怎么板着张脸，是不是有些紧张？不必紧张，不过是台击球机器罢了"},{"label":"回忆大厅2","jp":"はい。でも、たぶん大丈夫です。バッティングには、それなりに自信がありますから。","zh":"不过，应该没什么问题。我对自己的棒球水平还是有自信的。"},{"label":"回忆大厅3","jp":"…なんですか、その疑いの眼差しは。じゃあ、賭けでもします？","zh":"…什么啊，那充满怀疑的眼神。\n来赌一把吗？"},{"label":"回忆大厅4","jp":"3球以内に打てなかったら、大人しく打席を離れます、その代わり、もし1球でも打てたら、そこの自販機で飲み物を奢ってください！","zh":"如果在三球内，我没打中的话，就会老老实实离开击球位。相对的，哪怕我打中一球，那就要请我喝那边自动贩卖机里的饮料"},{"label":"回忆大厅5","jp":"どうですか？先生にとっても、悪い話じゃないですよね？…へへっ。","zh":"如何？对于老师来说，也不是什么坏事。…嘿嘿。"},{"label":"咖啡馆1","jp":"あれ？あの人は…！","zh":"嗯？那个人是…！"},{"label":"咖啡馆2","jp":"おお！なんかここすごいですね！","zh":"哦哦！总觉得这里很厉害的样子！"},{"label":"咖啡馆3","jp":"一見普通っぽいですけど、よくよく見るとちょっと変わってる…うんん、楽しい！","zh":"虽然乍一看很普通的样子，细细观察的话可以看出来是暗藏玄机呢。"},{"label":"咖啡馆4","jp":"ここが噂に聞く異世界のカフェ…","zh":"这就是传说中的异世界咖啡厅…"},{"label":"咖啡馆5","jp":"なんだか落ち着きますね！えへ！","zh":"感觉心情平静了下来呢！欸嘿嘿！"}],"好感度":[{"label":"好感度1","jp":"なんて言ったらいいんですかね…「ありがとうございます」、じゃ全然足りない気がします…","zh":"该怎么说好呢…谢谢…也万全不足以表达此时的心情…"},{"label":"好感度2","jp":"え？ええ？あたしにですか？本当にいいんですか？","zh":"欸？欸欸？这是给我的吗？这样做真的好吗？"},{"label":"好感度3","jp":"先生には助けられてばかりですね、はは...","zh":"总是受到老师的帮助呢，哈哈…"},{"label":"好感度4","jp":"ここに来てから楽しいことばかりなのは、きっと先生のおかけなんだと思います。","zh":"自从来到这里，遇上的尽是些开心的事，这肯定都是托老师的福。"}],"战斗":[{"label":"普通技能","jp":"お、お味は、どうでしょう…？","zh":"味道…如何？"},{"label":"EX动画1","jp":"う？うぅ...な、なに！？","zh":"唔？呜哇？什么东西！？"},{"label":"EX动画2","jp":"来た！","zh":"来了！"},{"label":"EX动画3","jp":"来ると思った！","zh":"要来了！"},{"label":"EX技能1","jp":"ここは…よいしょ！","zh":"这边是…嘿咻！"},{"label":"EX技能2","jp":"は―！","zh":"哈—！"},{"label":"EX技能3","jp":"させない！やー！","zh":"才不会让你得逞！呀—！"}],"成长":[{"label":"升级1","jp":"く、くれるんですか？ありがとうございます！頑張ります！","zh":"给、给我的吗？谢谢！我会努力的！"},{"label":"升级2","jp":"よく分からないけど、なんだか強くなった気が！","zh":"虽然不是很明白，但是总觉得变强了呢！"},{"label":"升级3","jp":"うわ！体中から力が湧いてくる！こういうものなんですか！","zh":"呜哇！力量正从体内源源不断地喷涌而出！原来是这种感觉啊！"},{"label":"升级4","jp":"先生、あたし今なら何でもできそうな気がします！","zh":"老师，我感觉到，现在的我无所不能！"},{"label":"获得专武","jp":"え？これはあたしに？へ、変な感じですね…ありがとうございます。と、とりあえず頑張りますね！それしか言えなくて、すみません、はは...","zh":"欸？这个要给我吗？有种奇怪的感觉呢…感谢您。总、总之，我会加油的！只能这么说了，哈哈…"}],"事件":[{"label":"老师生日","jp":"ハッピーバースデー！お誕生日おめでとうございます、先生！何か欲しいもの、ありますか？","zh":"Happy birthday！生日快乐，老师！有什么想要的礼物吗？"},{"label":"万圣节","jp":"ハロウィーン…！先生！私たちも何か被りに行きましょう！","zh":"万圣节…！老师！我们也变装出去玩把！"},{"label":"新年","jp":"あけましておめでとうございます！先生！時間が経つのって、本当あっという間ですね……。今年もよろしくお願いします、先生！","zh":"新年快乐！老师！时间流逝就如同白驹过隙…今年也请多指教，老师！"},{"label":"圣诞节","jp":"ここにもクリスマスがあるんですか！？じゃあじゃあ、サンタさんが飛んでるところ、見れますかね！？","zh":"这个世界也有圣诞节吗！？那能不能看到飞在天上的圣诞老人！？"}],"活动":[{"label":"活动登陆1","jp":"来てくれたんですね、先生。では早速に行きましょう！","zh":"您来了啊，老师。那么赶紧出发吧！"},{"label":"活动登陆2","jp":"待ってましたよ、先生！","zh":"久等了，老师！"},{"label":"活动大厅1","jp":"あれ？先生？どうかしました？","zh":"老师？怎么了吗？"},{"label":"活动大厅2","jp":"何かお手伝いしましょうか？","zh":"有什么我能帮到您的地方吗？"},{"label":"活动大厅3","jp":"むむ、先生、今は遊んでる場合じゃないですよ！","zh":"唔唔，老师，现在不是玩耍的时候！"},{"label":"活动大厅4","jp":"もう、先生、集中！集中ですよ！","zh":"真是的，老师，集中精神！集中精神！"},{"label":"活动事件1","jp":"もう残り半分？最後まで頑張りましょう！","zh":"还剩下一半？加把劲坚持到最后吧！"},{"label":"活动事件2","jp":"そろそろ終わりが見えてきましたね。","zh":"已经能看到终点了呢。"},{"label":"活动结束","jp":"最後にもう一度見ていきませんか？","zh":"再最后看一眼吗？"},{"label":"活动商店1","jp":"あれ？何かお探しですか？","zh":"您在找什么？"},{"label":"活动商店2","jp":"ええと…見てもらいたいのはあたしじゃ