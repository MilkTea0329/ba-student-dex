29/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/941892.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/10/671441.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"千秋（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/6/30/97665367ms6wi5yj.png","url":"https://www.gamekee.com/ba/tj/714029.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive~"},{"label":"卡池抽取","jp":"号外!ごうが~い!パンデモニウム•ソサエティーの書記、元宮チアキがシャーレに到着しましたよ~!","zh":"号外号外！万魔殿的秘书，元宫千明，来沙勒啦——！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"はあ!先生お帰りなさい!さっそくインタビューを始めたいですが~いいですか？","zh":"哈，老师回来啦~！正好这里有问题想采访一下老师~！"},{"label":"登陆2","jp":"こんにちは、先生!今日も一日張り切っていきましょう！","zh":"您好，老师！今天也要加油喔——！"},{"label":"大厅1","jp":"はーい!元宮チアキただいま待機中で~す!何かネタ?お手伝いすることはありますあか？","zh":"嗯！元宫千明随时待命！有什么新闻……啊不，有什么需要帮忙的嘛~！"},{"label":"大厅2","jp":"今週の週刊万魔殿、読みました?特別付録のかわいいイブキちゃんブロマイドがもう最高で!","zh":"这周的《万魔殿周刊》您看了吗？【特别附录超可爱小伊吹高清近照】真的超棒的！"},{"label":"大厅3","jp":"これ、来週の週刊万魔殿に載せるマコト先輩の写真なんですけど~はい？小さいすぎて全然見えない?","zh":"诶嘿，这张真琴前辈的照片会登在下周的《万魔殿周刊》上！……什么？太小了看不清？"},{"label":"大厅4","jp":"お仕事中の先生の姿!はい!目線くださ~い!表情固いですよ~はい、リラックスリラックス~","zh":"老师工作中的样子……来，请看我这里！……表情好僵硬！来，放轻松~！"},{"label":"大厅5","jp":"書記としても、当番としても、なんでもやりますから!いつでも言ってくださいね、先生!","zh":"不管是作为秘书还是值日生，我什么都愿意做！有需要的话就随时告诉我哦，老师~"},{"label":"回忆大厅1","jp":"あははっ!シャッターチャンス、捉えました!居眠りする先生の顔、次号の表紙にビッタリです!","zh":"啊哈哈哈！好耶~被我抓拍到了！老师的睡颜……下期封面就是它啦~"},{"label":"回忆大厅2","jp":"これで週刊万魔殿特集号の準備は万全! さっすが私!またスクープゲットしちゃいました~!","zh":"有了这张照片，《万魔殿周刊》特辑的取材就完成啦！我千明的名头可不是吹的吧~大独家到手喽！"},{"label":"回忆大厅3","jp":"ふふっ、書記の行動力、侮っちゃいけませんよ~?","zh":"诶嘿嘿，可别小瞧秘书的执行力哦~？"},{"label":"回忆大厅4","jp":"そうだ!この勢いで、先生の謎に迫っていきましょうか......? 靴下に空いた穴の謎、とか......!","zh":"喔，来都来了，要不再探索一下老师的秘密吧！比如老师有没有穿着破了洞的袜子之类的~？"},{"label":"回忆大厅5","jp":"えっ!意地悪な子は机の下閉じ込めの刑に処す......!? ご、ごめんなさ~い!出してください~!","zh":"哇？！老师，怎么把出口堵住了呀？呜，行啦，这里太挤啦——拜托放我出去——！"},{"label":"咖啡馆1","jp":"ここ、おもしろいですね!","zh":"好神奇的地方啊！"},{"label":"咖啡馆2","jp":"これはスクープの予感がします","zh":"这个……说不定能凑成大新闻呢~！"},{"label":"咖啡馆3","jp":"はぁ、あの方と友達になりたいです!","zh":"哈，我也想和那个人交朋友！"},{"label":"咖啡馆4","jp":"ここに週刊パンデモのスタンドを置いたら...","zh":"在这里放上《万魔殿周刊》的立牌的话……！"},{"label":"咖啡馆5","jp":"これは!イブキちゃんお喜び間違いなしですね","zh":"哈！小伊吹应该会很喜欢！"}],"好感度":[{"label":"好感度1","jp":"あはは、なんだかちょっと照れますね。","zh":"啊哈哈哈……有点害羞呢……"},{"label":"好感度2","jp":"これは、嬉しいです、えっ!いつもより大人しい、私が?ですか?そ、そんなことないですよ~","zh":"这，好开心……！啊，说我比平时文静……？啊哈哈哈，没有吧~哈哈~"},{"label":"好感度3","jp":"うぇぇ、もう!こういう時どんな顔すればいいのかわかりません!","zh":"嗯……！真是的，都不知道摆什么表情好了！"},{"label":"好感度4","jp":"あの、うまく言葉にできないのですが。もう少しだけ先生を集材したい気分です!だめですかね...","zh":"嗯……具体原因我也说不清楚，就是想，再多采访老师一下，可以……吗？"}],"战斗":[{"label":"编入队伍1","jp":"お手伝いが必要ですか?","zh":"请问需要帮忙吗？"},{"label":"编入队伍2","jp":"いいネタ、見つかるかも~!","zh":"说不定有猛料哦……？"},{"label":"拎起","jp":"準備オッケーです!","zh":"准备完毕！"},{"label":"任命队长1","jp":"みんなで突撃しますよ!","zh":"大家冲啊——！"},{"label":"任命队长2","jp":"頑張っていきましょ!","zh":"一起加油吧！"},{"label":"普通技能","jp":"次の特集はこれに決めた!","zh":"下次特辑的主题，就是它啦~！"},{"label":"EX动画1","jp":"ネタの匂いが~あは、バレちゃいました","zh":"嗅到了新闻的气息……啊哈，在那里！"},{"label":"EX动画2","jp":"ふむふむなるほど、はぁ、危ない!","zh":"嗯，原来是这样……啊，好险！"},{"label":"EX动画3","jp":"どれどれ...?あはは!やっば!にげろ~!","zh":"让我看一眼……啊啊，溜了溜了~！"},{"label":"EX技能1","jp":"はい、どうぞ!","zh":"给，接好喽！"},{"label":"EX技能2","jp":"今、取材中なんで!","zh":"现在是采访时间！"},{"label":"EX技能3","jp":"ちょ~っと痛みますよ~?","zh":"可能会……有点痛哦~？"},{"label":"战斗开始1","jp":"よ- い!ドン!","zh":"准备，砰！"},{"label":"战斗开始2","jp":"取材開始です!","zh":"开始取材！"},{"label":"获得BUFF","jp":"ありがとうございま~す","zh":"谢谢喽~！"},{"label":"施放BUFF","jp":"元気盛り盛り","zh":"干劲十足！"},{"label":"掩体","jp":"かくれま~す","zh":"藏起来啦！"},{"label":"被CC1","jp":"いったぁ","zh":"哎呀！"},{"label":"被CC2","jp":"わあ","zh":"哇哦！"},{"label":"被CC3","jp":"えんん","zh":"呜！"},{"label":"回避","jp":"おっと、避けちゃいました","zh":"哎呀~还好还好~"},{"label":"队伍移动1","jp":"どんどんいきますよ","zh":"继续前进吧！"},{"label":"队伍移动2","jp":"先、行きますね","zh":"我先走啦！"},{"label":"回复","jp":"ありがとうございます!元気出ました!","zh":"谢谢，我感觉我又可以啦！"},{"label":"中途退出","jp":"今回の取材はここまで...","zh":"本次采访，到此为止……"},{"label":"战斗喊叫","jp":"やっ","zh":"呀！"},{"label":"战斗喊叫","jp":"やぁ","zh":"呀~！"},{"label":"战斗喊叫","jp":"よぉ","zh":"哟！"},{"label":"角色移动","jp":"やっ!","zh":"呀！"},{"label":"战斗胜利1","jp":"楽勝でしたね","zh":"轻轻松松~！"},{"label":"战斗胜利2","jp":"はい、充実した取材でした!","zh":"这次取材的内容，超满意！"},{"label":"关卡完成1","jp":"はいっ!任務完了、です!","zh":"呀吼，收工！"},{"label":"关卡完成2","jp":"いい写真がたくさん撮れました~!","zh":"太出片了~！"},{"label":"战斗失败1","jp":"つ、つぎはミスしませんから...","zh":"下，下次不会再失误了！"},{"label":"战斗失败2","jp":"はぁ、あれ？こんなはずじゃあ!","zh":"啊，啊？！不对吧……！"}],"成长":[{"label":"升级1","jp":"ふぁは!ありがとうございます、先生。","zh":"啊啊！谢谢你，老师！"},{"label":"升级2","jp":"はい!これからも書記魂を燃やしてだんだん行きますよ～！","zh":"好，我的秘书之魂已经熊熊燃烧了，今后会继续努力的！"},{"label":"升级3","jp":"少し強くなった気がします、今なら週刊万魔殿の勧誘活動もうまく行きそうな~","zh":"感觉自己更能干了，接下来，《万魔殿周刊》的宣传活动，一定能顺利展开……！"},{"label":"升级4","jp":"はああ、嬉しい!今なら空も飛びちゃいそうです。先生、写真取りますから一緒に写ってください!はーい!チーズ!","zh":"哇啊？！好开心，开心的要飞起来了！老师，快来这里，我要拍照喽？来，茄——子！"},{"label":"获得专武","jp":"やった!すご~く嬉しいです!特ダネゲットした時と同じか、それ以上に!","zh":"太开心了！就像抓到了大独家！不对，比这还要开心！"}],"事件":[{"label":"学生生日","jp":"あれ？そう言えば私の誕生日でしたね、編集に夢中で忘れてました。ははは、ありがとございます。","zh":"啊，是我生日啊？沉迷剪辑都给忘啦……啊哈哈哈，谢谢您提醒我！"},{"label":"老师生日","jp":"お誕生日おめでとうございます!先生が生まれた日特集を組んでみました。それとインタビューの回答、お願いします!","zh":"生日快乐！我策划了老师出生那天的特辑，那么，请老师接受一下采访吧！"},{"label":"万圣节","jp":"今日のこの日をずーど楽しみにしてました!町中に変わった人がいっぱい....友達になってきますね!","zh":"啊，这一天我可期待太~久了！路上有好多有意思的人呢！嘿，我去交个朋友！"},{"label":"新年","jp":"明けましておめでとうございます!先生には週刊万魔殿の新年号最初の読者なっていただきます!","zh":"新年快乐呀，老师！今年第一份《万魔殿周刊》的抢先阅读机会，就留给您了哦？"},{"label":"圣诞节","jp":"メリークリスマスです!ささ、","zh":"老师，圣诞快乐！请站到圣诞树旁边，我给您拍个照！"},{"label":"春节","jp":"","zh":"老师，和我一起去山海经学院转转吧，因为这次《万魔殿周刊》的主题是：超丰盛！山海经春节团圆饭！"},{"label":"中秋","jp":"","zh":"好像很多人都在期待今晚的月亮呢……啊，难道有月球人会出现吗？！啊——那只想和他们交朋友呀！"}],"活动":[{"label":"活动登陆1","jp":"わ～!お楽しみがいっぱい!","zh":"啊哈——这么多好玩的东西！"},{"label":"活动登陆2","jp":"先生!こっちです!私の隣!先生の席、とってありますよ～!","zh":"老师，这边，来坐我边上吧！已经给老师占好位置啦！"},{"label":"活动大厅1","jp":"は~い!お呼びですか？","zh":"嗯？您叫我了吗？"},{"label":"活动大厅2","jp":"次号に使えそうな写真取っていきますよ!","zh":"下期的照片，我们一起去抓拍一些吧！"},{"label":"活动大厅3","jp":"先生、あ～んしてください。はいっ!今のはパンデモウム•ソサエティー特製