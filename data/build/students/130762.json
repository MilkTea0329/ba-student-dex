637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/759052.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/5/13/43947.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"碧蓝档案。"},{"label":"卡池抽取","jp":"常盤台中学2年、御坂美琴。私の手伝いが必要なら言ってちょうだい。","zh":"我是常盘台中学二年生，御坂美琴。如果需要我帮忙的话，记得说哦。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"あ、先生。こっち、こっち。ちょっと来るの遅いわよ。待ってたんだから。","zh":"啊，老师，在这在这，你稍微迟到了一点哟...我可等了好一会呢。"},{"label":"登陆2","jp":"お疲れ様、先生。私？ずっとここにいたけど。","zh":"辛苦啦老师，我吗？一直在这里呀。"},{"label":"大厅1","jp":"なんとなーく、一人で出かけるのはまだハードル高いというか……。","zh":"该怎么说呢，感觉一个人出门，还是有点太难了。"},{"label":"大厅2","jp":"停電の時に助けてほしい？はいはい、冗談でしょ。\n……まぁ、助けなくもないけどさ。","zh":"停电的时候希望我帮你？好好好....是开玩笑吧？虽然我也没有没帮过就是了。"},{"label":"大厅3","jp":"たまーに、学園都市に似てると感じる事があるんだよね、ここ。","zh":"有时候，还是感觉这里和学园都市好像啊。"},{"label":"大厅4","jp":"先生、よかったら風にあたらない？","zh":"老师！可以的话要一起出去吹吹风吗？"},{"label":"大厅5","jp":"ここってしゃべる猫も多いわよね……一体どういう事なのかしら？\nあ、いや！なんでもない！","zh":"这里会说话的猫好多啊……到底是什么情况？啊！没什么。"},{"label":"回忆大厅1","jp":"うーーーん。ずっと眺めてたら、ちょっとは可愛く見えてきたような……","zh":"嗯......一直看着的话，是觉得有点可爱了呢......"},{"label":"回忆大厅2","jp":"結局、これはブタなの……？\nそれともカバ？……えっ、鳥！？嘘でしょ！？","zh":"话说，这个是猪？还是河马？诶？是鸟吗？骗人的吧！？"},{"label":"回忆大厅3","jp":"そ、それはそうだけど……あはは……ま、どっちでもいいわ。","zh":"话是这么说没错……啊哈哈哈……嘛，反正没什么关系的。"},{"label":"回忆大厅4","jp":"というか、よく考えたら……\nこれ、先生からのプレゼントなのよね。","zh":"嗯，仔细想了想的话……这个毕竟是老师赠与的礼物嘛。"},{"label":"回忆大厅5","jp":"……大切にするわ。ありがとう、先生。","zh":"嘿嘿，我会好好珍惜的。谢谢老师。"},{"label":"咖啡馆1","jp":"ここがシャーレのカフェ...。","zh":"这就是夏莱的咖啡厅吗？"},{"label":"咖啡馆2","jp":"何なのあれ？","zh":"那是啥啊？"},{"label":"咖啡馆3","jp":"変なものが沢山あるわね。","zh":"奇怪的东西有好多啊。"},{"label":"咖啡馆4","jp":"こ、これは結構可愛いかも。","zh":"这，这还有点可爱呢。"},{"label":"咖啡馆5","jp":"うん？誰かに呼ばれてる？","zh":"嗯？是有谁在叫我吗？"}],"好感度":[{"label":"好感度1","jp":"なんか...ずっともらってばっかだけど、いいの？","zh":"感觉...一直都是我在接受恩惠，这样真的好吗？"},{"label":"好感度2","jp":"ちょっと照れ臭いかも...有難くもらうけど。","zh":"虽说稍微有点难为情...但我会心怀感激收下的。"},{"label":"好感度3","jp":"たまにはこういうのも悪くないわね、うん。","zh":"偶尔这样来一次，也不错嘛。对吧。"},{"label":"好感度4","jp":"私も、何かしたいんだけど、その...\n手伝えること、ないかしら。","zh":"我也该帮忙做点什么，要不...我来帮你打打下手吧。"}],"战斗":[{"label":"编入队伍1","jp":"うん？何？参加すればいいの？","zh":"嗯？什么？是要我来参加吗？"},{"label":"编入队伍2","jp":"手伝って欲しいの？それくらいなら...まぁ。","zh":"是要我来帮忙吗？如果只是简单的帮一下的话（也不是不行）。"},{"label":"拎起","jp":"何か用？","zh":"叫我干嘛？"},{"label":"任命队长1","jp":"よし、いくわよ。","zh":"好，我要上了。"},{"label":"任命队长2","jp":"ここに行くの？オッケー。","zh":"要去这边吗？OK。"},{"label":"普通技能","jp":"これは痛いわよ！","zh":"这下可是很痛的哦！"},{"label":"EX动画1","jp":"あとで後悔するんじゃないわよ！","zh":"你可别等会后悔呀！"},{"label":"EX动画2","jp":"そっちがやる気なら！","zh":"既然是你先动手的话！"},{"label":"EX动画3","jp":"そんなに見たいなら！","zh":"既然你那么想看的话！"},{"label":"EX技能1","jp":"よく見てなさい！","zh":"好好见识下吧！"},{"label":"EX技能2","jp":"食らえ！","zh":"接招吧！"},{"label":"EX技能3","jp":"これはどう？","zh":"这招如何？"},{"label":"战斗开始1","jp":"早く終わらせるわよ！","zh":"快点结束吧！"},{"label":"战斗开始2","jp":"これ全部やるの?とりあえずわかったわ！","zh":"这些都要干掉吗？总之我明白了！"},{"label":"获得BUFF","jp":"おっ、サンキュー！","zh":"哦！谢谢！"},{"label":"施放BUFF","jp":"ちょっと本気出そうかな。","zh":"稍微拿出点真本事吧!"},{"label":"掩体","jp":"ここよさそうね。","zh":"这里还不错嘛。"},{"label":"回避","jp":"むだよ。","zh":"没用的。"},{"label":"队伍移动1","jp":"ここは終わり、次！","zh":"这里结束了，继续吧！"},{"label":"队伍移动2","jp":"まだまだ！","zh":"还没完呢！"},{"label":"回复","jp":"おっ、ありがとう！","zh":"哦！谢谢！"},{"label":"中途退出","jp":"そんな...","zh":"怎么会..."},{"label":"战斗胜利1","jp":"もういいんじゃない？","zh":"这不是蛮好的么？"},{"label":"战斗胜利2","jp":"どう？悪くなかったでしょう。","zh":"怎么样？还不错吧。"},{"label":"关卡完成1","jp":"じゃ、出発するわよ。","zh":"那么，我出发啦。"},{"label":"关卡完成2","jp":"なんか...大方わね。","zh":"感觉差不多了..."},{"label":"战斗失败1","jp":"ぐっ、お...おかしいな。","zh":"咳、好...好奇怪啊。"},{"label":"战斗失败2","jp":"思ったりより難しかったわね。","zh":"感觉比想象中要难呢。"}],"成长":[{"label":"升级1","jp":"あ？なにこれ？いいんじゃない！","zh":"啊？这是什么？挺不错的啊！"},{"label":"升级2","jp":"頭がすっきりする感じね。ありがとう！","zh":"感觉眼前一亮了呢，谢谢！"},{"label":"升级3","jp":"こんなにいいの？あたしはいいんだけど...","zh":"这样可以吗？我的话倒没问题的..."},{"label":"升级4","jp":"手助けしてくれた分、ちゃんと返していくから!","zh":"帮了我的这份人情，我一定会好好的还给你的！"},{"label":"获得专武","jp":"正直言って、ちょっと珍しいというか……。\n普段はこういうの、持ち歩いてないからさ。\nわざわざ用意してもらっちゃって……ありがと。期待に応えられるよう、ちゃんとやるわね。","zh":"说实话，这样子的武器好像很少见呢......\n可能是平时不怎么携带着出门吧。\n谢谢你......特意为我准备……我一定会努力回应你的期待的，我会加油的。"}],"事件":[{"label":"学生生日","jp":"え？あ、ありがとう。\nまさか誕生日もここで過ごすことになるなんて……\nあはは……ちょっと複雑な気持ちだわ。","zh":"诶？谢谢你了 没想到生日居然也在这里过了......心情真是有点复杂啊。"},{"label":"老师生日","jp":"お！先生、今日誕生日？おめでとう！なにか欲しい物ある？","zh":"哦！今天是老师的生日？恭喜呀！有什么想要的东西吗？"},{"label":"万圣节","jp":"なんか外が騒がしいわね。\nこんな日はなーんか色々起こるのよね……","zh":"感觉外面好吵闹啊。在这种日子里好像总会发生很多事情呢……"},{"label":"新年","jp":"あけましておめでと、先生！\nそういえば、ここでは新年は何をして過ごすの？","zh":"新年快乐老师！话说回来，这里的新年一般都是会干些什么呀？"},{"label":"圣诞节","jp":"クリスマスか……こっちでもお祝いするのね。先生は出かける約束とかある？","zh":"圣诞节吗……这里也会庆祝呀。老师会有什么人约你吗？"}],"活动":[{"label":"活动登陆1","jp":"そろそろ始めようかしら！","zh":"差不多该开始了吧！"},{"label":"活动登陆2","jp":"私は準備オッケー。先生は？","zh":"我已经准备好啦，老师呢？"},{"label":"活动大厅1","jp":"うん？なんか呼んだ？","zh":"嗯？刚刚说什么了吗？"},{"label":"活动大厅2","jp":"なんだ、冷やかしか。","zh":"什么嘛，是在嘲笑我嘛。"},{"label":"活动大厅3","jp":"他にやんなきゃいけないことあるんじゃないの？","zh":"你不是还有别的事情需要做吗？"},{"label":"活动大厅4","jp":"はあ……わかった、わかった。何か手伝おうか？","zh":"呼 ，知道啦知道啦，需要我帮什么忙吗？"},{"label":"活动事件1","jp":"かなり進んだわね！","zh":"进步了一大截呢！"},{"label":"活动事件2","jp":"もうほとんど終わった感じよね。","zh":"嗯，感觉差不多都结束了。"},{"label":"活动结束","jp":"一応もう一回確認してみて？","zh":"姑且再确认一下吧？"},{"label":"活动商店1","jp":"あれ？何かお探しですか？","zh":"咦？您在找什么吗？"},{"label":"活动商店2","jp":"えっと…見てもらいたいのは、私じゃなくて、あっちなんですけど","zh":"呃…让您看的不是我，是在那边"},{"label":"CH9998_BoxShop_1","jp":"あたしじゃなくて、あっちへしなさいよ。","zh":"不是我啦，去看那边。"},{"label":"CH9998_BoxShop_2","jp":"アハハ、な...なに？くすぐったい！","zh":"啊哈哈，怎...怎么啦？好痒的啦！"},{"label":"CH9998_BoxShop_300","jp":"これで大体終了かな、お疲れ様先生！","zh":"这下就差不多结束了，辛苦啦老师！"},{"label":"CH9998_BoxShop_End","jp":"ほろ、まだ残ってるから、手遅れになる前に全部回したら、もったいないわよ","zh":"看，还剩下好多呢，在耽误时间之前再来一次吧，不然太浪费啦。"},{"label":"CH9998_BoxShop_Login_1","jp":"またあったわね、先生。ちょっと回していく。","zh":"又见面了，老师，要出去走走吗？"},{"label":"CH9998_BoxShop_Login_2","jp":"いい感じじゃない。今なら、いいの出るかもね。","zh":"状态不错，总感觉马上会有什么好事发生哦。"},{"label":"CH9998_Boxshop_SPBuy_1","jp":"ほら、当たりじゃない。おめでとう！","zh":"看，这不是抽中了吗，恭喜哟！"},{"label":"CH9998_Boxshop_SPBuy_2","jp":"これ結構レアなんじゃない。","zh":"这不是蛮少见的嘛。"},{"label":"CH9998_Boxshop_SPBuy_3","jp":"そこそこいいものじゃない。","zh":"勉勉强强还算不错吧。"}]},"stats":{"init":[{"name":"攻击力","value":"287"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2407"},{"name":"治愈力","value":"1718"},{"name":"命中值","value":"731"},{"name":"闪避值","value":"764"},{"name":"暴击值","value":"208"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1336"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"30 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6300"},{"name":"防御力","value":"104"},{"name":"生命值","value":"52227"},{"name":"治愈力","value":"6118"},{"name":"命中值","value":"951"},{"name":"闪避值","value":"764"},{"name":"暴击值","value":"1338"},{"name":"暴击伤害","value":"226%"},{"name":"稳定值","value":"1336"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"30 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"565"},{"name":"生命值","value":"3371"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"977"},{"name":"攻击力","value":"107"},{"name":"治愈力","value":"205"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/43637/2025/5/13/185971.png","attrs":[{"name":"攻击力","value":"153"},{"name":"生命值","value