5/5/551510.png","name":"TWISTED VALENTINE","desc":"明日奈为主人淮备的巧克力。在保管和运送过程中发生了一点小小的变形。"},"ability":{"attrs":[{"name":"生命值","value":"1050"},{"name":"攻击力","value":"121"},{"name":"治愈力","value":"191"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/5/829959.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/5/44011.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 明日奈（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/5/428299.png","url":"https://www.gamekee.com/ba/89742.html"},{"name":"3★ 明日奈（制服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/5/271224.png","url":"https://www.gamekee.com/ba/645821.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"ご主人様と一緒に！\n楽しい一日を始めちゃおう！","zh":"和主人一起，开始愉快的一天啦。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生！いや、ご主人様！\nこんにちは！\n今日も一緒に頑張ろうね！","zh":"老师，不对，主人您好，今天也一起加油吧！"},{"label":"登陆2","jp":"どんなミッションでもどんと来いだよ！\n私とご主人様なら問題なし！","zh":"无论什么任务，都放马过来吧，只要我和主人搭档，就没问题。"},{"label":"大厅1","jp":"こんにちは！ご主人様！\n今日もせいいっぱい仕えてあげるね！","zh":"您好主人，今天我也会努力侍奉你的。"},{"label":"大厅2","jp":"私に会いに来てくれたの？そうだよね？\nやっぱりご主人様は私のことが好きなんだね！","zh":"你是来见我的吗，一定是吧，我就知道主人喜欢我。"},{"label":"大厅3","jp":"掃除と洗濯なら任せて！\n跡形も残さず片付けてあげる！","zh":"打扫卫生和洗衣服的活就交给我吧，我会收拾的干干净净，不留一点痕迹。"},{"label":"大厅4","jp":"任務が入ってきたよ～\nさあさあ、ご主人様！\n早く解決しに行こう！","zh":"任务来啦，主人，我们快点去解决吧！"},{"label":"大厅5","jp":"休憩？そんなのいらない！\nそれより一緒に遊ぼう！","zh":"休息？没必要，有那个时间不如一起玩啊。"},{"label":"回忆大厅1","jp":"…ふふっ、ご主人様に乗っかっちゃった！\nうん、身体も軽いし、今なら何でもできそう！","zh":"哎呀，别这么盯着我看嘛。"},{"label":"回忆大厅2","jp":"うーん、何なんだろうなー、この感じ…\n…まあ良いか！じゃーん！\nいつものアスナちゃん、復活！","zh":"嗯，其实我也会有害怕的时候。"},{"label":"回忆大厅3","jp":"これもご主人様のおかげだよ、\nありがとね！","zh":"但是，我更害怕我的同伴受伤。"},{"label":"回忆大厅4","jp":"ふふっ。やっぱりこうしてご主人様の\nそばにいると、心が躍るなー。\n…なんだかちょっと、癖になっちゃいそう！","zh":"所以不管什么时候，我都会站在最前面。"},{"label":"回忆大厅5","jp":"だからこれから時々こういう風に…ね？\nよろしく、私のご主人様！","zh":"主人也是，你只管跟在明日奈的身后就行啦，我一定会带你去充满快乐的地方。"},{"label":"咖啡馆1","jp":"らんらら～ん、今日はなんだか良いことがありそうな予感～。\nご主人様もそうでしょ？","zh":"啦啦啦，总感觉今天会发生什么好事呢？主人是不是也是这么觉得呢？"},{"label":"咖啡馆2","jp":"ご主人様、ようこそ～。私が元気づけてあげる！","zh":"主人，你来啦，我来帮你打起精神！"},{"label":"咖啡馆3","jp":"あっ！ご主人様だ！食事～？お風呂～？それとも…えへへ！","zh":"啊，主人来啦，要吃饭，要洗澡，还是？嘿嘿嘿？"},{"label":"咖啡馆4","jp":"うーん…服がピッチピチ。太ったかな？それともまた…？","zh":"嗯..衣服有点紧，难道是胖了？还是又.."},{"label":"咖啡馆5","jp":"暇だなぁ～何か漫画とかないかな～？","zh":"好无聊啊，有没有漫画书什么的?"},{"label":"咖啡馆6","jp":"るんるんるん～♪","zh":"啦啦啦~"}],"好感度":[{"label":"好感度1","jp":"ご主人様は私に興味津々なんだね！","zh":"哼，主人对我很感兴趣嘛~"},{"label":"好感度2","jp":"ご主人様が私のご奉仕を必要としてくれるなら、\nいつでも、どこでも、何でもするよ！","zh":"只要主人一声令下，我随时随地都能提供服务。"},{"label":"好感度3","jp":"ご主人様と一緒にいるの楽しい！これからも私と楽しく過ごそうね！","zh":"和主人在一起可真开心啊，以后也要多和我一起玩哦！"},{"label":"好感度4","jp":"ご主人様、心配しないで。私はずっとご主人様のそばを離れないから！","zh":"主人，不用担心，我永远都不会离开主人的。"}],"战斗":[{"label":"编入队伍1","jp":"アスナだよ！先生、よろしく！","zh":"明日奈报道，多关照啦老师。"},{"label":"编入队伍2","jp":"ふふっ！やっぱり私が必要なんだね！","zh":"嗯哼，就知道不能没有我。"},{"label":"拎起","jp":"やっほー！まっかせてねー！","zh":"呀吼，交给我吧！"},{"label":"任命队长1","jp":"コールサインゼロワン、アスナ！いっくよー！","zh":"呼号ZERO ONE 明日奈出动！"},{"label":"任命队长2","jp":"さぁ！それでは任務を始めてみようかなっと！","zh":"好，我们这就开始执行任务吧！"},{"label":"普通技能","jp":"覚悟しなさい！","zh":"脖子给我洗干净了！"},{"label":"EX动画1","jp":"アスナ、いっくよー！","zh":"明日奈，出击喽！"},{"label":"EX动画2","jp":"ふふっ！全っ然当たらないよ！","zh":"嗯哼，根本就打不中嘛！"},{"label":"EX动画3","jp":"イチかバチか、やってみようかな！","zh":"豁出去了，上吧！"},{"label":"EX技能1","jp":"誰にも私を止められない！","zh":"没人能挡的住我！"},{"label":"EX技能2","jp":"イッツ、ショウタイム！","zh":"It's show time!"},{"label":"EX技能3","jp":"アスナ、ここに参上！","zh":"我明日奈就来会会你！"},{"label":"战斗开始1","jp":"全員、戦闘配置へ！派手にやってみようか！","zh":"全体，做好战斗准备，我们战个痛快吧！"},{"label":"战斗开始2","jp":"C&Cエージェントの力を見せてあげる！","zh":"让他们见识一下，C&C特工的实力！"},{"label":"获得BUFF","jp":"-","zh":"-"},{"label":"施放BUFF","jp":"-","zh":"-"},{"label":"掩体","jp":"-","zh":"-"},{"label":"被CC1","jp":"-","zh":"呀！"},{"label":"被CC2","jp":"-","zh":"救命啊！"},{"label":"被CC3","jp":"-","zh":"饶不了你！"},{"label":"回避","jp":"-","zh":"-"},{"label":"队伍移动1","jp":"-","zh":"-"},{"label":"队伍移动2","jp":"-","zh":"-"},{"label":"回复","jp":"最っ高！大好き！","zh":"真棒！爱死你了！"},{"label":"中途退出","jp":"うん…ごめん…。","zh":"嗯..抱歉."},{"label":"战斗喊叫","jp":"-","zh":"嘿！"},{"label":"战斗喊叫","jp":"-","zh":"哈！"},{"label":"战斗喊叫","jp":"-","zh":"要上了！"},{"label":"角色移动","jp":"-","zh":"-"},{"label":"战斗胜利1","jp":"よっしゃ～！ちょっとウォーミングアップできたかな。\nあれ？あはは…","zh":"好耶！身体有点热乎起来了。"},{"label":"战斗胜利2","jp":"んぅ～すっごく良かった…あらら、見ちゃった？","zh":"（伸懒腰）真痛快！哎呀，你在看哪呀？"},{"label":"关卡完成1","jp":"この空気、最高！","zh":"这种气氛真是棒极了！"},{"label":"关卡完成2","jp":"みんなお疲れ、すっごく良かったよ","zh":"大家辛苦了，打的真漂亮！"},{"label":"战斗失败1","jp":"う～ん、予想と違ったなぁ…","zh":"嗯….跟我想的不一样啊…"},{"label":"战斗失败2","jp":"惜しかった…皆、ゴメン！","zh":"好可惜，大家抱歉！"}],"成长":[{"label":"升级1","jp":"これからが本番ね。","zh":"好戏还在后头呢。"},{"label":"升级2","jp":"あれ？なんだか頭がよくなった気分…！","zh":"哎？怎么感觉自己变聪明了?"},{"label":"升级3","jp":"ご主人様の期待に私は絶対何としても答えるから！","zh":"无论如何，我都绝对不会让主人失望的！"},{"label":"升级4","jp":"ふふっ。ご主人様は私に何を望んでいるの？今の私なら叶えてあげられるよ","zh":"哼哼，主人对我有什么期望吗？我现在就为你实现！"},{"label":"获得专武","jp":"ご主人様！見て見て！\n新しい武器が届いたの！\nキラキラしてて可愛いでしょ？！","zh":"主人，快看快看，新的武器送来了，闪闪发光的很可爱吧？"}],"事件":[{"label":"学生生日","jp":"ご主人様！今日はご主人様の可愛いメイドの誕生日だよ！\nプレゼントは何をくれるの？","zh":"主人！今天是你可爱女仆的生日，你准备送我什么礼物啊？"},{"label":"老师生日","jp":"ご主人様のお誕生日を世界一盛大にお祝いするの！","zh":"我会为主人献上全世界最热烈的生日祝福！"},{"label":"万圣节","jp":"わあ！ハロウィンだ！\n見て見て！ご主人様！町が活気で溢れてるよ！\n早く行ってみよ！","zh":"哇！万圣节欸，主人，你看你看，街上也太热闹了吧，我们快去看看吧！"},{"label":"新年","jp":"明けましておめでとうございます、私のご主人様。\n今年もよろしくお願いいたします…\nなんてね！今年も来年も最高に楽しませてあげる！","zh":"恭祝您新春快乐，我的主人，今年也请多多关照，\n逗你的，今年明年我都会让您开开心心的！"},{"label":"圣诞节","jp":"メリークリスマス！\nサンタの代わりに、メイドがご主人様にプレゼントを渡しに来たよ！\nプレゼントは何かというと…ふふっ。","zh":"圣诞快乐，就由女仆来代替圣诞老人为主人送上礼物吧，\n你问礼物是什么？哼哼哼~"},{"label":"春节","jp":"","zh":"主——人——\n新春快乐！和明日奈一起开开心心的度过新的一年吧！\n今后也会这么一直开心下去的！"},{"label":"中秋","jp":"","zh":"月饼已经准备好啦！\n今天能和主人团圆，真的好开心啊！"}]},"stats":{"init":[{"name":"攻击力","value":"2