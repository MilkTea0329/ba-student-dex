com/wiki2.0/images/w_85/h_85/829/157597/2025/4/30/757612.png","levels":[{"lv":1,"text":"每20秒，对一名敌方单位造成攻击力295%的伤害并赋予眩晕状态(持续1.6秒)"},{"lv":2,"text":"每20秒，对一名敌方单位造成攻击力310%的伤害并赋予眩晕状态(持续1.6秒)"},{"lv":3,"text":"每20秒，对一名敌方单位造成攻击力325%的伤害并赋予眩晕状态(持续1.6秒)"},{"lv":4,"text":"每20秒，对一名敌方单位造成攻击力354%的伤害并赋予眩晕状态(持续1.7秒)"},{"lv":5,"text":"每20秒，对一名敌方单位造成攻击力369%的伤害并赋予眩晕状态(持续1.7秒)"},{"lv":6,"text":"每20秒，对一名敌方单位造成攻击力384%的伤害并赋予眩晕状态(持续1.7秒)"},{"lv":7,"text":"每20秒，对一名敌方单位造成攻击力413%的伤害并赋予眩晕状态(持续1.9秒)"},{"lv":8,"text":"每20秒，对一名敌方单位造成攻击力428%的伤害并赋予眩晕状态(持续1.9秒)"},{"lv":9,"text":"每20秒，对一名敌方单位造成攻击力443%的伤害并赋予眩晕状态(持续1.9秒)"},{"lv":10,"text":"每20秒，对一名敌方单位造成攻击力472%的伤害并赋予眩晕状态(持续2秒)"}]}},"profile":{"fullName":"空崎 ヒナ（水着）","kana":"空崎 そらさき","twName":"阳奈（泳装）","cnName":"日奈（泳装）","age":"17岁","birthday":"2月19日","height":"142cm","hobby":"睡眠、休息","designer":"-","artist":"DoReMi","cv":"日 | 广桥凉\n中 | 王雅欣\n韩 | 박신희（朴信姬）","hallLevel":"5","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"","bio":"格黑娜学园所属的风纪委员长，为了夏季集训而来到了海边。\n几乎没有在海边玩过的她，泳衣和泳圈看起来都是以前的东西。即使说着“不穿就太浪费了”这样的理由，但是心底还是稍微在意着自己还能穿上旧泳衣的事实。\n但是不管无论是什么样的打扮、季节或是地点，她对风纪的严格也丝毫没有改变。\n\"就算是夏天，要做的事也没有改变\"","sourceUrl":""},"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"866"},{"name":"攻击力","value":"136"},{"name":"治愈力","value":"201"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/4/30/488046.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/4/30/872917.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 日奈","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/26/685313.png","url":"https://www.gamekee.com/ba/59934.html"},{"name":"★3 日奈（礼服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_246/h_203/829/43637/2025/8/1/878489.png","url":"https://www.gamekee.com/ba/tj/611753.html"},{"name":"NPC 日奈（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/26/438370.png","url":"https://www.gamekee.com/ba/161199.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"ゲヘナの風紀委員長、ヒナ。\n……これはあくまで、夏のトレーニング合宿のための格好だから。","zh":"格黑娜的风纪委员长，日奈。\n……这只是为了夏日集训的着装。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ああ、おかえり。先生。トレーニングの準備ならできてるよ。","zh":"啊，欢迎回来。老师。训练的准备已经完成了。"},{"label":"登陆2","jp":"今年の夏も、よろしく。……えっと、そうやってあんまり見られると、その……。","zh":"今年夏天也请多关照。……那个，一直这样盯着我的话，那个……。"},{"label":"大厅1","jp":"この水着？合宿のトレーニングにはちょうどいいかなって。","zh":"这件泳衣？正好适合合宿的训练。"},{"label":"大厅2","jp":"別に期待とか、楽しみにしてたわけじゃ…。その、ほんの少しくらいしか…。","zh":"并不是期待什么的…那个，只有一点点…。"},{"label":"大厅3","jp":"トレーニングもいいけど、休息も大事？……確かにそれも正論。でも、私がサボるわけにはいかないから。","zh":"训练也很重要，休息同样也很重要？……确实说的没错。但是，我不能偷懒。"},{"label":"大厅4","jp":"何かできること……？ありがとう、先生。\nそう言ってくれるだけで、私は嬉しい。","zh":"能做些什么吗……？谢谢你，老师。\n有你这句话，我就很高兴了。"},{"label":"大厅5","jp":"この夏が終わる、最後の瞬間まで……。\n私がすぐそばで、先生の事を助けるから。","zh":"到这个夏天结束，直到最后的瞬间为止……。\n我会在老师身边，帮助你的。"},{"label":"回忆大厅1","jp":"何でみんな、そんなに海が好きなんだろう……って、ずっとそう思ってた。\nみんなは楽しそうだけど、私はどうしても好きになれなくて…","zh":"为什么大家都那么喜欢大海呢……我一直在思考。\n虽然大家看起来很开心，但是我却怎么也喜欢不上…"},{"label":"回忆大厅2","jp":"水の中はよく見えないし、足が付かないと不安だし……\n先生も、そう思ったことない？","zh":"水里既看不清楚，脚也不能沾地，这样就会很不安……\n老师也这么想吗？"},{"label":"回忆大厅3","jp":"特に夜の海は、まるで暗闇みたいに不気味で……\n見てるだけで吸い込まれそうで、好きになれなかったけど……","zh":"特别是夜晚的大海，简直就像深渊一样令人毛骨悚然……\n只是看着就好像被吸进去了，我不喜欢……"},{"label":"回忆大厅4","jp":"でも……今は、みんなの気持ちが少しだけ分かった気がする。\n海って、こんなに綺麗だったのね。","zh":"但是……现在，感觉稍微明白了大家的心情。\n大海，原来这么漂亮啊。"},{"label":"回忆大厅5","jp":"不思議……今まで、こんな風に思ったことなかったのに。\nありがとう、先生。一緒にいてくれて……\n色んなことを、教えてくれて。","zh":"不可思议……到现在为止，明明没有这样想过。\n谢谢你，老师。陪着我……\n告诉我各种各样的事情。"},{"label":"咖啡馆1","jp":"この水着、変じゃないかな……？","zh":"这件泳衣很奇怪吧……？"},{"label":"咖啡馆2","jp":"トレーニングのせいか……少し体がだるい。","zh":"也许是因为训练……身体有点酸酸的。"},{"label":"咖啡馆3","jp":"可愛い水着なんて、私には似合わない……","zh":"可爱的泳衣什么的，不适合我……"},{"label":"咖啡馆4","jp":"ここは涼しいね……トレーニングにぴったり。","zh":"这里好凉快啊……很适合训练。"},{"label":"咖啡馆5","jp":"次のトレーニングの内容を考えないと……","zh":"必须要考虑下次训练的内容了……"}],"好感度":[{"label":"好感度1","jp":"今年の夏も、先生と一緒にいられるんだね。","zh":"今年夏天也能和老师在一起呢。"},{"label":"好感度2","jp":"せっかくの夏なのに…私みたいなつまらない子と一緒でいいの？私と…いっしょがいい？そ…そう。","zh":"难得的夏天…和我这样无聊的孩子在一起真的好吗？\n和我呆在一起就好了...吗？这…这样啊。"},{"label":"好感度3","jp":"あ、あんまりくっつかないで！いくら私でもその…。この格好だと、さすがに恥ずかしい…！","zh":"不，不要贴贴！不管怎么说我还穿着……这个打扮，真的好害羞…！"},{"label":"好感度4","jp":"先生の手、ひんやりしてて気持ちいい。外はこんなに日が照ってるし、その…もう少し。","zh":"老师的手冰凉凉的很舒服。外面这么晒，那个…再多一点。"}],"战斗":[{"label":"编入队伍1","jp":"戦闘ね。了解。","zh":"战斗啊。明白。"},{"label":"编入队伍2","jp":"準備ならもうできてる。","zh":"准备的话已经准备好了。"},{"label":"拎起","jp":"何？どうすればいい？","zh":"什么？怎样才好？"},{"label":"任命队长1","jp":"面倒だけど、これもトレーニングの一環。","zh":"虽然很麻烦，但这也是训练的一环。"},{"label":"任命队长2","jp":"先生、指示をお願い。","zh":"老师，请指示。"},{"label":"普通技能","jp":"そこ。","zh":"那里"},{"label":"EX动画1","jp":"この海の風紀も、私が守らないと！","zh":"这片海的风纪，我也要守护！"},{"label":"EX动画2","jp":"仕方ない…実力行使で！","zh":"没办法…行使实力！"},{"label":"EX动画3","jp":"私がやらないと…か。","zh":"我必须要做的事…吗。"},{"label":"EX技能1","jp":"そろそろ諦めたら？","zh":"差不多该放弃了吧？"},{"label":"EX技能2","jp":"逃がさない。","zh":"别想逃。"},{"label":"EX技能3","jp":"トレーニングとはいえ、容赦はしない。","zh":"虽说是训练，但也绝不容许。"},{"label":"战斗开始1","jp":"これより、夏合宿のトレーニングを始める。","zh":"现在开始进行夏季集训的训练。"},{"label":"战斗开始2","jp":"総員、遅れないように。行こう。","zh":"全体人员，不要迟到。走吧。"},{"label":"获得BUFF","jp":"ありがとう","zh":"谢谢。"},{"label":"施放BUFF","jp":"準備完了。","zh":"准备完毕。"},{"label":"掩体","jp":"遮蔽物を確保。","zh":"占领掩体"},{"label":"被CC1","jp":"んっ…。","zh":"（受击音效）"},{"label":"被CC2","jp":"ハァ、まったく…！","zh":"真是的"},{"label":"被CC3","jp":"これぐらい…。","zh":"这种程度"},{"label":"回避","jp":"無駄","zh":"没用。"},{"label":"队伍移动1","jp":"暑い…めんどくさい。","zh":"好热...真麻烦。"},{"label":"队伍移动2","jp":"ああ…まだいるの？","zh":"啊...还在这里吗？"},{"label":"回复","jp":"ありがとう","zh":"谢谢。"},{"label":"中途退出","jp":"あっ…熱中症…？ごめん…先生。","zh":"啊…我中暑了吗…？对不起…老师。"},{"label":"战斗喊叫","jp":"","zh":"-"},{"label":"战斗喊叫","jp":"逃がさない。","zh":"别想逃。"},{"label":"战斗喊叫","jp":"","zh":"-"},{"label":"角色移动","jp":"移動する","zh":"进行移动。"},{"label":"战斗胜利1","jp":"作戦成功。その…、あんまりじっと見ないでほしい。","zh":"作战成功。那个……可以不要这样盯着我看吗。"},{"label":"战斗胜利2","jp":"これくらいたいした事じゃない。…だから、そんなにこっち見ないで！","zh":"这没什么大不了的。…所以，不要这么看着我！"},{"label":"关卡完成1","jp":"先生の指示もあったんだから…これくらいの勝利は当然。","zh":"因为有老师的指示……胜利是理所当然的。"},{"label":"关卡完成2","jp":"作戦成功。…でも少し簡単すぎ。トレーニングにしては物足りない。","zh":"作战成功。…但是有点太简单了。作为训练来说还不够呢。"},{"label":"战斗失败1","jp":"油断した。戻ったら反省会ね、先生。","zh":"我大意了。回去进行检讨会，老师。"},{"label":"战斗失败2","jp":"しくじった…。次は、必ず。","zh":"失败了…。下次一定。"}],"成长":[{"label":"升级1","jp":"ちゃんと合宿の成果があったみたい。","zh":"好像好好集训的成果显现出来了。"},{"label":"升级2","jp":"こんな格好だけど…、私の助けが必要なら、いつでも言って？","zh":"虽然我是这样的打扮……但如果需要我的帮助，无论何时请和我说哦？"},{"label":"升级3","jp":"私はまだまだ強くなれる。先生の為にも、強くなりたい。","zh":"我还能变强。为了老师，我也想变强。"},{"label":"升级4","jp":"いつもありがとう…。こんな私だけど…もう少し頼ってくれるとうれしい。","zh":"一直以来谢谢你…。虽然是这样的我……如果能再拜托我一点的话我会很高兴的。"},{"label":"获得专武","jp":"これを、私に……？分かった、ありがたく受け取る。最後の瞬間、その時まで……先生の期待に応えてみせるから。","zh":"这个，给我的吗……？知道了，谢谢你。最后的瞬间，到那个时候为止……我会回应老师的期待。"}],"事件":[{"label":"学生生日","jp":"私の誕生日……？ああ、そういえばそうだった。\n何か欲しいもの……？いや、別に何も……。\nえっ、取り合えず一緒に海に飛び込もう？\nちょ、ちょっと待って先生！こ、心の準備が……！","zh":"我的生日……？啊，这么说来是这样。\n想要什么东西……？不，没什么……。诶，一起跳进海里吧？\n等一下，老师！还，还没准备好……！"},{"label":"老师生日","jp":"今日、先生のお誕生日？\nえっと、どうしよう……私に何かできることある？\n一緒に、海辺を散歩……？ふふっ。そんなことで良いなら、喜んで。","zh":"今天是老师的生日？\n嗯，怎么办……我能做些什么呢？\n一起在海边散步……？呵呵。如果那样就可以了的话，我很愿意。"},{"label":"万圣节","jp":"ハロウィンか……。ちょっと慣れないけど……\n夏の海みたいに賑やかで、みんな楽しそうね。","zh":"万圣节吗……。虽然有点不习惯……\n像夏天的大海一样热闹，大家看起来都很开心呢。"},{"label":"新年","jp":"明けましておめでとう。先生。\n今年の夏もよろしくね。\n出来れば今年も、またその次の夏も……。","zh":"新年快乐。老师。\n今年夏天也请多关照。\n如果可以的话，今年也、明年的夏天也……。"},{"label":"圣诞节","jp":"メリークリスマス、先生。\n今日がどれだけ特別な日なのか、私はよく分かってないけど。\n先生と一緒に迎えられたことは、嬉しいって思える。","zh":"圣诞快乐，老师。\n我不知道今天是个多特别的日子。\n但能和老师一起迎接，我很高兴。"},{"label":"春节","jp":"","zh":"新的一年，新的开始，一起去海上看日出怎么样？"},{"label":"中秋","jp":"","zh":"我从未想象过能与你在海上赏月，这样美丽的景色，我会一直记着的。"}],"活动":[{"label":"活动登陆1","jp":"いらっしゃい、先生。見ての通り、夏合宿の準備は完璧。何でも言って。","zh":"欢迎，老师。\n如您所见，夏日集训的准备非常完美。您有何吩咐。"},{"label":"活动登陆2","jp":"ああ、先生。合宿のスケジュールはちゃんと確認した？\n今日もこんなに暑いし、水分補給はこまめにね。","zh":"啊啊，老师，已经好好确认过集训的日程表了吗？\n今天天气如此炎热，要注意补充水分。"},{"label":"活动大厅1","jp":"夏……。蒸し暑くて、だるくて、何もかもめんどうだけど……。\nこれもトレーニングの一環、仕方ない。","zh":"夏天……闷热到让人心生困倦，做什么都好麻烦……\n但是这也是训练的一环，没有办法。"},{"label":"活动大厅2","jp":"海には常に危険が伴う。\nいつどこで事故が起こるか分からないから、気を付けて。\nその……。何かあったら、私のことを呼んでくれれば。","zh":"在海边活动往往与危险相伴。随时都有可能发生事故，还请注意安全。\n那个……要是发生了什么，就叫我哦。"},{"label":"活动大厅3","jp":"夏のトレーニング合宿。まさか今年は、先生と一緒だなんて……\n……ちょっと新鮮。","zh":"夏天的训练合宿。没想到今年可以和老师一起……\n……感觉有点新鲜。"},{"label":"活动大厅4","jp":"この水着はあくまで、トレーニングのためで…。\n新しい物を買わなくても、そのまま使えば効率的かなって……。","zh":"说到底，泳装也只是为了训练才穿的……\n即便不买新的泳装，穿旧的泳装也能做到有效率地训练。"}]},"stats":{"init":[{"name":"攻击力","value":"366"},{"name":"防御力","value":"78"},{"name":"生命值","value":"2458"},{"name":"治愈力","value":"1685"},{"name":"命中值","value":"102"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"204"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1364"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"35 (7)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"10860"},{"name":"防御力","value":"429"},{"name":"生命值","value":"50272"},{"name":"治愈力","value":"5999"},{"name":"命中值","value":"102"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"834"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1364"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"35 (7)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"719"},{"name":"生命值","value":"3000"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[{"name":"攻击力","value":"1500"}]},"abilityDetail":{"attrs":[{"name":"生命值","value":"866"},{"name":"攻击力","value":"136"},{"name":"治愈力","value":"136"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_182/h_144/829/43637/2025/4/26/672971.png","attrs":[{"name":"攻击力","value":"207"},{"name":"生命值","value":"1025"}]},{"label":"羁绊角色2","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/6/16/314203.png","attrs":[{"name":"攻击力","value":"167"},{"name":"生命值","value":"1050"}]},{"label":"羁绊角色3","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_246/h_203/829/43637/2025/6/16/194934.png","attrs":[{"name":"攻击力","value":"217"},{"name":"生命值","value":"890"}]}],"review":{"score":"60(B)","scoreIcon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_78/h_78/829/236746/2026/5/4/1780538755206_1780484382794_le19f6is7b_4r3p0fwre2.png","tiers":[{"name":"新手期","value":"★★★★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538770230_1780484152979_ztlyoqzvjh_jegj7hm1j8.png"},{"name":"总力战","value":"★★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538776594_1780484206588_4dnfad9a3r_3ot3lq8zz4.png"},{"name":"大决战","value":"★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538781498_1780484086283_7rhrvvb2ea_pkm9d9l9xl.png"},{"name":"竞技场","value":"★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538786645_1780484112302_bbcdnsjkd1_0c1pwgm01y.png"},{"name":"爬塔","value":"不适合","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538791414_1780484130867_nbi636h5oo_cihwoby2e7.png"},{"name":"演习＆高难","value":"★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538796344_1780484179072_oph41vmqoz_mjsbhuirm.png"}],"skills":{"ex":"*red:3费**red:扇形范围对*最多5个敌人*red:441%伤害*","ns":"每20秒对单*red:226%伤害*+眩晕(2秒)，\n爱用品T2改为对单472%伤害+眩晕(2秒)","ps":"PS 加暴击26.6%，专二加CC强化27","ss":"EX技能结束后，加攻击16.5%(可*叠5次)"},"employment":"野外LU寿司P1可用对策，*red:礼奈的207攻击力挂件*","advice":"想*red:卷礼奈面板*的可以抽并开专"},"officialImages":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_908/h_1210/829/157597/2025/4/30/152843.png"],"expressions":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_311/h_311/829/157597/2025/5/17/93837.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/917516.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/289465.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/923040.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/361810.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/10186.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/292454.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/248371.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/329507.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/571219.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_310/h_310/829/157597/2025/5/17/102591.png"]}