/images/w_252/h_204/829/43637/2025/4/30/657785.png","url":"https://www.gamekee.com/ba/614051.html"},{"name":"NPC 星野（2年级）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/30/647552.png","url":"https://www.gamekee.com/ba/619744.html"},{"name":"星野 * 恐怖","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/4/30/398191.png","url":"https://www.gamekee.com/ba/628376.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive"},{"label":"卡池抽取","jp":"いやー、大事になっちゃったね～これは…おじさんが出なきゃいけないね。","zh":"哎呀~事情闹大了~看来……非得大叔我出面不可了。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お？！先生！お疲れ！来る途中大丈夫だった？後つけられたりしてないー？","zh":"噢，老师，辛苦啦~来的路上还顺利吗~？没被人跟踪之类的吧？"},{"label":"登陆2","jp":"先生～今日もお仕事頑張って～このおじさんがちゃーんと見てるからね~","zh":"今天的工作也要加油啊，老师。大叔会好好看着你的。"},{"label":"大厅1","jp":"あれ、先生はこういう恰好が好きなのか…う～ん…おじさんにはよく分からないなぁ~","zh":"哎呀，原来老师喜欢这种衣服啊……嗯……大叔我实在不太懂诶……"},{"label":"大厅2","jp":"糖分は大事だからね～アメは持ち歩いてるんだ～先生も一つ、要る？","zh":"补充糖分很重要~所以我都会随身带着糖果。老师要不要也来一颗？"},{"label":"大厅3","jp":"ん～…はぁ。先生～悪いけど、マッサージお願いしてもいい？この格好、すぐ肩が凝るんだよねぇ~","zh":"唔……唔姆！老师，不好意思。能帮我按摩一下吗？\n这身衣服穿久了，肩膀都僵了。"},{"label":"大厅4","jp":"壁に背を向ける。これが室内戦の基本だよ～そそ、今のその位置。それなりに使えるから、覚えておいて～","zh":"背靠着墙，可是室内战的基础啊~\n对对对，就是现在这个位置。会考哦，要划上重点~"},{"label":"大厅5","jp":"先生は今日も残業～？はい、あったかいコーヒー。これで夜戦に備えてね~","zh":"老师，你今天也要加班啊？\n喏，热咖啡。夜战必备哦。"},{"label":"回忆大厅1","jp":"いやー~もうこんな時間になっちゃったかぁ~こうなったら、朝まで待つしかないねぇ。","zh":"哎呀，没想到已经这么晚了。\n照这样下去，就只能乖乖等到天亮了。"},{"label":"回忆大厅2","jp":"…へ？またまたぁ～こんなおじさんといたって、別に楽しくないでしょ～","zh":"诶？\n哎呀，和我这种大叔待在一起能有什么好玩的。"},{"label":"回忆大厅3","jp":"う、うへぇ～…その設定まだやるの？おじさんにはちょっと荷が重いかも～","zh":"呜，呜嘿嘿~这个设定，还要一直用下去吗……\n大叔可能会有点压力山大啊~"},{"label":"回忆大厅4","jp":"…まあ、先生が相棒役をそれは、そうだけどさぁ～おじさんはこれが好きなんだ。大目にみてよ～","zh":"……这个嘛，如果老师愿意当我的搭档的话，我也不是不能配合啦。\n那，英雄和搭档要来一顿简单的晚餐吗？……虽然只是应急的口粮。"},{"label":"回忆大厅5","jp":"それは、そうだけどさぁ～おじさんはこれが好きなんだ。大目にみてよ～","zh":"唔，这么说也没错啦……\n诶嘿，大叔我就是好这口。多包涵一下吧~"},{"label":"咖啡馆1","jp":"遮蔽物…確認、出口…確認。","zh":"（掩体……确认，出入口……确认。）"},{"label":"咖啡馆2","jp":"とりあえず、弾薬を確認しよう。","zh":"先检查弹药吧。"},{"label":"咖啡馆3","jp":"うへ…気が休まらないなぁ…こんな時は、先生に会いたいかも…","zh":"呜嘿……总觉得心里不太踏实呢……这种时候就会有点想老师……"},{"label":"咖啡馆4","jp":"この髪型、たしかに楽だけど…変じゃないかなぁ。","zh":"这个发型，方便倒是方便……不过会不会有点怪怪的？"},{"label":"咖啡馆5","jp":"今日は昼寝する気にならないなぁ…","zh":"今天……有点不太想睡午觉呢。"}],"好感度":[{"label":"好感度1","jp":"またこんなの、おじさん照れちゃうよ~","zh":"哎呀……都给大叔整害羞了。"},{"label":"好感度2","jp":"万が一、先生が危険な目にあったら、その時は、いや、そんなことはさせない。","zh":"万一老师遇到危险…………不对，我是不会让这种事情发生的。"},{"label":"好感度3","jp":"うへへ、先生とパトロール、次はいつかな？今から楽しみだね~","zh":"呜嘿~下次跟老师一起巡逻……是什么时候呢~已经开始期待咯~"},{"label":"好感度4","jp":"私がこんな姿でも、先生は信じてくれるんだね。うへ、なんか恥ずかしい~あと.....うれしい。","zh":"就我这副德性，老师也肯相信我呀。呜嘿~感觉怪不好意思的~……不过，也很开心。"}],"战斗":[{"label":"编入队伍1","jp":"気合い入れていくよ~","zh":"鼓足干劲冲吧。"},{"label":"编入队伍2","jp":"めんどくさあいけど、まぁ、ちゃんとやるからさあ~","zh":"好麻烦……嗯，不过我会好好干的。"},{"label":"拎起","jp":"うへ~待機するのも地味に疲れるね~","zh":"呜嘿，光是等着也挺累的。"},{"label":"任命队长1","jp":"私についてきて。","zh":"跟我来。"},{"label":"任命队长2","jp":"始めようか~","zh":"开始吧~"},{"label":"切换形态","jp":"前衛は私に任せて。","zh":"前卫包在我身上。"},{"label":"普通技能","jp":"立て直していこう~","zh":"从头来过吧~"},{"label":"EX动画1","jp":"今度はおじさんの番だよ~","zh":"那，轮到大叔上了？"},{"label":"EX动画2","jp":"通じないよ！","zh":"都说了行不通的。"},{"label":"EX动画3","jp":"呼んだ？","zh":"叫我吗？"},{"label":"EX技能1","jp":"みんな！下がって！","zh":"大家都往后退！"},{"label":"EX技能2","jp":"私が行く。","zh":"让我来！"},{"label":"EX技能3","jp":"それだけ？おじさんがっかりしちゃったな~","zh":"这样就完了？真让大叔失望啊~"},{"label":"战斗开始1","jp":"覚悟して。","zh":"做好心理准备吧。"},{"label":"战斗开始2","jp":"援護は任せた。","zh":"掩护就拜托了。"},{"label":"获得BUFF","jp":"丈夫になったかも！","zh":"好像变结实了诶~"},{"label":"施放BUFF","jp":"おじさん、強くなったよ~","zh":"大叔变强咯~"},{"label":"被CC1","jp":"いたた...","zh":"痛痛痛"},{"label":"被CC2","jp":"-","zh":"-"},{"label":"被CC3","jp":"-","zh":"-"},{"label":"回避","jp":"止めちゃうよ~","zh":"此路不通哦~？"},{"label":"队伍移动1","jp":"まだあるのが....","zh":"还有漏网之鱼吗？"},{"label":"队伍移动2","jp":"私が先に進むから、心配しないで。","zh":"我来打头阵，别担心。"},{"label":"回复","jp":"ありがとう。","zh":"谢啦~"},{"label":"中途退出","jp":"これは....困るな....","zh":"这下…难办了呀…"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"角色移动","jp":"一帰りよ。","zh":"换地方咯。"},{"label":"战斗胜利1","jp":"これくらいへっちゃらだよ~","zh":"这点小事，不在话下~"},{"label":"战斗胜利2","jp":"もう安心していいよ~","zh":"现在可以放心了。"},{"label":"关卡完成1","jp":"当然の結果がな~","zh":"会有这种结果很正常嘛。"},{"label":"关卡完成2","jp":"終わった～じゃ休もうか。","zh":"结束了~那就休息一会吧。"},{"label":"战斗失败1","jp":"ごめんね、おじさんがもっと頑張ってれば....","zh":"抱歉…如果大叔能再…努力一点…"},{"label":"战斗失败2","jp":"腕が鈍っちゃったかな....","zh":"变迟钝了吗…"}],"成长":[{"label":"升级1","jp":"おぉ！おじさんにくれるの？ありがとうね~","zh":"噢？给大叔的吗？谢啦~"},{"label":"升级2","jp":"うん！確かに受け取ったよ！じゃ悪い子達を片付けに行こうか~","zh":"嗯，收到了。……那，该去教训一下那帮坏家伙了。"},{"label":"升级3","jp":"いや、またもらっちゃったよ～そんで、次はどこで戦えばいい？","zh":"哎呀，又接下咯。所以，这回该在哪儿打了呢？"},{"label":"升级4","jp":"うへぇ、こういうの照れるけど~ありがとう先生、先生のためにおじさん戦うね。","zh":"呜嘿~有点不好意思……谢谢你啦，老师。为了老师，大叔会战斗的。"},{"label":"获得专武","jp":"…おじさんの力が必要になったら、いつでも言うんだよ。先生のことは、いつだって最優先だからさ。","zh":"……需要大叔帮忙就说哈？老师永远排在第一位。"}],"事件":[{"label":"学生生日","jp":"ああ、私の誕生日だったかあ…別にあんま気にしてないけど…先生に覚えてもらえるてるのは…ちょっと嬉しいかな。","zh":"啊，今天是我的生日啊？我都忘了……\n老师能记得……有点小开心呢。"},{"label":"老师生日","jp":"先生、お誕生日おめでと～プレゼントは…うーん、私の銃でも触ってみる？","zh":"老师，生日快乐啊~礼物嘛……嗯，要不要摸摸我的枪~？"},{"label":"万圣节","jp":"うへー~今日ならこの格好でも普通に見えるかな？先生、一緒に出かけてみない～？","zh":"呜嘿~今天这样穿还是挺普通的吧？老师，要不要一起出去走走呀~？"},{"label":"新年","jp":"明けましておめでとう、先生。今年は先生も私も、のんびりできるといいね～","zh":"新年快乐啊，老师。希望今年咱们两个都能过得悠闲自在哈~"},{"label":"圣诞节","jp":"クリスマスプレゼントかぁ…もらえるなら、銃の整備セットがいいなぁ。そろそろ買い替えたいと思ってるんだ～","zh":"圣诞礼物啊……枪械保养套装不错哦。我正想着要不要买新的呢~"},{"label":"春节","jp":"","zh":"老师，新春快乐啊。嗯？你说有一种叫“年”的怪兽正在进攻阿拜多斯？呜嘿~那可不能让它得逞啊。搭档，我们一起去打倒它吧~？"},{"label":"中秋","jp":"","zh":"今天晚上月亮好大好亮啊~唔，平时都是晒太阳，偶尔晒晒月亮也不错。嗯？老师，你拿着的这个团子上面是不是画着鲸鱼？给大叔也吃一口嘛！"}]},"stats":{"init":[{"name":"攻击力","value":"148"},{"name":"防御力","value":"179"},{"name":"生命值","value":"3352"},{"name":"治愈力","value":"1319"},{"name":"命中值","value":"601"},{"name":"闪避值","value":"239"},{"name":"暴击值","value":"200"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1992"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"35