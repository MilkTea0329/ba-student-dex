i2.0/pro/829/images/w_47/h_54/1609130/2026/7/25/27220274mt8ku9a4.png"}],"uniqueWeapon":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_958/h_246/492704/2026/7/26/93474228mt9zkb1w.png","name":"75式特殊水下自动步枪","desc":"琴音从入学起就一直在使用的水下步枪。\n\n由于使用水下用箭形弹，即使在水阻较大的水中也能稳定瞄准目标。不过在陆地上，相比其他步枪射程会大幅缩短，但琴音似乎并不太在意。","table":{"cols":["Lv1","Lv30","Lv40","Lv50","Lv60"],"rows":[{"label":"攻击力","values":["138","500","625","750","876"]},{"label":"生命值","values":["1349","4904","6131","7357","8584"]},{"label":"治愈力","values":["138","502","628","753","879"]}]},"skill":{"name":"顽强的虎鲸+","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_109/h_95/1609130/2026/7/25/42476127mt8kgwt8.png","description":"","levels":[{"lv":1,"text":"生命值增加14%，治愈力增加471"},{"lv":2,"text":"生命值增加14.7%，治愈力增加494"},{"lv":3,"text":"生命值增加15.4%，治愈力增加518"},{"lv":4,"text":"生命值增加18.2%，治愈力增加612"},{"lv":5,"text":"生命值增加18.9%，治愈力增加636"},{"lv":6,"text":"生命值增加19.6%，治愈力增加659"},{"lv":7,"text":"生命值增加22.4%，治愈力增加753"},{"lv":8,"text":"生命值增加23.1%，治愈力增加777"},{"lv":9,"text":"生命值增加23.8%，治愈力增加800"},{"lv":10,"text":"生命值增加26.6%，治愈力增加894"}]},"star3":"室内战适应性强化至SS","star3Icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/673843.png","star4":"爆炸克制率增加10%"},"favoriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"淵上 コトネ","kana":"淵上 ふちがみ","twName":"-","cnName":"-","age":"16岁","birthday":"10月16日","height":"171cm","hobby":"潜水、读书、无线电","designer":"kokosando","artist":"ramuri","cv":"日 | 天音ゆかり","hallLevel":"5","momoTalkLevel":"","momoTalkStatus":"向着更广阔、更深邃的海洋。","bio":"隶属于奥德赛海洋学园，潜水部的副部长。\n\n视力不好，平时戴着度数很高的眼镜。虽然视力很差，但作为补偿，听力和直觉极为出众。在水中视野不佳时，负责依靠听觉引导部员。\n\n爱好是通过业余无线电与陆地通信。正因如此，她也与陆地上的学生保持着联系。","sourceUrl":""},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/492704/2026/7/26/34274332mta0uicr.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/492704/2026/7/26/78390814mta0ulnb.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/82914064mta0v1qo.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/06284653mta0uv4l.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/67554920mta0vjtt.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/99287173mta0vndo.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/00446725mta0vr0z.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/33836659mta0vu4m.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/74282623mta0vyn5.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/47524634mta0w41l.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/83468502mta0w913.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/492704/2026/7/26/34274332mta0uicr.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/492704/2026/7/26/78390814mta0ulnb.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/82914064mta0v1qo.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/06284653mta0uv4l.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/67554920mta0vjtt.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/99287173mta0vndo.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/00446725mta0vr0z.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/33836659mta0vu4m.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/74282623mta0vyn5.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/47524634mta0w41l.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_304/h_240/492704/2026/7/26/83468502mta0w913.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ——","zh":"蔚蓝档案——"},{"label":"卡池抽取","jp":"オデュッセイア海洋高等学校ダイビング部副部長、淵上コトネ。えっと……シャーレの先生、で合ってる？目が悪いから、あまり見えなくて。","zh":"奥德赛海洋学园潜水部副部长，渊上琴音。那个……是夏莱的老师，对吧？我眼神不太好，看不太清楚。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"いらっしゃい、先生。ふふっ、足音で分かってたよ。","zh":"欢迎光临，老师。呵呵，光凭脚步声我就认出你了哦。"},{"label":"登陆2","jp":"たぶん……先生、だよね？ごめん。ちょっと眼鏡を外してて……足音では分かってたんだけど。","zh":"大概……是老师，对吧？抱歉。我刚好把眼镜摘了……其实光听脚步声我就知道了。"},{"label":"大厅1","jp":"先生、「恋よ鯉」先生の新作、読んだ？お話はすごく良かったけど……海の描写がちょっと気になっちゃって。オデュッセイア出身ではなさそう。","zh":"老师，「恋之鲤」老师的新作，读过了吗？故事本身非常精彩……但海里的描写有点让我在意。感觉作者不是奥德赛出身。"},{"label":"大厅2","jp":"最近、D.U.にポキサラダの専門店が増えてるんだけど……魚が入ってないんだよね。やっぱそれってただのサラダだよね……？","zh":"最近，D.U.里卖泼奇沙拉的专卖店变多了……但里面都没放鱼呢。果然那只是普通沙拉而已吧……？"},{"label":"大厅3","jp":"（ここ、やけに盗聴器が多いような……？）","zh":"（这里，窃听器是不是多得有点反常……？）"},{"label":"大厅4","jp":"先生、ココロを怒らせないようにね。怒るとすごく怖いんだ……本当だよ。","zh":"老师，可别惹心生气哦。她生起气来可吓人了……是真的哦。"},{"label":"大厅5","jp":"陸のどこにいるよりも、海の方が落ち着くけど……いつかは陸に戻る日も来るんだよね。","zh":"比起待在陆地上的任何地方，在海里反而更让我安心……不过，总有一天也会迎来回到陆地的日子吧。"},{"label":"回忆大厅1","jp":"あ、先生。来てくれてたんだね。ごめん。水の中にいたから気づいてなくて……。","zh":"啊，老师。原来你来了呀。抱歉。我刚才待在水里，所以没注意到……。"},{"label":"回忆大厅2","jp":"ん？ああ……この本？防水加工のものだから大丈夫だよ。","zh":"嗯？啊……这本书？因为是做过防水加工的，所以没问题哦。"},{"label":"回忆大厅3","jp":"そうじゃない……？水の上で寝るのは危険？心配しないで、慣れてるから。それに……ここ、すごく気持ちいいんだ。","zh":"不是那样……？在水面上睡觉很危险吗？别担心，我已经习惯了。而且……这里，感觉特别舒服。"},{"label":"回忆大厅4","jp":"日向ぼっこしながら、水中の音を聞いていられるの……。そういう意味では、読書とダイビングってちょっと似てるかも。どちらも沈みゆくものの声を聴くから。","zh":"可以一边晒太阳，一边听着水里的声音……。从这种意义上来说，读书和潜水或许有点相似呢。因为两者都是在倾听沉没之物的话语。"},{"label":"回忆大厅5","jp":"ほら、先生も一緒にやってみない？私が……水底の世界のお話を、たくさん聞かせてあげるから。","zh":"来嘛，老师也一起试试看？我会……把水底世界的许多故事，讲给你听的。"},{"label":"咖啡馆1","jp":"（なんか、変なものがいるような…………また、視力落ちたかな）","zh":"（好像有什么奇怪的东西在…………难道视力又下降了吗）"},{"label":"咖啡馆2","jp":"これ、陸で流行ってるの……？","zh":"这个，在陆地上很流行吗……？"},{"label":"咖啡馆3","jp":"いい天気……午後はマリンスーツを干さないと。","zh":"天气真好……下午得把潜水服晾一晾才行。"},{"label":"咖啡馆4","jp":"この作家さんの新刊……出てたんだ。","zh":"这位作家的新作……原来已经出版了呀。"},{"label":"咖啡馆5","jp":"（ゆっくり座れるところ……どこかにあるかな）","zh":"（能悠闲坐下来休息的地方……哪里才有呢）"}],"好感度":[{"label":"好感度1","jp":"先生の心臓の音……いつ聞いても落ち着く。","zh":"老师的心跳声……无论什么时候听都觉得安心。"},{"label":"好感度2","jp":"先生、見つけた。ふふ……見えなくても、分かるよ。","zh":"老师，找到你了。呵呵……就算看不见，我也认得出来。"},{"label":"好感度3","jp":"私の尻尾……触ってみる？","zh":"我的尾巴……要摸摸看吗？"},{"label":"好感度4","jp":"……おかしいな。こんなに静かなのに、読書に集中できない。","zh":"……真奇怪。明明这么安静，却没办法专心读书。"}],"战斗":[{"label":"编入队伍1","jp":"呼んだ？","zh":"叫我了吗？"},{"label":"编入队伍2","jp":"了解。","zh":"了解。"},{"label":"拎起","jp":"ちょっと……どこ触ってるの？","zh":"喂……你在摸哪里啊？"},{"label":"任命队长1","jp":"ダイビングポイント到着。潜降を開始するね。","zh":"已到达潜水点。要开始下潜了哦。"},{"label":"任命队长2","jp":"最終チェック完了。下で合流しよっか。","zh":"最终检查完毕。我们在水底会合吧。"},{"label":"普通技能","jp":"座標、送るね。","zh":"坐标，我发给你。"},{"label":"EX动画1","jp":"アクティブソナー、展開。","zh":"主动声呐，展开。"},{"label":"EX动画2","jp":"反響音確認。敵の位置を共有するね。","zh":"确认到回波。我来共享敌人的位置。"},{"label":"EX动画3","jp":"どこに隠れても無駄。全部聞こえてるよ。","zh":"躲到哪里都没用。一切我都听得见。"},{"label":"EX技能1","jp":"弾種切替。水中モード。","zh":"切换弹种。水中模式。"},{"label":"EX技能2","jp":"確実に、貫く。","zh":"必定贯穿。"},{"label":"EX技能3","jp":"ORCA2、対応開始。","zh":"ORCA2，开始应对。"},{"label":"战斗开始1","jp":"陸……久しぶりに走るかも。","zh":"陆地上……好久没跑步了呢。"},{"label":"战斗开始2","jp":"それじゃあ、始めよっか。","zh":"那么，开始吧。"},{"label":"获得BUFF","jp":"ナイス。","zh":"漂亮。"},{"label":"施放BUFF","jp":"出力上昇、速度を上げるよ。","zh":"输出上升，要加速了哦。"},{"label":"掩体","jp":"遮蔽、維持。","zh":"遮蔽，保持。"},{"label":"被CC3","jp":"これはまずいかも。","zh":"这恐怕不太妙。"},{"label":"回避","jp":"遅い。","zh":"太慢了。"},{"label":"队伍移动1","jp":"移動するよ。","zh":"要移动了哦。"},{"label":"队伍移动2","jp":"ルートを修正。","zh":"修正路线。"},{"label":"回复","jp":"あ、ありがとう。","zh":"啊，谢谢你。"},{"label":"中途退出","jp":"音が…遠ざかっていく…","zh":"声音……正在逐渐远去……"},{"label":"角色移动","jp":"潮の流れに乗って。","zh":"乘着海流的流向。"},{"label":"战斗胜利1","jp":"……やっと静かになった。これで読書に集中できる。","zh":"……终于安静下来了。这下可以专心读书了。"},{"label":"战斗胜利2","jp":"今日のお話は……ここまで。","zh":"今天的故事……就到这里。"},{"label":"关卡完成1","jp":"うん……いい探索だったね。","zh":"嗯……真是次不错的探索呢。"},{"label":"关卡完成2","jp":"ふふっ、また来よっか。次は……先生と、二人きりで。ね？","zh":"呵呵，下次再来吧。下次就……和老师两个人。好吗？"},{"label":"战斗失败1","jp":"これは想定外だったかも。","zh":"这大概在预料之外了。"},{"label":"战斗失败2","jp":"ごめん、自分の耳を過信してた。","zh":"抱歉，我太相信自己的耳朵了。"}],"成长":[{"label":"升级1","jp":"陸地でも海について学べるのって、いいことだね。","zh":"在陆地上也能学习海洋相关的知识，真是件好事呢。"},{"label":"升级2","jp":"さすがダイビング部のスポンサー。ありがとう。","zh":"不愧是潜水部的赞助商。谢谢你。"},{"label":"升级3","jp":"学びの場って、地図に載るようなものじゃないんだよね。本当は。","zh":"学习的地方，其实并不是会标在地图上的那种东西呢。真的。"},{"label":"升级4","jp":"先生の教え方は優しいね…………海はそうでもないから。","zh":"老师的教导方式很温柔呢…………不过海可没那么温柔。"},{"label":"获得专武","jp":"ダーツはあまり得意じゃないけど……これを使ったら、水中でもブルズアイを狙えそう。ありがとう、先生。","zh":"投镖我不太擅长……但用上这个的话，就算在水里也能瞄准靶心呢。谢谢你，老师。"}],"事件":[{"label":"学生生日","jp":"誕生日に欲しいもの？そうだね――先生が欲しい、って言ったら……困らせちゃう、かな？ふふ","zh":"生日想要的东西？嗯——如果我说想要老师的话……会不会让你困扰呢？呵呵。"},{"label":"老师生日","jp":"誕生日おめでとう、先生。オデュッセイアではイルカを見つけるといいことがあるって言われてるんだ。だから……今日は一日、先生と一緒にいてあげる。","zh":"生日快乐，老师。在奥德赛，听说只要发现海豚就会有好事发生哦。所以……今天一整天，我就陪在老师身边吧。"},{"label":"万圣节","jp":"トリック・オア・トリート、だよ先生。でも、机の上の飴は既に持って行っちゃったから……先生はいま、お菓子を持っていない。さて……どんな悪戯をしよっかな。","zh":"不给糖就捣蛋哦，老师。不过，桌上的糖果已经被我拿走啦……所以老师现在，一颗糖果都没有了。那么……该捣些什么蛋好呢。"},{"label":"新年","jp":"あけましておめでとう、先生。ん？寒くないのかって？ちょっと寒いけど……大丈夫。この後、みんなと温水プールに行くから。よかったら、先生も来る？","zh":"新年快乐，老师。嗯？问我冷不冷？是有点冷……不过没关系。因为待会儿要和大家一起去温水泳池。如果方便的话，老师也一起来嘛？"},{"label":"圣诞节","jp":"イルミネーション、綺麗だね。まるで夜の海から見上げた空みたい。","zh":"灯饰好漂亮啊。就像从夜晚的海里仰望天空一样。"}],"活动":[{"label":"活动登陆1","jp":"オデュッセイア海洋高等学校――違うな……ダイビング部へようこそ、先生。","zh":"奥德赛海洋学园——不对……欢迎来到潜水部，老师。"},{"label":"活动登陆2","jp":"待ってたよ、先生。ここは私が案内するね。","zh":"老师，我一直在等您。这里就由我来带路吧。"},{"label":"活动大厅1","jp":"先生……ちょっとジロジロ見すぎかも。私でも気づくくらい。","zh":"老师……你盯得有点太久了哦。连我都能察觉到。"},{"label":"活动大厅2","jp":"アイス？嫌いじゃないけど……。……カロリー、ちょっと高いから。一応、気にしてるの。","zh":"冰激凌？我倒是不讨厌……。……因为热量有点高。我姑且还是会在意的。"},{"label":"活动大厅3","jp":"先生、いい声って言われない？……先生の声で『海底二万里』の朗読、聞いてみたいな。","zh":"老师，是不是常被人说声音很好听？……好想听老师用那个声音朗读《海底两万里》啊。"},{"label":"活动大厅4","jp":"ダイビング部はみんな2年生だよ……それがどうかしたの？もしかして……私、3年生に見えた？","zh":"潜水部的大家都是二年级生哦……有什么问题吗？难道说……我看起来像三年级生？"},{"label":"活动事件1","jp":"はぁ……あの子たちが何かやらかしたみたい。","zh":"唉……那群孩子好像又闯了什么祸。"},{"label":"活动事件2","jp":"（12海里……）（ちょうどトライデントの巡回範囲から外れる場所……）（……怪しいかも）","zh":"（十二海里……）（正好是脱离三叉戟号巡逻范围的地方……）（……可能有点可疑）"},{"label":"活动结束","jp":"フジツボ掃除は大変だけど……仕方ないね。私たちにしかできないことだし……こういうことから、コツコツと、ね。","zh":"清理藤壶虽然很辛苦……但也没办法呢。这是只有我们才能做到的事……就从这种事情开始，一点一点来吧。"},{"label":"活动商店1","jp":"今月は部費を少し節約できそう。先生のおかげ。","zh":"这个月的社团经费似乎能省下一些。多亏了老师。"},{"label":"活动商店2","jp":"海の掃除をしてると、たまに珍しいものを見つけるんだ。数少ない楽しみ、かも。","zh":"在海里打扫的时候，偶尔会找到一些稀罕的东西。这或许算是为数不多的乐趣之一吧。"},{"label":"活动商店关闭","jp":"もう片づけちゃうから、交換したいものがあるなら今のうちにね。","zh":"马上就收摊了，有想交换的东西就趁现在哦。"},{"label":"活动商店登陆1","jp":"寄付はいつでも大歓迎。ダイビング用品だと……嬉しいかも。","zh":"捐赠随时都欢迎。如果是潜水用品的话……我会很开心的。"},{"label":"活动商店登陆2","jp":"海の中で拾ったものと交換する？","zh":"要用在海里捡到的东西来交换吗？"},{"label":"活动商店购买1","jp":"これは……まだ使えそうだね。","zh":"这个……看起来还能用呢。"},{"label":"活动商店购买2","jp":"手伝ってくれてありがとう、先生。","zh":"谢谢你帮忙，老师。"},{"label":"活动商店购买3","jp":"それにするんだ？いいんじゃないかな。","zh":"决定要那个了吗？挺好的。"},{"label":"活动商店购买4","jp":"え……それ本当に必要なの？","zh":"诶……那个真的有必要吗？"}]},"stats":{"init":[{"name":"攻击力","value":"382"},{"name":"防御力","value":"170"},{"name":"生命值","value":"3189"},{"name":"治愈力","value":"1382"},{"name":"命中值","value":"105"},{"name":"闪避值","value":"227"},{"name":"暴击值","value":"210"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1328"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15(3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8817"},{"name":"防御力","value":"2639"},{"name":"生命值","value":"106720"},{"name":"治愈力","value":"8564"},{"name":"命中值","value":"105"},{"name":"闪避值","value":"227"},{"name":"暴击值","value":"210"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1328"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15(3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"不用写"},{"name":"生命值","value":"不用写"},{"name":"治愈力","value":"不用写"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"背包","grade":"T10","attrs":[{"name":"生命值","value":"14000"},{"name":"防御力","value":"36%"},{"name":"生命值","value":"5%"}]},{"slot":"3号装备","name":"项链","grade":"T10","attrs":[{"name":"治愈力","value":"42%"},{"name":"群控强化力","value":"38%"},{"name":"攻击力","value":"18%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"2154"},{"name":"攻击力","value":"143"},{"name":"治愈力","value":"165"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_493/h_496/191981/2026/7/27/78381105mtacl5vn.png","attrs":[{"name":"治愈力","value":"231"},{"name":"生命值","value":"2480"}]}],"review":{"score":"60(B)","scoreIcon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_78/h_78/829/236746/2026/5/4/1780538755206_1780484382794_le19f6is7b_4r3p0fwre2.png","tiers":[{"name":"新手期","value":"★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/245/images/w_23/h_23/236746/2026/5/30/89615996mr0ev1l7.png"},{"name":"总力战","value":"★★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538776594_1780484206588_4dnfad9a3r_3ot3lq8zz4.png"},{"name":"大决战","value":"★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538781498_17804840