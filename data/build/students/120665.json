.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/157431.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/734620.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/208829.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/91019.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/67720.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/459639.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/790597.png","name":"情人节挑战书","desc":"玲纱的挑战书形状的巧克力。其实是在大块巧克力的外面套上了挑战书的信封。里面塞了一张玲纱写的信。"},"ability":{"attrs":[{"name":"生命值","value":"2059"},{"name":"攻击力","value":"78"},{"name":"治愈力","value":"214"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/552888.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/983726.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 玲纱（魔法）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_505/h_504/829/191981/2025/9/22/123050.png","url":"https://www.gamekee.com/ba/tj/680454.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー！アーカイブ！！","zh":"Blue！Archive！！"},{"label":"卡池抽取","jp":"呼ばれて飛び出て！参りました！\nみんなのスーパースター、宇沢レイサ、登場です！","zh":"说玲纱，玲纱到！\n天空一声巨响，大家的超级巨星，宇泽玲纱闪亮登场！！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生！宇沢レイサ、待機していました！","zh":"老师，欢迎回来！\n宇泽玲纱正在待命！"},{"label":"登陆2","jp":"先生の「登場」ですね！！それでは、今日は何をしましょうか！","zh":"老师登场啦！\n那么，今天要做些什么呢！"},{"label":"大厅1","jp":"お呼びですか、先生！なんでもお申しつけください！","zh":"您叫我嘛，老师！\n请您尽管吩咐！"},{"label":"大厅2","jp":"あっ、もしかして、声……大きかったですか？\n響いちゃったかも……すみません……","zh":"诶，难道……我的声音太大啦，吵到您了嘛……？\n……对不起！"},{"label":"大厅3","jp":"ん……不思議です。ここにくると、ちょっとだけ力が抜けるというか……","zh":"……好厉害呀，一来到这里，我就放松下来了。"},{"label":"大厅4","jp":"お、お使いでも行ってきましょうか？\nその……じっと立ってると、なんだか落ち着かなくて……！","zh":"有……有要使唤我的地方嘛……？\n就，光是站在这里什么都不做，我浑身不自在……"},{"label":"大厅5","jp":"この先、何があってもご安心ください！\n先生のそばには私、宇沢レイサがついておりますから！","zh":"以后无论发生什么，老师都不用担心！\n因为您身边还有我，宇泽玲纱！！"},{"label":"回忆大厅1","jp":"……なんだか、不思議な気分です。\nこうして……人と一緒に、日の出を見るのは初めてで。","zh":"总觉得，很不可思议呢……\n像这样，和别人一起看日出，还是第一次……"},{"label":"回忆大厅2","jp":"そういえば、誰かと二人きりで過ごした時間も……。\nもしかすると、これが最長かも……はは。","zh":"而且，跟别人一起单独待这么长的时间……\n好像，也是第一次……嘿嘿……"},{"label":"回忆大厅3","jp":"んん……また変なことを言ってしまった気がします……。\n実はまだ、少し眠くて……自分でも何を言っているのか、よく……","zh":"嗯……我是不是又说了些莫名其妙的话……\n其实我现在有些困……所以我也不知道自己在说些什么……"},{"label":"回忆大厅4","jp":"で、でも先生は……なんでも分かってくださるから……\n今回も……いつもみたいに、分かってくださいね。へへ……","zh":"但，但是不管我说什么，老师您都能懂我……\n所以这次也……请像往常一样，继续懂我吧~……嘿嘿……"},{"label":"回忆大厅5","jp":"ん……いいですね……\n先生……ありがとうございます……ひひ……","zh":"嗯……您会的吧？\n老师……谢谢您……嘿嘿~"},{"label":"咖啡馆1","jp":"ひ、人が多い……。","zh":"好，好多人啊……"},{"label":"咖啡馆2","jp":"どこにいればいいんだろう……","zh":"我，我该待在哪里才好……"},{"label":"咖啡馆3","jp":"いや、逆にこういう時こそ普段どおりに……！","zh":"……不对！越是这种时候，反而应该像平时那样……"},{"label":"咖啡馆4","jp":"や、やっぱ止めとこう……変な人だと思われちゃう。","zh":"要……要不还是算了吧……会被别人当成怪人的……！"},{"label":"咖啡馆5","jp":"居心地の良い場所ですね！","zh":"这里很让人安心呐！"}],"好感度":[{"label":"好感度1","jp":"先生さえよろしければ、その…先生の護衛を、もっとしたいです！","zh":"如果老师愿意的话……我，我还能继续做老师的护卫！"},{"label":"好感度2","jp":"先生には…その…情けないところを多くお見せした気もしますが、大丈夫ですよね？","zh":"我好像，总是让老师看到我没出息的地方……\n应该，没关系吧……"},{"label":"好感度3","jp":"私が今ここにいるのは、全部先生のおかけです！","zh":"我现在能走到这里，都是多亏了老师！"},{"label":"好感度4","jp":"これまで通り…いえ！これからも！よろしくお願いいたします！","zh":"一直以来，不对！\n还有以后，都请老师继续指教啦！"}],"战斗":[{"label":"编入队伍1","jp":"遂に私の出番ですね！","zh":"终于！轮到我大展拳脚啦！"},{"label":"编入队伍2","jp":"はい！いつでも行けますよ！","zh":"收到！随时可以出发！"},{"label":"拎起","jp":"宇沢レイサにお任せください！","zh":"就交给我！宇泽玲纱吧！！"},{"label":"任命队长1","jp":"私の力が必要でしたら、どこにでも！","zh":"哪里需要我，我就会去向哪里！"},{"label":"任命队长2","jp":"皆さんと一緒に、私、宇沢レイサが参ります！","zh":"宇泽玲纱，与各位共同出击！"},{"label":"普通技能","jp":"必殺！勝利のポーズ！","zh":"必杀！胜利的Pose！"},{"label":"EX动画1","jp":"トリャー！","zh":"嘿呀！！"},{"label":"EX动画2","jp":"ここに参上！","zh":"闪亮登场！！"},{"label":"EX动画3","jp":"勝負です！","zh":"一决胜负！！"},{"label":"EX技能1","jp":"逃がしませんよ！","zh":"别想逃！！"},{"label":"EX技能2","jp":"挑戦状は受け取ってください！","zh":"收下这封，战书吧！！"},{"label":"EX技能3","jp":"覚悟してください！","zh":"做好准备吧！！"},{"label":"战斗开始1","jp":"おお！私が戦闘なんですね！","zh":"哦！让我来打头阵是嘛！"},{"label":"战斗开始2","jp":"恐れることなく、前へ！","zh":"无所畏惧！前进！！"},{"label":"获得BUFF","jp":"あ…ありがとうございます！","zh":"十，十分感激……"},{"label":"施放BUFF","jp":"最大出力で、行きますよ！","zh":"最高马力，全速前进！！"},{"label":"掩体","jp":"させません！","zh":"不会让你得逞！"},{"label":"被CC1","jp":"-","zh":"呃啊！"},{"label":"被CC2","jp":"-","zh":"咿！"},{"label":"被CC3","jp":"-","zh":"诶咿！"},{"label":"回避","jp":"無駄ですよ！","zh":"没有用哇！（？"},{"label":"队伍移动1","jp":"未だ未だ行きますよ！","zh":"还能继续哦！！"},{"label":"队伍移动2","jp":"次、行きます！","zh":"向下一个地点，出发！！"},{"label":"回复","jp":"は！あ…ありがとうございます！","zh":"啊！十，十分感谢……"},{"label":"中途退出","jp":"ま…未だ行け…","zh":"我……我还能再……"},{"label":"战斗喊叫","jp":"-","zh":"哈！！"},{"label":"战斗喊叫","jp":"-","zh":"呀啊啊！！"},{"label":"战斗喊叫","jp":"-","zh":"嘿呀！！"},{"label":"角色移动","jp":"-","zh":"哈啊！！"},{"label":"战斗胜利1","jp":"うむ！当然の結果です！","zh":"哼姆！这是必然的结果！！"},{"label":"战斗胜利2","jp":"次行きますよ！次！","zh":"准备下一场战斗！下一场！！"},{"label":"关卡完成1","jp":"フー！楽勝でしたね！","zh":"呼！轻轻松松！"},{"label":"关卡完成2","jp":"フー！正義は必ず勝つんです！","zh":"呼！正义必胜！"},{"label":"战斗失败1","jp":"う…ごめんなさい…","zh":"呜……对不起……"},{"label":"战斗失败2","jp":"私がもっと…ちゃんとしていれば…","zh":"要是我更努力一点的话……"}],"成长":[{"label":"升级1","jp":"こ…これは、私に…ですか？","zh":"这！这个是，给我的嘛……？"},{"label":"升级2","jp":"ありがとうございます！先生！これからも頑張りますね！","zh":"谢谢老师！以后我会更加努力的！"},{"label":"升级3","jp":"宇沢レイサの成長に、終わりはありません！","zh":"宇泽玲纱的成长，永无止境！！"},{"label":"升级4","jp":"成長には責任が伴うもの！もっともっと頑張ります！","zh":"成长总是伴随着责任！我会更加努力的！！"},{"label":"获得专武","jp":"本当は、未だ実感がありません。私は…ちゃんと先生のお役に立てているのでしょうか…そうだといいなって、いつも心から願っています。","zh":"说实话……我还是不敢相信，我，真的帮到老师了嘛……？\n要是能帮到就太好了……！我一直真心地希望着……"}],"事件":[{"label":"学生生日","jp":"あっ、私の誕生日ですか？ありがとうございます！\n最近、誕生日を祝ってくださる方が多くて！\n……本当、長生きしてみるもんですね！私、まだ15歳ですけど！","zh":"啊！我的生日嘛……？\n谢谢你……！！最近祝我生日快乐的人好多啊！\n嘿，真是活久见啊！……虽然我才十五岁就是啦~！"},{"label":"老师生日","jp":"お誕生日おめでとうございます！先生！凄く特別な日ですから、一緒にパトロールなどいかがでしょうか！","zh":"生日快乐，老师！\n在这么特别的一天里，要和我一起去巡逻嘛？！"},{"label":"万圣节","jp":"飴がなかったらいたずらをしてもらえるの日です！え？解釈が変？","zh":"今天是只要没有糖就可以捣蛋的日子！！\n……诶？我理解错了……？"},{"label":"新年","jp":"明けましておめでとうございます！先生！今年もよろしくお願いしますね！","zh":"新年快乐，老师！\n今年也请您多多关照哦！"},{"label":"圣诞节","jp":"メリークリスマス～！！え？プレゼント交換？\nあ、ああっ……！？忘れてました…！あんまりこういうのは、慣れてなくて……！","zh":"圣诞快乐！诶？交换礼物……？\n诶，诶诶诶……！还有这种事嘛？我完全忘记了……\n我对这种事情没什么经验……"},{"label":"春节","jp":"","zh":"老师~祝您新春快乐！\n听说山海经有在今天放鞭炮的传统！我们快去看看吧！我也想玩！"},{"label":"中秋","jp":"","zh":"哦哦……！在这明亮皎洁的月光之下，我感受到了无穷无尽的力量！\n我要代表月……诶？这个不能说……？好吧……"}],"活动":[{"label":"活动登陆1","jp":"あっ、先生！こっちですよ！","zh":"啊，老师！在这边！！"},{"label":"活动登陆2","jp":"自警団のスーパーヒーロー！\n宇沢レイサ、ご挨拶申し上げます！","zh":"自警团的超级英雄，\n宇泽玲纱，向您问好！！"},{"label":"活动大厅1","jp":"はい！宇沢レイサ、待機中です！","zh":"是！宇泽玲纱正在待命！"},{"label":"活动大厅2","jp":"どうかしましたか？いつでもお声がけください！","zh":"有什么事嘛？您随时可以和我说的！"},{"label":"活动大厅3","jp":"事件ですか！？どこですか！？誰の事ですか！？","zh":"出事了嘛？在哪里！是谁！"},{"label":"活动大厅4","jp":"んん……じっとしているのが、一番、難しいです……","zh":"呃诶……要乖乖呆着是最难的……"},{"label":"活动事件1","jp":"おおおっ！盛り上がってまいりました！","zh":"哦哦！气氛高涨啊！"},{"label":"活动事件2","jp":"ラストスパート！です！","zh":"现在是最后冲刺阶段！！"},{"label":"活动结束","jp":"最後まで、駆けぬけましょう！","zh":"坚持到最后吧！！"},{"label":"活动任务1","jp":"うん……？先生？どうしました？","zh":"嗯……？老师，您怎么啦？"},{"label":"活动任务2","jp":"集中！作業に集中してください！","zh":"集中精神！请专心工作！！"},{"label":"活动任务每日结束","jp":"今日のやる事はこれで終わり！フー！この達成感、いいですね！","zh":"今天的工作就到此结束！\n呼~这份成就感，真不错~！"},{"label":"活动任务登录1","jp":"あっ！こんにちは、先生！\n解決しなきゃいけない事件が山積みです！","zh":"啊，老师，您好啊！\n有一大堆事情正等着您呢！"},{"label":"活动任务登陆2","jp":"リストをご用意しました！一緒にチェックしていきましょう！","zh":"清单已经列好啦~一起来确认一下吧！"},{"label":"活动任务获取1","jp":"おおー！さすが先生です！","zh":"哦哦！不愧是老师~！"},{"label":"活动任务获取2","jp":"いいですね！順調です！！","zh":"不错嘛！很顺利！"},{"label":"活动商店1","jp":"うん？何かお探しですか？それはここにはないものでしょうか？","zh":"嗯？您在找什么啊……这里没有嘛？"},{"label":"活动商店2","jp":"必要な物がありましたら何なりと！すぐにお持ちしますので！","zh":"如果有什么需要的，请尽管告诉我！\n我马上就给您拿过来！"},{"label":"活动商店关闭","jp":"他に何か必要なものはありますか？確認してまいります！","zh":"您还需要什么嘛？我可以帮您确认一下~"},{"label":"活动商店登陆1","jp":"パトロール中に集めた物です！先生もご覧になりますか？","zh":"这些都是我在巡逻时收集到的东西！\n老师要看看嘛？"},{"label":"活动商店登陆2","jp":"この仕事をしていると、落とし物をよく見かけるんですよね……\n無事持ち主が見つかるといいんですが","zh":"巡逻的时候，经常能捡到遗失的物品呢……\n要是能找到失主就好了~"},{"label":"活动商店购买1","jp":"ほお、なるほどなるほど。","zh":"喔……原来如此原来如此。"},{"label":"活动商店购买2","jp":"んむ！それもいいですね。","zh":"嗯！那个也挺好的！"},{"label":"活动商店购买3","jp":"お探しのものは、そちらでしたか！","zh":"您需要那个嘛？"},{"label":"活动商店购买4","jp":"はい、こちらです、どうぞー！","zh":"好，在这里！给您~"}]},"stats":{"init":[{"name":"攻击力","value":"209"},{"name":"防御力","value":"163"},{"name":"生命值","value":"3049"},{"name":"治愈力","value":"1797"},{"name":"命中值","value":"655"},{"name":"闪避值","value":"217"},{"name":"暴击值","value":"218"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1812"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (2)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4287"},{"name":"防御力","value":"2597"},{"name":"生命值","value":"104734"},{"name":"治愈力","value":"8294"},{"name":"命中值","value":"655"},{"name":"闪避值","value":"217"},{"name":"暴击值","value":"518"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1812"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (2)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"410"},{"name":"生命值","value":"7032"},{"name":"治愈力","value":"981"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"背包","grade":"T10","attrs":[{"name":"生命值","value":"14000"},{"name":"防御力","value":"1700"},{"name":"生命值","value":"5%"}]},{"slot":"3号装备","name":"护身符","grade":"T10","attrs":[{"name":"暴击抵抗值","value":"420"},{"name":"暴伤抵抗率","value":"3000"},{"name":"暴击值","value":"300"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"2059"},{"name":"攻击力","v