/191981/2025/6/23/953939.png","url":"https://www.gamekee.com/ba/647100.html"},{"name":"★3 柚子（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_232/h_239/829/191981/2026/0/18/274123.png","url":"https://www.gamekee.com/ba/690661.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー……アーカイブ……","zh":"Blue Archive..."},{"label":"卡池抽取","jp":"花岡ユズ……です。色々あって……今はこの格好をしています。\nよろしく、お願いします……","zh":"我是，花冈柚子……因为各种各样的原因，所以现在穿成了这个样子……\n请，请您多多指教……"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ひゃっ！？だ、誰！？あ、先生でしたか、よかった……おかえりなさい。","zh":"呀！谁，谁？！\n原，原来是老师啊……太，太好了……欢，欢迎回来……"},{"label":"登陆2","jp":"先生、お待ちしてました……いらっしゃってくれて嬉しいです。","zh":"老师，欢迎你！您能来，我真的很开心！"},{"label":"大厅1","jp":"掃除はあまり得意ではないですが……先生の、お願いなら……","zh":"虽然我不太擅长打扫，但既然老师拜托了，我会好好努力的！"},{"label":"大厅2","jp":"え、似合ってる？もう……からかわないでください！……ほ、本音と言われたら、それはそれで……。","zh":"诶？这身很适合我……？请，请不要拿我开玩笑！\n如，如果您说的是真心话的话，那，那……"},{"label":"大厅3","jp":"どうして猫耳はこんなにメイド服に合うのかな？\n猫ってメイドっていうよりご主人様側な気がするのに……","zh":"为什么猫耳和女仆装会这么适合呢……？\n比起女仆，猫猫更像主人才对吧~"},{"label":"大厅4","jp":"これは……ゲームの参考になるかも。","zh":"这也许，能成为游戏的参考！"},{"label":"大厅5","jp":"この服、フリルが多くて……恥ずかしい……","zh":"这身衣服有好多折边……好害羞……"},{"label":"回忆大厅1","jp":"えっと、これは……\n寝ている間に、入ってきちゃったみたいで……","zh":"呃，这……这应该……是我睡觉的时候，钻到这里面来的……"},{"label":"回忆大厅2","jp":"その……休憩室には他の方もいますから……\n座っていると、話しかけられちゃって……。","zh":"因为……休息室里还有其他人在……只要我一坐下来，马上就会有人过来搭话……"},{"label":"回忆大厅3","jp":"「リボンはどこで買ったの？」\nとか、「お休みの日には何してるの？」とか……\nいろいろ質問されるので、思わず逃げてしまって……","zh":"【这蝴蝶结是哪里买的呀？】或者是……【平时休息日都做什么呀？】之类的……\n因为被问了各种各样的问题，所以，下意识就逃跑了……"},{"label":"回忆大厅4","jp":"見つけたのが、ここだったんです……。\nまさか……猫の休憩所だったなんて。","zh":"于是……发现了这里……。\n没想到，这里是，猫咪的休息室……"},{"label":"回忆大厅5","jp":"ひゃっ！？ちょ、ちょっと待ってください！\n出ます！い、今出ますから……\nくすぐったい！","zh":"呀啊？！请，请等一下！……\n呜……我，我会出去的！……我现在就出去！好痒啊……"},{"label":"咖啡馆1","jp":"今のわたしはメイドだし……掃除でもしてみようかな……。","zh":"既然我现在是女仆，那是不是打扫一下卫生会比较好呢……？"},{"label":"咖啡馆2","jp":"ゲームを作るメイド……新しいかも？","zh":"会做游戏的女仆……也许，还挺新鲜的？"},{"label":"咖啡馆3","jp":"うう……どこかに隠れたい……。","zh":"呜呜……好想藏起来……"},{"label":"咖啡馆4","jp":"段ボールは、 潜入の必須アイテムだけど……。","zh":"潜入时一定要用到纸箱……！"},{"label":"咖啡馆5","jp":"おかえりなさい、ご主人様。うう、やっぱり恥ずかしい……。","zh":"主人，欢迎回来！\n呜……！果然还是很害羞……"}],"好感度":[{"label":"好感度1","jp":"あ…あの…先生？い…いいえ…やっぱり、なんでもありません。","zh":"老，老师……没，没什么……"},{"label":"好感度2","jp":"先生がいってくださったから、頑張ることができました。言葉だけでは伝えきれませんが、その...ありがとう…ございます！","zh":"因为老师鼓励了我，我才能这样鼓起劲来……\n虽然口头上不能清楚地表达我的意思……但是，嗯……谢谢你。"},{"label":"好感度3","jp":"先生は、その…メイドって、どう思います？じゃあ…この格好は？","zh":"话说……老师是怎么看待女仆的呢……？\n那……我这身打扮呢？"},{"label":"好感度4","jp":"その...もし少し…前向きな私になれたら…先生に、言いたいことがあります。え！？今ですか！？そ…それは…","zh":"如果，我能变得再积极一点的话……我有话想向老师说……！\n诶？！现在就说嘛……？诶，这有些……"}],"战斗":[{"label":"编入队伍1","jp":"わ……わたしですか？ 本当に……？","zh":"真的……要选我吗？真的吗？"},{"label":"编入队伍2","jp":"先生が一緒にいてくださるなら……わたしも……！","zh":"如果能和老师一起的话，那我也……"},{"label":"拎起","jp":"うぅ……帰りたい……","zh":"请……请把我放到箱子里"},{"label":"普通技能","jp":"う…受け取ってください！","zh":"请，请吃我这一招吧！"},{"label":"EX动画1","jp":"隠れるのは、また自信があるから！","zh":"如果是藏起来的话……我还是很有信心的！"},{"label":"EX动画2","jp":"見つからないように......！","zh":"不要让人发现……！"},{"label":"EX动画3","jp":"そこ！","zh":"在那里！"},{"label":"EX技能1","jp":"ターゲット、確認しました！","zh":"确认目标！"},{"label":"EX技能2","jp":"当たって！","zh":"打中吧……！"},{"label":"EX技能3","jp":"う…動かないでください！","zh":"请，请不要乱动！"}],"成长":[{"label":"升级1","jp":"せん......先生！？えっと......その.......うう.......","zh":"老，老师……？\n就，就是……你……呜呜呜……（？"},{"label":"升级2","jp":"いつも、ありがとうございます！先生がいてくださって、本当に、よっかたです！","zh":"我一直都很……感谢你！\n有您在我身边……真的是，太好啦！"},{"label":"升级3","jp":"こうやって、一歩を踏み出せましたし、私自身も、変わりたいです。","zh":"像这样，向前迈出了一步……！\n我自己也想，越变越好……"},{"label":"升级4","jp":"今の私は.......メイド.......なので、先生の.......お役に立ちたいです。","zh":"现在的我，是女仆……\n所以，我也想帮上老师的忙！"},{"label":"获得专武","jp":"こ、ここまでしてもらえるなんて……そんな……すごく、嬉しいです。……わたし、もっと頑張りますね。……見ていてください、先生！","zh":"您，您竟然为我做了这么多……！\n我，我真的，很开心！我会更加努力的，请您好好看着吧，老师！"}],"事件":[{"label":"学生生日","jp":"誕生日、覚えててくださったんですか？ありがとうございます。その……特に何もしなくて、大丈夫です。\n先生……いえ、ご主人様と一緒にいるのが一番の幸せですから。\nと、とりあえずそんな設定です！","zh":"您还记得我的生日啊……谢，谢谢您！\n不用准备什么……，没关系的！能和老师……不，能和主人在一起，我就是最幸福的啦……！\n总，总之就是这种设定啦！"},{"label":"老师生日","jp":"お、お誕生日おめでとうございます、ご主人様。\nな、なんちゃって……メイドなので。","zh":"主，主人，祝，祝您生日快乐……！\n我试着说说看……因为我是女仆嘛……！"},{"label":"万圣节","jp":"ハロウィーン……仮装した人が\n街に溢れるお祭りですね。わたしには、やっぱり無縁といいますか……ゲームのイベントなら……よくやりますけど。","zh":"万圣节……就是人们变装及上大街的节日吧……\n这种日子果然不适合我……不过，游戏里的万圣节活动，我倒是经常参加……"},{"label":"新年","jp":"明けましておめでとうございます、ご主人様。……や、やっぱり先生とお呼びした方がいいでしょうか？","zh":"祝您新年快乐，主人……！\n果，果然还是叫老师会比较好……嘛……？"},{"label":"圣诞节","jp":"サンタさんは煙突を通って来るらしいです……\nゲーム開発部に煙突はありませんが……機会があれば一度入ってみたいです。こじんまりしてて、居心地よさそう……","zh":"听说圣诞老人都是钻烟囱进去的……可惜游戏开发部没有烟囱……\n有机会的话，我也想钻进去试试！又窄又小……感觉在里面会很安心~"},{"label":"春节","jp":"","zh":"老师，新，新春快乐……！\n我听说新年伊始，应该把家打扫的干干净净的……现在我是您的女，女仆，所以就……\n啊呜呜……好害羞……！"},{"label":"中秋","jp":"","zh":"在游戏里，月亮一直是很重要的一项呢！\n比如大名鼎鼎的复古游戏，《天使村·月上协奏曲》……\n所，所以，我想把我和老师一起度过的今天做，做进游戏里……"}],"活动":[{"label":"活动登陆1","jp":"先生！えっと…おかえりなさいませ、ご主人様。","zh":"老师，不对……欢迎回来，主人……"},{"label":"活动登陆2","jp":"こんなに人がいるところは、\n慣れてなくて…。これもある意味、イベントだとは思いますが…。","zh":"这里人这么多……好不习惯……\n但从某种角度来看，这就像游戏活动一样……"},{"label":"活动大厅1","jp":"は、箱は？箱はどこに？あれがないと、わたし…あ、見つけて\nくださったんですね！ありがとうございます、先生。","zh":"箱，箱子呢……！箱子在哪里？！\n如果没有箱子的话……我就……\n啊，您找到啦……？谢谢您，老师……"},{"label":"活动大厅2","jp":"その…すごく、怖いですが…この体験は、ゲームに生かせるかもしれませんし…。","zh":"虽，虽然很害怕……\n但这种体验，说不定也能用到游戏里……"},{"label":"活动大厅3","jp":"先生。わたし…上手くできるでしょうか？","zh":"老师……我，我能做好嘛……？"},{"label":"活动大厅4","jp":"うう…帰ってゲームしたい…。\nでも、震えてばかりじゃいけませんよね。わたしにできることをしないと…。","zh":"呜呜……好像回家打游戏……\n可是，我不能一直这样瑟瑟发抖……至少，也要做些力所能及的事情……"},{"label":"活动事件1","jp":"掃除におもてなし…うう、お客さんがもうちょっと少なかったら…。","zh":"扫除和待客……呜呜……要是客人能再少一点就好了……"},{"label":"活动事件2","jp":"た、大変なことになってしまいました…！先生…助けてください…！","zh":"不，不得了了……！老师，请帮帮我……！"},{"label":"活动结束","jp":"あんなことが起きたなんて、未だに信じられません…解決できたのは、全部先生のお陰です。","zh":"我现在都不太敢相信，竟然发生了那种事情……\n……最后能成功解决，这都是多亏了老师……！"}]},"stats":{"init":[{"name":"攻击力","value":"240"},{"name":"防御力","value":"99"},{"name":"生命值","value":"2986"},{"name":"治愈力","value":"1681"},{"name":"命中值","value":"783"},{"name":"闪避值","value":"191"},{"name":"暴击值","value":"261"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1095"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value"