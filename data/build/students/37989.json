mages/w_275/h_275/829/103682/2025/4/29/46255.png","url":"https://www.gamekee.com/ba/tj/161196.html"},{"name":"★3 白子*恐怖","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/134620.png","url":"https://www.gamekee.com/ba/162557.html"},{"name":"NPC 白子（1年级）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/4/114514.png","url":"https://www.gamekee.com/ba/624154.html"}],"voices":{"通常":[{"label":"登录界面","jp":"ブルーアーカイブ。","zh":"碧蓝档案。"},{"label":"卡池抽取","jp":"アビドス対策委員会2年生砂狼シロコ、よろしく。","zh":"你好，我是阿拜多斯对策委员会的砂狼白子，请多关照。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"やってほしい事があるなら何でも言って。","zh":"有什么需要帮忙的地方，请尽管说。"},{"label":"登陆2","jp":"ようこそ、先生。今日もよろしく。","zh":"老师好，今天也请多指教了。"},{"label":"大厅1","jp":"先生を手伝うためにここにいるよ。","zh":"我是为了帮助老师，才到这里来的。"},{"label":"大厅2","jp":"何でそんなにじーっとみてるの？","zh":"为什么一直，盯着我瞧啊？（心声）"},{"label":"大厅3","jp":"…あの、私の顔に何かついてる？","zh":"嗯..我脸上，沾什么东西了吗"},{"label":"大厅4","jp":"え、ただ顔を見たかっただけ？そ、そう。","zh":"哎？就是想看看我？哦..好吧.."},{"label":"大厅5","jp":"こうやって一緒にいるのも悪くないね。","zh":"就这样，呆在一起，也挺不错的。"},{"label":"回忆大厅1","jp":"何かやってほしいこと、ある？","zh":"有什么，我能帮忙的吗？"},{"label":"回忆大厅2","jp":"何を考えているのか？気になる。","zh":"好想知道，老师到底在想什么。（心声）"},{"label":"回忆大厅3","jp":"これから、何をするつもりだろう。","zh":"这是，打算干什么呢？"},{"label":"回忆大厅4","jp":"先生を手伝うために、ここにいるから。","zh":"我来这里，是为了给老师帮忙的。"},{"label":"回忆大厅5","jp":"こんなに撫でられでも…別に困ることなんて…。","zh":"你，你这么摸我的头，到也不是不可以..."},{"label":"咖啡馆1","jp":"ええ、まあまあ広い所だね、適度の運動をするには十分だ","zh":"嗯...？这个地方还蛮大的，用来稍微运动一下是足够了"},{"label":"咖啡馆2","jp":"うむ。","zh":"嗯。"},{"label":"咖啡馆3","jp":"次のライティングはどこに行こうか。","zh":"下次去哪里骑车好呢？(语气不同）"},{"label":"咖啡馆4","jp":"先生は放課後は、何の仕事をしてるのかな。","zh":"老师下班后，会干些什么呢？"},{"label":"咖啡馆5","jp":"そういえば銃器の点検時間だったね。","zh":"啊，该检查维护枪械了。"}],"好感度":[{"label":"好感度1","jp":"おかしい、ドキドキが止まらない。","zh":"-"},{"label":"好感度2","jp":"先生と一緒にいると、なんだか不思議な気分。","zh":"和老师在一起的时候，总有种奇妙的感觉"},{"label":"好感度3","jp":"先生、教えて、私の知らない、色なことを、もっと。","zh":"老师，教教我，我不知道的事情，还有别的，很多。"},{"label":"好感度4","jp":"先生に会ったその瞬間から、ここは私にとってもっと特別な場所になった。","zh":"从见到老师的那一刻起，这里对我来说，已经变成了一个更加特别的地方。"}],"战斗":[{"label":"编入队伍1","jp":"準備できたよ","zh":"我准备好了。"},{"label":"编入队伍2","jp":"オッケー、賛成する。","zh":"ok，我会参战。"},{"label":"拎起","jp":"ん…","zh":"嗯..."},{"label":"任命队长1","jp":"敵発見、指示を、","zh":"发现敌人，请指示。"},{"label":"任命队长2","jp":"先生、出撃命令を。","zh":"老师，请下令出击。"},{"label":"普通技能","jp":"いくよ。","zh":"要上了。"},{"label":"EX动画1","jp":"状態良好、行くよ。","zh":"状态，良好，上吧。"},{"label":"EX动画2","jp":"ユニット起動。","zh":"单位启动。"},{"label":"EX动画3","jp":"ドローン、作動開始。","zh":"开始操纵无人机。"},{"label":"EX技能1","jp":"火力支援をはじめる。","zh":"火力支援，开始。"},{"label":"EX技能2","jp":"ターゲット、設定完了。","zh":"目标，设置完成。"},{"label":"EX技能3","jp":"支援攻撃。","zh":"支援攻击。"},{"label":"战斗开始1","jp":"フォーメーション、Bで行くよ","zh":"采用b阵型。"},{"label":"战斗开始2","jp":"陣形を維持しながら、前進する","zh":"保持队形，向前移动"},{"label":"获得BUFF","jp":"ありがとう。","zh":"嗯，谢谢"},{"label":"施放BUFF","jp":"-","zh":"喝！"},{"label":"掩体","jp":"遮蔽物、確保。","zh":"已找到掩体。"},{"label":"被CC1","jp":"ヶっ","zh":"（喘息）"},{"label":"被CC2","jp":"まったく。","zh":"可恶.."},{"label":"被CC3","jp":"-","zh":"（喘息）"},{"label":"回避","jp":"無駄。","zh":"没用。"},{"label":"队伍移动1","jp":"この辺に確か、銀行が……","zh":"我记得这附近..有银行。"},{"label":"队伍移动2","jp":"ライティングに持って来いな場所だね。","zh":"这是个骑车的好地方啊。"},{"label":"回复","jp":"うん、ありがとう。","zh":"嗯，谢谢。"},{"label":"中途退出","jp":"ミスだ、ごめん。","zh":"额...失误了，抱歉。"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"战斗喊叫","jp":"-","zh":"-"},{"label":"角色移动","jp":"移動しよう。","zh":"继续前进。"},{"label":"战斗胜利1","jp":"戦術の勝利だ。","zh":"这是战术上的胜利。"},{"label":"战斗胜利2","jp":"クリア。","zh":"Clear."},{"label":"关卡完成1","jp":"備えあれば患いなし。シンプルなルールだ。","zh":"有备无患，简单的法则。"},{"label":"关卡完成2","jp":"素晴らしい指揮だった、先生。","zh":"老师的指挥，很出色。"},{"label":"战斗失败1","jp":"ごめん、私の判断ミスだ。","zh":"抱歉，是我误判了。"},{"label":"战斗失败2","jp":"少し力不足くだったか。","zh":"实力还有所欠缺啊。"}],"成长":[{"label":"升级1","jp":"トレーニングの成果を感じた。","zh":"我感受到了训练的成果。"},{"label":"升级2","jp":"ありがとう、先生。","zh":"老师，谢谢你。"},{"label":"升级3","jp":"成長したみたい。これも、先生のおかげ。","zh":"我这应该是有所成长了吧，多谢老师。"},{"label":"升级4","jp":"成長してるのがわかる。","zh":"我真的有在成长。"},{"label":"获得专武","jp":"わたしも、少しは強くなったかな、うん、これなら、みんなの力になれる。","zh":"我应该，也变强了一点吧，嗯，这样就能帮到大家了。"}],"事件":[{"label":"学生生日","jp":"私の誕生日…覚えてるとは思わなかった。\nいや、もちろん嬉しい。うん、本当だよ。","zh":"原来，你还记得我的生日啊，没有，当然开心了，嗯，真的"},{"label":"老师生日","jp":"誕生日おめでとう。先生。\n記念として一緒にジョギングでもしない？","zh":"祝你生日快乐，老师，为了纪念这个时刻，我们一起去慢跑怎么样 嗯？不愿意吗？"},{"label":"万圣节","jp":"ハロウィン。特別な記憶はない。都市はいつも静かだったから。\nうん。賑やかな都市が見られたらいいね。","zh":"万圣节，我对万圣节没有什么特别的回忆，因为这个城市一直都很安静，嗯，真想看看这个城市热闹起来是什么样子。"},{"label":"新年","jp":"明けましておめでとう、先生。\n今年もよろしく。","zh":"新年快乐啊，老师，今年也请你多多关照。"},{"label":"圣诞节","jp":"メリークリスマス。今日は特別な日なんだって。\nどういう風に特別なのかわからないけど……\n先生、教えてくれない？","zh":"圣诞快乐，听说今天是个特别的日子，\n虽然我也不知道今天为什么这么特别，老师，你能告诉我吗？"},{"label":"春节","jp":"","zh":"老师新年快乐，要和我在新年的清晨出去跑步吗？"},{"label":"中秋","jp":"","zh":"老师，今晚的月亮很明亮呢，要和我一起出去看看吗？\n啊……这次只是出门逛逛，不用跑步。"}]},"stats":{"init":[{"name":"攻击力","value":"340"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2492"},{"name":"治愈力","value":"1662"},{"name":"命中值","value":"707"},{"name":"闪避值","value":"808"},{"name":"暴击值","value":"202"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1384"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8079"},{"name":"防御力","value":"108"},{"name":"生命值","value":"55775"},{"name":"治愈力","value":"5918"},{"name":"命中值","value":"707"},{"name":"闪避值","value":"808"},{"name":"暴击值","value":"832"},{"name":"暴击伤害","value":"266%"},{"name":"稳定值","value":"1384"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"699"},{"name":"生命值","value":"3491"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"s