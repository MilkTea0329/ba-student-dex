.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/353104.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/602224.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/981923.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/258145.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/990535.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/86996.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/157597/2025/5/4/278135.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/353104.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/602224.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/981923.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/258145.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"794"},{"name":"攻击力","value":"160"},{"name":"治愈力","value":"217"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/695061.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/4/460320.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 伊织","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/157597/2025/5/4/628858.png","url":"https://www.gamekee.com/ba/59300.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue archive."},{"label":"卡池抽取","jp":"……べっ、別に遊んでるわけじゃない。偵察任務の途中だから、誤解しないで。","zh":"我，我可不是在偷懒，我正在执行侦查任务，你可别误会啊。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生。今日は良い天気だし、日光浴にはピッタリの日だね。","zh":"老师你来啦，今天阳光充足，还挺适合晒日光浴的呢。"},{"label":"登陆2","jp":"先生、遅い！危うく私だけ、極端に焼けちゃうところだったじゃんか……！","zh":"老师，你迟到了，我等你等的皮肤都快晒伤了。"},{"label":"大厅1","jp":"歩きながら飲食をしない！リゾート地だからって例外は無いからな！","zh":"禁止边走边吃东西，在度假区也不能破例。"},{"label":"大厅2","jp":"なに、そんなニコニコして……いくら海だからって、浮かれすぎ。","zh":"笑得这么灿烂，该不会是因为看到大海了吧？"},{"label":"大厅3","jp":"……え？私の水着姿を見てたら、自然に……？","zh":"是因为看到我穿泳装的样子。"},{"label":"大厅4","jp":"……っ！死ね、このヘンタイ！","zh":"去死吧，你这个变态。"},{"label":"大厅5","jp":"ふう、海辺で飲むレモネードはやっぱり格別だ。","zh":"在海边喝柠檬水味道就是不一样。"},{"label":"大厅6","jp":"べ、別に、海だからって浮かれてるわけじゃない！","zh":"那来了海边就嗨起来了。怎么可能？"},{"label":"回忆大厅1","jp":"……ん？うわっ！？","zh":"……嗯？哇！？"},{"label":"回忆大厅2","jp":"い、いつの間にそこに！？","zh":"你，你什么时候来的？"},{"label":"回忆大厅3","jp":"え、さっきからずっと見てた……？\nこのっ……ヘンタイ！死ねっ！！","zh":"已经看了好久了。你这个变态，去死！"},{"label":"回忆大厅4","jp":"……言っておくけど、別に遊んでるわけじゃないからな？\nこれもれっきとした、風紀を守る活動の一環で……！","zh":"话说在前头，我可不是在偷懒啊。我，我这也是维护海边纪律的一种形式。"},{"label":"回忆大厅5","jp":"……っていうか、いつまでジッと見てるんだ！早くどっか行って！","zh":"你怎么还在看有完没完？赶紧走开。"},{"label":"咖啡馆1","jp":"リゾート地だからって、規則違反は許さないからな。","zh":"这里应该没有放假，玩疯了。开始清理违规的家伙吧。"},{"label":"咖啡馆2","jp":"規則違反をしてるやつは……今のところいなさそうだな。","zh":"目前没看到违规的家伙。"},{"label":"咖啡馆3","jp":"（紫外線対策、しっかりしないと……）","zh":"防晒做到这种程度应该足够了吧。"},{"label":"咖啡馆4","jp":"（どこか、ビーチベッドを広げられそうなところは……）","zh":"有没有什么地方适合展开太阳椅呢？"},{"label":"咖啡馆5","jp":"（なっ、なんだか今、気持ち悪い視線を感じた気が……）","zh":"感觉刚才有恶心的视线盯着我。"}],"好感度":[{"label":"好感度1","jp":"先生のこと……頼りにしてるから。","zh":"既然是老师说的，那我就先相信你。"},{"label":"好感度2","jp":"今年の夏は付き合ってもらうよ？なっ！いや、その、トレーニングの話！","zh":"今年夏天你有跟我在一起吗？我是说一起训练。"},{"label":"好感度3","jp":"もしかして、ずっと私の後をつけてきたのか？……え、嘘だろ？","zh":"不会吧？你一直都跟在我后面。"},{"label":"好感度4","jp":"まったく……本当に不思議な人だ。ヘンタイで、大人なのに情けなくて。でも……なんだか放っておけない。","zh":"老师怎么这么奇怪，明明是个废柴到不可救药的大人，却老师让我放心不下。不会吧？你一直都跟在我后面。"}],"战斗":[{"label":"编入队伍1","jp":"問題ない","zh":"没问题。"},{"label":"编入队伍2","jp":"ここでも任務があるのか","zh":"在这儿也要执行任务哦。"},{"label":"拎起","jp":"っちょっと！変なところを触るな！","zh":"手别乱碰。"},{"label":"任命队长1","jp":"規則違反はどこだ！？","zh":"违反规则的人在哪呢？"},{"label":"任命队长2","jp":"さて、準備運動でもするか","zh":"好嘞，做准备运动吧。"},{"label":"普通技能","jp":"-","zh":"-"},{"label":"EX动画1","jp":"まったく。せっかくの休憩時間が！","zh":"难得的休息时间。"},{"label":"EX动画2","jp":"少しぐらいゆっくりさせてくれ！","zh":"本来想好好休息的。"},{"label":"EX动画3","jp":"せっかくの非番の日なんだけどなぁ","zh":"好不容易今天不用值班。"},{"label":"EX技能1","jp":"逃がすか","zh":"别想逃。"},{"label":"EX技能2","jp":"どんな状況でも逃がしはしない！","zh":"不管发生了什么，你们都逃不掉的。"},{"label":"EX技能3","jp":"違反者にはばつを！","zh":"收下违反规则的家伙。"},{"label":"战斗开始1","jp":"これより、夏合宿のトレニンーグが開始する。","zh":"夏季集训现在开始。"},{"label":"战斗开始2","jp":"砂のお城みたいに、あとかたもなく壊してやる！","zh":"就像推倒沙堡一样，铲平他们吧。"},{"label":"获得BUFF","jp":"よし、行くぞ","zh":"好，我要上了。"},{"label":"施放BUFF","jp":"よし！","zh":"好嘞。"},{"label":"掩体","jp":"一旦隠れる","zh":"我先避一下。"},{"label":"被CC1","jp":"-","zh":"-"},{"label":"被CC2","jp":"いた","zh":"-"},{"label":"被CC3","jp":"な、なんだ","zh":"你干什么？"},{"label":"回避","jp":"無駄だ","zh":"白费力气。"},{"label":"队伍移动1","jp":"場所を移動する","zh":"移动位置。"},{"label":"队伍移动2","jp":"狙撃ポイントへ移動する","zh":"移动到狙击点。"},{"label":"回复","jp":"ありがとう","zh":"谢了。"},{"label":"中途退出","jp":"っち…ちょっと浮かれすぎたか","zh":"切...不知不觉间，是我大意了"},{"label":"战斗喊叫","jp":"-","zh":"耶。"},{"label":"战斗喊叫","jp":"逃がすか","zh":"不会放过你的。"},{"label":"战斗喊叫","jp":"くらえ","zh":"看招。"},{"label":"角色移动","jp":"よし、早く次の場所へ行こう","zh":"好，快去下个地方吧。"},{"label":"战斗胜利1","jp":"いっても効かない馬鹿には、銃弾を食らわせるしかない","zh":"听不懂人话的蠢货，只能喂他吃枪子了。"},{"label":"战斗胜利2","jp":"まったく、海だからと言って、浮かれすぎだ。馬鹿ともめ","zh":"真是的，虽说是在海边，未免撒欢过头了，这帮蠢货。"},{"label":"关卡完成1","jp":"まったく、鬱陶しいやつらだった","zh":"切，一帮败兴的杂鱼。"},{"label":"关卡完成2","jp":"これでようやく、ゆっくり休憩ができる","zh":"好啦，这样终于能好好休息啦。"},{"label":"战斗失败1","jp":"ちっ、覚えとけよ","zh":"切，等着瞧"},{"label":"战斗失败2","jp":"くそ！何でこんなことに","zh":"该死，怎么会这样？"}],"成长":[{"label":"升级1","jp":"これも夏の合宿の成果だな。","zh":"这也是集训的成果。"},{"label":"升级2","jp":"なるほど。確かに技術が身についてるみたいだ。","zh":"原来如此，看来我又掌握了新的技术。"},{"label":"升级3","jp":"夏だから、海だからってトレーニングを怠るわけにはいかない。","zh":"就算在夏天的海边训练，也不能懈怠。"},{"label":"升级4","jp":"うん、確かに成長してる。……ちょっと！どこを見てるんだ？","zh":"我确实成长了，喂，你看哪呢？"},{"label":"获得专武","jp":"これは……ちゃんとした武器なのか？本当に？","zh":"这是正经武器吗？真的？"}],"事件":[{"label":"学生生日","jp":"海で迎える誕生日なんて……\nちょっとロマンチックすぎるけど、悪くないな。\n海といったらバカばっかりだし、\nトラブルだらけであんまり好きじゃなかったけど……。\nでも、これは最高の誕生日だ。\nありがとう、先生。","zh":"在海边过生日有点太浪漫了，不过也不错。海边竟是一帮蠢货在闹事，烦得要死。所以我本来不怎么喜欢。\n不过今年的生日真的很开心。老师，谢谢您。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\n何か欲しい物とかないのか？\n……この状況だけでもう十分？\n何それ、どういう意味？","zh":"老师生日快乐，有没有什么想要的？现在这样就够了。什么意思啊？"},{"label":"万圣节","jp":"なんだかちょっと涼しい気が……。\nは？後ろで何かが通り過ぎた気がする？\nばっ、夏でもないのに、急に怖い話をするな！","zh":"总觉得凉飕飕的。我身后是不是有什么东西过去了？现在又不是需要讲鬼故事，消暑的夏天，别突然吓唬人。"},{"label":"新年","jp":"もうお正月か……。\nちょっと前まで夏だったのに、時間が経つのは早いな。","zh":"已经要过年了，怎么感觉夏天才过去没多久？时间过得太快了吧。"},{"label":"圣诞节","jp":"はぁ、ビキニのサンタ服！？\nだ、誰が着るかそんな破廉恥なの！\n死ね！ヘンタイ！","zh":"圣诞比基尼？谁会穿那种不要脸的衣服？去死吧，变态。"},{"label":"春节","jp":"","zh":"老师，祝你新春快乐。总感觉夏天才刚刚过去，没有想和你去海边的意思。"},{"label":"中秋","jp":"","zh":"赏月是不需要涂防晒霜的，如果你想跟上来也不是不可以。"}],"活动":[{"label":"活动事件1","jp":"合宿期間も残り半分。必要なものがあるなら急いだほうがいい。","zh":"夏季集训已经过去一半了，需要什么东西的话最好抓紧点。"},{"label":"活动事件2","jp":"合宿期間もあと少しだ、何か必要なら早めに言って。","zh":"集训没剩几天了，需要什么就早点说。"},{"label":"活动结束","jp":"今日で最終日か、本当に目まぐるしバカンス…いや、合宿だった。","zh":"今天就是最后一天了，真是个多灾多难的假...夏季集训啊。"},{"label":"活动商店1","jp":"なんでこっちをじっと見てるんだ、ただではあげられないからな。","zh":"干嘛一直盯着我看？免费送可不行。"},{"label":"活动商店2","jp":"ヒナ委員長の忙しさに比べたら、これぐらい大したことじゃない。","zh":"跟会长的工作比起来，这点事算不了什么。"},{"label":"活动商店关闭","jp":"そう、もう夏も終わりだよ、何かやり残したことはないか、ちゃんと確認しておいて。","zh":"夏季集训已经结束了，好好检查一下有没有漏掉的东西吧。"},{"label":"活动商店登陆1","jp":"ゲヘナの校章が入った箱を拾ったら、渡して。色んなものと交換できるよ。","zh":"如果捡到有个歌赫纳徽章的补给箱，可以来这和我换东西啊。"},{"label":"活动商店登陆2","jp":"や、先生、夏合宿に必要なものなら、だいたい何でも揃ってるよ。","zh":"老师来了，夏季集训需要的东西这差不多都齐了。"},{"label":"活动商店购买1","jp":"お、いいんじゃない？","zh":"是个好东西。"},{"label":"活动商店购买2","jp":"へ、気前がいいね、先生。","zh":"哟，老师还挺大方嘛。"},{"label":"活动商店购买3","jp":"へえ、そんなものがあったのか、先生は運がいいね。","zh":"还有这种东西，老师运气不错嘛。"},{"label":"活动商店购买4","jp":"良かったね、先生、それ結構貴重なものだから、取り扱いには注意したほうがいい。","zh":"这个可贵重了，省着点用啊。"}]},"stats":{"init":[{"name":"攻击力","value":"429"},{"name":"防御力","value":"17"},{"name":"生命值","value":"2252"},{"name":"治愈力","value":"1819"},{"name":"命中值","value":"995"},{"name":"闪避值","value":"178"},{"name":"暴击值","value":"221"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","v