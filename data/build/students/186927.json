0/images/w_300/h_237/829/103682/2025/5/11/297540.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/11/863102.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/11/98844.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/11/433863.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/103682/2025/5/11/555284.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/191981/2026/1/18/757167.png","name":"洁白少女","desc":"在百鬼夜行自治区各处有售的夷产巧克力饼干。外面包有一层薄薄的白巧克力。唯一的缺点是容易弄脏手。"},"ability":{"attrs":[{"name":"生命值","value":"873"},{"name":"攻击力","value":"139"},{"name":"治愈力","value":"200"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/11/602380.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/11/692404.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"名草（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/75159.png","url":"https://www.gamekee.com/ba/667917.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"百鬼夜行連合学園、百花繚乱紛争調停委員会御稜ナグサ\nこの力は皆を守るためにある","zh":"我是百鬼夜行联合学院，百花缭乱纠纷调解委员会的御稜名草。这份力量，我要用来守护大家。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ああ、おかえりなさい、先生\n今日は、何をすればいいのか教えて？","zh":"啊，老师，你来了。今天的工作……从哪开始比较好呢？"},{"label":"登陆2","jp":"あっ、先生…おかえりなさい、帰ってきてくれて、よかった\nその…不安で。\nみんな、離れてしまうんじゃって、消えてしまうんじゃないかって…\nあまり…一人にしないで…ごめんなさい","zh":"啊，老师……太好了，你回来了。……抱歉，我还是没改掉这个毛病。只要不在我身边，我就害怕大家会消失不见。所以，不要让我一个人孤零零地待太久。"},{"label":"大厅1","jp":"シャーレの仕事は...少し新鮮\n百花繚乱でも事務仕事はしてだけど...シャーレほど本格なものじゃなかったから","zh":"在沙勒工作挺新奇的，我很喜欢。百花缭乱也有不少事务工作，但毕竟不像沙勒这么正式。"},{"label":"大厅2","jp":"あの...シャーレ当番の日によく焼き鳥を焼いてる気がするのは...気のせい？\n好き...だけどここで焼くのはやめた方がいいと思う","zh":"话说，老师。为什么我每次来的时候你都会准备烤鸡肉串？我喜欢是喜欢……但沙勒的办公室并不适合做烧烤。"},{"label":"大厅3","jp":"...どうかしたの？白い肌に見惚れたて...?そう、よく飽きないね","zh":"我的脸上粘了什么东西吗？为什么一直盯着看……？你是说，因为我的皮肤像雪一样白，所以视线就不由自主被吸引过去了？唔，听你这么说还真意外呢。"},{"label":"大厅4","jp":"固い氷で...ゆっくり時間をかけて凍らせるんだって\nなんだか...鉄を焼くのと似ている気がする\n…孤独が募ると、頑なになっていくものなのかもしれないね","zh":"据说为了制造出坚硬的冰块，需要花很长时间慢慢冷冻……虽然温度不一样，但总觉得和锻铁的过程很相似呢。世间万物是不是越孤独就越坚硬呢？"},{"label":"大厅5","jp":"百花繚乱紛争調停委員会はその名の通り紛争を調停するために存在しているの\n本当はこの銃を抜く前に終わるといいんだけど","zh":"我们【百花缭乱纠纷调解委员会】顾名思义，专门负责调解纠纷。当然……如果能在开枪之前调解完就好了……"},{"label":"回忆大厅1","jp":"夜が明けるこの瞬間がもっとも闇が深くなる。\n私はこの漆黒が恐ろしかった","zh":"黎明前的这一刻……是黑暗最深沉的时候。以前……我很害怕这片漆黑。"},{"label":"回忆大厅2","jp":"闇を照らすほど眩しく輝くこともー夜が明けるまで耐え忍ぶことも、私にはできなかったから。\n他人を演じることでー影に紛れて平静を装うことしか、できなかったの。","zh":"我无法明亮到照亮黑暗，就连忍受黑夜的流逝……对我都无比艰难。我只能扮演成另一个人——混进阴影中，装作平静地躲起来。"},{"label":"回忆大厅3","jp":"でもー今は違う","zh":"但是，以后再也不会这样了。"},{"label":"回忆大厅4","jp":"明けない夜はないとー私に影が落ちると、知ったから。\nだからー","zh":"因为我知道，黑夜终将结束——我的影子会落在大地上。所以——"},{"label":"回忆大厅5","jp":"黄昏に名乗りをあげようー—\n私は百花繚乱紛争調停委員会の委員長、御稜ナグサ!","zh":"我会在黄昏面前报上名号。……我是百花缭乱纠纷调解委员会的会长，御稜名草！"},{"label":"咖啡馆1","jp":"アヤメだったら...どう過ごしてたかな","zh":"如果菖蒲在，她会在这里做些什么呢？"},{"label":"咖啡馆2","jp":"ここにいてもいいのかな","zh":"我也可以待在这种地方吗……？"},{"label":"咖啡馆3","jp":"これは ...焼き鳥？","zh":"（这是……烤鸡肉串的味道？）"},{"label":"咖啡馆4","jp":"ちょっと熱いけど...きっと皆にとっては過ごしやすいんだろうな","zh":"感觉有点热……不过对别人来说，这样应该刚刚好吧。"},{"label":"咖啡馆5","jp":"少しくらくらする ...休もうかな","zh":"感觉有点头晕……休息一会儿再走吧。"}],"好感度":[{"label":"好感度1","jp":"雪は熱に触れると溶けてしまうけど、\n先生のそばにいられるのなら、\nそれでも……いいかな","zh":"在温暖的阳光下，冰雪终究会融化……如果能待在老师身边，这样的结局似乎也不坏。"},{"label":"好感度2","jp":"私って美少女のところしか取り柄がないのにどうしてこんな風に優しくしてくれるの?","zh":"我这个人，除了脸蛋长得好看以外毫无优点，老师为什么要对我这么好呢？"},{"label":"好感度3","jp":"これでも心から感謝しているの、無表情系美少女だからそうは見えないかもしれないけど","zh":"别看我这样，我也是真心感谢老师的。只不过，我虽然是个美少女，但在表达感情方面不太擅长，所以你或许看不出来。"},{"label":"好感度4","jp":"先生の手暖かいね","zh":"老师的手很温暖，我很喜欢。"}],"战斗":[{"label":"编入队伍1","jp":"私がいこうか","zh":"……我来试试吧。"},{"label":"编入队伍2","jp":"最善を尽くすよ","zh":"我会全力以赴的。"},{"label":"拎起","jp":"ひゃっ!先生何があったの？","zh":"呃，诶？！……老师，怎么了？"},{"label":"任命队长1","jp":"作戦地域に到着","zh":"抵达作战区域。"},{"label":"任命队长2","jp":"頼りないかもしれないけど、信じてほしい","zh":"我也许还不够可靠，但希望你能相信我。"},{"label":"普通技能","jp":"これで完璧","zh":"嗯，很完美。"},{"label":"EX动画1","jp":"皆を助けられるのなら","zh":"只要能保护大家……"},{"label":"EX动画2","jp":"私は返事続ける、御稜ナグサという役を","zh":"我会继续演下去，继续扮演名为御稜名草的这个角色！"},{"label":"EX动画3","jp":"皆を失うの事の方が怖いの","zh":"我当然害怕，但失去大家更可怕！"},{"label":"EX技能1","jp":"これが私にできる最善","zh":"这就是我能做到的全部。"},{"label":"EX技能2","jp":"絶対に引き下がりはしない","zh":"我不会退缩的！"},{"label":"EX技能3","jp":"いざ、尋常に勝負","zh":"堂堂正正地一决胜负吧！"},{"label":"战斗开始1","jp":"いこうか","zh":"各位，上吧。"},{"label":"战斗开始2","jp":"百花繚乱の力見せてあげる","zh":"我就让你见识一下百花缭乱的力量。"},{"label":"获得BUFF","jp":"信頼されているんだよね、きっと","zh":"大家应该是信任我的吧……"},{"label":"施放BUFF","jp":"行ける","zh":"我能行的。"},{"label":"掩体","jp":"ここなら大丈夫","zh":"这里很安全。"},{"label":"被CC1","jp":"","zh":"咳！"},{"label":"被CC2","jp":"","zh":"咳！"},{"label":"被CC3","jp":"","zh":"咳！"},{"label":"回避","jp":"この程度なの","zh":"就这样而已吗？"},{"label":"队伍移动1","jp":"警戒を怠らないで","zh":"不要放松警惕。"},{"label":"队伍移动2","jp":"まだ終わってない","zh":"还没有结束。"},{"label":"回复","jp":"ありがとう","zh":"谢谢。"},{"label":"中途退出","jp":"やっぱり私には","zh":"我还是……"},{"label":"战斗喊叫","jp":"はぁ","zh":"哈啊！"},{"label":"战斗喊叫","jp":"ふぅ","zh":"哼！"},{"label":"战斗喊叫","jp":"ふ","zh":"嘿！"},{"label":"角色移动","jp":"急ごう","zh":"动作快。"},{"label":"战斗胜利1","jp":"まだ被害が多い","zh":"我们也有很多损失。"},{"label":"战斗胜利2","jp":"安心してはだめ","zh":"……不能因小小的胜利而自满。"},{"label":"关卡完成1","jp":"無事に終わったね、皆のおかげ、ありがとう","zh":"作战很成功。这都是大家的努力换来的，感谢大家。"},{"label":"关卡完成2","jp":"これくらい当然、本当ならもっとてきたのに","zh":"这是理所当然的。本来应该表现得更好才对。"},{"label":"战斗失败1","jp":"やっぱり、私には無理だったんだ。皆、ごめん。","zh":"我果然还是做不到……各位，很抱歉……"},{"label":"战斗失败2","jp":"ぐぅぅ。本当にごめんなさい","zh":"呜……真的，很抱歉……"}],"成长":[{"label":"升级1","jp":"本当にこれが私の力なの？ありがとう先生","zh":"这真的是我的力量吗？……谢谢你，老师。"},{"label":"升级2","jp":"どうだろう、ずっと最善を尽くしているだけ","zh":"你说我成长了吗？嗯……我只是一直在尽自己最大的努力而已。"},{"label":"升级3","jp":"まだこんな力が残っていたんだありがとう、先生のおかげで気づけた","zh":"没想到我居然也有这种可能性。这一切都多亏了老师，谢谢你。"},{"label":"升级4","jp":"まだ足りない、もっと頑張らないと教えてくれてありがとう先生","zh":"我知道自己还差得远，也能深深感受到自己的不成熟之处。谢谢你，老师。"},{"label":"获得专武","jp":"この銃は失格がなければ持つことができないもの、そう、これを御稜ナグサが持つ意味、先生なら分かっていると思う、それでも任せてくれるのなら信じてくれるのなら、私も全力であがいてみるよ","zh":"老师应该也明白，没有资格的人是不能拿起这把枪的。对我而言，这把枪承载的意义太沉重了。但如果老师依然愿意把它托付给我，再一次相信我的话……我会尽全力去尝试的。"}],"事件":[{"label":"学生生日","jp":"覚えていてくれたんだありがとう\n今まであまり気にしたことはなかったけど\nこれからは...特別な日だと思えるかも","zh":"啊，生日……原来你记得啊。谢谢你。以前，我从没觉得生日有多么特别过。但今后应该会好一点吧。"},{"label":"老师生日","jp":"変なのそばにいるだけでこんなにも幸せな気持ちになる\n私にとっても、自分の事のように特別に思うんだ\nお誕生日おめでとう","zh":"奇怪吧？只是因为有人在身边，我就觉得分外感激。也许就是因为这个，今天对我来说也格外特别。生日快乐，老师。"},{"label":"万圣节","jp":"ハロウィーンのことを考えていたの\n私、いつもなりたい自分を演じているから...ずっとコスプレをしていることになるのかな\nふふ。今日と言うの日は私のためにあるのかもしれない","zh":"啊，抱歉。我刚才想了一下万圣节的事。我一直在扮演理想中的自己，这也就相当于一直在cosplay吧。所以今天，或许正是为我而存在的日子呢，呵呵。"},{"label":"新年","jp":"明けましておめでとう。今年は...もう少しだけ頼ろうと思う。いいかな...","zh":"新年快乐，老师。今年我可以再多依赖你一点吧……？"},{"label":"圣诞节","jp":"私は冬が好き...\n全部が白に溶けて、気にならなくなるから\nだから、この季節の真冬のお祭りが大好きなんだ","zh":"我喜欢冬天。当一切都被染成雪白，我会觉得自己也变得平凡了一点。所以我真的很喜欢这个深冬里的节日。"},{"label":"春节","jp":"","zh":"新春……我喜欢这个节日。看着大家热热闹闹地聚在一起，仿佛连我也会变得不那么孤独。这种时候，老师……你会陪着我的，对吗？"},{"label":"中秋","jp":"","zh":"今晚的月光真明亮啊。它洒在地上的样子，你不觉得有些像雪吗？它们都那么洁白美丽，却又那么清冷，与阴影相伴，就像我一样……嗯？老师，你那是什么表情？"}]},"stats":{"init":[{"name":"攻击力","value":"371"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2477"},{"name":"治愈力","value":"1673"},{"name":"命中值","value":"915"},{"name":"闪避值","value":"196"},{"name":"暴击值","value":"203"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1964"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8319"},{"name":"防御力","value":"107"},{"name":"生命值","value":"49304"},{"name":"治愈力","value":"5955"},{"name":"命中值","value":"915"},{"name":"闪避值","value":"196"},{"name":"暴击值","value":"833"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1964"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"5 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"730"},{"name":"生命值","value":"3023"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"873"},{"name":"攻击力","value":"138"},{"name":"治愈力","value":"199"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_515/h_567/829/103682/2025/5/11/122229.png","attrs":[{"name":"攻击力","value":"207"},{"name":"生命值","value":"1010"}]},{"label":"羁绊角色2","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/829/191981/2026/5/10/1781096825619_1781096825593_2ghp35dcjt_fvhwukbnji.png","attrs":[{"name":"攻击力","value":"168"},{"name":"生命值","value":"1030"}]},{"label":"羁绊角色3","icon":"","attrs":[]}],"review":{"score":"56(C)","scoreIcon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_78/h_78/829/236746/2026/5/4/1780538755206_1780484382794_le19f6is7b_4r3p0fwre2.png","tiers":[{"name":"新手期","value":"★★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538770230_1780484152979_ztlyoqzvjh_jegj7hm1j8.png"},{"name":"总力战","value":"★★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538776594_1780484206588_4dnfad9a3r_3ot3lq8zz4.png"},{"name":"大决战","value":"★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538781498_1780484086283_7rhrvvb2ea_pkm9d9l9xl.png"},{"name":"竞技场","value":"不适合","icon":"https://cdnimg-v2.gamekee