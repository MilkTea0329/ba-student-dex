25/5/5/626761.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 夏","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43637/2025/5/5/207377.png","url":"https://www.gamekee.com/ba/90626.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝……档案！"},{"label":"卡池抽取","jp":"やあやあ、先生。私のステージへようこそ。\n……このリズムについて来れるかな？","zh":"哟哟~欢迎来到我的舞台，老师。\n呵呵，只要跟上我的节拍就好。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"我がステージへようこそ","zh":"欢迎来到我的演出现场……！"},{"label":"登陆2","jp":"にひ、なーんてね。せっかくだし、セッションでもしてみる？","zh":"嘿嘿，开玩笑的啦。\n不过，要不要听听我的演奏？"},{"label":"大厅1","jp":"おかえり、先生。キャンディー食べる？","zh":"你来啦，老师？要不要也吃点糖果？"},{"label":"大厅2","jp":"キャンディは素敵だよねぇ。このまま練習できるし。","zh":"糖果可真是个好东西，可以一边含在嘴里一边练习。"},{"label":"大厅3","jp":"ここで練習したら、先生の眠気覚ましに貢献できたり……する？","zh":"如果我在旁边打鼓，能把老师的困意赶走吗？"},{"label":"大厅4","jp":"何故だろう……旋律が甘く感じられるのは。","zh":"音乐明明是用耳朵聆听的，可为什么会觉得如此甜美呢……"},{"label":"大厅5","jp":"もっとロックな飾り付けをしたいんだけど手伝ってくれる～？","zh":"我想给这个空间加入点摇滚元素，老师会帮我的吧？"},{"label":"回忆大厅1","jp":"こ、こっち……こっちだ……せんせ……。","zh":"唔……\n我，我在这里……\n老师……"},{"label":"回忆大厅2","jp":"う……ドラムセットの中に……いるんだ……黒くてカサカサ動く……あいつが。\nいくら探しても見つからなくてぇ……。","zh":"呜……架子鼓里面……有……有个黑黑的，沙沙作响的，还会动的……东西……"},{"label":"回忆大厅3","jp":"な、何を言ってるのだ、先生！？\nキヴォトスでアレを怖がらない女子高生なんていないんだよ！？\n銃弾なんかよりよっぽど怖いんだよぉ！？","zh":"这，这是什么话嘛老师？！在基沃托斯，就没有不怕那种东西的女生！"},{"label":"回忆大厅4","jp":"うぅ、このままでは……\nせっかく手に入れた限定マカダミアクッキーが、\n餌食になってしまう……","zh":"呜呜，这样下去……我好不容易到手的限量版夏威夷果曲奇，就要变成牺牲品了……"},{"label":"回忆大厅5","jp":"だからお願い、先生……\n助けてぇ……。","zh":"求求你了，老师……救救我……"},{"label":"咖啡馆1","jp":"美しい響きが奏でられそうな場所だ。","zh":"这个空间的回声很不错呢。"},{"label":"咖啡馆2","jp":"私の演奏を披露するときが……ついに！","zh":"人好多呀……是时候献上我的演奏了吧？"},{"label":"咖啡馆3","jp":"どこにドラムを置こう……。","zh":"鼓要放在哪里呢……"},{"label":"咖啡馆4","jp":"甘いもの……どこだ……！","zh":"甜点在哪里……！"},{"label":"咖啡馆5","jp":"先生も来るのだろうか……。","zh":"待会儿老师也会来吗……"}],"好感度":[{"label":"好感度1","jp":"ふんん、ドラムの深淵に降れてみるかい","zh":"呵呵，要不来教你打鼓吧？"},{"label":"好感度2","jp":"時に甘い音楽は知っているかな","zh":"今天……来聊聊音乐的甜美之处吧？"},{"label":"好感度3","jp":"たまには一緒にボート過ごすのも悪くないね","zh":"有时候，像这样安静地待在一起也挺好的。"},{"label":"好感度4","jp":"先生と一緒に青春が激たらな、リズムは任せてよ","zh":"要是老师也能一起演奏就好了。\n……和我一起。"}],"战斗":[{"label":"编入队伍1","jp":"やはり必要かな？私のグルーヴが","zh":"怎么样？需要我的律动吗？"},{"label":"编入队伍2","jp":"ナイス選択ぅ","zh":"明智的选择！"},{"label":"拎起","jp":"ステージに上がった気分だよ","zh":"感觉就像登上舞台一样呢。"},{"label":"任命队长1","jp":"敵はどこだー","zh":"敌人在哪里！"},{"label":"任命队长2","jp":"ミュージックスタート","zh":"开始演奏吧！"},{"label":"普通技能","jp":"あまーい","zh":"好甜……！"},{"label":"EX动画1","jp":"わんつーすりーふぁー","zh":"One，two，three，four！"},{"label":"EX动画2","jp":"私に合わせて","zh":"奏响，鼓声！"},{"label":"EX动画3","jp":"ゆこう","zh":"上吧……！"},{"label":"EX技能1","jp":"これが...ロック...","zh":"这就是……摇滚……！"},{"label":"EX技能2","jp":"私のリズムに溺れるがいい","zh":"沉浸在我的节奏中吧……！"},{"label":"EX技能3","jp":"楽しんでいこう","zh":"鼓足干劲，出发！"},{"label":"战斗开始1","jp":"ビート刻んでいこう","zh":"是时候秀出我们的节奏了！"},{"label":"战斗开始2","jp":"セムラのために","zh":"为了泡芙，出发！"},{"label":"获得BUFF","jp":"もらった","zh":"收到！"},{"label":"施放BUFF","jp":"刮目せよ","zh":"给我瞧好了！"},{"label":"掩体","jp":"少し休もうか","zh":"休息一会儿再走吧~"},{"label":"被CC1","jp":"くぅ","zh":"咕！"},{"label":"被CC2","jp":"うぅ","zh":"呜！"},{"label":"被CC3","jp":"あ","zh":"呜啊！"},{"label":"回避","jp":"カット","zh":"停！"},{"label":"队伍移动1","jp":"次の小節へ","zh":"下个小节！"},{"label":"队伍移动2","jp":"テンポを上げよう","zh":"加快节奏！"},{"label":"回复","jp":"よっしゃ","zh":"很好！"},{"label":"中途退出","jp":"ここまでか、先に行け","zh":"别管我，快走……！"},{"label":"战斗喊叫","jp":"-","zh":"呼呜……"},{"label":"战斗喊叫","jp":"-","zh":"哈！"},{"label":"战斗喊叫","jp":"","zh":"咚咚！"},{"label":"角色移动","jp":"はぁ","zh":"哈啊！"},{"label":"战斗胜利1","jp":"拍手の準備はいいかな","zh":"好了，老师，可以鼓掌了。"},{"label":"战斗胜利2","jp":"やりきった","zh":"演奏，结束！"},{"label":"关卡完成1","jp":"素晴らしいセッションだった","zh":"精彩的合奏。"},{"label":"关卡完成2","jp":"練習は裏切らない","zh":"练习是不会背叛你的。"},{"label":"战斗失败1","jp":"-","zh":"咕……"},{"label":"战斗失败2","jp":"敗北は苦い物だ、糖分が欲しい","zh":"失败的滋味，太苦涩了……我需要，糖分……！"}],"成长":[{"label":"升级1","jp":"ふんん、応援ありがとう先生","zh":"呵呵，谢谢你的加油，老师。"},{"label":"升级2","jp":"喝采を、更なる喝采を","zh":"欢呼吧，喝彩吧……！"},{"label":"升级3","jp":"私は恐ろしいまだまだ成長し続けることが","zh":"越是成长，就越发现天外有天……！"},{"label":"升级4","jp":"どうかな？上達したと思うんだけど先生のおかげでここまで来れたんだ","zh":"怎么样，我的演奏？我能走到这里，都是多亏了老师。"},{"label":"获得专武","jp":"おぉー……まるで指先と一心同体のスティックを手に入れたような気持ち……。先生のセンスに惚れ惚れしてしまうな。","zh":"哦~拿起它，感觉就像握着刚好趁手的鼓棒……老师的眼光总是这么惊人啊。"}],"事件":[{"label":"学生生日","jp":"今日は、この私が世にデビューした日……！ところで、予定 は空いてるのだよね、先生？","zh":"今天是我在这个世界上首次登场的日子……！老师会为我抽出时间的吧？"},{"label":"老师生日","jp":"ハッピーバースデー、だね。先生。食べたいスイーツとかある？","zh":"生日快乐，老师~有什么想吃的甜点吗？"},{"label":"万圣节","jp":"タダでスイーツをもらえるだなんて。ほっんとう、素敵な日だよね、先生。","zh":"今天居然有免费的甜点吃，真是美好的一天啊，老师。"},{"label":"新年","jp":"あけましておめでとう、先生。ドラムで煩悩をかき消してみようかなって思うんだけど、一緒にどう？","zh":"新年快乐，老师。今年我想过得特别一点，用鼓声代替钟声，你觉得怎么样？"},{"label":"圣诞节","jp":"煙突の上にキャンディーを置いておかないと……そうすれば、サンタさんもきっと見つけてくれる！","zh":"我要在烟囱上放上糖果。这样圣诞老人就肯定不会错过了吧？"},{"label":"春节","jp":"","zh":"新春！节日！……也就是摇滚！想想吧老师，在这万人欢腾的夜晚，不是正适合来一段激情澎湃的演奏吗？现在的我，是名为柚鸟夏的鼓手……我的灵魂正在啸叫，我的双手也不住颤抖……ROOOOOCK！"},{"label":"中秋","jp":"","zh":"老师你看，今天的月亮是不是又大又圆？真让人想拿起鼓棒敲敲它呢……不知道它会发出什么样的鼓声？"}],"活动":[{"label":"活动登陆1","jp":"ふふ、よくぞ来てくれた、先生。","zh":"嘿嘿，快来吧，老师。"},{"label":"活动登陆2","jp":"楽にしていてくれて構わない。もうすぐ演奏が始まるよ。","zh":"随便坐吧。演奏就要开始了。"},{"label":"活动大厅1","jp":"ん？どうしたの、先生？","zh":"嗯？怎么了，老师？"},{"label":"活动大厅2","jp":"つつくなら、こっちもお願い……。練習で肩がひどく凝っててね……。","zh":"要戳的话，就戳戳我的肩膀吧……打鼓打得肩膀好酸啊……"},{"label":"活动大厅3","jp":"そんなにつついても、マカロンは出ないよ。","zh":"就算你戳再多下，也戳不出马卡龙的，老师。"},{"label":"活动大厅4","jp":"そこ座って、先生。ドラムの真髄、見せてあげようじゃないか……！","zh":"坐吧，老师。我来让你见识见识，什么是架子鼓……！"},{"label":"活动事件1","jp":"もっとお菓子が……いや、練習が必要だ……！","zh":"我需要更多的甜点……不对，是练习……！"},{"label":"活动事件2","jp":"さあ、フィナーレまであと一歩……！","zh":"好了，离终曲只差一步了……！"},{"label":"活动结束","jp":"……あぁ、すごかったよ。お疲れ様、先生。","zh":"……啊，真是场精彩的演奏。辛苦了，老师。"},{"label":"活动小游戏1","jp":"伝説が……はじまる。","zh":"传说……开始了。"},{"label":"活动小游戏2","jp":"立ち止まってる暇なんてない！「タイム・イズ・マネー」だよ、先生！","zh":"没时间犹豫了！\n时间就是金钱啊，老师！"},{"label":"活动小游戏3","jp":"音楽はマドレーヌと一緒。完成には、熟成の\n時間が必要なんだ。","zh":"音乐就像玛德琳蛋糕，完成它需要时间的沉淀。"},{"label":"活动小游戏4","jp":"まもなく完成する……究極の音楽が……！","zh":"极致的音乐……\n马上就要完成了！"},{"label":"活动小游戏awesome","jp":"私たちにとっては小さな一歩だが、バンド会にとっては偉大な一歩だ","zh":"这是我们的一小步，却是乐队界的一大步……！"},{"label":"活动小游戏daily_end","jp":"ふぅ、今日も燃え尽きたぜ真っ白いな","zh":"哼哼，今天也是燃烧殆尽的一天呢……只剩灰白……"},{"label":"活动小游戏failed","jp":"これは違う、私たちが望んだ結果はこんな物じゃない","zh":"不是这个……！我们期待的结果，不是这种东西……！！"},{"label":"活动小游戏success","jp":"レスピ通りに結果は出る物","zh":"只要按食谱做，自然会得到想要的结果。"}]},"stats":{"init":[{"name":"攻击力","value":"203"},{"name":"防御力","value":"24"},{"name":"生命值","value":"2747"},{"name":"治愈力","value":"2515"},{"name":"命中值","value":"101"},{"name":"闪避值","value":"823"},{"name":"暴击值","value":"203"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1372"},{"name":"射程","value":"450"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4938"},{"name":"防御力","value":"135"},{"name":"生命值","value":"66857"},{"name":"治愈力","value":"15580"},{"name":"命中值","value":"321"},{"name":"闪避值","value":"823"},{"name":"暴击值","value":"853"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1372"},{"name":"射程","value":"450"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"400"},{"name":"生命值","value":"5277"},{"name":"治愈力","value":"1372"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"项链","grade":"T10","attrs":[{"name":"治愈力","value":"42%"},{"name":"群控强化力","value":"38%"},{"name":"攻击力","value":"18%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"1540"},{"name":"攻击力","value":"76"},{"name":"治愈力","value":"299"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_612/h_617/829/103682/2025/6/17/352564.png","attrs":[{"name":"治愈力","value":"419"},{"name":"生命值","value":"1775"}]},{"label":"羁绊角色2"