mg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/408107/2026/1/12/28489.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"1014"},{"name":"攻击力","value":"110"},{"name":"治愈力","value":"237"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/408107/2026/1/12/679904.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/408107/2026/1/12/536365.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 柚子","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/11/168871.png","url":"https://www.gamekee.com/ba/77109.html"},{"name":"NPC 柚子（冬装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/953939.png","url":"https://www.gamekee.com/ba/647100.html"},{"name":"★1 柚子（女仆）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/11/263352.png","url":"https://www.gamekee.com/ba/589650.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー……すぅ……！アーカイブ！","zh":"碧…蓝…！档案！"},{"label":"卡池抽取","jp":"ミレニアムサイエンススクール……ゲーム開発部の花岡ユズ、です……。こ、こんな格好ですが……よろしく、お願いします……。","zh":"千禧年科技学园……游戏开发部的花冈柚子……就是我……。虽、虽然是这副打扮……还、还请多多关照……。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ふえぇ……！こ、この格好は、その……。\n……お、おかえりなさい、先生。","zh":"呼欸……！这、这副打扮，其实是……。\n……欢、欢迎回来，老师。"},{"label":"登陆2","jp":"お、お待ちしてました、先生……！\n早く出撃……ち、ちがうっ。当番のお仕事を、始めましょう……！","zh":"老、老师，一直在等您……！\n快出击……不、不对。我们开始值日吧……！"},{"label":"大厅1","jp":"このスーツ、思ったより楽ではあるんですが……それ以上に……恥ずかしい、です……。","zh":"这套装备，比想象中要轻便……但与此同时……也更让人害羞了……。"},{"label":"大厅2","jp":"スーツの感触、なんだか不思議ですよね。弾も弾いてしまいそうです。","zh":"装备的触感，总觉得很神奇呢。感觉连子弹都能弹开。"},{"label":"大厅3","jp":"全身を覆っているはずなのに……なんだか落ち着かなくて……うう……。","zh":"明明全身都被覆盖了……却总觉得不踏实……唔唔……。"},{"label":"大厅4","jp":"このスーツ……パソコンとも連動できるんです……。\n当番の時……役に立つでしょうか？","zh":"这套装备……还能和电脑联动呢……。\n值日的时候……能派上用场吗？"},{"label":"大厅5","jp":"あ、暑いですか……？こ、このスーツ……表面が冷たくて、気持ちいいですよ……？","zh":"啊，您觉得热吗……？这、这套装备……表面是凉的，很舒服哦……？"},{"label":"回忆大厅1","jp":"見てください、先生。\nわたしが守り抜いた世界です。","zh":"请看，老师。\n这就是我守护下来的世界。"},{"label":"回忆大厅2","jp":"……もちろん、分かっています。\nこの光景を見たのは、わたしだけじゃないって。","zh":"……当然，我明白。\n看到这番景象的，并不只有我一个人。"},{"label":"回忆大厅3","jp":"大会の時、こんなことを仰いましたよね。\n今この瞬間が、ゲームが。わたしたちの現実だって。","zh":"在大会的时候，您曾说过这样一句话。\n此刻，这场游戏。就是我们的现实。"},{"label":"回忆大厅4","jp":"だから、たとえエンディングの決まった世界だとしても……。\nこの世界のみんなが、同じシナリオを歩むとしても……。","zh":"所以，即便这是一个结局注定了的世界……。\n即便这个世界里的大家，都要遵循着相同的剧本前进……。"},{"label":"回忆大厅5","jp":"わたしがした選択、この感情は……。\n間違いなく、本物なんです。","zh":"我所做出的选择，这份感情……。\n毫无疑问，是真真切切的。"},{"label":"咖啡馆1","jp":"（平和な日常……今はその大切さが、よく分かります）","zh":"（平静的日常……现在深深体会到了它的可贵）"},{"label":"咖啡馆2","jp":"ソファ……突然発射したり、しませんよね……？","zh":"沙发……应该不会突然弹射出去吧……？"},{"label":"咖啡馆3","jp":"あたたかくて、いい匂い……いいですね。えへへっ。","zh":"暖暖的，好香……真舒服呢。嘿嘿。"},{"label":"咖啡馆4","jp":"ロッカーには……しばらく、入りたくありません……うぅ。","zh":"柜子……最近不太想进去呢……呜呜。"},{"label":"咖啡馆5","jp":"やっぱり、これ……少し派手過ぎませんか……？うぅぅ……。","zh":"果然，这身打扮……会不会太显眼了……？呜呜……。"}],"好感度":[{"label":"好感度1","jp":"その……先生の前なら、恥ずかしく、ないです……。","zh":"那个……如果在老师面前的话，我就不会觉得害羞了……。"},{"label":"好感度2","jp":"先生……あ、あの……一緒にゲームしませんか？","zh":"老师……那、那个……要不要一起玩游戏？"},{"label":"好感度3","jp":"あの……っ……手、また繋いでいただけませんか？","zh":"那个……能……能再牵一次我的手吗？"},{"label":"好感度4","jp":"外はやっぱり怖いけど……でも、そこに先生がいるならわたし……。","zh":"外面果然还是好可怕……但是，只要有老师在的话，我……。"}],"战斗":[{"label":"编入队伍1","jp":"どうしてここに……！？","zh":"为什么在这里……！？"},{"label":"编入队伍2","jp":"き、聞いてないです！？","zh":"我、我可没听说啊！？"},{"label":"拎起","jp":"お、おお落とさないでくださいね……！","zh":"请、请请别把我丢下啊……！"},{"label":"普通技能","jp":"タイミングを、合わせて……！","zh":"看准时机……！"},{"label":"EX动画1","jp":"大丈夫です。前にもやったこと、あります……！","zh":"没关系。以前也做过……！"},{"label":"EX动画2","jp":"今度は、わたしがみんなを……！","zh":"这次，换我来保护大家……！"},{"label":"EX动画3","jp":"体が、覚えてる……！いける！","zh":"身体还记得……！能行！"},{"label":"EX技能1","jp":"え、援護します！","zh":"诶，我来掩护！"},{"label":"EX技能2","jp":"ううううぅぅぅう……！！","zh":"呜呜呜呜呜……！！"},{"label":"EX技能3","jp":"怖いです……で、でも……！","zh":"好害怕……但、但是……！"}],"成长":[{"label":"升级1","jp":"コツを掴んできました……！","zh":"渐渐掌握窍门了……！"},{"label":"升级2","jp":"もっと、もっと強くならないと……！い、いつ呼び出されるか、分からないですし……うぅぅ……。","zh":"必须变得更强大才行……！不、不知道什么时候会被呼唤……呜呜……。"},{"label":"升级3","jp":"怖いけど……緊張は、していません……。これが、勇気の力、なのでしょうか……？","zh":"虽然很害怕……但并不紧张……。这就是勇气带来的力量吗……？"},{"label":"升级4","jp":"たとえ前に進めなくても、絶対に退いたり、しません……！","zh":"即使无法前进，也绝不会后退半步……！"},{"label":"获得专武","jp":"練習は本番のように。本番はゲームのように……！わたし、最善を尽くします……！","zh":"练习时要像实战一样认真。实战时要像游戏一样从容……！我会全力以赴的……！"}],"事件":[{"label":"学生生日","jp":"あ、ありがとうございます、先生……わたしのこと、忘れないでくれて……。","zh":"谢、谢谢您，老师……还记得我的生日……。"},{"label":"老师生日","jp":"お誕生日、おめでとうございます……！\nあ、あの、誕生日プレゼントに……ソフトを、用意してみたのですが……。\nど、どうでしょう……？","zh":"生、生日快乐……！\n那、那个，作为生日礼物……我准备了一份游戏……。\n您、您觉得如何……？"},{"label":"万圣节","jp":"わ、わたしよりすごい格好の人たちが、たくさん……！\nあっ、い、いや、わたしも着たかったとかじゃ、なくて……！","zh":"有、有好多打扮得比我还夸张的人啊……！\n啊，不、不是，我也不是说很想穿成这样……！"},{"label":"新年","jp":"いろんなことがありましたが、あっという間に一年が過ぎましたね。\n……あけましておめでとうございます、先生。","zh":"虽然发生了很多事情，但转眼间一年就过去了呢。\n……新年快乐，老师。"},{"label":"圣诞节","jp":"さ、サンタ服じゃないですが……あ、赤いですし……に、似たような、ものですよね。\nめ、メリークリスマスです、先生！","zh":"虽、虽然不是圣诞老人的衣服……但、但它是红色的……应、应该差不多吧。\n圣、圣诞快乐，老师！"}],"活动":[{"label":"活动登陆1","jp":"大丈夫です……わたしは大丈夫ですから……！","zh":"没关系的……我真的没关系……！"},{"label":"活动登陆2","jp":"逃げちゃダメ、逃げちゃダメ……逃げちゃ、ダメ……！","zh":"不能逃、不能逃……绝对不能逃……！"},{"label":"活动任务1","jp":"どんな時でも……ミッションは大事、ですから……。","zh":"无论何时……任务都很重要，所以……。"},{"label":"活动任务2","jp":"どうして、こんなことに……。","zh":"为什么会变成这样呢……。"},{"label":"活动任务3","jp":"もう少し、話せたら……。よかったのに……。","zh":"如果能再多说说话……就好了……。"},{"label":"活动任务4","jp":"わたしにできることがあれば……。いつでも、言ってください……！","zh":"如果有我能做到的事……请随时告诉我……！"},{"label":"活动任务获取1","jp":"ゲームシステムだったら、こう言うと思います。ミッションクリア！\nえへへっ……これを言ったら、少し緊張が解けた気がします。","zh":"如果是游戏系统的话，这时候一定会说：任务完成！\n嘿嘿……说出这句话，感觉稍微没那么紧张了。"},{"label":"活动任务获取2","jp":"先生は……怖くないですか？……わたしは、先生がいるから……もう少し頑張ってみます。","zh":"老师……您不会害怕吗？……我因为老师在……所以想再努力看看。"},{"label":"活动任务每日结束","jp":"お疲れ様、でした…さすが先生です。","zh":"辛苦您了……不愧是老师呢。"},{"label":"活动商店1","jp":"うぅ……なんだか怖いです……ううう……。\n先生……わたしのこと、忘れませんよね……？","zh":"呜……总觉得好害怕……呜呜……。\n老师……您不会忘记我的，对吧……？"},{"label":"活动商店2","jp":"わたしにできることを、したいのに……。\nみなさん、すごい方ばかりで……。","zh":"明明想要做力所能及的事……。\n大家却都那么厉害……。"},{"label":"活动商店登陆1","jp":"い、いらっしゃいませ、先生……。","zh":"欢、欢迎光临，老师……。"},{"label":"活动商店登陆2","jp":"お店みたいな場所……にしては、どこかさみしいような。","zh":"虽然说是像店铺一样的地方……却总觉得有些冷清呢。"},{"label":"活动商店购买1","jp":"あっ、はい……！そちら、ですね……！","zh":"啊，好的……！是那个，对吧……！"},{"label":"活动商店购买2","jp":"店員さんっぽく……店員さんっぽく……。\nいつもありがとうございます！","zh":"要像个店员一样……要像个店员一样……。\n感谢您的惠顾！"},{"label":"活动商店购买3","jp":"は、はい……こちら、どうぞ……。","zh":"好、好的……请您拿好……。"},{"label":"活动商店购买4","jp":"ど、どうかこれが……。\nみなさんの……役に立ちますよう、に……。","zh":"但、但愿这能……。\n对大家……有所帮助……。"},{"label":"carrier_monolog_1","jp":"隠れられる場所……ないかな……？","zh":"有没有……可以躲起来的地方呢……？"},{"label":"carrier_monolog_2","jp":"ここにもゲーム機が……。","zh":"这里也有游戏机啊……。"},{"label":"carrier_monolog_3","jp":"もう……降りるのは、いやです……。","zh":"已经……不想再空降了……。"},{"label":"carrier_monolog_4","jp":"先生は……こんな敵と、戦ってきたのですね……。","zh":"老师……一直在跟这样的敌人战斗吗……。"},{"label":"carrier_monolog_5","jp":"リオ会長も、ヒマリ先輩も……すごいです……。","zh":"莉音会长还有日鞠前辈……都好厉害啊……。"},{"label":"carrier_select_1","jp":"や、やっぱり、ロッカーの外は危険……。","zh":"果、果然，储物柜外面很危险……。"},{"label":"carrier_select_2","jp":"（どんなゲームがダウンロードされてるんだろ……？）","zh":"（下载了什么游戏呢……？）"},{"label":"carrier_select_3","jp":"先生……一緒にいて、くれますよね……？","zh":"老师……会陪着我的，对吧……？"},{"label":"carrier_select_4","jp":"なんだか先生といると……怖くありません……えへへ……。","zh":"总觉得和老师在一起的话……就没那么害怕了……嘿嘿……。"},{"label":"carrier_select_5","jp":"いろいろ、教えてもらっていますが……分かるような、分からないような……。","zh":"虽然您教了我很多……但我好像懂又好像不太懂……。"}]},"stats":{"init":[{"name":"攻击力","value":"295"},{"name":"防御力","value":"99"},{"name":"生命值","value":"3328"},{"name":"治愈力","value":"1984"},{"name":"命中值","value":"786"},{"name":"闪避值","value":"190"},{"name":"暴击值","value":"262"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1090"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700%"}],"max":[{"name":"攻击力","value":"6947"},{"name":"防御力","value":"544"},{"name":"生命值","value