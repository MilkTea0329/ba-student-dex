230.html"},{"name":"NPC 桃井（冬装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/436639.png","url":"https://www.gamekee.com/ba/647098.html"},{"name":"NPC 桃井（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_303/h_301/829/191981/2026/0/18/473378.png","url":"https://www.gamekee.com/ba/690647.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive"},{"label":"卡池抽取","jp":"これから、すっごく面白い物語が始まるよ！","zh":"超~级有趣的故事即将开始咯~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえり、先生！早く任務を始めよう！","zh":"老师你来啦~快点开始做任务吧！"},{"label":"登陆2","jp":"準備完了！行こう、先生！次のクエストをクリアしに！","zh":"准 备 完 毕 ~\n老师快走，去完成下一个任务吧！"},{"label":"大厅1","jp":"ゲームを楽しめる人とゲームが上手い人は別なことも多いよ。\n先生はどっち？","zh":"喜欢游戏和擅长游戏的人还挺不一样的\n老师属于哪一种呢？"},{"label":"大厅2","jp":"あっ！今日新作のゲームの発売日だった！","zh":"啊，今天有新的游戏要发售来着！"},{"label":"大厅3","jp":"元々今日はレイドに行こうと思ってたのに！\n当番になっちゃうなんて……！\n·……まぁ、こっちも好きだからいいけど。","zh":"本来今天想去打团队副本的，怎么偏偏轮到我值日啊……\n唉，算啦~值日……我也挺喜欢的"},{"label":"大厅4","jp":"先生！任務とかは後でいいからとりあえずゲームしに行こう！","zh":"老师！任务什么的以后再做，先去玩游戏吧！"},{"label":"大厅5","jp":"先生はいいな……。欲しいゲームがあったらいつでも買えるんでしょ？","zh":"真羡慕老师啊……老师想买什么游戏都可以随便买吧？"},{"label":"回忆大厅1","jp":"見て、先生！こっち側のスタンプ、全部集められたよ！これでクエストクリア、だね！やった！","zh":"老师你快看！这里面的图章我已经全部盖满了！\n这样的话，任务就通关啦！对吧？耶——"},{"label":"回忆大厅2","jp":"最初どうなるかと思ったけど……。やっぱり先生と私、相性バッチリだね！","zh":"一开始还以为绝对不可能完成……\n果然老师和我两个，就是完美的搭档啊"},{"label":"回忆大厅3","jp":"って、うわぁっ！？先生？汗まみれじゃん！大丈夫？","zh":"啊……啊？老师？？\n你怎么满头大汗啊，没事吧？"},{"label":"回忆大厅4","jp":"あはっ、大丈夫なら良かった。今日も先生のおかげで、すっごく楽しかったよ！","zh":"啊哈哈，没什么事情那就好，今天真的多亏了老师，玩的超级开心"},{"label":"回忆大厅5","jp":"もしまたこういうイベントがあったら、その時もまた、一緒に参加しようね、先生！","zh":"如果下次还有这样子的活动\n那么到时候，我们再两人一起参加吧，老师！"},{"label":"咖啡馆1","jp":"あっ！唐突に良いシナリオのアイデアが浮かんだ！","zh":"啊，突然想到了一个不错的剧情！"},{"label":"咖啡馆2","jp":"やった！クリア！！","zh":"好耶~通关~"},{"label":"咖啡馆3","jp":"ゲーム～ゲ～ム～ゲームがやりたい～","zh":"游戏~游戏~我想玩游戏~"},{"label":"咖啡馆4","jp":"あれ？これちっちゃい時にやったあのシリーズじゃん！？","zh":"诶？这不是我小时候玩过的那个系列吗？"},{"label":"咖啡馆5","jp":"うーん、これじゃ部員たちのおやつ代が足りない。アルバイトでもしようかな。","zh":"嗯……开发部的零食钱快要不够了，要不去打个工吧？"}],"好感度":[{"label":"好感度1","jp":"私の好感度を上げたいなら、新作のゲームをも～っと買って！","zh":"想提高我的好感度……那就多买点新游戏吧！"},{"label":"好感度2","jp":"な…なんて伏線……！このまま行ったらどうなっちゃうんだろう。","zh":"竟然还有这种伏笔？这样下去到底会变成什么样啊？"},{"label":"好感度3","jp":"あれ？もしかして今フラグ……。ち、違う！立ってない！","zh":"啊？刚才的难道是flag？啊，不行，不许立！"},{"label":"好感度4","jp":"最高のゲームを作るためには、やっぱり色んな経験が必要なの。…恋愛経験も、ね？","zh":"看来要做出最好的游戏，必须要积累各种各样的经验，\n应该……也包括……恋爱……经验吧？"}],"战斗":[{"label":"编入队伍1","jp":"任せてよー！","zh":"交给我吧！"},{"label":"编入队伍2","jp":"さぁ、私の番か！","zh":"好，轮到我啦~"},{"label":"拎起","jp":"ひゃぁ！？ちょっ、これじゃぁゲームできないじゃん！","zh":"啊，哎呀，这样我没法玩游戏啦！"},{"label":"任命队长1","jp":"早く終わらせてかーえろ！","zh":"快点搞定回去吧~"},{"label":"任命队长2","jp":"私のエイムを見せてあげる！","zh":"让你看看我的枪法！"},{"label":"普通技能","jp":"私……もう怒ったんだから！","zh":"我生气啦！"},{"label":"EX动画1","jp":"よしこのまま……えっ！？ううーっ許せなーい！","zh":"好……就这样！\n啊……饶不了你！"},{"label":"EX动画2","jp":"へぇー面白っ……えっ！？死んだ！？信じられなーい！","zh":"诶……真有意……\n啊？似了？太离谱了吧！"},{"label":"EX动画3","jp":"私の勝ち……えっ！？負けたじゃん！？もー！","zh":"我赢……啊？怎么输了？\n气死我啦！"},{"label":"EX技能1","jp":"アイス奢らなきゃいけなくなったじゃん！あなたたちのせいだよー！","zh":"这下我得请冰激凌了呀……都怪你们！"},{"label":"EX技能2","jp":"悔しいっ……悔しいーーっ！","zh":"不甘心……我不甘心！"},{"label":"EX技能3","jp":"私の怒りの弾丸を食らえ！","zh":"吃我这愤怒的子弹吧！"},{"label":"战斗开始1","jp":"うーん……パッドでの操作だったら自信あるんだけど……","zh":"嗯……要是能用手柄打的话我就有自信了"},{"label":"战斗开始2","jp":"勝利へのシナリオが見えた！","zh":"我已经看到胜利的剧本啦！"},{"label":"获得BUFF","jp":"ありがとう！","zh":"谢谢！"},{"label":"施放BUFF","jp":"いやーー！","zh":"呀——！"},{"label":"掩体","jp":"隠れるところ見つけ！","zh":"找到掩体了！"},{"label":"被CC1","jp":"いたいー！","zh":"疼死了"},{"label":"被CC2","jp":"助けてー！","zh":"救人呐！"},{"label":"被CC3","jp":"許せない……！","zh":"饶不了你！"},{"label":"回避","jp":"無駄だよ～","zh":"没用的哟~"},{"label":"队伍移动1","jp":"ここはクリア。","zh":"这里通关了。"},{"label":"队伍移动2","jp":"次のステージへ、前進！","zh":"前往——下一个关卡！"},{"label":"回复","jp":"体力ゲージはいつも、注意深く確認しておかなきゃね！","zh":"要随时关注体力槽哦！"},{"label":"中途退出","jp":"攻略本……読んでおけばよかった……","zh":"要是以前看过攻略就好了……"},{"label":"战斗喊叫","jp":"えぃー！","zh":"嘿！"},{"label":"战斗喊叫","jp":"喰らえ！","zh":"看招！"},{"label":"战斗喊叫","jp":"行くよ！","zh":"瞄准啦！"},{"label":"特殊载具","jp":"レトロこそ、真の最先端だよ！","zh":"复古游戏才是真正的潮流前线啊！"},{"label":"特殊载具","jp":"今からこのゲームはロボットものになるよ！","zh":"从现在开始，这个游戏要变成机器人游戏了！"},{"label":"角色移动","jp":"こっちに行こう！","zh":"前往那边！"},{"label":"战斗胜利1","jp":"クリア！次のステージへ！","zh":"通啦~前往下一关！"},{"label":"战斗胜利2","jp":"私たちの勝利！","zh":"我们胜利啦！"},{"label":"关卡完成1","jp":"これぐらいなら難易度はez（イージー）って感じだね。","zh":"感觉这个难度应该是easy吧~"},{"label":"关卡完成2","jp":"クリア！","zh":"通关！"},{"label":"战斗失败1","jp":"先生、諦めないで。リトライしよう！","zh":"老师，不要放弃，重开一把！"},{"label":"战斗失败2","jp":"あー、もうー、クソゲーじゃん！","zh":"啊——什么烂游戏啊！"}],"成长":[{"label":"升级1","jp":"経験値をもっともらえるようにして！","zh":"再多给我点经验值！"},{"label":"升级2","jp":"レベルアップっていつもときめく瞬間だよね！","zh":"每次升级，都是一个让人心跳的瞬间呢！"},{"label":"升级3","jp":"もっと強くなりたい！そうすれば、皆を守れるお姉ちゃんになれるから！","zh":"我想变得更强，那样，就能成为一个保护大家的好姐姐啦！"},{"label":"升级4","jp":"これからの私の火力、ハンパじゃないよ！","zh":"以后我的火力可就不是闹着玩的啦！"},{"label":"获得专武","jp":"こ……これが……私の専用装備！\nこれで私も、超強化型JK！","zh":"这……这就是我的专用装备？\n这样一来，我也是超强化型JK了！"}],"事件":[{"label":"学生生日","jp":"先生！今日は私とミドリの誕生日なの！一緒にできる2人用ゲーム買って～。","zh":"老师！今天是我和小绿的生日！买个双人合作游戏嘛～"},{"label":"老师生日","jp":"先生！お誕生日おめでとう！今日はゲーム開発部のみんなと一緒に美味しいもの食べに行こう！","zh":"老师！生日快乐！\n今天跟我们游戏开发部的大家一起去吃好吃的吧！"},{"label":"万圣节","jp":"わあ！ハロウィンだ！なんだかワクワクする！先生！早く飴ちょうだい！","zh":"哇~万圣节！总觉得好兴奋啊！\n老师！快点给我糖！"},{"label":"新年","jp":"ハッピーニューイヤー！今年も楽しくゲームやろ！","zh":"happy new year~\n今年也开心的玩游戏吧！"},{"label":"圣诞节","jp":"クリスマスか……うーん、先生が赤い服を着て、ゲーム機をプレゼントしてくれたら最高のクリスマスなのに！","zh":"圣诞节呀……\n啊，要是老师穿上红衣服送我游戏机，那就是最棒的圣诞节了"},{"label":"春节","jp":"","zh":"老师！新春快乐！\n今年会出什么有趣的新游戏呢？我已经等不及啦！"},{"label":"中秋","jp":"","zh":"中秋节，当然要和家人团聚啦~\n我和小绿打算一起吃月饼打游戏，老师要一起来吗？"}]},"stats":{"init":[{"name":"攻击力","value":"233"},{"name":"防御力","value":"20"},{"name":"生命值","value":"2426"},{"name":"治愈力","value":"1465"},{"name":"命中值","value":"681"},{"name":"闪避值","value":"821"},{"name":"暴击值","value":"194"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1436"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"5593"},{"name":"防御力","value":"113"},{"name":"生命值","val