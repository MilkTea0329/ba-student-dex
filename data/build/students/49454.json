/829/72324/2025/5/13/924645.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 艾米（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/13/578103.png","url":"https://www.gamekee.com/ba/607106.html"},{"name":"★3 艾米（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_235/h_235/829/191981/2026/0/18/606166.png","url":"https://www.gamekee.com/ba/690663.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"今から何をすればいい？\n教えて、先生。","zh":"接下来，我需要做什么呢？老师，告诉我吧。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生。待ってたよ。","zh":"老师，我一直在等你哦。"},{"label":"登陆2","jp":"…あれ、先生？いつ来た？","zh":"诶，老师？什么时候来的啊。"},{"label":"大厅1","jp":"特異現象捜査部のエイミ。待機中。","zh":"我是超自然现象调查部的艾米，正在待命。"},{"label":"大厅2","jp":"所構わず脱ぐなって、何回も指摘された。\n暑い時は体温調節をするのが自然な行動なのに、皆どうしたのかな。","zh":"经常有人批评我，让我不要随地脱衣服。热的时候就要调节体温不是很自然的行为吗？不知道大家……为什么要这样呢。"},{"label":"大厅3","jp":"ここ少し暑くない？","zh":"你不觉得……这里很热嘛？"},{"label":"大厅4","jp":"感情がないってよく言われるけど。\nそれがどんな意味なのかよく分からない。","zh":"经常听别人说我没有感情……？但我不太清楚那是什么意思……"},{"label":"大厅5","jp":"学校、無事に卒業できるのかな…。","zh":"我到底……能不能顺利毕业啊……？"},{"label":"回忆大厅1","jp":"先生、この服はどう？似合ってる？","zh":"老师，你看这件怎么样？好看嘛？"},{"label":"回忆大厅2","jp":"下着も服の一種だから、別に人に見せてもいいんじゃないのかな。","zh":"这不也是衣服的一种嘛？稍微给别人看个一眼两眼的，也没什么关系吧？"},{"label":"回忆大厅3","jp":"この下着、私にはちょっと小さそう…。もっと大きいサイズはないのかな。","zh":"这件衣服，对我来说好像有点小了……难道这里，已经没有更大的尺寸了吗？"},{"label":"回忆大厅4","jp":"うーん…ダメ。\nやっぱり着替えて、直接着てる姿を見せてあげる。","zh":"嗯……不行，还是等换好了之后，直接让你看我穿在身上的效果吧。"},{"label":"回忆大厅5","jp":"うん…？ここで着替えちゃダメ？\n更衣室は狭くて面倒なのに…。","zh":"嗯……？不能在这个地方换吗……？可是更衣室太窄了，不方便……"},{"label":"咖啡馆1","jp":"美しい空間だね。実はよく分かってないけど。","zh":"这地方好漂亮，但我其实也不太懂……"},{"label":"咖啡馆2","jp":"ふーん…。","zh":"嗯……？"},{"label":"咖啡馆3","jp":"ここでなら服を脱いでも…ダメ？","zh":"在这个地方，应该可以脱……不行嘛？"},{"label":"咖啡馆4","jp":"最近はこういうのが流行なんだ。","zh":"原来最近，流行这种啊……"},{"label":"咖啡馆5","jp":"何でだろう。なんか、ときめいた。","zh":"为什么呢……？不知道怎么了，有点心动。"}],"好感度":[{"label":"好感度1","jp":"先生になら。私の背中を任せてもいい","zh":"把身后交给老师，我很放心。"},{"label":"好感度2","jp":"私の銃に興味ある？","zh":"对我的枪，有兴趣嘛？"},{"label":"好感度3","jp":"先生の言うことは、理解しやすいから好き","zh":"老师说的话，很好懂。喜欢老师。"},{"label":"好感度4","jp":"先生を守ることは、私の任務だから","zh":"保护老师，就是我的任务。"}],"战斗":[{"label":"编入队伍1","jp":"…新しい任務？","zh":"有新任务……？"},{"label":"编入队伍2","jp":"いいよ。任せて。","zh":"好，交给我吧。"},{"label":"拎起","jp":"うーーーーーん","zh":"嗯……？"},{"label":"任命队长1","jp":"私の出番かな","zh":"该我上了吧？"},{"label":"任命队长2","jp":"皆を制圧すればいいのか？","zh":"全部压制住就行了吗……？"},{"label":"普通技能","jp":"敵、発見","zh":"发现，敌人。"},{"label":"EX动画1","jp":"インタプリタ起動。解析開始","zh":"解释器启动，开始分析。"},{"label":"EX动画2","jp":"行動を再解析。敵を完了","zh":"重新分析代码，应用完成。"},{"label":"EX动画3","jp":"パタン分析中。","zh":"正在，分析模式。"},{"label":"EX技能1","jp":"ディフェンスモード転換","zh":"转换为，防御模式。"},{"label":"EX技能2","jp":"苦しむのは慣れている","zh":"痛苦……我已经习惯了。"},{"label":"EX技能3","jp":"敵を完了。もう大丈夫","zh":"应用完成，现在没事了。"},{"label":"战斗开始1","jp":"戦闘、開始","zh":"战斗，开始。"},{"label":"战斗开始2","jp":"突入する","zh":"准备冲锋。"},{"label":"获得BUFF","jp":"支援、充分受け取った","zh":"支援收到，已经足够了。"},{"label":"施放BUFF","jp":"全力で行く","zh":"我会尽全力。"},{"label":"被CC1","jp":"-","zh":"……！"},{"label":"被CC2","jp":"-","zh":"……！"},{"label":"被CC3","jp":"-","zh":"呃啊……！"},{"label":"回避","jp":"無駄","zh":"没用。"},{"label":"队伍移动1","jp":"これで……終わり？","zh":"这样……就完啦？"},{"label":"队伍移动2","jp":"次の敵はどこ？","zh":"下一个敌人在哪儿？"},{"label":"回复","jp":"えっ……ありがとう","zh":"啊，谢谢。"},{"label":"中途退出","jp":"私は……ここまで……","zh":"我……到极限了……"},{"label":"战斗喊叫","jp":"-","zh":"……！"},{"label":"战斗喊叫","jp":"照準","zh":"瞄准。"},{"label":"战斗喊叫","jp":"打つ","zh":"射击。"},{"label":"角色移动","jp":"移動する","zh":"继续前进。"},{"label":"战斗胜利1","jp":"結果が導き出せた？","zh":"结算完成了吗？"},{"label":"战斗胜利2","jp":"私たちの勝利","zh":"我们赢啦。"},{"label":"关卡完成1","jp":"効率的な指示だった。先生","zh":"老师的指挥，很有效率。"},{"label":"关卡完成2","jp":"作戦終了。他の指示は？","zh":"行动结束。还有指示吗？"},{"label":"战斗失败1","jp":"作戦失敗。再編成を","zh":"行动失败……重新编队……！"},{"label":"战斗失败2","jp":"違う作戦に調整してみるのはどうかな","zh":"试一下别的行动如何……？"}],"成长":[{"label":"升级1","jp":"これも戦闘に必要なことだよね","zh":"这也是战斗必需的吧。"},{"label":"升级2","jp":"私にもっとたくさん教えて","zh":"再多教教我吧。"},{"label":"升级3","jp":"どんな訓練をすればいいのかな","zh":"应该怎么训练才好呢？"},{"label":"升级4","jp":"成長してる","zh":"我会继续成长的。"},{"label":"获得专武","jp":"初心者にも使いやすい……\n多目的戦術施行道具。","zh":"初学者也能轻松使用的，多用途战术执行工具。"}],"事件":[{"label":"学生生日","jp":"誕生日…？あ、そういえばそんなのがあったね。\n別に祝ってくれなくていいよ。大した意味もないし。\nうん？それでも祝ってくれるなら…あ、ありがとう…。","zh":"生日……？啊，好像是有这么个日子啊。不用特地祝福我啦，因为对我来说，没什么意义。嗯……？你非要祝福我的话……那，那就谢谢啦。"},{"label":"老师生日","jp":"今日が先生の生まれた日なの？\nうん。そしたら幸せな日だね。\n今日がなかったら、先生に会うこともできなかったから。","zh":"今天是老师出生的日子吗？嗯，那今天，应该就是我的幸运日吧。要是没有今天，我就不会遇到老师啦。"},{"label":"万圣节","jp":"ハロウィンに飴をあげないと、どんないたずらをされるんだろう…？","zh":"万圣节如果不给糖，会遇到什么样的恶作剧呢……？"},{"label":"新年","jp":"昨日と変わらない、ただの平凡な一日なのに。\n新鮮な気持ちになるのは不思議なことだね？\nうん。ハッピーニューイヤー。","zh":"今天其实和昨天一样，只是普通的一天。但却感觉哪里不太一样，很不可思议对吧。嗯，新年快乐~"},{"label":"圣诞节","jp":"今日は特別な日だと聞いたけど、どうして 恋人たちにも特別な日なの？\n教えて、先生。","zh":"我听说今天是个特别的日子，但为什么对情侣来说，也是特别的日子呢？老师，教教我吧。"},{"label":"春节","jp":"","zh":"只是年份的变更而已，大家为什么会这么开心呢？……不过，倒也不坏。"},{"label":"中秋","jp":"","zh":"虽然我不太明白，但和老师一起看着天上的月亮，我的内心，似乎也平静下来了。"}],"活动":[{"label":"活动任务1","jp":"この服……寒くないかって？\nんー、風通しがいいから私は好きだよ。","zh":"你是问……这么穿冷不冷？嗯……这样穿很透气，我挺喜欢的。"},{"label":"活动任务2","jp":"この服は涼しいけど、薬莢がよく服の中に入ってくるから……困る。","zh":"虽然这件衣服开口很多很凉快，但也容易让弹壳掉进去。唔……真头疼。"},{"label":"活动任务登录1","jp":"帰ってきたんだね、先生。\nまた会えてうれしい。","zh":"你回来啦，老师！能再见到你真开心。"},{"label":"活动任务登陆2","jp":"はう……眠い……。","zh":"嗯啊……好困。"},{"label":"活动任务获取1","jp":"思ってたより………早く終わった。","zh":"这么快……就结束了呀。"},{"label":"活动任务获取2","jp":"証明完了。","zh":"证明完毕。"}]},"stats":{"init":[{"name":"攻击力","value":"138"},{"name":"防御力","value":"183"},{"name":"生命值","value":"3434"},{"name":"治愈力","value":"1609"},{"name":"命中值","value":"586"},{"name":"闪避值","value":"234"},{"name":"暴击值","value":"195"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2044"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"8 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"3091"},{"name":"防御力","value":"2789"},{"name":"生命值","value":"128501"},{"name":"治愈力","value":"7091"},{"name":"命中值","value":"586"},{"name":"闪避值","value":"234"},{"nam