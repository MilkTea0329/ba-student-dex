66988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/13/615313.png","name":"窃听装置14号","desc":"小玉所制作的装有窃听器的巧克力。完全感觉不出有想隐藏的意思"},"ability":{"attrs":[{"name":"生命值","value":"766"},{"name":"攻击力","value":"64"},{"name":"治愈力","value":"226"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/13/395308.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/13/191017.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 小玉（野营）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/13/980536.png","url":"https://www.gamekee.com/ba/609145.html"},{"name":"NPC 小玉（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/191981/2025/6/23/442864.png","url":"https://www.gamekee.com/ba/643791.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"ミレニアム学園、音瀬コタマ。先生の声が聞こえたので、ここに来ました。","zh":"我是千禧年的音濑小玉。因为听到了老师的声音，所以就来这里了。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"来ましたか。足音でもう先生だと分かっていました。","zh":"您来了……我只听脚步声，就知道是老师了。"},{"label":"登陆2","jp":"ビクッ…いきなり来られたので、キャア、と悲鳴をあげるところでした。","zh":"诶！您来的这么突然，吓得我差点【哎呀】一声叫出来。"},{"label":"大厅1","jp":"先生の通話記録は女子高生の名前で溢れていますね。\n説明を要請します。","zh":"老师的通话记录里……全都是一些女生的名字呢！……请老师解释一下。"},{"label":"大厅2","jp":"…犯罪？何のことでしょうか。盗聴は犯罪ではありません。","zh":"违规……？您在说什么呢。窃听可不算是违规哦。"},{"label":"大厅3","jp":"先ほど、先生のSNSのアカウントに上がった内容について説明してくださいますか？","zh":"刚才……老师在社交网络上的私密账号上发布的内容……能解释一下吗？"},{"label":"大厅4","jp":"先生、良かったら歌を歌ってくれませんか？\nこの録音機に向かって。","zh":"老师，您能不能唱一首歌给我听听？对着这个录音机。"},{"label":"大厅5","jp":"どこかで先生を探す少女たちの声が聞こえます。\n…無視しましょう。","zh":"不知道从哪里传来了一群女孩子正在找老师的声音……还是无视好了。"},{"label":"回忆大厅0","jp":"","zh":"（哼歌）"},{"label":"回忆大厅1","jp":"…あっ、先生。\nすみません…夢中になっていて、気がつきませんでした。","zh":"……啊、老师。\n抱歉……我听入迷了， 没注意到您。"},{"label":"回忆大厅2","jp":"これ、ですか？\n…ふふっ。せっかくですし、先生も聞いてみますか？","zh":"您说，这个吗？\n……呵呵，机会难得， 老师要不也听听看？"},{"label":"回忆大厅3","jp":"はい。これは音楽ではなく、カフェにいる人たちの会話や\n音が収録された、いわゆる「環境音」です。","zh":"嗯，这不是音乐， 而是咖啡馆里的说话 声和周围的其他声音。也就是所谓的“环境音”。"},{"label":"回忆大厅4","jp":"リズムもメロディーもありませんが…\n耳を澄ませていると、様々な音や声が聞こえてきます。\n人々が織りなすこの音色が、私にとってはなぜだか、どんな音楽よりも、\n心に響いて…。","zh":"虽然没有节奏和旋律……但是认真去听的话， 就能听到很多与人相关的声音。\n这种人与人交织出的日常声音， 对我来说比什么音乐都更令我 着迷。"},{"label":"回忆大厅5","jp":"いつまでも、聴いていたくなるんです。","zh":"感觉能一直听下去。"},{"label":"咖啡馆1","jp":"カフェの新作デザートをチェック…個人用ブログにアップロード…。","zh":"确认咖啡厅的新款甜点……上传至私人博客！"},{"label":"咖啡馆2","jp":"モモフレンズの新作グッズ…キタコレ…。","zh":"Momofriends的新款周边……大的要来了！"},{"label":"咖啡馆3","jp":"このカフェには盗聴機が…ふむ、なるほど…。","zh":"信号的接收状态有点不稳定……"},{"label":"咖啡馆4","jp":"電波の受信状態が不安定です。","zh":"这个咖啡厅里有没有窃听器呢……？嗯……原来如此。"},{"label":"咖啡馆5","jp":"おかしいですね。先生のGPS情報がこの付近で捕捉されたのに…","zh":"奇怪……老师的卫星定位明明显示就在附近……"}],"好感度":[{"label":"好感度1","jp":"心拍数上昇、血流加速、体温上昇、原因は、不明…。","zh":"心率加快，血流加速，体温升高……原因……不明……"},{"label":"好感度2","jp":"今まで先生と交わした全ての会話は録音してあります。\nもしかして……聴きたいですか？","zh":"目前为止，我和老师之间的所有对话，我都录下来了。也许……您会想听听？"},{"label":"好感度3","jp":"先生の声は、私にとって音楽と同じです。私の心を高揚させますから。","zh":"老师的声音对我来说，就像音乐一样。因为它会振奋我的心情。"},{"label":"好感度4","jp":"確信…しました。先生は私にとって特別です。","zh":"我现在确信了……老师对我来说，很特别！"}],"战斗":[{"label":"编入队伍1","jp":"素晴らしい判断です。","zh":"很好的决定。"},{"label":"编入队伍2","jp":"適切な選択だと考えます","zh":"我认为，这是正确的选择。"},{"label":"拎起","jp":"受信状態、良好。","zh":"通信状态，良好"},{"label":"普通技能","jp":"あなたの狙いは、すべて把握しました。","zh":"你所有的企图，我都了如指掌。"},{"label":"EX动画1","jp":"傍受開始。","zh":"监听开始。"},{"label":"EX动画2","jp":"しっ！傍受を開始します。","zh":"嘘。要开始监听了！"},{"label":"EX动画3","jp":"私の耳はごまかせません。","zh":"什么都骗不过我的耳朵。"},{"label":"EX技能1","jp":"キャッチ。","zh":"抓到了。"},{"label":"EX技能2","jp":"見つけました。","zh":"找到了。"},{"label":"EX技能3","jp":"エンカウント、リンクします。","zh":"已遭遇。准备连接。"},{"label":"战斗开始1","jp":"戦闘を開始します。","zh":"战斗开始。"},{"label":"战斗开始2","jp":"作戦開始。敵を探知します。","zh":"作战开始，搜索敌人。"}],"成长":[{"label":"升级1","jp":"この調和された力は…まるで洗練されたオーケストラのようですね。","zh":"这种和谐的力量……就像一支配合完美的管弦乐队。"},{"label":"升级2","jp":"これで私はもっと強くなりました。試してもらっても構いません。","zh":"这样，我就变得更强了。您尽可以试试看。"},{"label":"升级3","jp":"この滑らかな旋律…もっと聴きたいです！","zh":"这流畅的旋律……我还想听到更多！"},{"label":"升级4","jp":"これでもっとよく聞こえます。先生の心拍の音まで。","zh":"这样，就能听的更清楚了！就连老师的心跳声也听得到……"},{"label":"获得专武","jp":"ヘルツ調整中……よく聞こえてますか？","zh":"正在调整赫兹数……能听清楚吗？"}],"事件":[{"label":"学生生日","jp":"誕生日…祝ってくださってありがとうございます。\n今日もらった数多くのお祝いの中で、先生の声でのお祝いが、私には一番価値のある言葉でした。","zh":"谢谢你，祝我生日快乐！我今天收到了那么多的祝福，但老师亲口对我说的祝福，对我来说，是最有价值的一句话！"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。もう何度も同じことを聞いてると思いますが…。\nお祝いの言葉は、どれだけ繰り返し言っても価値の下がらない、完璧な言葉の一つです。","zh":"祝您生日快乐，老师！虽然这句祝福您可能已经听了很多遍了，但祝福无论说多少次，意义都不会减少，是最完美的话语之一！"},{"label":"万圣节","jp":"ハロウィーンのお化けが出すラップ音はどんな音なんでしょうか。\n機会があればぜひ一度盗聴…いや、録音してみたいです。","zh":"万圣节的妖怪发出的那种有节奏的声音，到底是什么样啊？如果有机会，我一定要窃听……不对，录个音听听。"},{"label":"新年","jp":"新年はどんな音よりも、もっとたくさん先生の声を聞きたいです。","zh":"新的一年我最想听的不是别的声音，而是老师的声音。"},{"label":"圣诞节","jp":"クリスマスに傍受装置へ耳を澄ませていると様々な面白い話が聞けます。\n例えば…恋人たちの甘いささやきとか。","zh":"圣诞的时候，仔细听听监听装置，可以听到很多有意思的东西。比如说……情侣间甜蜜的悄悄话。"},{"label":"春节","jp":"","zh":"我听到了象征新春开始的钟声。老师，您要听听看嘛？"},{"label":"中秋","jp":"","zh":"如果把窃听器放进月饼里的话……嗯，似乎可行。"}]},"stats":{"init":[{"name":"攻击力","value":"140"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2245"},{"name":"治愈力","value":"1612"},{"name":"命中值","value":"100"},{"name":"闪避值","value":"1101"},{"name":"暴击值","value":"200"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1145"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4103"},{"name":"防御力","value":"109"},{"name":"生命值","value":"46960"},{"name":"治愈力","value":"10950"},{"name":"命中值","value":"100"},{"name":"闪避值","value":"1101"},{"name":"暴击值","value":"350"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值"