"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/217228.png","name":"大人的蘭姆夾心巧克力","desc":"添加蘭姆酒，香氣濃郁的夾心巧克力。對學生來說這個味道或許還太早了。當然，對旬來說也一樣"},"ability":{"attrs":[{"name":"生命值","value":"879"},{"name":"攻击力","value":"147"},{"name":"治愈力","value":"198"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/531697.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/348530.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"瞬（幼女）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/109167.png","url":"https://www.gamekee.com/ba/86656.html"},{"name":"雪玲(泳装)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_500/h_500/191981/2026/5/24/21663711mqrzl03w.png","url":"https://www.gamekee.com/ba/tj/709617.html"},{"name":"瞬","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/269505.png","url":"https://www.gamekee.com/ba/68522.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"訓育支援部梅花園の教官、シュンです。\nうちの子たちをよろしくお願いいたしますね、せ・ん・せ・い？","zh":"我是教育支援部【梅花园】的教官，瞬。我家的孩子，就拜托给您咯，老~师~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ、先生。お食事になさいますか、お風呂に入られますか？\nそれとも…授業？","zh":"您来啦，老师~您想先用餐呢，还是先入浴呢~或者……先工作？"},{"label":"登陆2","jp":"前回、途中で終わってしまった授業を再開しましょう、ふふ。","zh":"那么，就从上次课程中断的部分开始吧~呵呵~"},{"label":"大厅1","jp":"もう～、先生は私に甘えちゃダメですよ。\nでもたまにでしたら…大目に見てあげますよ？","zh":"老师真是的……不可以这样对我撒娇哦~嗯……只是偶尔的话，我可以不追究。"},{"label":"大厅2","jp":"ふふっ、今日もよろしくお願いいたしますね？","zh":"嗯哼哼~今天也要麻烦您多多照顾了~"},{"label":"大厅3","jp":"は～い、シュンですよ～","zh":"啊~我是瞬哦~"},{"label":"大厅4","jp":"いい子、いい子～","zh":"好孩子~好孩子~"},{"label":"大厅5","jp":"また触ると…\nこらっ、って叱っちゃいますよ？","zh":"您再碰我的话，我可要大声批评您了哦。"},{"label":"回忆大厅1","jp":"あら、おめざめになりましたか？","zh":"哎呀……您醒啦？"},{"label":"回忆大厅2","jp":"今日は本当に楽しかったです。","zh":"今天，我真的感觉非常开心。呵呵……"},{"label":"回忆大厅3","jp":"あら、もう子供たちが帰ってくる時間ですね。そろそろお仕事にお戻りなったほうが良いのでわ。","zh":"哎呀，现在这个时间，孩子们已经快要回来了吧。您是不是，差不多也应该回去工作了呢？"},{"label":"回忆大厅4","jp":"いえ、はやり、うへへ。もう少しゆっくりにしてください、先生。今日の授業は私が代わりますので。","zh":"啊……要不然，嘿嘿，还是在这多放松一会吧。老师，今天的工作我会替您完成的。"},{"label":"回忆大厅5","jp":"ああ、かわいい…","zh":"啊……真是可爱，嘿嘿。"},{"label":"咖啡馆1","jp":"あらまあ、カワイイ…","zh":"哎哟，真可爱~"},{"label":"咖啡馆2","jp":"ふふ、愛くるしいですね～","zh":"诶嘿嘿嘿，太讨人喜欢了。"},{"label":"咖啡馆3","jp":"ふふ、次はここへみんなを一緒に連れてきての授業にしましょうか？","zh":"诶嘿，下次就带大家来这里一起训练吧。"},{"label":"咖啡馆4","jp":"お昼寝の時間はまだなのに…なんだか眠くなってきました…","zh":"还没有到午睡的时间呢……可是总觉得有点困。"},{"label":"咖啡馆5","jp":"リンカはきちんと、子供たちの面倒を見られているでしょうか…","zh":"不知道凛华有没有好好照顾孩子们呢。"}],"好感度":[{"label":"好感度1","jp":"先生とご一緒していると、私もたまには子供みたいに甘えたくなります。","zh":"和老师在一起的时候，我偶尔也想像个孩子一样撒娇。"},{"label":"好感度2","jp":"先生は本当に特別な方ですね。生徒たちにとっても私にとっても。","zh":"老师……真的是个很特别的人呢。无论是对孩子们来说，还是对我来说。"},{"label":"好感度3","jp":"先生との授業、楽しみにしています。","zh":"我很期待，和老师一起上课。"},{"label":"好感度4","jp":"この瞬間が永遠に続くといいですね。","zh":"真希望此时此刻，能永远持续下去。"}],"战斗":[{"label":"编入队伍1","jp":"うっふふ。素晴らしい選択ですね。","zh":"诶嘿嘿，选的不错"},{"label":"编入队伍2","jp":"お姉さんにお任せください。","zh":"就交给姐姐吧~"},{"label":"拎起","jp":"あら？なにか、問題が？","zh":"哎呀……怎么了吗？"},{"label":"任命队长1","jp":"言うこと聞かない悪い子は、どこかなー？","zh":"不听话的坏孩子在哪里呀~"},{"label":"任命队长2","jp":"さぁー、かくれんぼスタートね！","zh":"来，开始捉迷藏啦~"},{"label":"普通技能","jp":"よいしょー！","zh":"嘿咻~"},{"label":"EX动画1","jp":"悪い子発見！","zh":"找到坏孩子了~"},{"label":"EX动画2","jp":"うふ、お姉さんがやるのをよく見ていてね。","zh":"诶嘿，要认真看姐姐的示范哦"},{"label":"EX动画3","jp":"これで終わらせてしまいましょう！","zh":"就这样结束吧~"},{"label":"EX技能1","jp":"めっ、ですよ？","zh":"这样，可不乖哟~\nEX技能2"},{"label":"EX技能2","jp":"バァン！","zh":"磅"},{"label":"EX技能3","jp":"バァーン！","zh":"磅~"},{"label":"战斗开始1","jp":"さあ、みんなでお散歩に行きましょうか！","zh":"来，大家一起去散步吧~"},{"label":"战斗开始2","jp":"みんなー、道に迷わないように気をつけてねー","zh":"小朋友们，注意不要迷路啊~"},{"label":"获得BUFF","jp":"お手伝いありがとうございます。","zh":"非常感谢您的帮助。"},{"label":"施放BUFF","jp":"さあ、ちょっとだけ本気で行きましょうか。","zh":"好，现在就稍微认真一点吧~"},{"label":"掩体","jp":"隠れます！","zh":"隐蔽起来~"},{"label":"被CC1","jp":"あら？","zh":"哎呀~"},{"label":"被CC2","jp":"んっ！","zh":"……"},{"label":"被CC3","jp":"あぁ…！","zh":"……！"},{"label":"回避","jp":"うふふ、そんないたずらは通用しませんよ？","zh":"诶嘿嘿，这种恶作剧对我可没用哟~"},{"label":"队伍移动1","jp":"みんなー、こっちよー。","zh":"小朋友们，来这边~"},{"label":"队伍移动2","jp":"道に迷わないように、気を付けてね。","zh":"当心不要迷路哦~"},{"label":"回复","jp":"あらありがとう。","zh":"哎呀，谢谢~"},{"label":"中途退出","jp":"これ以上は……ごめんなさい……","zh":"我没办法坚持了……对不起……"},{"label":"战斗喊叫","jp":"行きまーす！","zh":"我要开枪啦~"},{"label":"战斗喊叫","jp":"せーの。","zh":"一、二~"},{"label":"战斗喊叫","jp":"覚悟して","zh":"做好准备哟~"},{"label":"角色移动","jp":"場所を移動しまーす。","zh":"我们去下一个地方吧~"},{"label":"战斗胜利1","jp":"みんなご苦労様でした！","zh":"感谢大家的辛勤工作~"},{"label":"战斗胜利2","jp":"次からは仲良くするんですよ？","zh":"下次，我们要好好相处哦~"},{"label":"关卡完成1","jp":"えらいえらーい。みんなよくできました！","zh":"很棒很棒~大家都做的很好~"},{"label":"关卡完成2","jp":"よくできましたみんな。おうちに帰ったら復習するのを忘れないでね。","zh":"大家都干的很好~回家之后，别忘了复习哟。"},{"label":"战斗失败1","jp":"み、みんな、ケガはなかった？","zh":"啊，大家没有受伤吧！"},{"label":"战斗失败2","jp":"ごめんなさい……私の不注意でした。","zh":"对不起……都是因为我不够谨慎……"}],"成长":[{"label":"升级1","jp":"成長はいつも気持ちの良いことですね","zh":"成长，总是令人愉快呢。"},{"label":"升级2","jp":"体の隅々まで力が染み渡って、気分が高揚しますね～","zh":"力量，渗透到身体的每一个角落……感觉精神好振奋呢~"},{"label":"升级3","jp":"心も体も丈夫になりました～","zh":"身心，都更加强韧了~"},{"label":"升级4","jp":"子供達に教えるためには、私が率先して成長しないといけないでしょ","zh":"要教导孩子们，我应该先成长起来。对不对~"},{"label":"获得专武","jp":"これを使いたくはなかったのですけど……\nびしっとした愛のムチも、時には必要なのです。","zh":"虽然我不想用这个……但有的时候，爱的鞭策也是必要的。"}],"事件":[{"label":"学生生日","jp":"ふう…また一つ、年を取ってしまいましたね…\n私の年ですか？ふふ、秘密ですよ。","zh":"啊……年纪，又增长了一岁啊。啊，您问我的岁数吗？……哼哼，保~密~"},{"label":"老师生日","jp":"♪Happy birthday to you~♪Happy birthday to you~♪Happy birthday Dear Sensei~♪Happy birthday to you~♪","zh":"祝你生日快乐~祝你生日快乐~老师生日快乐~祝你生日快乐~"},{"label":"万圣节","jp":"あら、子供たちがどこかで飴をたくさん貰ってきたようですね。\nトリック…なんでしたっけ？","zh":"哎呀，孩子们不知道从哪里拿了这么多糖呢。嗯……不给糖……就怎么来着？"},{"label":"新年","jp":"ふふ、今年も一年、よろしくお願いしますね～。","zh":"嘿嘿，新的一年，也请老师多多关照啊。"},{"label":"圣诞节","jp":"しっ、先生。サンタの変装がバレないように気を付けてくださいね。\n子供たちの純粋な心は、何よりも大切なものなんですから","zh":"嘘，老师，请小心别让人发现圣诞老人是您假扮的哦。孩子们纯洁的心灵可是最珍贵的宝物。"},{"label":"春节","jp":"","zh":"新春快乐，老师。新的一年，无论是梅花园的孩子们，还是我，都还请您多多关照。"},{"label":"中秋","jp":"","zh":"玄武商会那边送来了一些月饼。梅花园的孩子们已经吃过了，剩下的，就由我和老师一起分享吧。嘿嘿"}]},"stats":{"init":[{"name":"攻击力","value":"393"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2495"},{"name":"治愈力","value":"1661"},{"name":"命中值","value":"908"},{"name":"闪避值","value":"201"},{"name":"暴击值","value":"252"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1980"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"20 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8633"},{"name":"防御力","value":"108"},{"name":"生命值","value":"48888"},{"name":"治愈力","value":"5913"},{"name":"命中值","value":"1128"},{"name":"闪避值","value":"201"},{"name":"暴击值","value":"1382"},{"name":"暴击伤害","value":"226%"},{"name":"稳定值","value":"1980"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"20 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"425"},{"name":"生命值","value":"1675"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Val