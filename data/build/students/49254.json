/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/79568.png","name":"安眠巧克力及安眠用具組合","desc":"椿為了因為總是過勞的老師所準備的安眠用具一式。想要更好睡的枕頭就和椿說一聲吧。平時購買的話合計3980元"},"ability":{"attrs":[{"name":"生命值","value":"2305"},{"name":"攻击力","value":"78"},{"name":"治愈力","value":"193"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/161994.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/130173.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 椿（导游）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/12/218317.png","url":"https://www.gamekee.com/ba/618557.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー…アーカイブ…","zh":"Blue...Archive...zzz"},{"label":"卡池抽取","jp":"夢かと思った、今この瞬間…。\nこんにちは。先生。これからよろしくね。","zh":"刚才有一瞬间，我还以为是在做梦……老师，你好~以后请多多关照啦~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ふぁ～。おはよう…先生。\nえ？朝じゃない？別にいいでしょ～","zh":"呃啊……早上好，老师！嗯……？已经不是早上啦……？……嗯，不要在意细节"},{"label":"登陆2","jp":"ふあ。先生…ごめん…\nもうちょっと寝る。先生も…ここに横になる？","zh":"嗯……老师，抱歉……我再多睡一会儿……要不，老师您也躺这儿~"},{"label":"大厅1","jp":"ふあー…あれ？先生。来てた？","zh":"呃啊……诶？老师，您来啦……？"},{"label":"大厅2","jp":"昼寝にちょうどいい時間なのに…\n一旦寝て起きたら、もっと仕事も捗るんじゃないかな？","zh":"现在正是睡午觉的时候啊……睡一觉起来，工作也会更有效率吧？"},{"label":"大厅3","jp":"夜に何をしてたらそんなに眠いのかって？\nふふっ。先生になら教えてあげようかな～","zh":"你问我昨天晚上干了什么今天这么困？……诶嘿嘿，看在老师的面子上，要不，我就告诉你吧？"},{"label":"大厅4","jp":"ふぁ…ん…。起きてから一番初めに会う人が先生だとは…いいね。","zh":"啊……嗯……睡醒起来第一个看见的人就是老师，真好~"},{"label":"大厅5","jp":"（このまま時間が止まってほしい。なんだか、すごく心地いい気持ち）","zh":"（真希望时间就这么停下来……感觉，真的好舒服啊~）"},{"label":"回忆大厅1","jp":"先生…来てくれたんだね…","zh":"老师……嗯……你来啦？"},{"label":"回忆大厅2","jp":"うん、今は修行中…。座禅をしてた…。","zh":"嗯……我正在……修行……坐禅呢……"},{"label":"回忆大厅3","jp":"居眠りしてたんじゃないの、って…？\n違うよ…。これも、れっきとした、修行の一環だから…。","zh":"你说我只是在打瞌睡……？才没有呢……这可是……正经的……修行的一个环节…"},{"label":"回忆大厅4","jp":"近場にこんな、修行にぴったりの場所があったなんて…。\n幸せ。まるで、夢を見てるみたいな気分…。\nこの幸せも、全部、先生のおかげなのかな…？","zh":"没想到附近还有这么适合修行的地方……真幸福~……感觉……像在做梦一样……我能这么幸福，也全是……因为有老师在吧……"},{"label":"回忆大厅5","jp":"ん…ほら、先生もそんなところにいないで、私と一緒に…。…寝よ？","zh":"嗯……老师，您也别光站着啊……快来一起……小睡一会吧……"},{"label":"咖啡馆1","jp":"あはは！あー…笑ったら眠くなった。","zh":"啊哈哈哈~啊……一笑，就感觉犯困啦……"},{"label":"咖啡馆2","jp":"わ～ここならゆっくりできそう～","zh":"啊……这里，感觉可以好好休息一下~"},{"label":"咖啡馆3","jp":"うふふふっ。新しい枕が届くよ。楽しみすぎる","zh":"诶嘿嘿嘿~新的枕头马上就到啦，真的好期待啊~"},{"label":"咖啡馆4","jp":"あはは！さ、さっき…！\n夢で…先生が…\nああ、もうダメ、面白すぎる！あはは。","zh":"啊哈哈哈，刚……刚才……老师……在梦里……啊，不行了……太搞笑了……啊哈哈……"},{"label":"咖啡馆5","jp":"あはは！あ～よく寝た！\nうん？そんな姿を見るのは初めて？","zh":"啊哈哈哈，啊……睡得好舒服~嗯……？第一次见我这个样子嘛~"},{"label":"咖啡馆6","jp":"なんだか眠たくなるようなのんびりとした空間だね～","zh":"这个地方让人感觉好放松，不知不觉都有点犯困了～"},{"label":"咖啡馆7","jp":"夢を見てる気分なの。なんでだろう？","zh":"总感觉是在做梦，为什么呢？"}],"好感度":[{"label":"好感度1","jp":"暖かい日差し、ふかふかの枕、柔らかい布団、\nそして……先生……。……良いね。","zh":"温暖的阳光，蓬松的枕头，柔软的被子，还有……老师，真好~"},{"label":"好感度2","jp":"世界で一番嫌いなもの？目覚まし時計。\nでも、先生の声は嫌いじゃないよ？","zh":"世界上最讨厌的东西……？……闹钟。但是，我不讨厌老师叫我的声音。"},{"label":"好感度3","jp":"わ、私だって一応本気を出す時はあるよ…。\n戦う時と…先生と一緒にいる時。","zh":"我、我有时候也会认真的！比如，战斗的时候……还有，和老师在一起的时候。"},{"label":"好感度4","jp":"幸せだけど、怖い。今この瞬間が夢のように目覚めてしまいそうで。","zh":"我很幸福，但是也很害怕……我怕现在这一刻，会像做梦一样醒过来。"}],"战斗":[{"label":"编入队伍1","jp":"わかった、今起きるから～","zh":"明白了……我现在就起……"},{"label":"编入队伍2","jp":"ふぅ～、それじゃ、また帰ってきてから寝るね～","zh":"啊~……那我，回来再睡啦~\n拎起"},{"label":"拎起","jp":"ふわ…意外と快適？","zh":"喔……还挺，舒服的…"},{"label":"任命队长1","jp":"はぁ～。あの子たちは、睡眠とらないのかな？","zh":"嗯……那些孩子，不睡觉的嘛？"},{"label":"任命队长2","jp":"ふぅ、しゅっぱ～つ。がんばって～。…え、私も行くの？","zh":"嗯……出发~加油~！……诶？我也要去嘛？"},{"label":"普通技能","jp":"傷？寝て起きたら治るよ。","zh":"伤口……？睡一觉就好啦~"},{"label":"EX动画1","jp":"よっと。じゃあ行こっか！","zh":"好嘞~那我们走吧~！"},{"label":"EX动画2","jp":"守らなきゃいけないものがあるの！","zh":"我有必须要保护的东西！"},{"label":"EX动画3","jp":"さあ、修行の成果を見せるよ！","zh":"来，给你展示一下训练的成果吧！"},{"label":"EX技能1","jp":"誰も私の昼寝は、いや、先生の邪魔はさせない！","zh":"谁也休想打扰我睡午……啊，不对，是休想妨碍老师！"},{"label":"EX技能2","jp":"私が先頭に立つよ、行こう！","zh":"我来带头，走吧~"},{"label":"EX技能3","jp":"痛くない…痛くない......","zh":"不疼……不疼……！"},{"label":"战斗开始1","jp":"私の後に、ついてきて。","zh":"跟在我后边~"},{"label":"战斗开始2","jp":"私が前に立つね。","zh":"我站在前面哦~"},{"label":"获得BUFF","jp":"私の出番だねぇ。","zh":"轮到我了吧~"},{"label":"施放BUFF","jp":"うわぁ……力を感じる……。","zh":"我……我感受到了力量……"},{"label":"被CC1","jp":"-","zh":"噫……"},{"label":"被CC2","jp":"痛い","zh":"好疼……！"},{"label":"被CC3","jp":"痛","zh":"哎呀……！"},{"label":"回避","jp":"邪魔だなぁ……","zh":"好烦呐……"},{"label":"队伍移动1","jp":"ここはもう安全。","zh":"这里安全啦~"},{"label":"队伍移动2","jp":"早く終わらせて寝たい…","zh":"好想早点结束，回去睡觉……"},{"label":"回复","jp":"あ～り～が～と～","zh":"谢~谢~你~呀~"},{"label":"中途退出","jp":"眠い……","zh":"好困……"},{"label":"战斗喊叫","jp":"-","zh":"呀！"},{"label":"战斗喊叫","jp":"","zh":"前进！"},{"label":"战斗喊叫","jp":"-","zh":"啊！"},{"label":"角色移动","jp":"ちょっと位置かわるね～","zh":"换个位置哦~"},{"label":"战斗胜利1","jp":"ふぅ…はぁ。役に立てて、よかった。","zh":"呃啊……能帮上忙就"},{"label":"战斗胜利2","jp":"ふぅ……はぁ。これで、安心して眠れるね。","zh":"啊……这样就能安心睡觉啦~"},{"label":"关卡完成1","jp":"お疲れ様～先生。…もう、寝てもいい？","zh":"老师辛苦啦~我现在可以睡了嘛~"},{"label":"关卡完成2","jp":"はぁ…終わった～、終わったよ～。おやすみなさ～い。","zh":"啊啊……结束啦、结束啦~晚安~"},{"label":"战斗失败1","jp":"ご、ごめん。ちょっと居眠りしてた。","zh":"对、对不起……我打了会瞌睡……"},{"label":"战斗失败2","jp":"眠ってたつもりだったけど……気絶、してたんだね。","zh":"我以为我睡着了，原来是昏过去了……"}],"成长":[{"label":"升级1","jp":"ん？よく眠れたからか…なんだか成長した気分だなぁ。","zh":"嗯……？是不是因为睡了个好觉呢，怎么有种成长了的感觉呀？"},{"label":"升级2","jp":"やっぱり…先生といるときは元気が出る！","zh":"果然，和老师在一起的时候，就会有精神。"},{"label":"升级3","jp":"今なら…冬眠もできそう。","zh":"现在……感觉可以冬眠了"},{"label":"升级4","jp":"夢を見るのもいいけど……これからは先生と、夢を叶えたい！","zh":"做梦虽然很好，不过以后……我想和老师一起实现梦想。"},{"label":"获得专武","jp":"この武器は……夢なのかな……ずっと願ってたことが、叶った。","zh":"这件武器……我是不是在做梦啊……我一直以来的愿望，实现了！"}],"事件":[{"label":"学生生日","jp":"今日が…私の誕生日…？\n記念にもっと寝ないと…それがいいね。","zh":"今天，是我的生日吗……？那作为纪念，再睡一会……也挺好的。"},{"label":"老师生日","jp":"お誕生日おめでとう先生。\n私が膝枕してあげるからひと眠りする？","zh":"老师，生日快乐~！要不要枕着我的腿，睡上一觉？"},{"label":"万圣节","jp":"今日は、眠るにはもったいない日だね。\n街に出ようよ、先生。\nきっと起きてても、夢を見てるような気分になれるから。","zh":"今天睡觉可有点浪费了……出去逛街吧，老师~反正就算醒着，感觉也会像做梦一样美妙~"},{"label":"新年","jp":"明けましておめでとう。今年はもうちょっと頑張って起きてるね。","zh":"新年快乐~今年，我会更加努力地保持清醒哟。"},{"label":"圣诞节","jp":"クリスマスは好き…。\n百鬼夜行では少し珍しい祭りだけど\nたくさんの人が幸せそうな顔をする、聖なる夜だからね。","zh":"我喜欢圣诞节。虽然我们百鬼夜行很少会办这种庆典，但是它能让很多很多的人脸上洋溢着幸福，是个美好的夜晚。"},{"label":"春节","jp":"","zh":"老师~新春快乐~新的一年，老师要和我一起修行嘛？"},{"label":"中秋","jp":"","zh":"月亮……明亮皎洁，真美啊！这样的晚上，用来睡觉就太浪费了……老师，我们一起……看看月亮吧！"}],"未实装语音":[{"label":"未实装语音-咖啡馆","jp":"今度は三森と、くるみも連れてこよう。","zh":"下次，把三森和胡桃也带过来吧。"}]},"stats":{"init":[{"name":"攻击力","value":"189"},{"name":"防御力","value":"30"},{"name":"生命值","value":"3201"},{"name":"治愈力","value":"1481"},{"name":"命中值","value":"98"},{"name":"闪避值","value":"1416"},{"name":"暴击值","value":"196"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1420"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"9 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4085"},{"name":"防御力","value":"1867"},{"name":"生命值","value":"109470"},{"name":"治愈力","value":"6613"},{"name":"命中值","value":"98"},{"name":"闪避值","value":"1416"},{"name":"暴击值","value":"496"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1420"},{"name":"射程","value":"350"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"9 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"204"},{"name":"生命值","value":"3898"},{"name":"治愈力","value":"437"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"背包","grade":"T10","attrs":[{"name":"生命值","value":"14000"},{"name":"防御力","value":"1700"},{"name":"生命值","value":"5%"}]},{"slot":"3号装备","name":"护符","grade":"T10","attrs":[{"name":"暴击抵抗值","value":"420"},{"name":"暴伤抵抗率","value":"3000"},{"name":"暴击值","value":"300"}]}],"giftDetail":{"t1Value":[]}