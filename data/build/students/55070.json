g","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/235121.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/512089.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/86082/2025/5/12/547235.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/837398.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/370090.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/511209.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/757736.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/336233.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/235121.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/512089.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/784058.png","name":"巧克力埴轮","desc":"花子准备的埴轮型巧克力。直勾勾的视线像是无论怎样都盯着你看。"},"ability":{"attrs":[{"name":"生命值","value":"863"},{"name":"攻击力","value":"75"},{"name":"治愈力","value":"334"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/730800.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/12/44976.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 花子（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/86082/2025/5/12/755739.png","url":"https://www.gamekee.com/ba/596034.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"浦和（うらわ）ハナコです。\nこれから色々とよろしくお願いしますね。\n……はい、それはもう「色々」と。","zh":"我是浦和花子，形形色色的方面都请您多多关照。对，形形—色色的方面。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生。今日もよろしくお願いいたします。","zh":"老师，您来了，今天也请多多关照。"},{"label":"登陆2","jp":"ふふっ。お待ちしておりましたよ、先生。","zh":"老师，我正等您呢。"},{"label":"大厅1","jp":"ふふっ。ここで「当番」をするのは、すごく楽しいですね？","zh":"在这里值日，别有一番乐趣呢。"},{"label":"大厅2","jp":"今ここにいるのは私たち二人だけ……\nこれは、期待しても良いんでしょうか？","zh":"现在这里就只有我们两个，我可以有所期待吗？"},{"label":"大厅3","jp":"どういう意味か……ですか？\nそれはもう、先生のお望み通りの意味で。","zh":"您问我什么意思？这个就是老师心里想的那个意思。"},{"label":"大厅4","jp":"先生、何か私にしてほしいことはありますか？","zh":"老师，你想让我做什么呢？"},{"label":"大厅5","jp":"ふふっ、先生のその表情が見たかったんです。","zh":"我就是想看老师的这个表情。"},{"label":"回忆大厅1","jp":"こんにちは、先生。\n来ていただいて、ありがとうございます。","zh":"老师，您来了。\n谢谢您特意跑一趟。"},{"label":"回忆大厅2","jp":"こうしていると涼しくて、とっても気持ち良いんですよ。\n私にとっての特等席なんです、ふふっ……","zh":"在这里坐着很凉快。感觉很舒服呢。\n对我来说啊，这可是特等席呢。"},{"label":"回忆大厅3","jp":"せっかくですし、先生もいかがですか？\nここで一緒に、脱いでしまいません……？","zh":"难得来一次，老师也一起来，怎么样？\n要不要在这里一起解放一下？"},{"label":"回忆大厅4","jp":"こうして、こんな真っ昼間から素肌をさらしていると、\n何だか楽しくなってくるんですよ？\nイケないことをしてる……そんな感じがして。","zh":"像这样两个人在大白天就坦诚相见，老师不觉得很刺激吗？\n您是不是也有一种做了坏事的感觉？"},{"label":"咖啡馆1","jp":"……ふふっ、ちょっといたずらでもしておきましょうか。","zh":"要不要小小的调皮一下呢？"},{"label":"咖啡馆2","jp":"この空間、見ているだけで楽しいですね。","zh":"这个地方真是赏心悦目。"},{"label":"咖啡馆3","jp":"あら、可愛らしいところですね｡","zh":"这个地方很可爱。"},{"label":"咖啡馆4","jp":"この内装は先生が？素敵ですね。","zh":"是老师布置的吗？真不错。"},{"label":"咖啡馆5","jp":"ここに置いていったら、誰かが驚くでしょうか……？","zh":"放在这里的话，会不会吓到别人呀？"}],"好感度":[{"label":"好感度1","jp":"先生のこと信じてもよろしいのでしょうか。","zh":"我……可以相信老师吗？"},{"label":"好感度2","jp":"まだまだ…イケますよね？先生？","zh":"老师，您还能坚持吧？"},{"label":"好感度3","jp":"先生にはありのままの私を見ていただきたいです。","zh":"希望老师能看到真实的我。"},{"label":"好感度4","jp":"先生は辛くて苦しい方が好きだったりしますか？","zh":"老师是会享受辛劳和痛苦的那种类型吗？"}],"战斗":[{"label":"编入队伍1","jp":"あら、私の出番ですか？","zh":"轮到我出场了吗？"},{"label":"编入队伍2","jp":"うふふ、私のこと認めってくれるなんで。","zh":"您居然会对我有需求？"},{"label":"拎起","jp":"あら、大胆ですね……","zh":"啊呀，好大胆呢。"},{"label":"任命队长1","jp":"さあ、始めましょうか。","zh":"好，那开始。"},{"label":"任命队长2","jp":"全部、先生の言う通りにしますよ。うふふ。","zh":"全都会按老师说的做。"},{"label":"普通技能","jp":"行きますよ～～","zh":"我要开始了。"},{"label":"EX动画1","jp":"さて…あら！？…うふふっ","zh":"那就……"},{"label":"EX动画2","jp":"行きます！あっ…うふふっ","zh":"我要开枪了……哼哼"},{"label":"EX动画3","jp":"では…ああっ！…ふふっ","zh":"接下来……"},{"label":"EX技能1","jp":"お役に立てると…いいのですが！","zh":"能帮上忙就好了。"},{"label":"EX技能2","jp":"喜んでいただけると…嬉しいです！","zh":"如果您高兴，我也开心。"},{"label":"EX技能3","jp":"ちゃんと…受け止めてくださいね！","zh":"请乖乖的……吃我一发。"},{"label":"战斗开始1","jp":"楽しんで行きましょう。","zh":"好好享受吧。"},{"label":"战斗开始2","jp":"期待しててくださいね。","zh":"敬请期待。"},{"label":"获得BUFF","jp":"もっともっと、頑張りますね。","zh":"我会更加努力的。"},{"label":"施放BUFF","jp":"もっと大胆になっても、いいですか？","zh":"我可以再大胆一点吗？"},{"label":"掩体","jp":"うふふ","zh":"-"},{"label":"被CC1","jp":"いや","zh":"-"},{"label":"被CC2","jp":"いたい","zh":"疼"},{"label":"被CC3","jp":"今のは痛かったですね。","zh":"刚才这下还挺疼"},{"label":"回避","jp":"うふふ、その程度ですか？","zh":"就这点本事吗？"},{"label":"队伍移动1","jp":"見つけましたよ。","zh":"找到你了"},{"label":"队伍移动2","jp":"まだまだいけますよ。","zh":"我还可以继续"},{"label":"回复","jp":"ありがとうございます。","zh":"非常感谢"},{"label":"中途退出","jp":"こんなはずでは。","zh":"不应该是这样的"},{"label":"战斗喊叫","jp":"や","zh":"-"},{"label":"战斗喊叫","jp":"へい","zh":"-"},{"label":"战斗喊叫","jp":"は","zh":"-"},{"label":"角色移动","jp":"よいっしょ","zh":"-"},{"label":"战斗胜利1","jp":"楽しかったですね。","zh":"好开心呀"},{"label":"战斗胜利2","jp":"うふふ、いかがでしたか、先生。","zh":"老师，您感觉如何呀？"},{"label":"关卡完成1","jp":"あっ、こんな感じでいいでしょうか。","zh":"这种感觉可以吗？"},{"label":"关卡完成2","jp":"流石先生、凄いです。","zh":"不愧是老师，真厉害。"},{"label":"战斗失败1","jp":"もう、足腰が立ちません。","zh":"腰腿都软了。"},{"label":"战斗失败2","jp":"少し、よそ見をしすぎました。","zh":"有点太不专心了。"}],"成长":[{"label":"升级1","jp":"ふふっ、また少し成長したと思いませんか？","zh":"您不觉得我又成长了一点吗？"},{"label":"升级2","jp":"ありがとうございます、先生。","zh":"老师，非常感谢您。"},{"label":"升级3","jp":"今度きちんとお返しをしますね。はい、先生のお望みのままで。","zh":"下次我会好好报答您的。\n对，就是老师~想要的那个。"},{"label":"升级4","jp":"ここまで大切にしてくださると私、そろそろ我慢できなくなってしまいますよ？","zh":"你要是再对我这么好，我就真的要忍不住了。"},{"label":"获得专武","jp":"……先生は困った方ですね、そんなに私の全部が見たいのですか？\n……うふふ、実力のお話です、いま、一体何を考えていたのでしょう。","zh":"老师你也真是的，就那么想看~我的全部吗？\n哦呵呵~我说的是实力，您想到哪儿去了呀？"}],"事件":[{"label":"学生生日","jp":"誕生日プレゼント、ですか……。\nあ、先生がプレゼント、なんて素敵かもしれませんね。\n包みは、私が解いても良いですか……？","zh":"生日礼物，老师来当礼物好像不错，那我可以拆包装了吗？"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。\n何か欲しいものなどはありませんか？何も無いのでしたら……\n「あれ」、でも良いんですよ？","zh":"老师，祝您生日快乐，你有什么特别想要的礼物吗？\n没有的话，那个……怎么样呢？"},{"label":"万圣节","jp":"ハロウィンといえば、さりげなく大胆な露出ができる日……\n……え、誤解、ですか？","zh":"万圣节就是有正当的理由大胆暴露自己的节日。\n……不是我想的那样？"},{"label":"新年","jp":"今年も色々とよろしくお願いします、先生。\n困らせてしまうことも多いかもしれませんが、これからも私のこと、見捨てないでくださいね？","zh":"老师新年在形形色色的方面也都要请您多多关照了~\n可能会有很多事让您为难，到时候还请您多多包涵。"},{"label":"圣诞节","jp":"聖なる夜……ああ、すごく楽しみですね……\n……あ、ただの独り言です。お気になさらず。","zh":"神圣的夜晚，好期待呀……\n只是自言自语了，请别介意。"},{"label":"春节","jp":"","zh":"老师新春快乐，要和我一起去欣赏象征着勃勃生机的新年日出吗？"},{"label":"中秋","jp":"","zh":"今晚的月亮又大又圆，真想让人摸摸呢。\n老师，您说是吗？"}]},"stats":{"init":[{"name":"攻击力","value":"181"},{"name":"防御力","value":"25"},{"name":"生命值","value":"2658"},{"name":"治愈力","value":"2563"},{"name":"命中值","value":"691"},{"name":"闪避值","value":"809"},{"name":"暴击值","value":"197"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1628"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"4895"},{"name":"防御力","value":"138"},{"name":"生命值","value":"51022"},{"name":"治愈力","value":"17841"},{"name":"命中值","value":"691"},{"name":"闪避值","value":"809"},{"name":"暴击值","value":"347"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1682"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"138"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"355"},{"name":"生命值","value":"2703"},{"name":"治愈力","value":"1375"}]},"equipDetails":[{"slot":"1号装备","name":"鞋子","grade":"T10","attrs":[{"name":"攻击力","value":"46%"},{"name":"生命值","value":"20%"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"项链","grade":"T10","at