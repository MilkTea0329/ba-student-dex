img-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538776594_1780484206588_4dnfad9a3r_3ot3lq8zz4.png"},{"name":"大决战","value":"★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538781498_1780484086283_7rhrvvb2ea_pkm9d9l9xl.png"},{"name":"竞技场","value":"不适合","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538786645_1780484112302_bbcdnsjkd1_0c1pwgm01y.png"},{"name":"爬塔","value":"不适合","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538791414_1780484130867_nbi636h5oo_cihwoby2e7.png"},{"name":"演习＆高难","value":"★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538796344_1780484179072_oph41vmqoz_mjsbhuirm.png"}],"skills":{"ex":"*red:5费*对矩形范围*red:681%伤害*+*red:83.1%燃烧*(20秒)","ns":"每60秒，对单*red:加攻击50.2%*，*red:减命中27.5%*(30秒)","ps":"加暴击26.6%，专二加攻击591","ss":"普攻伤害半径扩大至2倍，倍率变为83.8%"},"employment":"堆刀可用加攻挂件","advice":"*red:不推荐刻意抽取*\n真有需求时再考虑"},"officialImages":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_908/h_1210/829/43758/2025/5/13/908712.png"],"expressions":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/67773.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/889987.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/570618.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/292159.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/541427.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/805803.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/801348.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/549459.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/885784.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/719731.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/924011.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/259355.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/301694.png,//cdnimg-v2.gamekee.com/wiki2.0/images/w_297/h_297/829/43758/2025/5/18/499650.png"]}