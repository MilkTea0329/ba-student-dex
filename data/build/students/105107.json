/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/324342.png","name":"ALL TO YOU","desc":"日和用某种意义上的“一切”交换而来的巧克力。在小巧的袋子中蕴含了她满满的心意"},"ability":{"attrs":[{"name":"生命值","value":"775"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"199"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/253119.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/21002.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 日和（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/86082/2025/5/13/317112.png","url":"https://www.gamekee.com/ba/606282.html"}],"voices":{"通常":[{"label":"标题","jp":"えへへ……ブルーアーカイブ…","zh":"blue archive"},{"label":"卡池抽取","jp":"えへへ……何だかんだで、来てしまいました……これからも辛いですよね？苦しいんですよね？\nですが、それが人生のようですし……仕方ないですね。ヒヨリです、よろしくお願いいたします……えへへ。","zh":"嘿嘿，我终于也来这里了，接下来一定会很累很辛苦。\n但这就是人生，也没办法。我是日和，请多关照，嘿嘿嘿。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"うわぁっ！？お、おかえりなさい、先生……\nお、お待ちしておりました……！","zh":"欢迎您，老师，等候您多时了。"},{"label":"登陆2","jp":"えへへ……はい、お嫌かもしれませんが、本日の当番は私です。","zh":"嘿嘿没错，这次值日员是我，所以老师大概会吃点苦。"},{"label":"大厅1","jp":"何かあれば言ってください……内容によっては、もしかしたら役に……","zh":"如果有什么事情就告诉我，没准儿我可以帮上你什么忙。"},{"label":"大厅2","jp":"あの、何かやることなどは……？さっきからただ一緒にいるだけで……\nもっと何か、苦しい仕事とか……。\n……はい？こうしているだけでいいんですか？……本当に？","zh":"我说就没有什么需要我做的事情吗？\n从刚才开始就只是一起呆着而已，有没有更辛苦的工作之类的？"},{"label":"大厅3","jp":"","zh":"真的吗？只要继续这样待着就可以吗？"},{"label":"大厅4","jp":"この間、そういう雑誌で色々読んできましたので。\nえへへ……何か役に立てるかもです……。","zh":"最近我在杂志上读到过各种各样的文章，或许能帮上一些忙。"},{"label":"大厅5","jp":"お仕事は、苦しいですが……\n人生は元々全てが苦しいので、大丈夫です。","zh":"工作虽然很辛苦，但人生本来就是辛苦的，所以没关系。"},{"label":"回忆大厅0","jp":"-","zh":"-"},{"label":"回忆大厅1","jp":"み、見てください先生、私のここ……","zh":"老师，您看，我这里。"},{"label":"回忆大厅2","jp":"や、やっぱり変ですよね？みんなと違うんですよね！？\nもしかして変なのではと、前から思ってはいましたが……\nやっぱり、そうだったんですね……！","zh":"是不是很奇怪，和其他人不一样吧。\n我以前就一直在想自己的肚脐是不是有些奇怪。\n果然是这样的。"},{"label":"回忆大厅3","jp":"せ、先生？どうしてさっきから、視線を……？\nまさか……ま、まともに見られないぐらい変なんですか！？","zh":"老师，您的视线为什么总是闪开啊？\n难道已经奇怪到无法直视的地步了吗？"},{"label":"回忆大厅4","jp":"そうなんですね……もう生きていく意味も無いかもしれません\nどうして人生は、こう…… まるで直視できない 私のここみたいに、グロテスクで……。","zh":"果然是这样，这么一来，我已经没有活下去的意义了。\n为什么我的人生会像我这里一样不忍直视，这么丑陋畸形呢？"},{"label":"回忆大厅5","jp":"せ、先生……せめて何か感想を……\nこんな身体でも、良いとか役立ちそうとか、何か言っていただけないと……。","zh":"老师至少说句安慰的话吧。\n就算身体长得奇怪，也会有它的用处之类的，这样安慰我一下可以吗？"},{"label":"咖啡馆1","jp":"えへへ。失礼します……。","zh":"嘿嘿，打扰了。"},{"label":"咖啡馆2","jp":"何だか良さそうな家具が、たくさん……","zh":"这里有不少看起来很不错的家具呢。"},{"label":"咖啡馆3","jp":"あれも、これも……良いですね……良さそうなものがたくさん……","zh":"还有那个真不错呀，有这么多好东西。"},{"label":"咖啡馆4","jp":"えへへ……ご迷惑をおかけします、すみません……。","zh":"嘿嘿嘿，我太没礼数了，抱歉。"},{"label":"咖啡馆5","jp":"楽しい気分になれそうな……なれなさそうな……。","zh":"好像变开心了一点，又好像没有。"}],"好感度":[{"label":"好感度1","jp":"あのう......私、これ以上はきっと、役に立てないと思いますが......どうしたものですかね......","zh":"怎么说呢？虽然我觉得自己的用处也就到这里了，这是怎么回事呢？"},{"label":"好感度2","jp":"あ、ありがとうございます......えへへ......","zh":"谢谢你。"},{"label":"好感度3","jp":"こんなに私を言詰めて、\n人生は苦しいものだって教えてくださってるんですか。\nそうですよね。そういうことですよね。","zh":"您这样推着我向前走，是想告诉我人生就是受苦，对吧？是这样的。"},{"label":"好感度4","jp":"あげては落として、またつらい目に......そういうことですよね。","zh":"夸奖，然后再贬低一次，让我陷入痛苦，原来是这个套路吗？"}],"战斗":[{"label":"编入队伍1","jp":"はい！準備できました。よろしくお願いします......。","zh":"是的，我准备好了，请多多关照。"},{"label":"编入队伍2","jp":"えへへ......こ、今回はどんなお仕事で......","zh":"嘿嘿嘿，这次是什么样的工作？"},{"label":"拎起","jp":"うへぇー!どうせ捨てるなら、最後に何か…\n美味しいものをくださいー!","zh":"呜噫——！反正都要把我扔掉，最后请给我留点…\n好吃的东西吧——！"},{"label":"普通技能","jp":"い、痛そうですね......","zh":"会很痛的。"},{"label":"EX动画1","jp":"...うわ！私が行きます！","zh":"我我我我来了。"},{"label":"EX动画2","jp":"え？少々お待ちお","zh":"稍稍等一下。"},{"label":"EX动画3","jp":"み、皆さん......あっ、し、支援します！","zh":"各位，我来支援了。"},{"label":"EX技能1","jp":"え、えへへ......私にはこのぐらいしかできないので......","zh":"我也就只会这些了。"},{"label":"EX技能2","jp":"で、ではまた、次の場所へ","zh":"前往下个地点。"},{"label":"EX技能3","jp":"こういうのも......人生ですよね......","zh":"这也是人生。"}],"成长":[{"label":"升级1","jp":"へ？私ですか？！つまり、もっと苦しめた、そういうことですか。","zh":"给我的吗？也就是说想让我更痛苦，是这个意思吧？"},{"label":"升级2","jp":"この先は、もっと苦しいんですよね。どんどん辛くなるんでしょうけど。仕方ないですね、えへへ......","zh":"以后会更痛苦吧，虽然会越来越痛苦，不过这也没办法。"},{"label":"升级3","jp":"強くなればなるほど、今以上に苦しむんですよね......","zh":"随着我越来越强，应该也会比现在更痛苦吧。"},{"label":"升级4","jp":"こんな私でも、役に立てることか","zh":"就算卑微如我，也能派上用场吗？"},{"label":"获得专武","jp":"先生は私を、骨の髄までこき使うつもりなんですね……\nまあ、どうしようもありませんし……受け入れるとしましょう、えへへ……。","zh":"老师是想狠狠压榨我吧。反正也没别的办法，只能接受了。"}],"事件":[{"label":"学生生日","jp":"人は、苦しむために生まれるんですよね？\nへへ……ですから私はもう何年も、充実した年を重ねています。\nそ、それは違うかも……？そうなんですか？","zh":"人是为了受苦才出生的，不是吗？\n所以我这些年的人生非常充实……\n啊，你说这个论调太扭曲了？是吗？"},{"label":"老师生日","jp":"せ、先生、誕生日おめでとうございます！！\nこんな辛い時間を先生は何度も繰り返してきたんですよね？\nすごいですね、本当に素晴らしいです。\n私も辛いですが……これからも、頑張ります。","zh":"祝祝老师生日快乐，老师一直在不停重复着如此痛苦的时光吗？\n真了不起，太厉害了。我虽然也很痛苦，但以后会加油的。"},{"label":"万圣节","jp":"えへへ……飴を奪われるか、いたずらされるか……どっちでも辛いですよね。\nどっちを選んでも苦しい二者択一……人生みたいですね……。","zh":"嘿嘿嘿，不管是被夺走糖果还是被捣蛋，选哪一个，结果都是痛苦的，\n就像我们的人生一样。"},{"label":"新年","jp":"またこうして一年が過ぎましたね。\n今年は新たに、どれだけの苦しみが待っていることでしょうか……えへへ。","zh":"一年又这样过去了，新的一年又会有怎样的辛苦等着我吃呢？\n嘿嘿嘿嘿嘿嘿。"},{"label":"圣诞节","jp":"聖夜について雑誌で読みました。色々と準備は万端です。\n……えっと、どうして逃げようとするんですか？","zh":"我在杂志上学过关于圣诞节的知识，准备可以说是万无一失。\n喂，你为什么要逃跑？"},{"label":"春节","jp":"","zh":"老师，新春我也会受苦的。\n新春快乐。快乐只是一时的，受苦才是长久远。"},{"label":"中秋","jp":"","zh":"月饼，我知道了，里面一定藏了魔鬼辣椒，是用来让我受苦的新道……\n……没放那么危险的东西？"}]},"stats":{"init":[{"name":"攻击力","value":"259"},{"name":"防御力","value":"18"},{"name":"生命值","value":"2380"},{"name":"治愈力","value":"1996"},{"name":"命中值","value":"949"},{"name":"闪避值","value":"188"},{"name":"暴击值","value":"211"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2171"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COS