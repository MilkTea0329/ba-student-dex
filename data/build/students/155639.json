2025/5/13/309203.png"}],"uniqueWeapon":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_631/h_246/829/86082/2025/5/13/810267.png","name":"天蝎座 / Scorpius","desc":"亚津子使用的冲锋枪。\n为守护小队的夏天出了一份力。","table":{"cols":["Lv1","Lv30","Lv40","Lv50","Lv60"],"rows":[{"label":"攻击力","values":["152","554","692","831","557"]},{"label":"生命值","values":["492","1789","2237","2684","3181"]},{"label":"治愈力","values":["245","892","1115","1338","1562"]}]},"skill":{"name":"清爽的海风+","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_103/h_95/829/86082/2025/5/13/97773.png","description":"","levels":[{"lv":1,"text":"治愈力增加1044，治愈力增加14%"},{"lv":2,"text":"治愈力增加1096，治愈力增加14.7%"},{"lv":3,"text":"治愈力增加1148，治愈力增加15.4%"},{"lv":4,"text":"治愈力增加1357，治愈力增加18.2%"},{"lv":5,"text":"治愈力增加1409，治愈力增加18.9%"},{"lv":6,"text":"治愈力增加1462，治愈力增加19.6%"},{"lv":7,"text":"治愈力增加1670，治愈力增加22.4%"},{"lv":8,"text":"治愈力增加1722，治愈力增加23.1%"},{"lv":9,"text":"治愈力增加1775，治愈力增加23.8%"},{"lv":10,"text":"治愈力增加1983，治愈力增加26.6%"}]},"star3":"屋外战适应性强化至 A","star3Icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/86082/2025/5/13/692326.png","star4":"COST上限增加0.5"},"favoriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"秤 アツコ（水着）","kana":"秤 はかり","twName":"敦子（泳装）","cnName":"亚津子（泳装）","age":"15岁","birthday":"1月20日","height":"158cm","hobby":"收到花","designer":"-","artist":"Paruru","cv":"日 | 花泽香菜\n中 | 刘一蕾\n韩 | 김성화（金成华）","hallLevel":"3","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"正在练习拍摄人物照片","bio":"来海边游泳的阿里乌斯战术小队的一员。\n\n无论是来到海边还是参加庆典都是第一次，所以看起来比平时更加快乐。在努力用黑市买来的数码相机留下关于大海的回忆。","sourceUrl":""},"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"980"},{"name":"攻击力","value":"114"},{"name":"治愈力","value":"366"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/179117.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/123154.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 亚津子","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_296/h_296/829/86082/2025/5/13/449547.png","url":"https://www.gamekee.com/ba/158662.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー、アーカイブ。","zh":"blue archive！"},{"label":"卡池抽取","jp":"アリウススクワッド、秤アツコ。……ふふ、畏まりすぎたかな？","zh":"啊，这个……谢谢你，老师。我很喜欢。我会为了老师去用的。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"こんにちは、先生。\n私にできること、ある？","zh":"你好，老师。有什么我可以做的吗？"},{"label":"登陆2","jp":"おかえり、先生。\n今日もよろしくね。","zh":"快请进，老师。今天也请多多关照。"},{"label":"大厅1","jp":"ミサキと「ツーショット」を撮ったよ。……二人とも変な顔、\nふふ。もう一回、撮りたいかも。","zh":"我和美咲拍了“双人照”。……两个人的表情都好奇怪，呵呵。还想重拍一张。"},{"label":"大厅2","jp":"その……変に聞こえるかもしれないけど……\n先生の写真、撮ってもいい？","zh":"那个……我这么问也许有点奇怪……老师，可以给你拍张照吗？"},{"label":"大厅3","jp":"こんな日でも、先生はお仕事なんだ。\nサッちゃんも今頃……ううん、なんでもない。","zh":"这种日子，老师也在工作啊。\n小纱现在应该也……呃，没什么。"},{"label":"大厅4","jp":"先生、私の水着、大丈夫そう？\n変じゃないかな。","zh":"老师，我的泳装怎么样？不奇怪吧？"},{"label":"大厅5","jp":"お祭りの景品コーナーで焼きそばの交換券をもらったんだ。\nヒヨリ、気に入ってくれるかな。","zh":"我在庆典的抽奖处领到了炒面的兑换券。日和会喜欢吗？"},{"label":"回忆大厅1","jp":"写真、いっぱい撮ってきたけど……\nこうして撮られるのは初めて。\nこういうとき、どうしたらいいか分からない……","zh":"虽然拍过很多照片……不过，像这样被拍还是第一次呢。\n不知道这种时候该怎么做比较好……"},{"label":"回忆大厅2","jp":"こう、笑えばいいのかな？\nもっとお花のほうに寄る……？\nわかった。","zh":"像这样笑就可以了吗？\n再往花那边靠一些……？好的。"},{"label":"回忆大厅3","jp":"ハマナス……いいにおい。","zh":"沙滩玫瑰的香味……真美妙。"},{"label":"回忆大厅4","jp":"偶然見つけた場所だけど……\n先生のおかげで、ここに来れた。","zh":"多亏了老师，才能在偶然间发现这样的地方。"},{"label":"回忆大厅5","jp":"ありがとう先生。\n素敵な思い出になったよ。","zh":"谢谢你，老师。带我创造了这么美好的回忆。"},{"label":"咖啡馆1","jp":"いい写真、撮れるかな？","zh":"能拍到好看的照片吗？"},{"label":"咖啡馆2","jp":"（サッちゃん、元気にしてるといいな）","zh":"（小纱，希望你能过得好。）"},{"label":"咖啡馆3","jp":"どこかで、お花の香りがする。","zh":"好像从哪儿飘来了花香。"},{"label":"咖啡馆4","jp":"ここ、ゆっくりできそう。","zh":"这里应该可以放松休息。"},{"label":"咖啡馆5","jp":"これは……？初めてみた。","zh":"这是……？第一次见到。"}],"好感度":[{"label":"好感度1","jp":"先生の隣にいるね。……なんとなく、そうしたいの。","zh":"我会待在老师身旁的。……我也不知道为什么，就是想这样。"},{"label":"好感度2","jp":"先生には、いつももらってばかり。私からもいろいろ、したいのに……","zh":"我总是单方面地接受老师的好意。我也想为你做点什么……"},{"label":"好感度3","jp":"ふふ、ありがとう。記念に写真、撮っておくね。","zh":"呵呵，谢谢你。拍张照片留念吧。"},{"label":"好感度4","jp":"あっ、こういうときは……ちゃんとお礼を、だったね。はい、こちらこそ、よろしくお願いします。","zh":"啊，这种时候……得好好道谢才行。嗯，是我应该请您多多关照。"}],"战斗":[{"label":"编入队伍1","jp":"呼んでくれてうれしい。","zh":"很高兴你叫我。"},{"label":"编入队伍2","jp":"確認した。","zh":"确认好了。"},{"label":"拎起","jp":"……やっぱ、レンズ越しはもったいないかも。","zh":"…… 果然，隔着镜头看，未免太可惜了。"},{"label":"普通技能","jp":"いい香り。","zh":"呵呵，好香的味道。"},{"label":"EX动画1","jp":"先生、笑って。","zh":"老师，笑一下。"},{"label":"EX动画2","jp":"写真、撮ってあげる。","zh":"我给你拍个照。"},{"label":"EX动画3","jp":"一枚撮らせて。","zh":"让我拍一张吧。"},{"label":"EX技能1","jp":"ここ、いい写真を撮れそう。","zh":"这里，拍照应该会很好看。"},{"label":"EX技能2","jp":"はい、チーズ。","zh":"来，茄——子。"},{"label":"EX技能3","jp":"はい、撮るね。","zh":"好，我要拍咯。"}],"成长":[{"label":"升级1","jp":"くれるの……？大切にするね。","zh":"给我的吗……？我会好好珍惜的。"},{"label":"升级2","jp":"学んでいくって、楽しいね。","zh":"了解彼此，真是件愉快的事。"},{"label":"升级3","jp":"こんなに……もしかして私、期待されてるのかな……？","zh":"竟然这样……难道说，老师对我有所期待吗……？"},{"label":"升级4","jp":"ありがとう、先生。いつも新しい景色、みせてくれて。","zh":"谢谢你，老师。总是让我看到全新的风景。"},{"label":"获得专武","jp":"あ、これ……ありがとう、先生。\nすごく、気に入ったよ。\nこれは先生のために、使うから。","zh":"啊，这个……谢谢你，老师。我很喜欢。我会为了老师去用的。"}],"事件":[{"label":"学生生日","jp":"ありがとう、先生。\nプレゼントは大丈夫……\nそれより、一緒に散歩してほしい。","zh":"谢谢你，老师。礼物就不用了……我更想和你一起去散步。"},{"label":"老师生日","jp":"お誕生日おめでとう、先生。\n今日はプレゼントを渡す日、だよね。覚えてるよ。\nプレゼントに……私はどうかな？\n今日一日は、先生の言う事、なんでも聞くよ。","zh":"生日快乐，老师。今天是赠送礼物的日子。我一直记着呢。\n把我自己当作礼物……怎么样？今天一天，老师说什么我都会听的。"},{"label":"万圣节","jp":"いたずら……お菓子……？\nごめん、ハロウィーンのことはまだ、よく知らなくて。\nだから先生に、教えてもらいたい。","zh":"恶作剧……糖果……？抱歉，我还不太了解万圣节。\n因为不太了解，所以希望老师能教教我。"},{"label":"新年","jp":"明けましておめでとう、先生。\n新しい年……今年はなにが起こるのか、楽しみだね。","zh":"新年快乐，老师。\n新的一年……今年会发生什么事情呢，我很期待。"},{"label":"圣诞节","jp":"メリークリスマス、先生。\n特別な日は、写真にしなきゃ。\nはい、こっち見て。","zh":"圣诞快乐，老师。特别的日子应该拍照留念哦。来，看这边好吗？"},{"label":"春节","jp":"","zh":"老师，新年好！要在沙滩上放烟花吗？那，我跟你一起去准备吧。"},{"label":"中秋","jp":"","zh":"老师，你也是来看月亮的吗？听说，今天这样的日子应该一起吃“月饼”。和老师一起吃……应该会更甜吧。"}],"活动":[{"label":"活动登陆1","jp":"海のお祭り…\nこんなの、はじめて。","zh":"我还是……第一次体验这种海边的庆典。"},{"label":"活动登陆2","jp":"先生、楽しんでる？","zh":"老师，玩得开心吗？"},{"label":"活动大厅1","jp":"砂に触れたり、波を追いかけたり…\n海って、楽しいね。","zh":"触摸细沙，追逐海浪……在海边真开心。"},{"label":"活动大厅2","jp":"野外ステージ…楽しそう。\n先生、一緒に見に行こう。","zh":"露天舞台……好像很有意思。老师，一起去看看吧。"},{"label":"活动大厅3","jp":"みんなと一緒だから、楽しいんだと思う。\nもちろん「みんな」の中には、先生もいるよ。","zh":"和大家一起来很开心。当然，“大家”也包括老师。"},{"label":"活动大厅4","jp":"お祭りに連れてきてくれて、ありがとう。\n先生も、楽しんでね。","zh":"谢谢你带我来参加庆典。老师也要玩得开心哦。"},{"label":"活动事件1","jp":"お祭りの間は、何も起こらないといいな…\nこんなに楽しい時間、めったにないから。","zh":"希望庆典期间不要发生任何事情……难得有这样开心的时光。"},{"label":"活动事件2","jp":"お祭りはあと少しで…\nはじまりがあれば終わりがある、っていうけど…\nちょっと、寂しいな。","zh":"庆典快要结束了……虽然说有始就有终……不过还是有点遗憾呢。"},{"label":"活动结束","jp":"お祭り、終わっちゃったね…\nでも大丈夫だよ。海は、変わらずきれいだから。","zh":"庆典结束了……不过没关系。因为大海依旧美丽。"},{"label":"活动任务1","jp":"呼んだ？","zh":"是在叫我吗？"},{"label":"活动任务2","jp":"ふふ、私じゃなくて隣を見て。","zh":"呵呵，别看我呀，看我旁边。"},{"label":"活动任务每日结束","jp":"今日のお仕事はこれで終わり、少し休もうか、先生。","zh":"今天的任务到此结束。休息一会儿吧，老师。"},{"label":"活动任务登录1","jp":"こんにちは、先生。\nはい、これ、やることリストだよ。","zh":"你好，老师。给，这是待办事项清单。"},{"label":"活动任务登陆2","jp":"…多いね。一つずつ、終わらせていこう。","zh":"……好多啊，一件件来吧。"},{"label":"活动任务获取1","jp":"お疲れ様、先生。","zh":"辛苦了，老师。"},{"label":"活动任务获取2","jp":"先生、頑張ってるね。\n私もやる気出てきた。","zh":"老师真努力呀。我也有斗志了。"}]},"stats":{"init":[{"name":"攻击力","value":"249"},{"name":"防御力","value":"95"},{"name":"生命值","value":"2872"},{"name":"治愈力","value":"2609"},{"name":"命中值","value":"702"},{"name":"闪避值","value":"1103"},{"name":"暴击值","value":"270"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1477"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢