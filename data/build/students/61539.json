ges/w_146/h_116/829/103682/2025/5/13/568618.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/507952.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/103682/2025/5/13/93925.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"728"},{"name":"攻击力","value":"94"},{"name":"治愈力","value":"237"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/321705.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/13/583583.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 纱绫","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/13/846644.png","url":"https://www.gamekee.com/ba/68521.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"なんなのだ、せっかくの休日だったのに……\nま、先生の呼び出しなら仕方ないのだ","zh":"搞什么，难得休息一次。不过既然是老师叫我出来的那就没办法了。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ふう、ふう……あ、あれ？来てたのだ？\n……これ、一緒に食べる？","zh":"你来了，一起吃吗"},{"label":"登陆2","jp":"待ってたのだ！！\n全く、ぼく様を待たせるなんて……\n罰として今度実験に付き合うように！\nふっふっふっふっ……！","zh":"我等你很久了，居然让小爷我等你，就罚你配合实验好了，哼哼哼。"},{"label":"大厅1","jp":"うむ、刀削麵のこのモチっとした食感はやはり、いつ食べても美味しい……\nこの世における真理の一つなのだ。","zh":"啊，刀削面还是得筋道点才好吃，这可是颠扑不破的真理。"},{"label":"大厅2","jp":"なに、ぼく様が普通の食べ物を食べるのがおかしいのか？\nそんな、ぼく様はネズ助じゃないし！","zh":"干嘛？小爷我吃点普通的东西有这么奇怪吗？我又不是鼠鼠。"},{"label":"大厅3","jp":"ぼく様に似合ってて素敵な服……？\nうーはっはっはっ！\nそりゃあもちろん、ぼく様は何を着ても似合うのだ！","zh":"这件衣服很适合我，哈哈哈，那是当然小爷我穿什么都好看。"},{"label":"大厅4","jp":"インスピレーションは研究室の外でもいっぱいもらえるからな。\nキンをからかう時とか、メイをいじめる時とか……。","zh":"在研究室外面也能找到很多灵感，比如说动一下金，或者折腾一下梅。"},{"label":"大厅5","jp":"うん……？漏れてる？何が？","zh":"是不是有什么东西漏了？"},{"label":"回忆大厅1","jp":"ふふ……なるほど、これは中々すごい匂いなのだ……。\n確かにこのまま食べるのは難しそうだし……。","zh":"呵呵，嗯，这味道真的很冲啊。\n直接吃下去确实有点困难。"},{"label":"回忆大厅2","jp":"じゃあ、まず匂いを消すために消臭剤を1さじ……。\nあとは嗅覚を鈍らせるために、からしの粉を2さじ……。","zh":"为了去除异味，先撒一点除臭剂。\n然后要让嗅觉变迟钝，再撒一点芥末粉。"},{"label":"回忆大厅3","jp":"美味しくなあれ～なのだ～。","zh":"就这样改，变美味吧。"},{"label":"回忆大厅4","jp":"あ、あれっ？間違えて、からし粉を入れすぎてしまったのだ！","zh":"一不小心，芥末粉加多了。"},{"label":"回忆大厅5","jp":"まあ、気にするほどのことでも無いのだ。\n代わりに消臭剤をもう少し入れれば、多分大丈夫！","zh":"算了，应该没关系。\n再放点除臭剂中和一下就好了。"},{"label":"咖啡馆1","jp":"ほら、怖がらなくて良いんだぞ、ネズ助。","zh":"鼠鼠乖别怕。"},{"label":"咖啡馆2","jp":"おほ～、これはかなり……。","zh":"这还挺不错的。"},{"label":"咖啡馆3","jp":"チーズ味の飲み物はないのか？","zh":"有没有奶酪味的饮料？"},{"label":"咖啡馆4","jp":"休日を過ごすのにはいい場所なのだ。","zh":"这地方挺适合度假的。"},{"label":"咖啡馆5","jp":"これ、実験には使えないのかな？","zh":"这个能不能拿去做实验呢？"}],"好感度":[{"label":"好感度1","jp":"さすが先生なのだ～！","zh":"不愧是老师。"},{"label":"好感度2","jp":"フヒヒ…ハッ？い、いや、ぼく様はこんな間抜けな笑い方はしない！うーはっはっはっー！","zh":"不对，刚才笑错了，重来。"},{"label":"好感度3","jp":"先生を見ているとこみ上げるこの複雑な気持ちは何なのだ？本当に困った難題なのだ……。","zh":"怎么回事？为什么一看着老师心里就会浮现一种复杂的感情？到底是什么感情啊"},{"label":"好感度4","jp":"チーズか先生かでどっちかを選べと言うなら……。う～ん……両方選べる方法はないのか……？","zh":"如果让我在老师和奶酪中选一个？\n就没办法两者兼得吗？"}],"战斗":[{"label":"编入队伍1","jp":"ようやくぼく様の出番か","zh":"终于轮到小爷我出场了。"},{"label":"编入队伍2","jp":"ぼく様のかっこいい活躍、期待してるといいのだ","zh":"好好期待小爷我大展身手吧。"},{"label":"拎起","jp":"なに？ぼく様に何か問題でも？","zh":"怎么，有什么问题想问小爷我吗？"},{"label":"普通技能","jp":"これに耐えられるものなら耐えてみるのだ！","zh":"能忍就忍着吧。"},{"label":"EX动画1","jp":"イヤッホォー！","zh":"呀哈。"},{"label":"EX动画2","jp":"思いっきり楽しむのだ！","zh":"尽情享受吧。"},{"label":"EX动画3","jp":"もっともっと速く","zh":"再快点。再快点。"},{"label":"EX技能1","jp":"さあ、プレゼントなのだ！","zh":"来吧，这是礼物。"},{"label":"EX技能2","jp":"ふっふ、これでもくらえ！","zh":"给你这个。"},{"label":"EX技能3","jp":"くらうのだ！","zh":"接下这招。"},{"label":"战斗开始1","jp":"秘蔵の武器を見せるときなのか","zh":"该让你们看看秘密武器啦。"},{"label":"战斗开始2","jp":"準備はできてるなぁ！ネズ助","zh":"准备好了吗？鼠鼠。"},{"label":"战斗胜利1","jp":"やっぱり予想した通りのたのだ","zh":"不出所料。"},{"label":"战斗胜利2","jp":"うははは！まさにこれだ！","zh":"哈哈，就是这个。"}],"成长":[{"label":"升级1","jp":"こんなに強力な物を持ってくるとは……先生もなかなかやるのだ！","zh":"牛啊，老师，这种好东西你也搞得到。"},{"label":"升级2","jp":"う～ん、これはもの凄く強くなった気分なのだ！","zh":"这是感觉变强了好多。"},{"label":"升级3","jp":"ふっふっふっ……ぼく様は現在進行形で成長してるのだ！","zh":"小爷我成长的速度简直是肉眼可见。"},{"label":"升级4","jp":"これも新しい実験か？ふむ、悪くない！","zh":"这也是新实验吗？不错。"},{"label":"获得专武","jp":"ぼく様は研究だけでなく射撃の腕も天才なのだ！","zh":"小爷我不仅擅长研究，还精通射击，是个全能型人才。"}],"事件":[{"label":"学生生日","jp":"うう、不老不死の霊薬を作れないまま、また一つ歳を取ってしまったのだ……。\nうん？歳を取るのを気にしてるのかって？\nはは、まさか。シュン教官じゃあるまいし。","zh":"长生不老的灵药还没做出来，就又老了一岁……\n你说我太在意年龄了？\n怎么可能，我又不是瞬教官。"},{"label":"老师生日","jp":"お誕生日おめでとうなのだ、先生。\nプレゼントがない代わりに実験中の飲み物ならあるけど、飲んでみる？","zh":"老师生日快乐啊，虽然没准备礼物，不过有个药正在做实验，你要试试吗？"},{"label":"万圣节","jp":"Trick or Treat！お菓子をくれないといたずらするのだ！\nもちろんお菓子をくれてもいたずらはするけどな、うーはっはっはっ！","zh":"今年我也能收到糖果了。"},{"label":"新年","jp":"先生と一緒に一年を始められるなんて……\nぼく様は今年も大吉に違いない！","zh":"居然能跟老师一起开始新的一年，小爷我今年肯定也会吉星高照"},{"label":"圣诞节","jp":"先生、何か欲しい物はあるか？\n黄金は無いけど、手足が黄金の色に染まる薬ならあげられるぞ。ははは！","zh":"老师，你想要什么礼物呢？黄金我是没有，不过我可以送给你。能让手脚变成金黄色的药。"},{"label":"春节","jp":"","zh":"新春佳节就要和老师一起度过，小爷我接下来的一整年肯定都会顺顺利利的。"},{"label":"中秋","jp":"","zh":"今天有好多人问小爷我能不能帮忙做月饼？\n哼炼丹房是制作灵药的地方，又不是糕饼作坊。\n不过如果是老师的话，倒也是可以一起烤月饼什么的。"}],"活动":[{"label":"活动登陆1","jp":"山海経高級中学校へようこそなのだ、先生！","zh":"老师，欢迎你来山海经。"},{"label":"活动登陆2","jp":"ふっふっふ今日の約束はもちろん覚えてるよね、先生？","zh":"哼哼哼，老师，你该不会忘了今天有什么安排吧？"},{"label":"活动大厅1","jp":"シュン教官はどこに行ったのだ……？","zh":"瞬教官去哪儿了？"},{"label":"活动大厅2","jp":"ふっふっふ不老不死の霊薬を生み出せる日は近いのだ！","zh":"哼哼哼，很快就能做出长生不老药了"},{"label":"活动大厅3","jp":"おかしいのだ……「若返りの秘薬」に変なものは入れなかったはず……。","zh":"奇怪，回春秘药里也没加其他材料啊。"},{"label":"活动大厅4","jp":"……もしかして沸騰させてる時に、空中に舞っていたネズ助の毛が混ざったのだ！？","zh":"难道是制作秘药的时候，鼠鼠的毛掉进去了？"},{"label":"活动事件1","jp":"この出張研究所はあくまで臨時のもの。\nだからもし欲しい材料があったら、早めに手に入れておくことをおススメするのだ","zh":"驻外研究所只能临时营业，要是找到了不错的炼丹材料，可要抓紧来兑换啊"},{"label":"活动事件2","jp":"最近何だか、商会の雰囲気が怪しいのだ……\nこの出張研究所も、早めに畳んだ方が良いかもしれないな","zh":"最近周边商会的气氛很不寻常，这个驻外研究所也得快点关门才行。"},{"label":"活动商店1","jp":"世の中に存在するほぼ全てのものは、錬丹術で生み出せるのだ","zh":"炼丹术可以制作出世界上存在的所有物质。"},{"label":"活动商店2","jp":"うーん……先生が言ってるその「青色の石」については、ぼく様もよく知らないのだ……","zh":"老师说的那个蓝色的石头，小爷我也不太清楚。"},{"label":"活动商店关闭","jp":"出張研究所、営業終了なのだ！\nあ、でも、もし残った材料とかがあれば、是非ぼく様に見せてほしい！","zh":"驻外研究所停止营业了。不过如果还有剩下的材料，也可以拿给小爷我看看。"},{"label":"活动商店登陆1","jp":"ぼく様の出張研究所へようこそなのだ、先生！","zh":"欢迎来到小爷我的驻外研究所，老师。"},{"label":"活动商店登陆2","jp":"良い錬丹術の素材があったら、ぼく様が高く買い取るのだ！","zh":"如果有品质优良的炼丹材料，小爷我愿意高价收购。"},{"label":"活动商店购买1","jp":"悪くない選択だ！","zh":"选那个还不错。"},{"label":"活动商店购买2","jp":"ふふ、良い素材を集めてくれてありがとうなのだ","zh":"收集到了这么好的材料，谢了老师。"},{"label":"活动商店购买3","jp":"おお、素晴らしい選択なのだ！","zh":"明智的选择。"},{"label":"活动商店购买4","jp":"それは選ぶとは.....やっぱり先生は見る目があるのだ！ふふふ！","zh":"选了那个，看来老师的眼光很不错，哼哼。"}]},"stats":{"init":[{"name":"攻击力","value":"253"},{"name":"防御力","value":"18"},{"name":"生命值","value":"2392"},{"name":"治愈力","value":"1987"},{"name":"命中值","value":"420"},{"name":"闪避值","value":"759"},{"name":"暴击值","value":"262"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1090"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"7227"},{"name":"防御力","value":"103"},{"name":"生命值","value":"43836"},{"name":"治愈力","value":"8342"},{"name":"命中值","value":"640"},{"name":"闪避值","value":"759"},{"name":"暴击值","value":"1392"},{"name":"暴击伤害","value":"226%"},{"name":"稳定值","value":"1090"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"497"},{"name":"生命值","value":"2534"},{"name":"治愈力","value":"1084"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[{"name":"攻击力","value":"1000"}]},"a