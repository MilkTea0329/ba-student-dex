w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/277700.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/86082/2025/5/13/67511.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 纱织","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_261/h_261/829/86082/2025/5/13/741325.png","url":"https://www.gamekee.com/ba/164453.html"},{"name":"★3 纱织（礼服）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_715/h_655/829/86082/2025/5/13/891807.png","url":"https://www.gamekee.com/ba/654558.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"blue archive"},{"label":"卡池抽取","jp":"ここが今回のアルバイト先か…\n海は初めてだが、任せてくれ。","zh":"这次是在这里打工啊……海边是第一次，但是交给我没问题。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"先生、待っていた。\n今日の業務はなんだ？","zh":"啊，老师，我正等你呢。今天的工作是什么？"},{"label":"登陆2","jp":"ん～ん～ん～せ、先生！？い、今の、\n聞こえていたか…？","zh":"嗯~嗯~嗯~\n老，老师？！刚，刚才的听到了吗……？"},{"label":"大厅1","jp":"アルバイトだからと、\n手を抜くなどあっては\nならない。\n与えられた業務は、\nすべて全力で挑んでいる。","zh":"不能因为是兼职就敷衍了事。\n交给我的工作，我向来都会竭尽全力。"},{"label":"大厅2","jp":"次の給料でミサキに\n贈り物をしよう…","zh":"下次发工资要给美咲买个礼物……"},{"label":"大厅3","jp":"この服装は、アルバイトで\n必要だから着ているだけだが…\n先生が気に入ったと\nいうのなら、これからも\n着るとしよう。","zh":"这身衣服是因为打工才穿的……\n老师要是喜欢的话，那我以后也会继续穿的。"},{"label":"大厅4","jp":"海、お祭り…\nいつか、\nアズサとも一緒に\n訪れたいものだ。","zh":"大海，庆典……总有一天，我要跟阿梓一起去看看。"},{"label":"大厅5","jp":"海もアルバイトも、\n知らないことだらけだ。\nしかしいつまでも\n「不慣れ」を言い訳には\nできない。尽力する。","zh":"大海、打工……都是充满未知的事物。\n但也不能总是以“陌生”为借口。我会全力以赴的。"},{"label":"回忆大厅1","jp":"終演後の客席というのは、寂しいものだな。大勢いた観客がはけ、照明はすべて消えて…","zh":"演出结束后的观众席，真是冷清。\n那么多观众都离开了，灯光也全部熄灭……"},{"label":"回忆大厅2","jp":"華やかなステージは跡形もなく、静寂に沈んでいる。熱気と歓声に満ちていた空間が突如静まると…どこか、切なさを覚えるほどだ。","zh":"华丽的舞台悄无声息地沉没于寂静之中。\n原本充满热情和呐喊声的空间突然安静下来……甚至让人感到一丝不舍。"},{"label":"回忆大厅3","jp":"…でも、今はもう、\n大丈夫だ。","zh":"……但是现在没事了。"},{"label":"回忆大厅4","jp":"変わったことは何もないが、穏やかでいられる。","zh":"虽然什么都没变，但是可以平静地待着了。"},{"label":"回忆大厅5","jp":"…先生が隣にいるから、かもしれないな。","zh":"……也许是因为老师就在身边吧。"},{"label":"咖啡馆1","jp":"ここで練習してもいいか？","zh":"可以在这里练习吗？"},{"label":"咖啡馆2","jp":"あの装飾、アツコに似合いそうだ。","zh":"那个装饰……好像很适合亚津子。"},{"label":"咖啡馆3","jp":"この辺りは騒々しいな、ミサキには不向きかもしれない。","zh":"这周围真吵。美咲应该不太喜欢。"},{"label":"咖啡馆4","jp":"カフェか。ヒヨリのお気に入りの雑誌が見つかるといいのだが…。","zh":"咖啡厅啊……要是有日和喜欢的杂志就好了。"},{"label":"咖啡馆5","jp":"確かここに、家計簿が…","zh":"账本明明放在这里的……"}],"好感度":[{"label":"好感度1","jp":"先生の変わらぬ支援に、感謝を。","zh":"老师总是这么信任我。谢谢。"},{"label":"好感度2","jp":"その、もし良ければ…先生のために演奏を…あっ、いや…何でもない。","zh":"那个，呃，不介意的话……我想为老师演奏……呃，唔，还是算了。"},{"label":"好感度3","jp":"私は常に先生を応援している。それだけ…覚えていてくれ。","zh":"我一直都在支持老师。……只要记住这点就好。"},{"label":"好感度4","jp":"働いて給料をもらうのは簡単だ。しかし、先生の信頼に答えるのは、とても難しく感じる。","zh":"干活拿钱这件事很容易。但是要报答老师的信任……感觉实在很难。"}],"战斗":[{"label":"编入队伍1","jp":"何をすればいい？","zh":"要做什么呢？"},{"label":"编入队伍2","jp":"業務を全うする。","zh":"我会完成工作的。"},{"label":"拎起","jp":"次はどんな業務だ。","zh":"接下来是什么样的工作？"},{"label":"任命队长1","jp":"現場に到着した。","zh":"已到达现场。"},{"label":"任命队长2","jp":"準備完了。行くぞ。","zh":"准备就绪，出发。"},{"label":"普通技能","jp":"今日の業務も丁寧に行こう。","zh":"今天的工作也要谨慎行事。"},{"label":"EX动画1","jp":"私にできること、私がしたいことは！","zh":"我能做到的事，还有想做的事……！"},{"label":"EX动画2","jp":"何かが、見える！","zh":"我好像有头绪了……！"},{"label":"EX动画3","jp":"胸が、高鳴る！","zh":"胸口，怦怦直跳……！"},{"label":"EX技能1","jp":"これを！","zh":"就是这个……！"},{"label":"EX技能2","jp":"もう一曲！","zh":"再来一首……！"},{"label":"EX技能3","jp":"今だ！","zh":"就是现在！"},{"label":"战斗开始1","jp":"前方に立つ。","zh":"我来带头。"},{"label":"战斗开始2","jp":"皆の夏のために。","zh":"为了所有人的夏天。"},{"label":"获得BUFF","jp":"支援、感謝する","zh":"感谢支援。"},{"label":"施放BUFF","jp":"へいっ。","zh":"嘿。"},{"label":"掩体","jp":"遮蔽する。","zh":"已掩蔽。"},{"label":"被CC1","jp":"えっ。","zh":"诶。"},{"label":"被CC2","jp":"えっ。","zh":"诶。"},{"label":"被CC3","jp":"あっ。","zh":"啊。"},{"label":"回避","jp":"甘い。","zh":"太生疏了。"},{"label":"队伍移动1","jp":"移動する。","zh":"开始移动。"},{"label":"队伍移动2","jp":"次はどこだ。","zh":"接下来去哪儿？"},{"label":"回复","jp":"感謝しよう。","zh":"谢谢。"},{"label":"中途退出","jp":"まだ…やるべきことが…。","zh":"我还有未竟之事……"},{"label":"战斗喊叫","jp":"はっ。","zh":"哈。"},{"label":"战斗喊叫","jp":"ひゃっ。","zh":"嘿啊。"},{"label":"战斗喊叫","jp":"へいっ。","zh":"嘿。"},{"label":"角色移动","jp":"次。","zh":"下一个。"},{"label":"战斗胜利1","jp":"任務完了。","zh":"任务完成了。"},{"label":"战斗胜利2","jp":"そろそろ練習に行きたいのだが。","zh":"现在该去练习了……"},{"label":"关卡完成1","jp":"ステージの時間には間に合いそうだ。","zh":"应该能赶上演出时间。"},{"label":"关卡完成2","jp":"業務、完了だ。","zh":"工作完成了。"},{"label":"战斗失败1","jp":"私の力不足で、すまない。","zh":"是我力量不足，对不起。"},{"label":"战斗失败2","jp":"えっ。気が緩んでいた。","zh":"……是我松懈了。"}],"成长":[{"label":"升级1","jp":"これで業務が円滑に進む。礼を言う。","zh":"……多亏有你，工作才能顺利进行。谢谢。"},{"label":"升级2","jp":"これは…本当に受け取っていいのか？","zh":"这种东西，我真的可以收下吗……？"},{"label":"升级3","jp":"次の給料が入ったら、この恩は必ず…うん？い、いらない？","zh":"等下次我拿到薪水，一定会报答这份恩情…………呃？不，不需要吗？"},{"label":"升级4","jp":"計り知れないほど、たくさんの恩が先生にあるというのに、今の私には、感謝の言葉を返すしかできないのが…もどかしいなあ。","zh":"老师给了我数不清的恩情，……我能做的却只有感谢……真是堵心。"},{"label":"获得专武","jp":"将来は不確かだが、\n一つだけ断言できる。\n先生からもらった\nこの信頼の証は…\n最後まで、大切にする。","zh":"虽然前路未知，但有一点我可以保证。老师给予的信任的证明……我会永远视若珍宝。"}],"事件":[{"label":"学生生日","jp":"私の誕生日…\n\nああ…仕事に没頭していて忘れていた。\n\n慣れなくても、お礼はきちんと言わなければ。\n\n感謝する、先生。","zh":"老师，今天是你的生日。在这个喜庆的日子里，我准备了一首最合适的曲子。可以请你坐在那边吗？我现在就开始演奏。"},{"label":"老师生日","jp":"誕生日だな、先生。\n\nめでたい日に最適な曲を用意した。そこに座ってくれ、今から演奏する。","zh":"我的生日……啊……工作太专心，都忘记了。虽然不太习惯，但还是要好好道谢才是。谢谢你，老师。"},{"label":"万圣节","jp":"お菓子…いたずら…む…\n\nまだよく分からないな…片方を選べば、いいのか？","zh":"嗯，点心还是恶作剧……我还是不太明白，是要二选一吗？"},{"label":"新年","jp":"明けましておめでとう、先生。\n\n笑顔の一年であるよう、祈ろう。","zh":"新年快乐，老师。祝愿您新的一年喜气洋洋。"},{"label":"圣诞节","jp":"クリスマスだな。キャロルを数曲、サンプリングしてきた。\n\n聞いてくれるか？先生。","zh":"圣诞节到了。我准备了几首圣诞颂歌的样曲，要听一下吗？老师。"},{"label":"春节","jp":"","zh":"老师，过年好！刚才领薪水的时候，发现信封变成了红色的……啊，原来这是新春的习俗吗？去沙勒一起贴春联？……好的，接下来没有工作安排，我这就去！"},{"label":"中秋","jp":"","zh":"昨天接到了做月饼的紧急工作，作为报酬也领到了一些月饼……这，这是我亲手做的，如果不嫌弃的话……请老师尝尝吧。"}],"活动":[{"label":"活动登陆1","jp":"次の仕事は…\nあ、先生、\n何か手伝ってほしいのか？","zh":"接下来的工作是……啊，老师。有什么需要帮忙的吗？"},{"label":"活动登陆2","jp":"い、いらっしゃいませ！\n何名様…\n\n…あ、先生だったか。\nすまない。反射でつい。","zh":"欢迎光临！请问几位？……啊，是老师啊。对不起。问候语说顺口了。"},{"label":"活动大厅1","jp":"海は…\n果てしなく広くて、\n驚くほど水が多いのだな。\n\n感心した。","zh":"大海……一望无际，海水之无限，真的令人惊叹。"},{"label":"活动大厅2","jp":"もう少し\n時間があったら、\nステージの完成度を\nあげられたのに…。","zh":"如果再多一点时间，舞台的完成度还可以更高……"},{"label":"活动大厅3","jp":"海風は涼しいな。\n\n熱を冷ますのに\nちょうどいい。","zh":"海风好凉爽。正好能吹干汗水。"},{"label":"活动大厅4","jp":"楽しいお祭りになるよう、\n最善を尽くそう。\n先生も、どうかお祭りを\n楽しんでくれ。","zh":"为了打造一场欢乐的庆典，我会全力以赴。\n希望老师也能好好享受庆典。"},{"label":"活动事件1","jp":"アルバイトはまだ\n終わっていない。\n\n最後まで、\n気を引き締めていこう。","zh":"打工还没结束。 打起精神坚持到最后吧。"},{"label":"活动事件2","jp":"お祭りも終盤だな。\n楽しめたか？先生。","zh":"庆典也快结束了。玩得开心吗？老师。"},{"label":"活动结束","jp":"今回の仕事も、\n無事に終わったな。\n先生のおかげだ。\n恩に着る。","zh":"这次的工作也顺利完成了。多亏了老师。承蒙你的照顾了。"},{"label":"活动任务1","jp":"アルバイトで生計を\n立てている身だ。\n\n仕事の案件は、しっかり\n管理しなければならない。","zh":"我是靠打工维持生计的人。工作内容必须严格管理。"},{"label":"活动任务2","jp":"せ、先生、私に用か？","zh":"老，老师？找我有事吗？"},{"label":"活动任务每日结束","jp":"今日はここまでだ。協力に感謝する。先生、一緒に飲み物でも飲まないか？","zh":"今天就到这里吧，谢谢老师的协助。要不要一起喝杯饮料？"},{"label":"活动任务登录1","jp":"悪いが先生、\n少し力を貸してくれ。\n\n私一人では手が回らなくてな。","zh":"啊，老师很抱歉，能帮个忙吗？我一个人有点应付不来。"},{"label":"活动任务登陆2","jp":"今日の業務リストだ。\n先生、手伝ってもらえるか？","zh":"这是今天的工作清单。老师，可以帮帮我吗？"},{"label":"活动任务获取1","jp":"おかげで助かった。\n先生は敏腕だな。","zh":"得救了。老师做事真利索呀。"},{"label":"活动任务获取2","jp":"もう片付けたのか…？\n\nお礼にこれを…\n受け取ってくれ。","zh":"已经整理好了吗……？那……请老师收下这份谢礼。"}]},"stats":{"init":[{"name":"攻击力","value":"298"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2400"},{"name":"治愈力","value":"1723"},{"name":"命中值","value":"733"},{"name":"闪避值","value":"761"},{"name":"暴击值","value":"209"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1332"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6944"},{"name":"防御力","value":"104"},{"name":"生命值","value":"54789"},{"name":"治愈力","value":"6136"},{"name":"命中值","value":"953"},{"name":"闪避值","value":"761"},{"name":"暴击值","value":"1339"},{"name":"暴击伤害","value":"226%"},{"name":"稳定值","value":"1332"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"15 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"585"},{"name":"生命值","value":"3359"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[]},"abilityDetail":{"attrs":[{"name":"生命值","value":"974"},{"name":"攻击力","value":"111"},{"name":"治愈力","value":"205"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/103682/2025/6/18/42356.png","attrs":[{"name":"攻击力","value":"153"},{"name":"生命值","value":"1130"}]},{"label":"羁绊角色2","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_261/h_261/829/103682/2025/6/18/599610.png","attrs":[{"name":"攻击力","value":"128"},{"name":"生命值","value":"1185"}]},{"label":"羁绊角色3","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_182/h_144/829/103682/2025/6/18/698524.png","attrs":[{"name":"攻击力","value":"158"},{"name":"生命值","value":"1145"}]}],"review":{"score":"63(B)","scoreIcon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_78/h_78/829/236746/2026/5/4/1780538755206_1780484382794_le19f6is7b_4r3p0fwre2.png","tiers":[{"name":"新手期","value":"★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538770230_1780484152979_ztlyoqzvjh_jegj7hm1j8.png"},{"name":"总力战","value":"★★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538776594_1780484206588_4dnfad9a3r_3ot3lq8zz4.png"},{"name":"大决战","value":"★","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/1780538781498_1780484086283_7rhrvvb2ea_pkm9d9l9xl.png"},{"name":"竞技场","value":"不适合","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_23/h_23/829/236746/2026/5/4/178053878