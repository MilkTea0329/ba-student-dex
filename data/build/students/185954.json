oriteItem":{"icon":"","name":"","desc":"","t1":"","t2mats":[],"t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"朝比奈 フィーナ(ガイド)","kana":"朝比奈 あさひな","twName":"菲娜","cnName":"菲娜","age":"17岁","birthday":"11月3日","height":"165cm","hobby":"侠客电影鉴赏","designer":"-","artist":"Mx2J","cv":"日 | 木戸衣吹\n中 | 苏子芜\n韩 | 박이서（朴怡书）","hallLevel":"6","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"今天的向导就是我！","bio":"因修学旅行而担任向导的菲娜。\n即使成为向导，她特有的开朗活泼与积极性格也未曾改变。反而活用这份特质，以超越常人的热情投身向导工作的祭典运营管理部成员。或许需要稍微留意——她是否把侠客体验和修学旅行搞混了呢？","sourceUrl":""},"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"667"},{"name":"攻击力","value":"145"},{"name":"治愈力","value":"231"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/408835.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/103682/2025/5/12/848265.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 菲娜","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_216/h_216/829/103682/2025/5/12/532453.png","url":"https://www.gamekee.com/ba/68176.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive~"},{"label":"卡池抽取","jp":"百鬼夜行連合学院、お祭り運営委員会の朝比奈フィーナ！\n皆さんをご案内しマス！","zh":"我是百鬼夜行联合学院庆典运营管理部的朝比奈菲娜！接下来由我来做各位的导游！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"全員集まりマシタぜ、お頭！\n……いえ、センセイ！","zh":"大家都到齐了，老师！"},{"label":"登陆2","jp":"センセイ！今日はフィーナが当番のガイドを務めマス！","zh":"老师！今天的导游是菲娜！"},{"label":"大厅1","jp":"制服を身に纏い、先頭に立って道を示す……。","zh":"身穿黑衣，引领众人……"},{"label":"大厅2","jp":"なんだか任侠みたいデスね！","zh":"这不也是一种侠客之道吗？！"},{"label":"大厅3","jp":"百鬼夜行は私の庭のようなものです！\n案内なら任せてクダサイ！","zh":"百鬼夜行对我来说，就跟我家院子一样熟悉！需要导游的话，就交给我吧！"},{"label":"大厅4","jp":"ワタシたちのやり方でお出迎えしマス！\n覚悟してクダサイ！","zh":"我会用我们的方式迎接您的！请您做好心理准备！"},{"label":"大厅5","jp":"センセイと一緒なら無敵デス！","zh":"只要和老师在一起，我就是无敌的！"},{"label":"回忆大厅1","jp":"うーん、ハッ！\n……なんだか、緊張していたみたいデス。\nお客さんと一緒の間は夢中だったから、気づかなったのデスが……\nこうして先生と一緒にいると、なんだか心が落ち着きマス。","zh":"嗯……哈！嗯，总觉得刚才一直很紧张呢。和游客们在一起时太专注了，自己都没发现……但像这样和老师待在一起，就感觉，身心全都放松下来啦。"},{"label":"回忆大厅2","jp":"軽やかに動くためにはストレッチは必須デス！\nもう一度！\nん、んん、うーん！","zh":"想要身手敏捷，拉伸是必须的！再来一次！呜，嗯嗯……嗯嗯……啊……！"},{"label":"回忆大厅3","jp":"え？肩の力を抜いた方が\nイイ……デスか？","zh":"诶？我放松下来的样子……很好吗？"},{"label":"回忆大厅4","jp":"そ、その……これはガイドとして気合いを入れているといいマスか……。\n二人っきりだと……\nその……。","zh":"那，那个……身为导游，精气神和责任感当然重要……但两个人独处的时候，该怎么说呢……"},{"label":"回忆大厅5","jp":"つい、リラックスしてしまうから……。","zh":"就会，忍不住放松下来……"},{"label":"咖啡馆1","jp":"Wow〜、任侠映画のセットみたいでカッコイイデス！","zh":"Wow~这里就像侠客作品里的事务所一样，好酷！"},{"label":"咖啡馆2","jp":"（このテレビ……映画が観られマス！）","zh":"（这台电视……能看电影！）"},{"label":"咖啡馆3","jp":"なんだかどこかで見たことある気がしマス！","zh":"这种氛围，好像在哪里见过！"},{"label":"咖啡馆4","jp":"素敵な方が多いデス……フィーナも負けていられマセン！","zh":"好多优秀的学员……菲娜也不能落后！"},{"label":"咖啡馆5","jp":"なんだか眠くなってきマシタ……。","zh":"看到老师休息的样子，我也想睡午觉了……"}],"好感度":[{"label":"好感度1","jp":"ガイドの制服、いかがでしょう…","zh":"这件导游的制服，您觉得怎么样？"},{"label":"好感度2","jp":"この制服、なんだか任侠感じマス！センセイも喜んでくれると嬉しいデス！","zh":"这身打扮，是不是很有侠客的感觉！希望老师也会喜欢！"},{"label":"好感度3","jp":"パッチリガイドができるようになったのも、センセイのおかげデス！","zh":"我能当好导游……全都多亏了老师！"},{"label":"好感度4","jp":"素敵だなって思ってもらいたいデス。私じゃなくて百鬼夜行のことデス！","zh":"希望能让老师多多感受到好的地方。……啊，不是说我的，是说百鬼夜行的！"}],"战斗":[{"label":"编入队伍1","jp":"案内が必要なんですね～","zh":"您需要导游是吧！"},{"label":"编入队伍2","jp":"出発しましょう！","zh":"那我们出发了！"},{"label":"拎起","jp":"わぁ！こんな景色になるんデスね！","zh":"哇！原来是这样的景色！"},{"label":"普通技能","jp":"ついてきてクダサイね！","zh":"大家跟上我哦！"},{"label":"EX动画1","jp":"参りマス！！","zh":"走吧！"},{"label":"EX动画2","jp":"ガイドにお任せ下サイ！","zh":"交给本导游吧！"},{"label":"EX动画3","jp":"任侠、ここに参上！","zh":"侠客登场！"},{"label":"EX技能1","jp":"さあ、派手に行きマスよ！","zh":"来，华丽地上吧！"},{"label":"EX技能2","jp":"これで、OKデス！","zh":"这样就OK了！"},{"label":"EX技能3","jp":"Oh！弾けマス！","zh":"Oh！火力全开！"}],"成长":[{"label":"升级1","jp":"燃えてキマシタよ！","zh":"燃起来了！"},{"label":"升级2","jp":"センセイを守るために、頑張りマス！","zh":"为了保护老师，我要再接再厉！"},{"label":"升级3","jp":"フィーナ、Powerがみなぎってキマシタ！","zh":"菲娜浑身充满了Power！"},{"label":"升级4","jp":"なんだか力があるれて来マス！","zh":"感觉浑身充满力量！"},{"label":"获得专武","jp":"1段階、イヤ、\n500段階は成長できた気がしマス！","zh":"感觉自己更上一层，不对，是500层楼了！"}],"事件":[{"label":"学生生日","jp":"今日はフィーナのBirthdayデス！\nHappy birthday to me～！","zh":"今天是菲娜的生日哦！Happy birthday to me~！"},{"label":"老师生日","jp":"センセイ、今日はBirthdayデスね？\n宴の準備はバッチリデス！","zh":"今天是老师的Birthday对吧？宴会的准备包在我身上！"},{"label":"万圣节","jp":"Trick or Treat!\nHalloween、デス！","zh":"Trick or Treat！Halloween到了！"},{"label":"新年","jp":"Happy New Year！\n新年おめでとうございマス、お頭！\n……いや、センセイ！","zh":"Happy New Year！新年快乐，头儿！……不对，老师！"},{"label":"圣诞节","jp":"ホッホッホー、\nメリークリスマス！\nデス、センセイ！","zh":"呵呵呵，圣诞快乐，老师！"},{"label":"春节","jp":"","zh":"老师！菲娜来为您恭贺新禧了！今天的庆典可是一年中最热闹的！就让我来为您导游吧！"},{"label":"中秋","jp":"","zh":"今天是中秋节，对吗！听说这是个历史悠久的节日，有许多与它有关的故事！不才菲娜，能肩负起导游讲解的任务吗……！"}],"活动":[{"label":"活动登陆1","jp":"Welcome to～百鬼夜行！","zh":"Welcome to~百鬼夜行！"},{"label":"活动登陆2","jp":"百鬼夜行へ、ようこそ\nいらっしゃいマシタッ！","zh":"欢迎来到百鬼夜行~！"},{"label":"活动大厅1","jp":"ジャーン！\nガイドはお任せあれ！デス！","zh":"锵锵！导游工作就交给我吧！"},{"label":"活动大厅2","jp":"迷子にならないように\n気をつけてクダサイね！","zh":"小心不要迷路哦！"},{"label":"活动大厅3","jp":"先生がいると、賑やかで楽しいデス！","zh":"有老师一起参与，气氛更加活跃了呢。"},{"label":"活动大厅4","jp":"みんなが楽しそうで、フィーナも嬉しいデス！","zh":"大家玩得这么开心，菲娜也很高兴！"},{"label":"活动事件1","jp":"センセイ！\n楽しんでマスか？","zh":"老师！您玩得开心吗？"},{"label":"活动事件2","jp":"だいぶガイドにも慣れてきマシタ！\n最後まで頑張りマスよ！","zh":"现在我已经很熟练了！我会加油坚持到最后的！"},{"label":"活动结束","jp":"また百鬼夜行にお越しの際は、\nフィーナにお声がけクダサイね","zh":"老师！下次也要来百鬼夜行找菲娜哦！"}]},"stats":{"init":[{"name":"攻击力","value":"388"},{"name":"防御力","value":"65"},{"name":"生命值","value":"2191"},{"name":"治愈力","value":"1933"},{"name":"命中值","value":"498"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"255"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"15