name":"生命值","value":"999"},{"name":"攻击力","value":"122"},{"name":"治愈力","value":"200"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/11/65871.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/11/232113.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 柚子（女仆）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/11/263352.png","url":"https://www.gamekee.com/ba/589650.html"},{"name":"NPC 柚子（冬装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/953939.png","url":"https://www.gamekee.com/ba/647100.html"},{"name":"★3 柚子（临战）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_232/h_239/829/191981/2026/0/18/274123.png","url":"https://www.gamekee.com/ba/690661.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive"},{"label":"卡池抽取","jp":"ゲーム開発部、部長……ユズです。ほ、本当に……わたしを連れてってくれるんですか？","zh":"我是……游戏开发部部长，柚子\n真的，要带上我吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"せ、先生。いらっしゃい。待ってました。","zh":"老，老师，您来了，\n我正等着您呢"},{"label":"登陆2","jp":"先生……お帰りなさい。","zh":"老师，欢迎回来"},{"label":"大厅1","jp":"先生の頼みなら……喜んでお受けします。","zh":"只要是老师的请求，我都会欣然接受"},{"label":"大厅2","jp":"はい。どんなことでもおっしゃってください。ベストを……尽くします！","zh":"嗯，不管是什么事，您尽管说就好了，我都会尽力而为"},{"label":"大厅3","jp":"あ。猫も飼いたいです。ゲームと猫さえあれば、世の中を生きていけます。","zh":"啊，我也想养猫。只要有游戏和猫咪，我就能在这个世界上活下去"},{"label":"大厅4","jp":"……はい。先生。わたしも、強くなります。先生とみんなが……わたしを守ってくれたように、わたしもみんなの力になりたいです。","zh":"嗯，老师，我也会变强的。\n就像老师和大家保护我一样，我也想为大家尽一份力。"},{"label":"大厅5","jp":"(この人に……相応しいわたしになりたい。)","zh":"（我想变得，配得上这个人！）"},{"label":"回忆大厅1","jp":"先生とじゃなかったら……できなかったと思います。","zh":"如果没有老师，我肯定做不到这些"},{"label":"回忆大厅2","jp":"みんなにプレゼントができたのは、先生のおかげです。","zh":"多亏了老师，我才能顺利的给大家送礼物"},{"label":"回忆大厅3","jp":"先生が助けてくれたように……\n先生にわたしが必要な瞬間が来たら、何でも言ってくださいね。","zh":"老师帮助了我\n所以，老师在需要我的时候，还请尽管开口"},{"label":"回忆大厅4","jp":"……必ず、恩返しします。","zh":"我一定会报答您的！"},{"label":"咖啡馆1","jp":"うーん...隠れられる場所はないのかな...","zh":"呜……有没有什么地方能躲起来啊"},{"label":"咖啡馆2","jp":"ひゃっ！ど、どうしてここに！","zh":"呀……您……您怎么会在这？"},{"label":"咖啡馆3","jp":"きっと先生も……オトナな女性が好きなはず、だよね？","zh":"老师……应该……也喜欢成熟的女性吧？"},{"label":"咖啡馆4","jp":"本格的に、ゲームを勉強したい。","zh":"我想更加正式的研究游戏！"},{"label":"咖啡馆5","jp":"ゆったりとした空間だね。こんなところですやすやしたいな。","zh":"这里感觉好舒服啊……\n我好想在这里睡觉觉……"}],"好感度":[{"label":"好感度1","jp":"め、迷惑…かけてないですよね？……それなら…いひひ…よかったです…！","zh":"没给您添麻烦吧？\n诶嘿嘿，那就好"},{"label":"好感度2","jp":"よく……わからないんです。本当によくわからない気持ちなのですが……うれしい……です。","zh":"我不太明白，真的不太明白，现在的心情究竟是什么\n但是我很开心"},{"label":"好感度3","jp":"授業や指揮をしてくださる時……なんだか先生は……あの……本当に……格好いい、というか……。","zh":"总觉得老师担任顾问和指挥的时候……\n真的很帅"},{"label":"好感度4","jp":"わ、わたしも先生のこと……。えっと……その……。は、恥ずかしい！","zh":"我……我也对老师……\n呜……羞死人啦……"}],"战斗":[{"label":"编入队伍1","jp":"せ、先生が必要としてくれるのであれば……わたしも。","zh":"如果老师需要的话，我也……"},{"label":"编入队伍2","jp":"な、仲良くなれるように頑張ります……多分。","zh":"我会努力和大家成为好朋友的，应该吧……"},{"label":"拎起","jp":"わ、わたしをですか？うぅ……やってみます！","zh":"选……选我吗？我试试看"},{"label":"任命队长1","jp":"ほ、他の人たちと一緒に……？が、頑張ります。","zh":"和……和其他人一起？我会加油的"},{"label":"任命队长2","jp":"えっ！ベ、ベストは尽くします！","zh":"诶？我……我会尽力的"},{"label":"普通技能","jp":"っが...頑張ります……！","zh":"我……我会加油"},{"label":"EX动画1","jp":"行きます……！","zh":"我要上了"},{"label":"EX动画2","jp":"照準は、定まりました！","zh":"目标已瞄准"},{"label":"EX动画3","jp":"これは……面白いと思います！","zh":"我觉得，这个还挺好玩"},{"label":"EX技能1","jp":"レトロよ……永遠であれ！","zh":"复古游戏啊，成为永恒吧！"},{"label":"EX技能2","jp":"覚悟してください！","zh":"请做好觉悟吧！"},{"label":"EX技能3","jp":"これが……創作の苦しみです！","zh":"这，就是创作的痛苦！"},{"label":"战斗开始1","jp":"と、とりあえず、部長らしい姿を見せないと……！","zh":"总之……必须要有部长的样子"},{"label":"战斗开始2","jp":"落ちついて、気をつけながら進みましょう。","zh":"冷静下来，保持警惕前进吧！"},{"label":"获得BUFF","jp":"あ...ありがとうございます……！","zh":"非……非常感谢"},{"label":"施放BUFF","jp":"頑張ります……！","zh":"我会加油……"},{"label":"掩体","jp":"こ、ここに隠れて引きつけます、今のうちに！","zh":"我……我藏在这里吸引火力，趁现在！"},{"label":"被CC1","jp":"ひぃ……！","zh":"呀！"},{"label":"被CC2","jp":"痛い……","zh":"好疼"},{"label":"被CC3","jp":"だ……大丈夫です。","zh":"不要紧……"},{"label":"回避","jp":"これぐらいなら、だ……大丈夫です！","zh":"就这样的话……没问题！"},{"label":"队伍移动1","jp":"なんとかやり遂げました、つ...続けて行きます！","zh":"总算完成了……继续前进！"},{"label":"队伍移动2","jp":"危ないところでした……","zh":"刚才好险啊……"},{"label":"回复","jp":"ご配慮……ありがとうございます！","zh":"十分感谢您的照顾！"},{"label":"中途退出","jp":"ひぃ……ごめんなさい……","zh":"呜呜……对不起……"},{"label":"战斗喊叫","jp":"え...えい！","zh":"哎！"},{"label":"战斗喊叫","jp":"はあ！","zh":"哈——"},{"label":"战斗喊叫","jp":"行きます！","zh":"我要上啦！"},{"label":"特殊载具","jp":"こ、これは......私が相乗します！","zh":"这…这是……让我来助你一臂之力！"},{"label":"特殊载具","jp":"私は、エースパイロットです！ゲームでの話ですが...","zh":"我是王牌驾驶员！虽说只是在游戏里…"},{"label":"角色移动","jp":"い、行きます！","zh":"前……前进！"},{"label":"战斗胜利1","jp":"ふぅ……役に立って、嬉しいです。","zh":"呼……能帮上忙，我很高兴！"},{"label":"战斗胜利2","jp":"お、お疲れ様でした！えへへ……","zh":"大……大家辛苦了……诶嘿嘿"},{"label":"关卡完成1","jp":"ふぅ……良かったぁ……","zh":"啊……太好了"},{"label":"关卡完成2","jp":"成功……！嬉しいです、こんな気分なんですね。","zh":"好开心，原来成功是这样的心情呢~"},{"label":"战斗失败1","jp":"ご、ごめんなさい！","zh":"对……对不起！"},{"label":"战斗失败2","jp":"はぁ、だめぇ……！","zh":"啊……不行了……"}],"成长":[{"label":"升级1","jp":"先生のおかげで少し安心しました。","zh":"多亏了老师，可以稍微放心一点了"},{"label":"升级2","jp":"もっと自信のあるわたしになりたいです。","zh":"我……想变得更有自信！"},{"label":"升级3","jp":"怖いとき……ですか？うーん……先生がそばにいないとき……でしょうか。","zh":"什么时候会害怕……\n唔……老师不在身边的时候吧？"},{"label":"升级4","jp":"わ、わたしはちっとも強くないですが……頑張ります！みんなのことが本当に好きだから。","zh":"我……我真的一点都不强\n但我会努力的，因为我真的很喜欢大家"},{"label":"获得专武","jp":"体の中で、力が漲ってる感じです。これが...勇気...でしょうか？","zh":"身体里有种力量涌动的感觉\n这就是勇气吗？"}],"事件":[{"label":"学生生日","jp":"きょ、今日はわたしの誕生日です。キヴォトスの文化の日ですからね……忘れちゃダメですよ。","zh":"今……今天是我的生日，也是基沃托斯的文化日\n所以……不可以忘记哦……"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生。本当に……本当に……！","zh":"老师，祝您生日快乐！\n我是真心的！"},{"label":"万圣节","jp":"街が、光るカボチャと飴で溢れていますね。わ、わたしも行ってみたいです。先生と一緒に……。","zh":"街上到处都是闪闪发光的南瓜和糖果诶\n我也想去看看，和老师一起"},{"label":"新年","jp":"明けましておめでとうございます。わたし、もっと成長した姿を、お見せしますから。","zh":"新年快乐，我会让您看到我更加成熟的样子"},{"label":"圣诞节","jp":"メ、メリークリスマス……先生。サンタとゲームは……似ています。どちらもトキメキをプレゼントしてくれるので。","zh":"圣诞快乐，老师。\n圣诞老人跟游戏有着相似之处，因为两者都会让人心跳加速"},{"label":"春节","jp":"","zh":"老师，新春快乐！\n今年我想做出更有趣的游戏……还想和老师更亲近一点"},{"label":"中秋","jp":"","zh":"中秋节快乐，真的要和我一起过节吗……\n不是的……我当然很开心……诶嘿嘿"}]},"stats":{"init":[{"name":"攻击力","value":"435"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2461"},{"name":"治愈力","value":"1683"},{"name":"命中值","value":"102"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"191"},{"name":"暴击伤害","value":"240%"},{"name":"稳定值","value":"976"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"1 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"10690"},{"name":"防御力","value":"107"},{"name":"生命值","value":"57024"},{"name":"治愈力","value":"5992"},{"name":"命中值","value":"302"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"821"},{"name":"暴击伤害","value":"306%"},{"name":"稳定值","value":"976"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"1 (1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"1239"},{"name":"生命值","value":"4997"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"150"}]},{"slot":"3号装备","name":"手表","grade":"T10","attrs":[{"name":"暴击值","value":"480"},{"name":"暴击伤害","value":"2600"},{"name":"生命值","value":"15%"}]}],"giftDetail":{"t1Value":[{"name":"暴击伤害","value":"2000"},{"name":"命中值","value":"200"}]},"abilityDetail":{"attrs":[{"name":"生命值","value":"999"},{"name":"攻击力","value":"162"},{"name":"治愈力","value":"200"}]},"bond":[{"label":"羁绊角色1","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_250/h_250/829/72324/2025/5/11/982464.png","attrs":[{"name":"攻击力","value":"231"},{"name":"生命值","value":"1185"}]},{"label":"羁绊角色2","icon":"h