-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43758/2025/5/13/264717.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43758/2025/5/13/626437.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 吹雪（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43758/2025/5/13/334820.png","url":"https://www.gamekee.com/ba/617235.html"},{"name":"NPC 吹雪（偶像）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/43758/2025/5/13/581753.png","url":"https://www.gamekee.com/ba/639185.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue archive。"},{"label":"卡池抽取","jp":"え？私？人違いじゃないの？は...この怠け者にいったい何の用なんだか？","zh":"我，你是不是找错人了？找我这个懒鬼干什么？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おっと、先生じゃん。","zh":"老师，你来啦。"},{"label":"登陆2","jp":"お疲れ先生、まあ...私は何もしてないんだけど。","zh":"辛苦啦老师，虽然我什么都没做。"},{"label":"大厅1","jp":"は......眠い...","zh":"好，快啊。"},{"label":"大厅2","jp":"どうしてキリノは、自分から苦労を背負い込むのか...","zh":"桐乃为什么那么喜欢自找苦吃呢？"},{"label":"大厅3","jp":"警察が暇ってことは、間違い平和だってこと。\nつまり逆に考えれば、平和のためには怠けたほうがいい。","zh":"警员悠闲说明城市和平嘛。所以反过来想，为了城市的和平，还是懒一点比较好。"},{"label":"大厅4","jp":"オールドファッション...名前は微妙だけど、味は最高なんだよね...","zh":"古典甜甜圈，虽然名字有点土，但味道是最好的。"},{"label":"大厅5","jp":"穴の無いドーナッツは...ドーナッツじゃなく...\nただの...揚げパンなんじゃ...","zh":"没有动的甜甜圈根本就不是甜甜圈。只能算是炸面包吧。"},{"label":"回忆大厅1","jp":"ああ...これぞ天国...\n暖かいボンネットの上で、ドーナッツとコーヒー、やぁ...張り込み最高。","zh":"简直是天堂啊。\n坐在暖暖的引擎盖上，吃着甜甜圈，喝着咖啡。简直真是太棒了。领导们应该不会来这里吧？"},{"label":"回忆大厅2","jp":"あ？先生、ちゃんと周りを警戒しておいてよ。\nこうしてる間にも、犯人が通り過ぎるかもしれないし。","zh":"oh，老师一定要注意观察周围哦。在我们吃甜甜圈的时候，可别让犯人偷偷溜走喽。"},{"label":"回忆大厅3","jp":"（はう...もぐ...もぐ...）","zh":"home so。"},{"label":"回忆大厅4","jp":"やっぱり、コーヒーと一緒に食べるなら、オールドファッションが嗜好。","zh":"要搭配咖啡的话，还是古典甜甜圈最合适啊。"},{"label":"回忆大厅5","jp":"うん？どうしたの先生？ふふ、ドーナッツ食べたい？","zh":"嗯？怎么了老师？嘿嘿，要吃甜甜圈吗？"},{"label":"咖啡馆1","jp":"あ～このソファーは悪くないね。","zh":"哟，这沙发蛮不错啊。"},{"label":"咖啡馆2","jp":"こういうの、生活安全局の事務所にもほしいかも。","zh":"要是生活安全局的办公室里也有一个就好啦。"},{"label":"咖啡馆3","jp":"もう...いっさい何もしたくない。","zh":"我要努力做一个什么都不干的人。"},{"label":"咖啡馆4","jp":"ああ...何か...サイレンの音が聞こえる気が...","zh":"我好像听到了警笛声。"},{"label":"咖啡馆5","jp":"...まさか、上層部がここまで来ることは...ないと思うけど。","zh":"领导们应该不会来这里吧？"}],"好感度":[{"label":"好感度1","jp":"へ...先生も私と一緒にサボる？","zh":"老师要和我一起摸会鱼吗？"},{"label":"好感度2","jp":"本当は...休憩を邪魔されるのは嫌いなんだけど...まあ、先生なら別にいいや。","zh":"其实我很讨厌别人打扰我休息。果然老师是个例外。"},{"label":"好感度3","jp":"ここでこうして休憩するの...なんだか落ち着くな...","zh":"在这里休息，不知不觉就放松下来啦。"},{"label":"好感度4","jp":"先生...その...えっと...あ...とりあえず、ドーナッツ食べる？","zh":"老师，就是~你要来个甜甜圈吗？"}],"战斗":[{"label":"编入队伍1","jp":"ねえぇぇ...私まで行く必要ある？","zh":"我说我就没必要去了吧。"},{"label":"编入队伍2","jp":"めんどくさー。","zh":"好麻烦。"},{"label":"拎起","jp":"ねっむぁ。","zh":"好困啊。"},{"label":"任命队长1","jp":"え？どうして私がリーダー？","zh":"为什么我是队长啊？"},{"label":"任命队长2","jp":"ええ？私が戦闘に？マジで言ってる...","zh":"让我先走。真的吗？"},{"label":"普通技能","jp":"当たったらラッキーってことで。","zh":"能不能打中就随缘喽。"},{"label":"EX动画1","jp":"休憩時間だ。","zh":"休息时间到。"},{"label":"EX动画2","jp":"ちょっと失礼～休んでからにしよう。","zh":"打扰了，先休息一下吧。"},{"label":"EX动画3","jp":"ドーナッツタイムってことで。","zh":"要是还有咖啡就好了。"},{"label":"EX技能1","jp":"どんな状況でも、余裕を失っちゃだめなんだって。","zh":"任何情况下都要保持从容。"},{"label":"EX技能2","jp":"あふ...ふん...うん～～うまい～","zh":"啊呜~啊呜~好吃~"},{"label":"EX技能3","jp":"コーヒーも欲しいどころだな...","zh":"要是还有咖啡就好了。"},{"label":"战斗开始1","jp":"さて...まあ、いい感じにやろう。","zh":"好，那就随便跟着感觉走吧。"},{"label":"战斗开始2","jp":"そーんなに焦らなくてもいいから、適当に...","zh":"不用太着急，慢慢来。"},{"label":"获得BUFF","jp":"私より、他の誰かにやってあげたら？まあ...一応感謝するけど。","zh":"给我还不如给别人呢，不过还是谢啦。"},{"label":"施放BUFF","jp":"あ....ここまでやる必要あるかな...","zh":"有必要做到这个地步吗？"},{"label":"掩体","jp":"おっと....","zh":"我想。"},{"label":"被CC1","jp":"うぇ...","zh":"唔…"},{"label":"被CC2","jp":"っえ...","zh":"呃…"},{"label":"被CC3","jp":"あ....もう....","zh":"我真是的。"},{"label":"回避","jp":"はは.....くすぐったいじゃん。","zh":"好呀。"},{"label":"队伍移动1","jp":"ああ...こっちの方？","zh":"来我这边吧。"},{"label":"队伍移动2","jp":"あれ...？こっちであってる？","zh":"啊……是这边吗？"},{"label":"回复","jp":"うん...ありがとう。","zh":"oh，谢谢啊。"},{"label":"中途退出","jp":"疲れた...まあ...動けない...","zh":"好累……动不了一点"},{"label":"战斗喊叫","jp":"あ...","zh":"哈…"},{"label":"战斗喊叫","jp":"一発で終わってぇ...","zh":"服了，一枪就结束吧。能别碍事吗？"},{"label":"战斗喊叫","jp":"邪魔しないでくれる？","zh":"能别碍事吗？"},{"label":"角色移动","jp":"この区域のパトロールは終了...ってことで。","zh":"这片区的巡逻已经结束啦"},{"label":"战斗胜利1","jp":"働いた後のコーヒーとドーナッツ、最高。","zh":"干完活，喝杯咖啡，吃个甜甜圈，太棒啦。"},{"label":"战斗胜利2","jp":"あーー疲れた疲れた、糖分補給しなきゃ。","zh":"好嘞好嘞，我得补充点糖分。"},{"label":"关卡完成1","jp":"終わった？終わったよね？よっしゃ、帰ろう帰ろう。","zh":"完事了，都完事了。好，下班，下班啦。"},{"label":"关卡完成2","jp":"や...本当に勝ってるとは思ってなかった。","zh":"没想到真的能赢。"},{"label":"战斗失败1","jp":"そもそも生活安全局は...戦闘向きじゃないんだって。","zh":"生活安全局本来就不是负责打架的。"},{"label":"战斗失败2","jp":"やっぱり無理だったか...","zh":"我就知道不行。"}],"成长":[{"label":"升级1","jp":"これを...私に？何で？相手間違えてない？","zh":"这个是给我的，为什么？你是不是搞错人了？"},{"label":"升级2","jp":"私は別に...今のままで十分なんだけど。","zh":"我呢，现在这样已经很满足了。"},{"label":"升级3","jp":"まあ...一応先生の好意はありがたく受け取っておく。","zh":"总之，老师的好意我收到了，谢谢。"},{"label":"升级4","jp":"これ以上頑張るのは...うん...ドーナッツとか余ってない？それさえあれば...なんとか...","zh":"哦，要我比现在更努力，甜甜圈还有剩吗？有的话我就再想想办法。"},{"label":"获得专武","jp":"ヴァルキューレ警察学校の制式銃は丈夫でいい感じなんだよね...まあ...命中率はいまいちだけど。","zh":"瓦尔基利的制式枪支很结实，感觉很不错。嗯，不过命中率不怎么样。"}],"事件":[{"label":"学生生日","jp":"誕生日なのに学校に行かなきゃいけないのっておかしくない？\n祝ってくれるなら、今日ぐらい休ませてほしいもんだよ。","zh":"你不觉得生日当天还要上学上班这件事很奇怪吗？谁想为我庆祝的话，今天就让我休息一下吧。"},{"label":"老师生日","jp":"うん？今日って先生の誕生日？あ...プレゼントとか何も無いな...\nしょうがない...今日は先生がどんな悪いことをしても、特別に目をつぶってあげる。","zh":"今天是老师的生日。我也没准备什么礼物。没办法了，如果今天老师犯了什么事儿，我就装作没看到吧。"},{"label":"万圣节","jp":"うん？町でお化けの仮面を被ったバカたちが暴れてる？\nああ......はい、これ...電話かけたら、警備局につながるから、あっちに頼んで。","zh":"我，你说有一群戴着怪物面具的笨蛋在市区捣乱。知道给这里打电话就能接通，警备局，你跟他们说吧。"},{"label":"新年","jp":"なんと、今日のお昼は特別なものを...\nえ？お世辞？いや...まあスタードーナッツのボックスセットだけど？","zh":"嗯？自己做的年节菜？不是啊？是【老师傅甜甜圈】的礼盒套餐啦。我今天特意带饭过来了。"},{"label":"圣诞节","jp":"クリスマス自体はまあ...どうでもいいんだけど、次の日特に出てくる、あの特売価格のケーキだけはたまんないね...","zh":"虽然我不怎么喜欢圣诞节本身，但对长假过后的特价蛋糕还是举双手欢迎的。"},{"label":"春节","jp":"","zh":"平安无事又一年，老师祝你今年工作变少。怎么样？是不是很实用的祝福啊。"},{"label":"中秋","jp":"","zh":"老师要来个甜甜圈吗？其实不是甜甜圈，是月饼啦。"}],"活动":[{"label":"活动登陆1","jp":"今日も忙しそうだね、先生。さっき買ってきたんだけど、チョコドーナっツでも食べる？","zh":"老师，你今天好像也很忙哎，我刚买了甜甜圈，你要不要吃？"},{"label":"活动登陆2","jp":"パトロールめんどくさー。","zh":"我讨厌巡逻。"},{"label":"活动大厅1","jp":"は...平和だね...","zh":"AH ~ 一派祥和。"},{"label":"活动大厅2","jp":"バレンタインデーのこいう賑やかな雰囲気は悪くないね。\n何より、この時期が終わるとすぐに売り残ったチョコドーナツが大量に安売されるから。","zh":"情人节热热闹闹的也挺不错。最重要的是，节日过后，买剩下的巧克力甜甜圈会变得超便宜。"},{"label":"活动大厅3","jp":"よっぽどのことがない限り、私たち生活安全局まで出動するようなことは無いと思うけどね。例えば......災厄の狐が装甲車を盗むとか？はは...冗談冗談、そんなこと、起きっこないって。","zh":"我们生活安全局应该是没机会出动的，除非发生大骚乱。比如说灾恶之狐抢走了装甲车之类的。哈哈，开玩笑的，怎么可能有那种事嘛？"},{"label":"活动事件1","jp":"や...青春だね...熱くて楽しそうで結構なことだ。","zh":"大家都很青春呐，这么有热情是好事，我很欣慰。"},{"label":"活动事件2","jp":"なーんか...トラブルの予感が...","zh":"有种预感，麻烦要来了。"},{"label":"活动结束","jp":"最終的に、なんとか落ち着いたね...この平和が、ずっと続いてほしいもんだけど。","zh":"总算顺利收尾，能一直和平下去就好了。"}]},"stats":{"init":[{"name":"攻击力","value":"247"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2229"},{"name":"治愈力","value":"1412"},{"name":"命中值","value":"908"},{"name":"闪避值","value":"198"},{"name":"暴击值","value":"252"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1980"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6723"},{"name":"防御力","value":"108"},{"name":"生命值","value":"48628"},{"name":"治愈力","value":"5909"},{"name":"命中值","value":"908"},{"name":"闪避值","value":"198"},{"name":"暴击值","value":"882"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"1980"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"475"},{"name":"生命值","value":"2438"}]},"equipDetails":[{"slot":"1号装备","name":"帽子","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击伤害","value":"2000"}]},{"slot":"2号装备","name":"发夹","gr