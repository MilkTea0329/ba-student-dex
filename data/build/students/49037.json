.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/12635.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/12/590623.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 真纪（野营）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/12/136522.png","url":"https://www.gamekee.com/ba/647136.html"},{"name":"NPC 真纪（睡衣）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/191981/2025/6/23/675941.png","url":"https://www.gamekee.com/ba/643808.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"碧蓝档案。","zh":"呦，老师，要不要一块去涂鸦？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰り、先生。今日のファッションもいい感じだね？","zh":"老师，你回来啦，哦，今天的穿搭也让人眼前一亮嘛。"},{"label":"登陆2","jp":"遅いじゃん、先生これ以上待たせてたら…\n先生のスマホ、ドカンッ！って爆発させるところだったよ。","zh":"老师，你怎么才来啊，要是再让我干等会，我就让老师的手机嘣的一下炸掉了哦？"},{"label":"大厅1","jp":"あたしの顔に何かついてる？…うん？塗料？","zh":"我脸上蹭到什么东西了吗？嗯？颜料？"},{"label":"大厅2","jp":"このグラフィティ素敵でしょ？あたしが描いたの！","zh":"这个涂鸦是不是很酷？我亲手画的。"},{"label":"大厅3","jp":"せっかくセキュリティを突破したのに、\nその足跡も残さなかったら、ハッキングのし甲斐がないよね。ふふっ。","zh":"好不容易突破了防御，要是不留下什么，我这个黑客不是白当了吗？"},{"label":"大厅4","jp":"TANGO DOWN！","zh":"TANGO DOWN！"},{"label":"大厅5","jp":"キヴォトス中央のサンクトゥムタワーの外壁を、\n全部グラフィティで埋められたら、どんなに素敵だろう…？","zh":"如果能把基沃托斯中央那个圣所之塔的外墙全部画满涂鸦，肯定帅呆了。"},{"label":"回忆大厅1","jp":"さて、これでいい感じじゃない？\n先生から見て、どう？","zh":"怎么样？感觉不错吧？老师觉得呢？"},{"label":"回忆大厅2","jp":"えぇっ…なんでそんなにイマイチな反応なの？\nもっと芸術魂を燃やして見てみてよ！","zh":"嗯？你的反应怎么这么不冷不热的呀，让我看看你熊熊燃烧的艺术之魂吧！"},{"label":"回忆大厅3","jp":"先生は何を描いたの？\nえーっと…。\nあはは！なにこれ、めっちゃ面白い！","zh":"老师你在画什么？我看看？哈哈哈哈什么呀这是，太搞笑了吧！"},{"label":"回忆大厅4","jp":"こんな高いところで怖くないのかって？\n大丈夫、先生がそばにいるから。","zh":"你问我这么高怕不怕，不怕呀，因为老师陪着我呢。"},{"label":"回忆大厅5","jp":"必要ならいつでもあたしを呼んで。 \n壁も、先生も、いい感じに彩ってあげる！","zh":"需要的话随时叫我哦，无论是墙还是老师，我都可以让你们大放异彩！"},{"label":"咖啡馆1","jp":"ここの壁にあたしの絵を添えたら、もっと素敵になりそう！","zh":"这面墙再加上我的画，应该会更好看。"},{"label":"咖啡馆2","jp":"このふかふかな感じをスプレーで表現するにはどうすればいいのかな？","zh":"这种松软的感觉用喷漆怎么表现呢？"},{"label":"咖啡馆3","jp":"おっと、塗料が付かないように気を付けて、気を付けて…っと。","zh":"哎呀，当心点当心点，可不能把颜料蹭到衣服上"},{"label":"咖啡馆4","jp":"ここに赤を足したらどうかな？","zh":"在这边补点红色怎么样？"},{"label":"咖啡馆5","jp":"…すごくいい色…。","zh":"这个颜色感觉好棒！"}],"好感度":[{"label":"好感度1","jp":"あはは、いつも手伝ってくれてありがとう、先生。","zh":"哈哈，谢谢老师一直帮助我！"},{"label":"好感度2","jp":"一度くらいは、先生の顔を描いてみたいなぁ。","zh":"哈哈，谢谢老师一直帮助我！"},{"label":"好感度3","jp":"せ、先生の写真とか見てたわけじゃないから…！","zh":"我，我可没在看老师的照片哦！"},{"label":"好感度4","jp":"先生と一緒にいると、いい感じのインスピレーションがよく浮かぶような気がする","zh":"感觉和老师在一起的时候，脑子里就会闪现出很棒的灵感。"}],"战斗":[{"label":"编入队伍1","jp":"何々～、なんか面白い事でもあった～","zh":"怎么了怎么了？有什么好玩的事吗？"},{"label":"编入队伍2","jp":"えへへー、任せて","zh":"嘿嘿，交给我吧！"},{"label":"拎起","jp":"あーれ、あたしの出番じゃ無かった？","zh":"啊？不是该我出战了吗？"},{"label":"任命队长1","jp":"あたしが勝ったら、あの遮蔽物に最高のグラフィティを描こう？","zh":"如果赢了，我就要在那个掩体上画一个最棒的涂鸦！"},{"label":"任命队长2","jp":"今日のグラフィティのフレーズは～、うん、VERITASが良さそう！","zh":"今天的涂鸦用什么单词呢？真理？好像不错！"},{"label":"普通技能","jp":"弾けろ！","zh":"炸裂吧！"},{"label":"EX动画1","jp":"やっぱ今日も完璧！","zh":"真是完美的一天！"},{"label":"EX动画2","jp":"いひひー、今回の作品も傑作だね","zh":"嘿嘿，这次也画了一幅杰作呀！"},{"label":"EX动画3","jp":"うんうん、気に入った","zh":"嗯嗯，我喜欢！"},{"label":"EX技能1","jp":"くらえ！","zh":"看招！"},{"label":"EX技能2","jp":"君達にプレゼント！","zh":"送你们一个礼物！"},{"label":"EX技能3","jp":"えはははっ","zh":"哈哈哈 ！"},{"label":"战斗开始1","jp":"さて、実力、発揮してみようかな","zh":"好，来发挥一下实力吧！"},{"label":"战斗开始2","jp":"世界をもっと愉快に！","zh":"让世界变得更有趣吧！"},{"label":"获得BUFF","jp":"私の出番かな？","zh":"该我出场了吧？"},{"label":"施放BUFF","jp":"私は今、心から燃え上がっている！","zh":"我现在感觉热血沸腾！"},{"label":"被CC1","jp":"あぅ……","zh":"-"},{"label":"被CC2","jp":"きゃあ！","zh":"-"},{"label":"被CC3","jp":"うえぇ？","zh":"-"},{"label":"回避","jp":"えへへー、無駄無駄ぁ！","zh":"捏嘿嘿，没用没用。"},{"label":"队伍移动1","jp":"早く次のグラフィティを描きに行こう","zh":"赶快去画下一个涂鸦吧！"},{"label":"队伍移动2","jp":"さぁさぁ、前進前進！","zh":"好了好了，前进前进！"},{"label":"回复","jp":"おぉ、ありがとう。","zh":"哦，谢谢。"},{"label":"中途退出","jp":"うぅ、やられちゃった","zh":"哎，被干掉了。"},{"label":"战斗喊叫","jp":"やぁ！","zh":"-"},{"label":"战斗喊叫","jp":"やーほ～！","zh":"-"},{"label":"战斗喊叫","jp":"これあげる","zh":"这个给你！"},{"label":"角色移动","jp":"フォーメーション変更！","zh":"更换阵型。"},{"label":"战斗胜利1","jp":"素晴らしい結果だね。先生から見てどう？","zh":"成果还不错嘛，老师觉得呢？"},{"label":"战斗胜利2","jp":"えへへー、あたしの芸術魂は止められない！","zh":"嘿嘿，没有任何人可以阻挡我的艺术之魂！"},{"label":"关卡完成1","jp":"勝った勝ったぁ！","zh":"赢了赢了！"},{"label":"关卡完成2","jp":"今日も一発かましてやったね！","zh":"今天也战了个痛！"},{"label":"战斗失败1","jp":"うーわ、失敗したー。皆逃げてー","zh":"哇……搞砸了，大家快逃！"},{"label":"战斗失败2","jp":"うぅ、今回の作品はだめだ……","zh":"哎……这次的作品不行了。"}],"成长":[{"label":"升级1","jp":"今、最高のインスピレーションが浮かんだ！","zh":"我现在突然有了一个超棒的灵感！"},{"label":"升级2","jp":"うん、よーし","zh":"嗯。很好！"},{"label":"升级3","jp":"これ、成績をあげるのにも役立つかな","zh":"这个能帮我提高成绩吗？"},{"label":"升级4","jp":"おほ、すごい力を感じる！","zh":"哦！我感受到一股强大的力量！"},{"label":"获得专武","jp":"この銃で、世界を色鮮やかにに染めるの！","zh":"有了这把枪，我可以把整个世界染的色彩斑斓！"}],"事件":[{"label":"学生生日","jp":"プレゼントに何が欲しいか、って？\n先生の服、あたしがチョイスした色で塗ってみてもいい？","zh":"问我想要什么礼物？老师的衣服可以让我涂上喜欢的颜色吗？"},{"label":"老师生日","jp":"先生、お誕生日おめでとう！\nん？なんで知ってるのかって？\nおっと、まだ公開されてない情報だったっけ？","zh":"老师，生日快乐。为什么会知道你的生日？哎呀，这是保密情报来着……"},{"label":"万圣节","jp":"今回のハロウィンのために、先月からコスチュームを準備してたの。\nふふっ、期待してて！","zh":"为了这次的万圣节，我从上个月就开始准备衣服了，你就期待着吧！"},{"label":"新年","jp":"ハッピーニューイヤー、先生！\n今年もキラキラしたものをいっぱい描いていこう！","zh":"新年快乐，老师，今年也要画很多闪闪发光的东西哦！"},{"label":"圣诞节","jp":"あっちもこっちも綺麗なイルミネーションでいっぱい…。\nこれ、そのまま壁に描き写せないかな？","zh":"到处都挂满了好看的彩灯，可以把这幅景象画到墙上吗？"},{"label":"春节","jp":"","zh":"老师，新春快乐呀~\n今年我想创作更多涂鸦，把枯燥的地方都染上色彩\n啊，老师也要来帮忙哦~"},{"label":"中秋","jp":"","zh":"中秋节快乐啊老师~\n今晚的月亮真美，下次涂鸦时也画上一轮明月吧！"}]},"stats":{"init":[{"name":"攻击力","value":"276"},{"name":"防御力","value":"81"},{"name":"生命值","value":"2563"},{"name":"治愈力","value":"1616"},{"name":"命中值","value":"98"},{"name":"闪避值","value":"196"},{"name":"暴击值","value":"201"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1424"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"45 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6365"},{"name":"防御力","value":"447"},{"name":"生命值","value":"50347"},{"name":"治愈力","value":"5754"},{"name":"命中值","value":"318"},{"name":"闪避值","value":"196"},{"name":"暴击值","value":"1375"},{"name":