t2skill":{"name":"","icon":"","levels":[]}},"profile":{"fullName":"角楯 カリン（制服）","kana":"角楯 かくだて","twName":"花凛（制服）","cnName":"花凛（制服）","age":"16岁","birthday":"2月2日","height":"170cm","hobby":"扫除","designer":"-","artist":"Mx2j","cv":"日 | 沼仓爱美\n中 | 喵酱\n韩 | 박하진（朴河真）","hallLevel":"2","momoTalkLevel":"2, 3, 5, 6","momoTalkStatus":"特殊任务进行中","bio":"千年科学学园所属，担任千年博览会向导的“C&C”特工。由于兼任会场向导和要人护卫的职责，她换上了制服。由于所属社团的性质，她平时通常穿着女仆装，因此似乎无法掩饰对这难得机会的兴奋。她性格温和、待人友善，作为向导也赢得了大家的信任。","sourceUrl":""},"giftTiers":[{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/722703.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/72324/2025/5/9/431956.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/950354.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/236969.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/14849.png"]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/72324/2025/5/9/431956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/950354.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/236969.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/72324/2025/5/9/14849.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"665"},{"name":"攻击力","value":"145"},{"name":"治愈力","value":"231"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/72324/2025/5/9/389065.webp","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/72324/2025/5/9/81170.webp","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 花凛（兔女郎）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/72324/2025/5/9/276657.png","url":"https://www.gamekee.com/ba/89275.html"},{"name":"★3 花凛","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_220/h_220/829/72324/2025/5/9/712219.png","url":"https://www.gamekee.com/ba/67011.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive."},{"label":"卡池抽取","jp":"ミレニアムサイエンススクールの角楯カリン、準備はできてる。……こ、この服装、大丈夫そうか？","zh":"千禧年科技学院，角楯花凛，准备就绪。……穿，穿这身衣服，真的不要紧吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ああ、先生。待ってた。\n……なんでって？護衛に理由が必要だろうか。","zh":"啊，老师，我正等着你呢。……为什么？护卫还需要理由吗？"},{"label":"登陆2","jp":"おかえり、先生。それから、お疲れ様。","zh":"老师，你来了。辛苦你了。"},{"label":"大厅1","jp":"うん？ああ、今日は制服を着ている。……理由？\nふふ……なんだろうな。当ててみてくれ。","zh":"嗯？如你所见，我今天穿了制服。你问为什么？……要猜猜看吗？"},{"label":"大厅2","jp":"いつもと違う服装だからか、少し勘が鋭くなっているようだ。","zh":"可能是因为穿了和平时不同的衣服，总觉得直觉变得更敏锐了。"},{"label":"大厅3","jp":"制服を着る機会があまりなくて……変なところはないだろうか？\nそうは言ったが……み、見すぎだ先生！","zh":"我平时不怎么穿制服的……有没有哪里看起来别扭？但你一直盯着我看的话，我会不好意思的……！"},{"label":"大厅4","jp":"任務遂行に支障はない。これまで通り、遠慮なく言ってほしい。","zh":"放心吧，这对执行任务没有影响。像平时那样有事尽管说就可以了。"},{"label":"大厅5","jp":"おはようございます、先生。今日も一日、よろしくお願いします。\n生徒として挨拶をしてみたのだけど……へ、変だっただろうか？","zh":"你好啊，老师。今天一天也请多关照了。用学员的方式打了个招呼……会，会很奇怪吗？"},{"label":"回忆大厅1","jp":"……あっ！先生！ま、待ってくれ！このまま渡すのは、ちょっと……！","zh":"老，老师，你，你先等等。我想了想，这个就这样给你好像不太好……！"},{"label":"回忆大厅2","jp":"その、私が脚で挟んでしまったもの、だから……\nこれは私が食べるから、先生はこっちを……！","zh":"因，因为我是用腿夹住的，所以感觉有点脏……这个我来吃吧，老师干脆吃我的这个……！"},{"label":"回忆大厅3","jp":"……あ。これは私の食べかけ……","zh":"……啊。对了，这个已经被我吃过一口了……"},{"label":"回忆大厅4","jp":"ち、違う！そういう意味じゃなくて……！\nやっぱこっちの……！では、なくて！","zh":"啊，不是，等等！不是的，我绝对不是那个意思……！还是给你这个…………！啊，不对不对！"},{"label":"回忆大厅5","jp":"本当に、そんなつもりは……！\nど、どちらを渡しても……うう……\nわ、私はどうすれば……！","zh":"才，才不是！我真的，真的没有那个意思！不，不管给哪个都……！呜呜……我该怎么办……！"},{"label":"咖啡馆1","jp":"どこかに鏡は……","zh":"要是有面镜子就好了。"},{"label":"咖啡馆2","jp":"時間ができた……先生はどこに……","zh":"有点闲呐……老师什么时候来呢……"},{"label":"咖啡馆3","jp":"ここは可愛い家具が多いな……気に入った。","zh":"好多可爱的家具呢……我很喜欢。"},{"label":"咖啡馆4","jp":"敵の気配はなさそうだ。警戒を少し緩める。","zh":"看样子这里没有敌人。可以放松警戒一下了。"},{"label":"咖啡馆5","jp":"この辺の掃除を…………いや、制服のときは止めておこう。","zh":"打扫一下这里吧…………唔，穿着制服还是算了。"}],"好感度":[{"label":"好感度1","jp":"先生はこの格好、どう思う……？","zh":"老师，我穿制服的样子……怎么样？"},{"label":"好感度2","jp":"今日は先生の身辺警護を行う、この服装なら、怪しまれることもないだろう……","zh":"今天我会贴身护卫老师。穿这身衣服……应该会更自然吧。"},{"label":"好感度3","jp":"制服姿で先生の隣に立つのは何だか新鮮で……いいな……","zh":"穿着制服和老师见面……有种和平时不一样的感觉，我挺喜欢的。"},{"label":"好感度4","jp":"任務中ではあるが、先生と話す時間は作れる、いつでも声をかけてくれ。","zh":"那个，虽然是在执行任务……但留给老师的时间还是有的，随时都可以叫我。"}],"战斗":[{"label":"编入队伍1","jp":"ガイドを探しているのか？","zh":"需要向导吗？"},{"label":"编入队伍2","jp":"この格好で仕事をするのか……？","zh":"工作……穿这身衣服去也可以的话……好吧"},{"label":"拎起","jp":"丈が…気になる…","zh":"跟平时的衣服相比……这个……有点短"},{"label":"普通技能","jp":"ターゲット、確認！","zh":"目标，确认！"},{"label":"EX动画1","jp":"その……えっと……危ない！","zh":"呃，就是……等等，危险！"},{"label":"EX动画2","jp":"あ……それは……伏せろ！","zh":"呃，就是……嗯？躲好！"},{"label":"EX动画3","jp":"ちょっと私では……こっちに！","zh":"我也不太清楚……啊！这边！"},{"label":"EX技能1","jp":"危険を排除した、もう大丈夫だ。","zh":"危险已经排除。可以放心了。"},{"label":"EX技能2","jp":"問題ない、私が解決する。","zh":"不用担心。我会解决的。"},{"label":"EX技能3","jp":"援護開始、後は任せてくれ。","zh":"实施掩护。狙击交给我吧。"}],"成长":[{"label":"升级1","jp":"先生、この恩は、絶対に忘れない。","zh":"老师，这份恩情……我绝不会忘记的。"},{"label":"升级2","jp":"いつもの格好ではないが、この姿でしかできない仕事もあるから。","zh":"虽然这身日常打扮与战斗无关，但，它一定也有派上用场的时候吧。"},{"label":"升级3","jp":"私にここまで…？有難う、この力で先生を守って見せる！","zh":"竟然对我如此厚爱……谢谢。我会用这份力量守护老师的。"},{"label":"升级4","jp":"先生……分かった……期待に応えられるよう、善処する！","zh":"原来老师对我如此期待……我明白了。我会全力以赴，不负所望。"},{"label":"获得专武","jp":"いつでも、どんな姿でも、先生のために駆けつけると誓おう。","zh":"无论何时、无论何地，无论穿着女仆装还是制服，我都随时准备着守护老师。"}],"事件":[{"label":"学生生日","jp":"誕生日……ありがとう。今日は一日中、先生と一緒にいられるのか……嬉しい。","zh":"生日……谢谢你。今天一整天都能和老师在一起……我很开心。"},{"label":"老师生日","jp":"お誕生日おめでとう。欲しいものがあれば言ってくれ。先生が喜ぶものを、贈りたいんだ。","zh":"生日快乐，老师。有什么想要的尽管说。我想送老师你喜欢的东西。"},{"label":"万圣节","jp":"ハロウィーンか。普段あまり制服を着ないから\nなんだかもう仮装をしているような気分だ。","zh":"万圣节到了啊。可能是因为我平时不太穿制服，现在这身打扮反而像变装一样。"},{"label":"新年","jp":"先生、明けましておめでとう。今年はもう少し、こうして私と……\nな、何でもない。","zh":"新年快乐，老师。今年要是能像这样多见见面……啊，没什么。"},{"label":"圣诞节","jp":"クリスマスを過ごすのに、この服装は平凡すぎる気が…………似合ってるから大丈夫？あ、ありがとう。","zh":"感觉这身装扮对过节来说有些普通……诶？很适合我……？谢，谢谢。"},{"label":"春节","jp":"","zh":"新春快乐，老师。难得度过这么热闹的节日，今天我也会暂时歇口气，换下平时的女仆装扮。那么……能请你陪我度过，普通学员的一天吗？这次我一定会找到最适合我们的方式。"},{"label":"中秋","jp":"","zh":"今天好像是叫做中秋的日子呢，老师。满月之下，一切风平浪静，没有紧急任务，能穿着这身制服和老师一起静静度过……就像老师教过我的，即使是平凡无奇的一天，只属于我们的回忆也会让它变得特别，你说对吗？"}],"活动":[{"label":"活动登陆1","jp":"お、お疲れ、先生。……言い慣れないな。","zh":"你，你好，老师。……打招呼的方式和平时不太一样，有点别扭呢。"},{"label":"活动登陆2","jp":"もう少し可愛い挨拶を……い、今のは独り言だ！","zh":"要用更可爱的方式…………啊，刚才是在自言自语！"},{"label":"活动大厅1","jp":"ど、どうしたんだ？依頼か？","zh":"呃，怎，怎么了？有什么需要我做的事吗？"},{"label":"活动大厅2","jp":"こ、これはミレニアム指定の制服だけど……？何か変なところでもあるのか？","zh":"这，这只是千禧年的普通制服……有什么奇怪的地方吗？"},{"label":"活动大厅3","jp":"えっと……先生。せっかくの制服だ、からその、私と一緒に……","zh":"那个……老师。难得穿了制服，要不要一起……"},{"label":"活动大厅4","jp":"……や、やはり、何でもない。気にしないでくれ。","zh":"……啊，算了，没什么。抱歉。"},{"label":"活动事件1","jp":"まったく……気が休まらない。","zh":"这次活动比想象中还要混乱啊……"},{"label":"活动事件2","jp":"あと少しだ、先生。一緒に頑張ろう。","zh":"还差一点就要结束了。加油，老师。"},{"label":"活动结束","jp":"終わったんだな。終わってみると逆に……名残惜しく感じる。","zh":"这么快就结束了。感觉……有点依依不舍呢。"}]},"stats":{"init":[{"name":"攻击力","value":"388"},{"name":"防御力","value":"65"},{"name":"生命值","value":"2186"},{"name":"治愈力","value":"1938"},{"name":"命中值","value":"384"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"256"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2240"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8877"},{"name":"防御力","value":"357"},{"name":"生命值","value":"42027"},{"name":"治愈力","value":"7886"},{"name":"命中值","value":"384"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"886"},{"name":"暴击伤害","value":"246%"},{"name":"稳定值","value":"2240"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value