5.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/766988.png","items":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/72581.png"]},{"level":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png","items":[]}],"gifts":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_300/h_237/829/157597/2025/5/11/809385.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/72581.png"],"chocolate":{"icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/855153.png","name":"倾尽茱莉全力的巧克力","desc":"茱莉为了送给老师而倾尽全力制作的手工巧克力。即使不尝味道，光是看着也可以感受到茱莉百分百的真心。"},"ability":{"attrs":[{"name":"生命值","value":"755"},{"name":"攻击力","value":"158"},{"name":"治愈力","value":"229"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/749295.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/157597/2025/5/11/162843.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 朱莉（打工）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_550/h_550/829/157597/2025/5/11/438716.png","url":"https://www.gamekee.com/ba/649361.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue…Blue Archive."},{"label":"卡池抽取","jp":"ゲヘナ学園、給食部のジュリといいます。\nお腹が空いたら、いつでも私に言ってくださいね？","zh":"我是歌赫娜供餐部的朱莉。肚子饿了，请随时告诉我哦～"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"おかえりなさい、先生。お腹空いてないですか？","zh":"欢迎回来，老师。您饿不饿呢～"},{"label":"登陆2","jp":"おかえりなさい、先生。ご飯にしますか？\nそれとも…お・や・つ？","zh":"欢迎回来，老师。需要用餐吗？还是来些……小、点、心？"},{"label":"大厅1","jp":"料理に酸味を出すためには、香辛料を入れるのと、塩酸を入れるのと、どちらがいいのでしょうか…？","zh":"想给饭菜里增加酸味的话，是放调味料好呢，还是放盐酸好呢？"},{"label":"大厅2","jp":"食材が生きているというのはそれだけ新鮮ということですから良いことですよね？","zh":"食材还在活蹦乱跳，就说明我的食材很新鲜呢。这不是好事嘛？"},{"label":"大厅3","jp":"なんか、焦げ臭いです…？","zh":"好像有股……烧焦的味道。"},{"label":"大厅4","jp":"…あら、私ったら！パイをオーブンに入れっばなしだったことを忘れてました！","zh":"哎呀，我可真是的！我忘了派还放在烤箱里呢！"},{"label":"大厅5","jp":"うう…。なんで私は料理をするたびに、失敗ばかりするのでしょう…。","zh":"呃……为什么我每次做饭都会失败呢……"},{"label":"回忆大厅1","jp":"あっ、見てください先生！\nこの真っ赤に実ったトマト、すっごく美味しそうだと思いませんか？","zh":"-"},{"label":"回忆大厅2","jp":"えへん、これも給食部としての成果です。 丹精込めて作った甲斐がありました！\nあ、あっちのトマトもすごく良い感じに……","zh":"-"},{"label":"回忆大厅3","jp":"えっと、あ、あれ、なのですが、その……何だかちょっと距離が……？\nこの近さですと、あの、私……。","zh":"-"},{"label":"回忆大厅4","jp":"（あ、先生の香りが……）\n（な、何だか急に、胸がドキドキしてきました……！？）","zh":"-"},{"label":"回忆大厅5","jp":"だっ、大丈夫です、はい！ご心配なく……！\nただその何と言いますか、えっと……\n何だか顔が熱くなってきて、その……！うぅ……！","zh":"-"},{"label":"回忆大厅6","jp":"","zh":"-"},{"label":"回忆大厅7","jp":"","zh":"-"},{"label":"咖啡馆1","jp":"う～ん、甘い香り…。","zh":"（嗅嗅）嗯～！甜甜的香味！"},{"label":"咖啡馆2","jp":"これも食べられますかね？","zh":"嗯……这个也可以吃吧～"},{"label":"咖啡馆3","jp":"とりあえず一回、揚げてみようかな…。","zh":"要不先试着……炸一下吧？"},{"label":"咖啡馆4","jp":"あら。とても良いところですね。","zh":"哎呀……这里真是个好地方～！"},{"label":"咖啡馆5","jp":"ここは美味しいお料理が作れそうです。","zh":"感觉在这里，可以做出美味的料理！"}],"好感度":[{"label":"好感度1","jp":"先生と一緒に過ごす時間は、お料理をしてる時と同じくらい楽しいです。","zh":"和老师一起度过的时光，就和做饭的时候，一样开心！"},{"label":"好感度2","jp":"最高の香辛料は…まさしく愛です♡","zh":"最棒的调味料，就是爱！"},{"label":"好感度3","jp":"この幸せを味で表現する為には、どんな食材入れればいいのか悩みますね。","zh":"如果要用味道来表达这份幸福，应该放入什么样的材料呢……？好烦恼啊……"},{"label":"好感度4","jp":"先生と一緒に食べるお料理なら、どのようなお料理でも美味しいです。","zh":"只要是和老师一次吃饭，无论是什么样的饭菜，都会很好吃！"}],"战斗":[{"label":"编入队伍1","jp":"では、実力を発揮してみましょうか。","zh":"那么，就来发挥一下实力看看吧！"},{"label":"编入队伍2","jp":"私にお任せください～","zh":"请交给我吧！"},{"label":"拎起","jp":"うう……また逃げられてしまいました。","zh":"呜…… 又让它跑掉了。"},{"label":"普通技能","jp":"私もお手伝いしますね！","zh":"我也会帮忙的哦！"},{"label":"EX动画1","jp":"せーのっ…あららっ！？","zh":"一、二……哎呀！"},{"label":"EX动画2","jp":"このままひっくり返せば…あれっ？！","zh":"只要再这样翻个面……啊啊！"},{"label":"EX动画3","jp":"これで完成です！…ちょっと待って！？","zh":"这样就完成啦！……啊！等一下！"},{"label":"EX技能1","jp":"あ、あれっ？","zh":"啊……诶？！"},{"label":"EX技能2","jp":"皆さんが食べちゃだめなのに～。","zh":"大家……不可以吃哦！"},{"label":"EX技能3","jp":"皆さんの分ではありません～！","zh":"啊……这不是给你们吃的！"},{"label":"载具协同1","jp":"-","zh":""},{"label":"载具协同2","jp":"-","zh":""},{"label":"战斗开始1","jp":"気をつけて、いってらっしゃい！","zh":"路上小心哦。慢走～！"},{"label":"战斗开始2","jp":"補給なら心配しないでください。","zh":"补给的事情请不用担心！"},{"label":"获得BUFF","jp":"さあ、美味しいご飯が届きますよ。","zh":"好了，美味的饭来咯。"},{"label":"特殊载具","jp":"","zh":"好啦，美味的饭菜送来了哦～"},{"label":"特殊载具","jp":"","zh":"各位，吃饭的时间到了哦～"}],"成长":[{"label":"升级1","jp":"これでもっと、美味しいご飯が作れるようになれますでしょうか？","zh":"这样……我是不是就可以做出更美味的饭菜了呢～"},{"label":"升级2","jp":"お料理上手になる為にも、体力は必須です！","zh":"为了烹饪出更可口的饭菜，体力是必不可少的！"},{"label":"升级3","jp":"なんだかお料理がしたくなりますね！","zh":"诶嘿，突然很想做饭啦！"},{"label":"升级4","jp":"もっと美味しいお料理を作るために頑張ります！","zh":"我会尽全力做出美味的料理的！"},{"label":"获得专武","jp":"ふふ、この銃をお料理に使うと、お肉の食感がぐんと柔らかくなりますね！","zh":"诶嘿嘿，如果用这把枪来做饭，肉的质地应该会柔软很多的！"}],"事件":[{"label":"学生生日","jp":"私の誕生日プレゼントですか？\nふふ…。その言葉だけでも十分嬉しいですよ。","zh":"我的生日礼物……？诶嘿嘿，有您这句话，我就已经很开心啦。"},{"label":"老师生日","jp":"お誕生日おめでとうございます、先生！\n先生に差し上げようとケーキを焼いたのですが、\nそれがその…。逃げちゃいました…。","zh":"祝您生日快乐，老师。我本来烤了一个蛋糕准备送给老师，可是……蛋糕……逃走了。"},{"label":"万圣节","jp":"ハロウィーンになるとなぜか私の作ったお菓子が人気なんです。\nいたずらにぴったり…？だとか。","zh":"不知道为什么，一到万圣节，我做的点心就很受欢迎。他们说什么……很适合用来搞……恶作剧……？"},{"label":"新年","jp":"お正月を迎えたのでおせち料理を作ってみました。\nよろしければ味見していただいてもいいでしょうか？","zh":"快到正月啦。我试着准备了一些年节菜。不知道您能不能帮我尝一下味道呢？"},{"label":"圣诞节","jp":"えー、その、クリスマスだから七面鳥を焼いたのですけれど…\n生きてて動くローストターキーはだめですよね…？","zh":"嗯……那个，因为圣诞节到了，所以我烤了火鸡。但是火鸡烤熟了……应该，是不会活蹦乱跳的吧……"},{"label":"春节","jp":"","zh":"我在年夜饭里加入了很多很多的爱～老师，趁它还没逃走，快来尝尝吧～！"},{"label":"中秋","jp":"","zh":"不知道为什么，歌赫娜的大家好像不怎么欢迎我做的月饼。……啊，老师，您会吃的吧，一定会的吧！"}]},"stats":{"init":[{"name":"攻击力","value":"170"},{"name":"防御力","value":"118"},{"name":"生命值","value":"2214"},{"name":"治愈力","value":"1634"},{"name":"命中值","value":"609"},{"name":"闪避值","value":"203"},{"name":"暴击值","value":"203"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2263"},{"name":"射程","value":"1000"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"-"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST