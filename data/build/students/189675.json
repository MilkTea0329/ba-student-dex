ifts":["https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081726530_1781081726501_dv72ed2hz6_89knwk9i02.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081742917_1781081742818_15pgfe6ydv_60y2w8k3d3.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081748318_1781081748291_1czjkutlwv_jrz6tqz5nf.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081761517_1781081761488_f2qswl9p6g_kaas19ab9a.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081774701_1781081774674_zucajtkmh2_zq1eo5d14r.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081787664_1781081787639_jvwpf8ciuq_1iidwr58hi.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081793804_1781081793779_rtpd1w8kj6_ou0hlh8jj1.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081801787_1781081801756_ep3id3yw3e_wl3qdzdyj.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081807298_1781081807273_mn44vrubma_rgo7u1xo8k.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081816718_1781081816692_pmbp3zai1j_0s0fy6npxt.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081825791_1781081825760_e5em1vuill_92mzuix1sd.png","https://cdnimg-v2.gamekee.com/wiki2.0/pro/829/images/w_300/h_237/829/191981/2026/5/10/1781081830533_1781081830502_itl9ogered_uwovpmcd7k.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"这个不用写"},{"name":"攻击力","value":"这个不用写"},{"name":"治愈力","value":"这个不用写"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"名草","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_515/h_567/829/103682/2025/5/11/122229.png","url":"https://www.gamekee.com/ba/tj/661924.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルー……アーカイブ。","zh":"蔚蓝……档案。"},{"label":"卡池抽取","jp":"こうして海に来たんだもの、みんなと忘れられない思い出を作りたいんだ。先生も一緒に付き合ってくれる?","zh":"难得像这样来到海边……我想和大家一起留下难忘的回忆。老师……也愿意陪着我吗？"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰り、先生。今日もお役に立てたらいいな。","zh":"欢迎回来，老师。今天……也希望自己能帮上你的忙。"},{"label":"登陆2","jp":"あ、待ってたよ。海に行くんだよね。もう着替えておいたよ。","zh":"啊，我一直在等你哦。要去海边对吧？我已经提前换好衣服了。"},{"label":"大厅1","jp":"これ どうかな?思ったより、似合う水着が見つからなくて…","zh":"这个……怎么样？比想象中还难找到适合自己的泳装呢……"},{"label":"大厅2","jp":"白を選んだ理由?これがいいって、みんなに言われたから。","zh":"为什么会选白色？因为大家都说……这件很适合我。"},{"label":"大厅3","jp":"スキンケアの秘訣？別に、特別なことをしているわけじゃないんだけど…あ、もしかしたら焼き鳥のおかげかも?","zh":"护肤的秘诀吗？其实……也没做什么特别的事情啦……啊，不过……说不定是因为经常吃烤串？"},{"label":"大厅4","jp":"大切なものは失ってから気づくって、よく言うよね。私もそうだった…だから…もう手放さない、絶対に","zh":"人们总说……重要的东西，往往是在失去之后才会察觉到。我也是这样……所以……这一次……我绝对不会再放手了。"},{"label":"大厅5","jp":"右腕が黄昏に飲まれてから、私は誰かの手にすがることを忘れてしまった。だから、いつも一人で考えて、全部自分で解決しようとしてた。だけど、今は違う。 先生と、みんながいるから。これからも、よろしくね。","zh":"自从右臂被黄昏吞噬之后……我就渐渐忘记，该怎么去依赖别人了。所以，一直以来我都习惯一个人思考，想靠自己把所有事情解决掉。但是……现在已经不一样了。因为有老师，还有大家在。以后……也请多多关照了。"},{"label":"回忆大厅1","jp":"最初はこの作戦でいこう。向こうは序盤から、全力で来るだろうから。","zh":"一开始……就按这个战术来吧。毕竟对面……从一开始就会全力进攻吧。"},{"label":"回忆大厅2","jp":"おー、先生?私のサイン、ちゃんと見てる?最初からよそみをするなんて、らしくないね。いったい何を見て","zh":"喂——老师？有好好在看我的暗号吗？从一开始就在走神……这可不像老师哦。到底……是在看哪里呀？"},{"label":"回忆大厅3","jp":"あっ、そっか。ごめんなさい。逆に集中できないよね、私がミステリオスの美少女だから。","zh":"啊……原来是这样。对不起。反而会没办法集中吧……毕竟，我可是神秘系美少女呢。"},{"label":"回忆大厅4","jp":"ビーチバレーはこうやってサインを出すんだけど。今からでもやり方を変えた方がいいかな","zh":"沙滩排球的话……一般会像这样打暗号。现在开始改一下方式……会不会比较好呢？"},{"label":"回忆大厅5","jp":"ダメか…さすがに遅いよね…","zh":"还是不行吗……果然，已经太迟了吧……"},{"label":"回忆大厅6","jp":"このまま行こう、先生。私たちなら、大丈夫。","zh":"就这样继续下去吧……老师。如果是我们的话……一定没问题的。"},{"label":"咖啡馆1","jp":"一番涼しいのはどこだろう","zh":"最凉快的地方……会在哪里呢。"},{"label":"咖啡馆2","jp":"潮風かい、楽しみ","zh":"海风吗……有点期待呢。"},{"label":"咖啡馆3","jp":"良い印象らしいところを、見せたいな。","zh":"真想让他看到...自己更讨人喜欢的一面啊。"},{"label":"咖啡馆4","jp":"あんまり、目どちとくないな","zh":"其实……我不太想太引人注目。"},{"label":"咖啡馆5","jp":"今日の思い出、大切にしたい。","zh":"今天的回忆……我想好好珍惜。"}],"好感度":[{"label":"好感度1","jp":"雪が解けたら春が訪れるように 荒れ果てた私の心にも芽吹きの時が来たみたい","zh":"就像积雪融化后，春天终会到来一样……我那早已荒芜的内心，似乎也终于迎来了萌芽的时候。"},{"label":"好感度2","jp":"やっぱり優しいね、私もいつか先生みたいになりたいな。","zh":"老师果然很温柔呢……总有一天，我也想变成像老师这样的人。"},{"label":"好感度3","jp":"いつも信じてくれてありがとう。 先生のこと、頼りにしてるよ。","zh":"谢谢老师一直相信着我。我……真的很依赖老师哦。"},{"label":"好感度4","jp":"微かなこと以外、特に取り柄がないんだけど、先生のそばに行ってもいいかな。","zh":"除了这些微不足道的小优点之外……我其实也没什么特别的地方。不过，我还能继续待在老师身边吗？"}],"战斗":[{"label":"编入队伍1","jp":"うん、百花繚乱も持ったよ。","zh":"嗯，“百花缭乱”也已经带上了。"},{"label":"编入队伍2","jp":"右腕、今なら大丈夫。任せて。","zh":"右臂的话……现在已经没问题了。交给我吧。"},{"label":"拎起","jp":"先生がそうしたいなら、従うよ。","zh":"如果这是老师的决定……我会听从的。"},{"label":"任命队长1","jp":"私が誰なのか、みんなに伝えるの?","zh":"终于……要让所有人知道，我真正是谁了吗？"},{"label":"任命队长2","jp":"勝利へ導くね","zh":"我会带领大家走向胜利的。"},{"label":"普通技能","jp":"しんけん しょうぶ","zh":"要认真上了。"},{"label":"EX动画1","jp":"これが夏の海","zh":"这就是……夏日的大海。"},{"label":"EX动画2","jp":"風が気持ちいい","zh":"海风……吹起来真舒服。"},{"label":"EX动画3","jp":"白い波、綺麗","zh":"白色的浪花……真漂亮。"},{"label":"EX技能1","jp":"まぶしかったかな","zh":"是不是……有点太耀眼了？"},{"label":"EX技能2","jp":"輝きすぎちゃったかな","zh":"会不会……闪耀得太过头了呢？"},{"label":"EX技能3","jp":"狙ったわけじゃないんだけど","zh":"虽然……我也不是故意这么做的。"},{"label":"战斗开始1","jp":"暑いのは苦手だけど、頑張るね。","zh":"虽然不太擅长应付炎热……不过我会努力的。"},{"label":"战斗开始2","jp":"私の活躍を見ていて、先生。","zh":"老师……请好好看着我的表现吧。"},{"label":"获得BUFF","jp":"気づかってくれてありがとう","zh":"谢谢你关心我。"},{"label":"施放BUFF","jp":"期待に答えないとね","zh":"得回应大家的期待才行呢。"},{"label":"掩体","jp":"少し休んでから行こうか","zh":"先稍微休息一下……再继续吧。"},{"label":"被CC2","jp":"これは…","zh":"这是……"},{"label":"被CC3","jp":"うっこり","zh":"呜……"},{"label":"回避","jp":"わかってたよ","zh":"我早就知道了。"},{"label":"队伍移动1","jp":"慎重に進もう","zh":"小心一点前进吧。"},{"label":"队伍移动2","jp":"みんな ついてきてる?","zh":"大家……都有跟上吗？"},{"label":"回复","jp":"これが…友達","zh":"这就是……朋友吗。"},{"label":"中途退出","jp":"こんな時に限って…腕が…","zh":"偏偏在这种时候……右臂……"},{"label":"战斗喊叫","jp":"はっ","zh":"哈！"},{"label":"战斗喊叫","jp":"ヘッ！","zh":"哼！"},{"label":"战斗喊叫","jp":"ヘッ","zh":"哼"},{"label":"角色移动","jp":"行くよ","zh":"要上了哦。"},{"label":"战斗胜利1","jp":"うん、私たちの勝ち。","zh":"嗯……这就是属于我们的胜利。"},{"label":"战斗胜利2","jp":"これが、百花繚乱の力。","zh":"这就是……百花缭乱的力量。"},{"label":"关卡完成1","jp":"先生の期待に答えられたなら、よかった。","zh":"如果有回应到老师的期待……那就太好了。"},{"label":"关卡完成2","jp":"私はもう、誰かの代わりじゃない。","zh":"我已经……不再是谁的替代品了。"},{"label":"战斗失败1","jp":"やっぱり私に委員長なんて無理だったんだ","zh":"果然……像我这样的人，根本没办法胜任委员长啊。"},{"label":"战斗失败2","jp":"ごめんなさい、私、本当に取り柄が少なくて…","zh":"对不起……我，真的没什么值得称道的地方……"}],"成长":[{"label":"升级1","jp":"これで、右腕の封印が一つ解けた","zh":"这样一来……右臂上的封印，又解开了一层。"},{"label":"升级2","jp":"そっか、私にもまだ伸びしろがあったんだね。","zh":"原来如此……我也还有继续成长的可能啊。"},{"label":"升级3","jp":"黄昏から取り戻した私の力、見せてあげる。","zh":"就让你见识一下……我从黄昏之中夺回的力量吧。"},{"label":"升级4","jp":"つぼみが開いたような感じがする ありがとう、先生のおかげだよ","zh":"总觉得……像花苞终于绽放开来了一样。谢谢你，这一切都是多亏了老师。"},{"label":"获得专武","jp":"私はまだまだ足りないことだらけ、それでもこの百花繚乱を持ち続けたいと思う。それは、百花繚乱の委員長を演じるためじゃない、自分自身の心と向き合うために。","zh":"我还有太多不足的地方……即便如此，我也想继续背负着这份“百花缭乱”。并不是为了继续扮演百花缭乱的委员长……而是，为了能够真正面对自己的内心。"}],"事件":[{"label":"学生生日","jp":"私が冬に生まれたのには、意味があるんだと思う。冬の厳しさを超えて、うららかの日のもとに咲く花のように。私もいつか、咲き誇りたいんだ。","zh":"我想……自己会在冬天出生，一定是有意义的。就像跨越严冬之后，终于在温暖阳光下绽放的花朵一样。总有一天……我也想那样骄傲地盛开。"},{"label":"老师生日","jp":"そばにいるだけで安心できる人がいるんだ。今日はその人の誕生日なんだって。だから、思い出に残るように、この格好でお祝いするね。お誕生日おめでとう","zh":"原来……真的会有那种，只要待在身边就能让人安心下来的人啊。听说今天，是那个人的生日。所以……为了能让这一天成为难忘的回忆，我才特地穿成这样的哦。生日快乐。"},{"label":"万圣节","jp":"今日みたいな日に水着。 私はただ、水着を着ただけなのかな。 コスプレになってる?うーん、コスプレの世界って、奥深いんだね","zh":"偏偏在今天这种日子穿泳装……我这样，算不算是在Cosplay呢？嗯……Cosplay的世界，果然很深奥呢。"},{"label":"新年","jp":"あけましておめでとう、先生。お正月くらいは、明るい話がいいよね。だから、形からではあるんだけど、明るい気分になれる格好にしてみたんだ。どう、かな。","zh":"新年快乐，老师。至少在新年的时候……还是聊些开心的话题比较好吧。所以……虽然只是从外表开始，但我还是试着换上了能让心情变明亮一点的打扮。怎、怎么样呢？"},{"label":"圣诞节","jp":"寒さには強い方だよ。ほろ、今も水着だけど平気。あ、今日は赤い服の方が良かった?","zh":"我其实还挺耐寒的哦。你看……现在穿着泳装也完全没问题。啊……今天是不是换成红色衣服会更合适一点？"}],"活动":[{"label":"活动登陆1","jp":"先生、私たちの活躍を見届けてくれる?","zh":"老师……愿意见证我们的表现吗？"},{"label":"活动登陆2","jp":"うふふ、今まで封じてた力、見せてあげる。","zh":"呵呵……就让你见识一下，我一直封印着的力量吧。"},{"label":"活动大厅1","jp":"お祭り、大盛り上がりだね。こっちまで熱くなってくる。","zh":"祭典的气氛……真的好热闹啊。连我这边都跟着兴奋起来了。"},{"label":"活动大厅2","jp":"日差しが強い、ちゃんと市外線対策しないと、日焼けって、やけどなんだって。","zh":"阳光好强……得好好做好防晒才行。听说晒伤，其实跟烫伤差不多呢。"},{"label":"活动大厅3","jp":"私が気になるの? ごめんなさい。めどってしまって。","zh":"老师一直在看我吗？对、对不起……一不小心就看入迷了。"},{"label":"活动大厅4","jp":"先生も、そう思わない?","zh":"老师……不也是这么觉得的吗？"},{"label":"活动事件1","jp":"まだ余裕はあるけど、気を抜かずにいこう。","zh":"虽然现在还有余裕……不过还是别放松警惕比较好。"},{"label":"活动事件2","jp":"ラストスパートだね みんな頑張ろう","zh":"已经是最后冲刺了呢……大家，一起加油吧。"},{"label":"活动结束","jp":"先生、最後までありがとう。次も一緒に楽しもうね。","zh":"老师，谢谢你陪我走到了最后。下次……也一起享受吧。"}]},"stats":{"init":[{"name":"攻击力","value":"270"},{"name":"防御力","value":"20"},{"name":"生命值","value":"2542"},{"name":"治愈力","value":"1630"},{"name":"命中值","value":"891"},{"name":"闪避值","value":"201"},{"name":"暴击值","value":"198"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"2016"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"5(1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"6263"},{"name":"防御力","value":"111"},{"name":"生命值","value":"50314"},{"name":"治愈力","value":"5804"},{"name":"命中值","value":"1111"},{"name":"闪避值","value":"201"},{"name":"暴击值","value":"1328"},{"name":"暴击伤害","value":"226%"},{"name":"稳定值","value":"2016"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"136"},{"name":"装弹数","value":"5(1)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"weapon":[{"name":"攻击力","value":"不用写"},{"name":"生命值","value":"不用写"},{"name":"治愈力","value":"不用写"}]},"equipDetails":[{"slot":"1号装备","name":"手套","grade":"T10","attrs":[{"name":"攻击力","value":"50%"},{"name":"暴击值","value":"500"},{"name":"命中值","value":"220"}]},{"slot":"2号装备","name":"发夹","grade":"T10","attrs":[{"name":"生命值","value":"13000"},{"name":"群控抵抗力","value":"36%"},{"name":"暴击值","value":"1