.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/280756.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/43637/2025/4/27/948381.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★3 芹香（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/376253.png","url":"https://www.gamekee.com/ba/150380.html"},{"name":"★3 芹香（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/733892.png","url":"https://www.gamekee.com/ba/161197.html"},{"name":"NPC 芹香(偶像)","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/103682/2025/5/10/849624.png","url":"https://www.gamekee.com/ba/639182.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"黒見セリカよ。\n言っとくけど私が一緒になる以上真面目にやってよね？","zh":"我是黑见芹香，丑话说在前头，跟我一起工作可不能摸鱼。"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ先生。待ってたわよ。\n…って違う違う！ そんなに待ってないから！","zh":"老师好啊，我在等你呢，嗯..也没有等很久。"},{"label":"登陆2","jp":"私がいる時ぐらいは真面目に働いてよ。\n…私も手伝うからさ。","zh":"至少在我面前的时候别摸鱼吧，我也会帮您一起做的。"},{"label":"大厅1","jp":"今待機中。何か用？","zh":"正在等任务呢，有事吗"},{"label":"大厅2","jp":"あんたね。そんな暇があったら、やるべきことをやんなさいよ！","zh":"说你什么好啊，有这种闲工夫，把该做的事情做了啊！"},{"label":"大厅3","jp":"（私がこんなにそばにいるんだから少しは興味を持ってよ…）","zh":"都这么陪着你了，就不能稍微关心一下人家嘛..（心声）"},{"label":"大厅4","jp":"あまり無理するのも良くないよ？必要なら私が手伝ってもいいよ。","zh":"太勉强自己也不好哦，要我来帮你也不是不可以。"},{"label":"回忆大厅1","jp":"（もっと頑張るしかない。\nこの町が無くなりそうなのを放っておくわけにはいかないから…）\n今は… 頼れる大人もいるから…。","zh":"我还得继续努力，总不能看着眼睁睁地这个街区自生自灭，现在终于有大人可以依靠了。"},{"label":"回忆大厅2","jp":"先生、こっちに来て。私と一緒に乗る？\n…あはは、冗談だよ。 いくらなんでもそれは無理だよね。","zh":"老师，过来呀，要不要..坐我边上？嗯哈哈，开玩笑的，怎么可能两个人一起荡秋千啊？"},{"label":"回忆大厅3","jp":"あの～、聞いてる？今めっちゃ真面目な雰囲気なんだから。\n…まったく。","zh":"歪？听见没有？现在可是在和你说正经的呢，真无语.."},{"label":"回忆大厅4","jp":"…うん？ご苦労様って？\n私の努力を よく知ってるって、何それ…。\nな、何の話？！いきなり 慰めてくるのはやめて！！\nこ、これは違うの、 目にゴミが入っただけよ…！","zh":"啊？你说我辛苦了？你知道我一直都很努力，什么意思啊？欸，说这个干嘛？不要莫名其妙的突然安慰我好不好，这...不是那样的，只是眼里突然进了沙子.."},{"label":"回忆大厅5","jp":"（でも先生じゃなかったら…私はもっと前に諦めてたかもしれない）\nな、なに？！何で そんなにじっとしているの…？","zh":"其实，如果没有老师，我可能在很早以前就已经放弃了（心声），干..干嘛，为什么要一直这样盯着我看啊？\n回忆大厅6"},{"label":"回忆大厅6","jp":"押してくれる？\nだ、大丈夫じゃないわ！ 誰かが見てたらどうするつもり！\n…な、なんでもないわよ！！ \nこ、こうやって先生と 二人っきりでデートしてることがバレてしまったら…","zh":"要帮我推？怎..怎么会没关系，被人看到了该怎么说啊？没什么意思好吧，就..就是我们，我和老师两个人单独出来玩的事情，被别人知道的话..."},{"label":"咖啡馆1","jp":"うーん、少しは親切にしてあげた方がよかったかな","zh":"额..我是不是应该再温柔一点啊？"},{"label":"咖啡馆2","jp":"バイトに行く時間は…まだみたい","zh":"该去打工了吧，啊，还有会儿。"},{"label":"咖啡馆3","jp":"ここ、アルバイト探してたりとかって…","zh":"听说这里，好像在招兼职什么的。"},{"label":"咖啡馆4","jp":"わあ！うれし…","zh":"哇！好开心！"},{"label":"咖啡馆5","jp":"あはは。","zh":"欸嘿嘿.."}],"好感度":[{"label":"好感度1","jp":"今日の私、どうだったかなぁ…。","zh":"我今天，表现的怎么样啊？"},{"label":"好感度2","jp":"大事にするね、先生。","zh":"我会好好珍惜的，老师。"},{"label":"好感度3","jp":"ふふ、まだ二人だけの秘密ね？","zh":"欸嘿嘿，这件事，还是我们两个人之间的秘密哦！"},{"label":"好感度4","jp":"こんなにどきどきしてるのに…。","zh":"害得人家那么激动了.."}],"战斗":[{"label":"编入队伍1","jp":"出撃ぃ？仕方ないわね、ありがたく思いなさいよ。","zh":"出击，真没办法，记得好好感谢我哦！"},{"label":"编入队伍2","jp":"しょうがない、やってやるわ！","zh":"算了，那就我来吧。"},{"label":"拎起","jp":"なにぃ？ちょっと待ってて。","zh":"干嘛呀，哎，先等等！"},{"label":"任命队长1","jp":"さあみんな、気合い入れていくわよ！","zh":"大家注意，都打起精神！"},{"label":"任命队长2","jp":"言っとくけど、真面目にやるから。","zh":"丑话说前头，我可是很较真的！"},{"label":"普通技能","jp":"","zh":"要上了！"},{"label":"EX动画1","jp":"にゃぁぁ～、マジムカついてきたぁ！","zh":"嗯哼啊，真是气死我了！"},{"label":"EX动画2","jp":"許せないっ！","zh":"饶不了你！"},{"label":"EX动画3","jp":"怒ってるってばぁ！","zh":"我好气啊!"},{"label":"EX技能1","jp":"やっ！！","zh":"呀！"},{"label":"EX技能2","jp":"はあぁぁぁぁぁっ！！","zh":"哈啊！"},{"label":"EX技能3","jp":"覚悟しなさい！","zh":"给我觉悟吧！"},{"label":"战斗开始1","jp":"よし、行こっか。","zh":"好，上吧！"},{"label":"战斗开始2","jp":"さぁ、行こ！","zh":"来，走吧！"},{"label":"获得BUFF","jp":"-","zh":"-"},{"label":"施放BUFF","jp":"-","zh":"-"},{"label":"掩体","jp":"-","zh":"-"},{"label":"被CC1","jp":"くっ！","zh":"（喘气）"},{"label":"被CC2","jp":"うう！","zh":"（无法形容的喘气）"},{"label":"被CC3","jp":"ああ！","zh":"（妈听打的喘气）"},{"label":"被CC4","jp":"やぁあ！","zh":"呀呀呀啊！"},{"label":"被CC6","jp":"しまった！","zh":"糟了！"},{"label":"回复","jp":"サンキュー！ナイスタイミングね。","zh":"Thank you~时机正好！"},{"label":"中途退出","jp":"肩に……力を入れすぎたかな……","zh":"是不是，肩膀抵太紧了呀..."},{"label":"战斗胜利1","jp":"ふん！簡単な任務だったから当然よ～。","zh":"哼，这么简单的任务，没什么了不起的。"},{"label":"战斗胜利2","jp":"な、なにじっと見てんのよ～。こっち見んな～！","zh":"你...你看什么看，不许看！"},{"label":"关卡完成1","jp":"これくらい何でもないから。","zh":"哼，小意思罢了。"},{"label":"关卡完成2","jp":"うへへ、楽勝楽勝~","zh":"欸嘿嘿，轻轻松松！"},{"label":"战斗失败1","jp":"指揮は悪くなかったけど……","zh":"指挥，是还可以啊...."},{"label":"战斗失败2","jp":"うう……悪かったわ……","zh":"呃啊，不好意思啊...."}],"z'd":[{"label":"被CC5","jp":"しまった","zh":"糟了！"}],"成长":[{"label":"升级1","jp":"べ、別に先生のために強くなったんじゃないからぁ！","zh":"别瞎想好不好，我怎么可能是为了老师努力的。"},{"label":"升级2","jp":"まぁ、正直このままでも十分強いけど、期待してくれていいよ。","zh":"其实，我本来已经很强了，但..也不是不能变得更强啊？"},{"label":"升级3","jp":"今なら誰にも負けない気がする～！","zh":"现在的我，不会输给任何人！"},{"label":"升级4","jp":"前よりもっと強くなれた気がする！","zh":"感觉，比以前更强了！"},{"label":"获得专武","jp":"よし、これなら少しはみんなの役に立てると思う！","zh":"好，这样，应该就能给大家帮上一点忙了！"}],"事件":[{"label":"学生生日","jp":"え？誕生日。あ…ありがとう。覚えて…くれてたのね…。\nえへへ！","zh":"哎？我的生日？谢、谢谢，原来...您记得啊，欸嘿嘿.."},{"label":"老师生日","jp":"あの、お、お誕生日おめでとう。あと、いつも一緒にいてくれてありがとう。\n…わ、笑うな！","zh":"哎..生、生日快乐，还有，谢谢您一直陪着我，不、不准笑！"},{"label":"万圣节","jp":"ひっ！べ、別にちっとも怖くないし？\n目玉のキャンディーとかカボチャの頭とか本当にちっとも怖くないけど？","zh":"呀！我、我才没在怕呢（跑音），什么眼球糖果，南瓜头，我可是一丁点都不怕（"},{"label":"新年","jp":"正月か…。初詣でも…。\nべ、別に一緒に行きたいってわけじゃないんだからね？！","zh":"新年啊。要不要去拜一拜..我、我可没说想跟你一起去啊！"},{"label":"圣诞节","jp":"メリークリスマ～ス どうせ先生は、クリスマスも暇でしょう？\n独りぼっちはかわいそうだから…。今日だけは相手してあげる！","zh":"诞快乐?欸嘿，不问也知道，老师圣诞节肯定没什么安排吧，看你一个人可怜巴巴的，那今天我就陪陪你好啦！"},{"label":"春节","jp":"","zh":"新春？\n先说好，我可没想过要和你去看日出！"},{"label":"中秋","jp":"","zh":"中秋啊……阿拜多斯的大家，现在在做什么呢？"}]},"stats":{"init":[{"name":"攻击力","value":"311"},{"name":"防御力","value":"19"},{"name":"生命值","value":"2302"},{"name":"治愈力","value":"1543"},{"name":"命中值","value":"717"},{"name":"闪避值","value":"820"},{"name":"暴击值","value":"256"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1364"},{"name":"射程","value":"650"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"15 (3)"},{"name":"防御无视值","value":"0"},{"name":"受恢复率","value":"100%"},{"name":"COST恢复力","value":"700"}],"max":[{"name":"攻击力","value":"8714"},{"name":"防御力","value"