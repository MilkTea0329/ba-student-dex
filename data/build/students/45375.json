mg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/629334.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/236746/2025/5/13/992327.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"★1 泉（泳装）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/13/388661.png","url":"https://www.gamekee.com/ba/83936.html"},{"name":"★3 泉（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/236746/2025/5/13/371131.png","url":"https://www.gamekee.com/ba/650981.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"蔚蓝档案。"},{"label":"卡池抽取","jp":"うわ！！私のことを探してくれてたの？一緒に美味しいもの食べに行こうよ！！","zh":"啊？是在找我吗？一起去吃好吃的吧！"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"ようこそ先生！待ってたよ！早くご飯食べに行こう！\nあ…仕事があるの？","zh":"你来了老师，一直等你呢，快去吃饭吧！啊？你要工作啊.."},{"label":"登陆2","jp":"先生！今日は何を食べに行こっか～。\n任務からやって、って？\nダメだよ、ご飯からだよ！","zh":"老师，今天去吃点什么好呢？要先去任务？不要啦先吃饭嘛.."},{"label":"大厅1","jp":"美味しくない、悪い店をやっつけに行く任務とかないのかな。","zh":"就没有那种去难吃的店里砸场子的任务吗？"},{"label":"大厅2","jp":"シャーレの近くに美味しいお店ないかな？\nトリニティの食堂で食べ尽くしちゃったから…。\nあ、これは言っちゃダメなやつだったっけ…？","zh":"沙勒附近没有好吃的店吗，崔尼蒂附近的食堂都被我吃了个遍了，啊？这个不能说吗？"},{"label":"大厅3","jp":"うん？このお菓子くれるの？\nやっぱり先生は優しいね！","zh":"这个零食是给我的吗？还是老师对我好！"},{"label":"大厅4","jp":"（さっきのあのタコのパンケーキ…美味しそうだったな…）","zh":"刚才那个章鱼松饼好像很好吃的样子！"},{"label":"大厅5","jp":"幸せを運ぶ青い鳥…？\n多分…チキンの味に近いんだろうな～","zh":"带来幸福的青鸟，我猜尝起来应该会比较像鸡肉吧。"},{"label":"回忆大厅1","jp":"","zh":"-"},{"label":"回忆大厅2","jp":"-","zh":"-"},{"label":"回忆大厅3","jp":"-","zh":"-"},{"label":"回忆大厅4","jp":"-","zh":"-"},{"label":"回忆大厅5","jp":"","zh":"-"},{"label":"回忆大厅6","jp":"-","zh":"-"},{"label":"咖啡馆1","jp":"特技？うん！食べることかな！","zh":"我的特长？嗯。应该是吃吧。"},{"label":"咖啡馆2","jp":"食事の時間だったら私を呼んでくれないと！","zh":"开饭的时候记得叫我啊！"},{"label":"咖啡馆3","jp":"ハンバーガーが実る木があったらいいのに！いつか開発されるんじゃないかな？","zh":"要是有可以长出汉堡的树就好了，应该会有人发明出来的吧！"},{"label":"咖啡馆4","jp":"よし！食べ物を探してみる！","zh":"好，我去找点吃的！"},{"label":"咖啡馆5","jp":"よし、今日も頑張ろう！","zh":"好，今天也要加油哦！"}],"好感度":[{"label":"好感度1","jp":"一緒にグルメ巡りに行こう？","zh":"一起踏上寻味之旅吧！"},{"label":"好感度2","jp":"何を食べてもどこで食べても楽しい！先生と一緒だからかな？","zh":"你不管吃的是什么，也不管在哪里吃，都很开心，是因为和老师在一起吗？"},{"label":"好感度3","jp":"今度は何を食べようか？","zh":"这次吃什么好呢？"},{"label":"好感度4","jp":"ああー！","zh":"哇！"}],"战斗":[{"label":"编入队伍1","jp":"オッケー！","zh":"ok！"},{"label":"编入队伍2","jp":"準備完了～！","zh":"准备完毕！"},{"label":"拎起","jp":"う、うん、うんん～","zh":"（吃东西）"},{"label":"任命队长1","jp":"早く終わらせてご飯に行こう？","zh":"早点结束去吃饭吧！"},{"label":"任命队长2","jp":"ああ、この辺においしくて有名なお店があって気がする！","zh":"嗯？附近好像有家好吃又有名的餐厅！"},{"label":"普通技能","jp":"やあ！","zh":"呀！"},{"label":"EX动画1","jp":"-","zh":"出来吧！豪华巧克力汉堡！"},{"label":"EX动画2","jp":"","zh":"嘿，我早有准备！"},{"label":"EX动画3","jp":"-","zh":"锵锵！吃零食了。"},{"label":"EX技能1","jp":"出てきて！デラックスチョコハンバーガー！","zh":"我好了！（音量警告）"},{"label":"EX技能2","jp":"よっ、こういう時のために用意していたの。","zh":"呜哇！（音量警告）"},{"label":"EX技能3","jp":"じゃん—！おやつ登場！","zh":"能量补充好了，你们给我等着吧！（音量警告）"},{"label":"EX技能提升1","jp":"う…う！元気が出る？！","zh":"唔...唔！突然充满元气了？！"},{"label":"EX技能提升2","jp":"ああ、おおおお！","zh":"啊啊，噢噢噢噢！"},{"label":"EX技能提升3","jp":"うううん、おい、エネルギー充電！覚悟しなさい！","zh":"唔...能量充电！做好觉悟吧！"},{"label":"战斗开始1","jp":"攻撃！敵のおやつを全部奪うわよ！","zh":"攻击！把敌人的零食全都抢过来！"},{"label":"战斗开始2","jp":"おやつを食べるために、早く終わらせろう！","zh":"早点结束吧，我要去吃点心了。"},{"label":"获得BUFF","jp":"元気できた！","zh":"我又有力气了！"},{"label":"施放BUFF","jp":"よい、ちょっと！","zh":"嘿！"},{"label":"被CC1","jp":"これは、美味しくない！","zh":"这个，，不好吃！"},{"label":"被CC2","jp":"痛い！","zh":"好疼！"},{"label":"被CC3","jp":"お腹すいた…","zh":"我饿了.."},{"label":"回避","jp":"痛くないわよ！","zh":"-"},{"label":"队伍移动1","jp":"これは終わり？ご飯はいつ？","zh":"什么时候开饭？"},{"label":"队伍移动2","jp":"あの子たちを片付けたら、ご飯を食べに行っていい？","zh":"把这些人都收拾掉的话，就能去吃饭了吗？"},{"label":"回复","jp":"Thank you~でも、お腹空いてきちゃった…","zh":"Thank you~但是..我饿了.."},{"label":"中途退出","jp":"ごめん、もう限界…","zh":"对不起，我撑不住了.."},{"label":"战斗喊叫","jp":"やっ！","zh":"呀！"},{"label":"战斗喊叫","jp":"はっ！","zh":"哈！"},{"label":"战斗喊叫","jp":"くらえ！","zh":"看招！"},{"label":"特殊载具","jp":"あっちに行くね～","zh":"去那边哦~"},{"label":"角色移动","jp":"","zh":"去那边吧！"},{"label":"战斗胜利1","jp":"はむ、うん。よし！","zh":"嗯，嗯！好！"},{"label":"战斗胜利2","jp":"あむ。暴れた後のハンバーガーってやっぱり最高！","zh":"大闹一场之后的汉堡特别香！"},{"label":"关卡完成1","jp":"-","zh":"老师，赢了！你会请我吃好吃的对吧？"},{"label":"关卡完成2","jp":"-","zh":"啊？饭点都到了？动作快点快点！"},{"label":"战斗失败1","jp":"お腹が空いてだから、負けちゃった…","zh":"我饿了..所以输了.."},{"label":"战斗失败2","jp":"パットしてご飯抜き？！","zh":"输了不许吃饭？？"}],"成长":[{"label":"升级1","jp":"ありがとう、先生！少しはお腹が満たされた気分！","zh":"谢谢老师，感觉肚子填饱一点了！"},{"label":"升级2","jp":"どうしてそんな大事な食べ物をいつも私にくれるの？","zh":"为什么总是给我吃这么好的东西呢？"},{"label":"升级3","jp":"ごちそうさまでした～！","zh":"多谢款待！"},{"label":"升级4","jp":"よ～し！美味しいものいっぱい食べて力を付けよう！","zh":"好嘞，多吃点好吃的东西，多涨点力气吧！"},{"label":"获得专武","jp":"美味しいものを食べるための道具が、また一つ増えちゃった！もちろんお箸とかそういうとは違うけど...これであれこれ一杯食べに行こう、先生。","zh":"能让我吃到美食的工具又多了一样，当然了，和筷子这类的东西是两码事，不过以后我们就可以去吃更多其他的好东西了，老师！"}],"事件":[{"label":"学生生日","jp":"じゃーん！今日が何の日か知ってる？\nえっへん！とにかく美味しいものを食べる日なんだ～！\nじゃ、一緒にケーキ食べよう！特別に少し分けてあげてもいいよ？","zh":"锵！你知道今天是什么日子吗？欸嘿！是必须要吃美食的日子，走，我们去吃蛋糕吧！我可以破例分你一点哦！"},{"label":"老师生日","jp":"先生！お誕生日なの？\nだったらカフェを貸し切って、一日中ケーキを食べよう！\n今日一日、私が一緒にいてあげる！","zh":"老师，今天是你生日啊！那我们把咖啡厅包下来，吃一整天的蛋糕吧，今天一整天我都会陪你！"},{"label":"万圣节","jp":"やっほー先生！Treat or Treat！だよ！早く行ってみよう！\nスイカぐらい大っきい飴もあるんだって！","zh":"呦吼！老师，今天该玩不给糖就捣蛋了，快走快走，听说还有西瓜那么大的糖果呢！"},{"label":"新年","jp":"お正月だよ！早くお餅とお汁こを食べなきゃ！\nあっちに行ったら甘酒もくれるんだって！","zh":"过年啦，该吃打糕和红豆沙了，听说去那边还能领到甜酒呢！"},{"label":"圣诞节","jp":"クリスマスね…\n七面鳥とか生クリームのケーキが美味しいよね～\nそれを一緒に食べると、もっと美味しいよね～","zh":"圣诞节啊..烤火鸡和奶油蛋糕可好吃了，要是能两个一起吃那就更棒了。"},{"label":"春节","jp":"","zh":"新春到了，又可以大吃大喝了。"},{"label":"中秋","jp":"","zh":"月饼，莲蓉的、蛋黄的、五仁的、豆沙的、鲜肉的。"}]},"stats":{"init":[{"name":"攻击力","value":"238"},{"name":"防御力","value":"81"},{"name":"生命值","value":"2571"},{"name":"治愈力","value":"1611"},{"name":"命中值","value":"97"},{"name":"闪避值","value":"195"},{"name":"暴击值","value":"244"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1428"},{"name":"射程","value":"750"},{"name":"群控强化力","value":"100"},{"name":"群控抵抗力","value":"100"},{"name":"装弹数","value":"45 (3)"},{"name":"防御无视值","value":"0