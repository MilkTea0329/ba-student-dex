61/h_61/829/43637/2025/4/26/766988.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_61/h_61/829/43637/2025/4/26/163858.png"],"chocolate":{"icon":"","name":"","desc":""},"ability":{"attrs":[{"name":"生命值","value":"781"},{"name":"攻击力","value":"128"}],"mats":["https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/640956.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/318966.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/251931.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/10/350577.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_304/h_240/829/737047/2025/5/10/82134.png","https://cdnimg-v2.gamekee.com/wiki2.0/images/w_146/h_116/829/43637/2025/4/27/454243.png"]},"sameName":[{"name":"阿露","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/526689.png","url":"https://www.gamekee.com/ba/57763.html"},{"name":"阿露（正月）","icon":"https://cdnimg-v2.gamekee.com/wiki2.0/images/w_252/h_204/829/737047/2025/5/10/305853.png","url":"https://www.gamekee.com/ba/150220.html"}],"voices":{"通常":[{"label":"标题","jp":"ブルーアーカイブ。","zh":"Blue Archive……嘿嘿。"},{"label":"卡池抽取","jp":"あら、今回はどんな依頼？それとも、ビジネスの提案かしら？まあ～どちらにしても、来てくれて嬉しいわ、先生。","zh":"咦，这次是什么委托？还是说……是商业提案呢？\n……不管是哪种，总之很高兴您能来哦，老师~"}],"大厅及咖啡馆":[{"label":"登陆1","jp":"お帰りなさい、先生。\n早速、仕事の話をしましょう。","zh":"老师，欢迎回来！\n马上来聊聊工作吧。"},{"label":"登陆2","jp":"待てたわ、今日の依頼は何かしら？もちろん、エスコートしてくれるでしょう。","zh":"我一直在等你呢。\n今天的委托是什么？你会作陪吧？"},{"label":"大厅1","jp":"どんな依頼でも言ってちょうだい、今日の私たちは、特別だもの。","zh":"什么请求都可以，尽管说吧！\n因为今天的我们……很特别。"},{"label":"大厅2","jp":"せっかくの正装ですもの、ね先生、一緒にお出かけしましょう。","zh":"难得穿次正装。那个……老师，要不要一起……出去下？"},{"label":"大厅3","jp":"ドレスが似合ってる？\nあ、当たり前よ、私は社長なんだから！\nうふふ...","zh":"你说礼服很适合我……？\n那，那当然！因为，我是社长嘛！诶嘿嘿……"},{"label":"大厅4","jp":"うう～\nこのドレス、ふにりんぐだい高そう..\nう、うん？別に何も言いてないわ。","zh":"呜……\n这件礼服，干洗费应该不便宜……\n嗯？……我什么也没说！"},{"label":"大厅5","jp":"ねえ、たまには仕事以外の話もしていいのよ。","zh":"我说啊，有时候除了工作上的事，也可以聊聊别的呀。"},{"label":"回忆大厅1","jp":"はぁ...こんなことになるなんて、思いもしなかったわ。でも...先生の言った通り、こういうのも悪くはないわね。","zh":"唉……没想到，会变成这样。\n不过，正如老师所说，这样也不赖呢。"},{"label":"回忆大厅2","jp":"正直、不思議だったのよ...ちゃんとした格好の大人が　どうしてこんな所でわざわざご飯食べるのか...。","zh":"说实话，我觉得很神奇……\n穿着得体的大人，为什么非得到这种地方来吃饭？"},{"label":"回忆大厅3","jp":"でも...今なら、少しわかる気がするわ。それぞれ理由は違っても....きっと、みんなこういう気持ちだったのかな、って","zh":"不过，现在有点明白啦。\n即使各自的理由不尽相同……但想必，大家一定都是因为有这种心情。"},{"label":"回忆大厅4","jp":"...先生も、きっとそうなのよね。","zh":"老师，肯定也是如此吧。"},{"label":"回忆大厅5","jp":"ふふ...私も少しは...先生に近づけたのかしら？","zh":"诶嘿嘿……我是不是，也稍微变得有点像老师啦？"},{"label":"咖啡馆1","jp":"あ、あの人は....でも、ここなら大丈夫よね...","zh":"那，那个人是……！\n不过在这里的话，应该没关系吧……"},{"label":"咖啡馆2","jp":"ここの雰囲気、嫌いじゃないわ。","zh":"这里的氛围，我并不反感。"},{"label":"咖啡馆3","jp":"そろそろ大きめの仕事、一つ決めたいところだけど。","zh":"我差不多，该风风光光地干一件大事了。"},{"label":"咖啡馆4","jp":"どこかにいい取引先ないかしら？","zh":"有没有合适的交易对象呢？"},{"label":"咖啡馆5","jp":"ん...今月の運営費、どうしよう。","zh":"呜……这个月的运营费，该怎么办呐……"}],"好感度":[{"label":"好感度1","jp":"先生には、どこまで打ち明けたらいいのかしら、こまってしまうわね。","zh":"应该对老师，坦白到什么程度呢……真难办呢。"},{"label":"好感度2","jp":"言葉だけじゃ、足りない気もするけど。\n感謝しているわ、先生。","zh":"虽然我觉得，光靠语言可能是不够的……\n但我还是想说，非常感谢你，老师。"},{"label":"好感度3","jp":"こういう時、何と言えばいいかしら？私にも、わからないことくらいあるわよ。","zh":"这种时候，该说什么好呢……\n看来，也有我不知道的事啊。"},{"label":"好感度4","jp":"先生その...\nいいえ、なんでもないいわ。","zh":"老师，那个……\n呜，没，没什么。"}],"战斗":[{"label":"编入队伍1","jp":"んへんへん、なるほど。","zh":"诶嘿嘿嘿，果然。"},{"label":"编入队伍2","jp":"賢明な判断ね。","zh":"明智的判断~"},{"label":"拎起","jp":"私が何か用...\nはあー！ふ...","zh":"你有什么话要对我sh……\n呃啊？！……哈……"},{"label":"任命队长1","jp":"この依頼、私にぴったりね。","zh":"这个委托，可真适合我。"},{"label":"任命队长2","jp":"心配は無用よ、私に任せなせい。","zh":"不用担心，交给我吧。"},{"label":"普通技能","jp":"んへんへん、\nあっ、ちょっと！","zh":"诶嘿嘿，啊……等等！！"},{"label":"EX动画1","jp":"社長からの提案よ。","zh":"这是社长的提议哦？"},{"label":"EX动画2","jp":"名前くらいは、聞いたことあるでしょう？","zh":"这个名字，你听说过吧？"},{"label":"EX动画3","jp":"ありがたく受け取りなさい。","zh":"建议你恭敬不如从命。"},{"label":"EX技能1","jp":"興味あるなら、連絡して頂戴。","zh":"有兴趣的话，请联系我。"},{"label":"EX技能2","jp":"便利屋68、覚えておきなさい。","zh":"是便利屋68，给我好好记住。"},{"label":"EX技能3","jp":"どう、悪くない提案でしょう？","zh":"怎么样，这个提议不错吧？"},{"label":"战斗开始1","jp":"さあー、始めましょう。","zh":"那，开始吧~"},{"label":"战斗开始2","jp":"みんな、行くわよ。","zh":"大家，出发吧。"},{"label":"获得BUFF","jp":"良い投資ね。","zh":"不错的投资。"},{"label":"施放BUFF","jp":"私を誰だと思ってるの？","zh":"你当我是谁啊？"},{"label":"掩体","jp":"私を倒せるとって思う？","zh":"想打败我？"},{"label":"被CC1","jp":"くは...","zh":"呃啊！"},{"label":"被CC2","jp":"う..","zh":"咳……"},{"label":"被CC3","jp":"ちっ...","zh":"切……"},{"label":"回避","jp":"へん、その程度かしら？","zh":"嗯……？就这点水平啊？"},{"label":"队伍移动1","jp":"ここは片付いたわね。","zh":"这里搞定了。"},{"label":"队伍移动2","jp":"まだ残党がいるわ、次に向かうわよ。","zh":"还有漏网之鱼，去下一个地方吧。"},{"label":"回复","jp":"ありがとう。","zh":"谢谢~"},{"label":"中途退出","jp":"これは...その...","zh":"这个……就是说……"},{"label":"战斗喊叫","jp":"はっ","zh":"哈！"},{"label":"战斗喊叫","jp":"ふっ","zh":"嘿！"},{"label":"战斗喊叫","jp":"はあ！","zh":"哈啊！"},{"label":"角色移动","jp":"はあー！","zh":"哈……！"},{"label":"战斗胜利1","jp":"もう終わり？思ったより簡単な依頼だったわね。","zh":"这就结束了？没想到这份委托这么简单呢。"},{"label":"战斗胜利2","jp":"くふ、期待以上、だったでしょう。","zh":"诶嘿嘿~超出你的预期了吧？"},{"label":"关卡完成1","jp":"私の手にかかれば、これくらい当然よ。","zh":"既然由我负责，那这是理所当然的。"},{"label":"关卡完成2","jp":"どう、満足してもらったかしら？","zh":"怎么样~还满意吗？"},{"label":"战斗失败1","jp":"ま、待って、次こそは...","zh":"等，等一下……！下次一定……"},{"label":"战斗失败2","jp":"な、なんですってーー！！","zh":"你，你说什么……！！"}],"成长":[{"label":"升级1","jp":"先見の明があるのね。約束するわ、絶対、先生をがっかりさせないって。","zh":"很有先见之明嘛。我保证，绝对不会让老师失望的。"},{"label":"升级2","jp":"ここまで期待されてるなんて...私も、もっと自分に磨きをかけないといけないわね。","zh":"居然对我有这么高的期待……\n看来我也必须要更加精进才行了。"},{"label":"升级3","jp":"安心して、私が強くなっても、先生を置いて行たりしないわよ。","zh":"放心吧，就算我变得再强大，也不会丢下老师不管的。"},{"label":"升级4","jp":"くふふ、この先も、私に期待してで頂戴。","zh":"诶嘿嘿，以后也要继续期待我的表现哦？"},{"label":"获得专武","jp":"長い付き合いだもの、「信頼してる」なんて言葉、今さらよね。\nそうね、これからもよろしく、先生。\nええ、これだけで十分よ。","zh":"我们相处了这么长时间，【信任】这种话……还真是让人觉得新鲜。\n……也是，以后也请多多关照了，老师。\n嗯，这就足够了。"}],"事件":[{"label":"学生生日","jp":"え、えっ？！\n私の誕生日、だけど。\n覚えてってくれたの？\nあ、あ、ありがとう。","zh":"诶，诶？！\n今天，确实是我的生日……\n不过你居然记得……！\n……谢，谢谢你。"},{"label":"老师生日","jp":"うふふふ...\n今日は飛び切り特別な日ね。\n覚えているに決まてるじゃない？\nお誕生日おめでとう、先生。","zh":"诶嘿嘿嘿~\n今天可是个格外特别的日子，我当然记得啦。\n……生日快乐，老师。"},{"label":"万圣节","jp":"街中が浮かれているわね。\n先生はどう？パーティーでも開く？","zh":"街上真热闹……\n老师觉得怎么样？要不要开个派对？"},{"label":"新年","jp":"明けましておめでとう、先生。\n言うまでもないけど、私たちの協力関係は続くから。\n今年もしっかり、頼むわよ。","zh":"新年快乐，老师。\n我们的合作关系会继续下去，这点毋庸置疑。\n所以今年也请多多关照啦。"},{"label":"圣诞节","jp":"私たち便利屋にとっては、いつもと変わらない日だけど。\nそうね、先生と一緒なら、意味のある日になるそうだわ。","zh":"虽然对我们便利屋来说，今天和平时没什么不同。\n但是我觉得，如果和老师在一起，今天就变得意义非凡啦。"},{"label":"春节","jp":"","zh":"老师，过年好啊~\n今年新春我换了一身衣服，怎么样？\n……嗯？你问会不会冷？\n啊哈哈……这根本不算什……啊……阿嚏！"},{"label":"中秋","jp":"","zh":"恰逢月圆之夜……老师，不来共饮一杯吗？\n……啊？不到二十岁不能喝酒？\n这，这其实是蓝莓汁啦……"}],"活动":[{"label":"活动登陆1","jp":"さあー、仕事の時間よ、先生！","zh":"好啦，该工作了老师！"},{"label":"活动登陆2","jp":"ちょっといいわ、先生に見せたいものがあるの。","zh":"老师来的正好，我给你看个东西。"},{"label":"活动大厅1","jp":"えん？先生？何か話でもあるのかしら？","zh":"嗯？老师……？\n怎么啦？"},{"label":"活动大厅2","jp":"し、しーー静かに！！\n潜入がバレちゃうでしょう？！","zh":"嘘，嘘！……小声点！\n会被发现的！"},{"label":"活动大厅3","jp":"いーー！！\nああ、先生じゃないの...","zh":"诶——！！\n啊……是老师啊……"},{"label":"活动大厅4","jp":"こ、ここはまずいわ。\n外で話しましょう。","zh":"这，这里很危险，我们出去再谈吧！"},{"label":"活动事件1","jp":"もうこんな時間。","zh":"都已经这么晚了啊……"},{"label":"活动事件2","jp":"ハイハイものね、そろそろ幕引きかしら？","zh":"时间过得真快啊……要接近尾声了吧。"},{"label":"活动结束","jp":"仕上げまで手を抜いちゃだめよ。","zh":"要坚持到最后啊，不可以放手。"},{"label":"BoxShop_1","jp":"し、集中しなさい。\nいいや、私じゃなくて、資料に。","zh":"专，专注一点……！\n不，不是对我，是对资料！"},{"label":"BoxShop_2","jp":"えん、えん？\nわ、私に何か用なの？","zh":"嗯，嗯……？\n有什么话要说吗……？"},{"label":"BoxShop_300","jp":"情報は揃ったけど、念のため、も少し見てみましょう。","zh":"情报虽然已经收集齐了，但以防万一，我们还是再仔细看看吧。"},{"label":"BoxShop1_End","jp":"ターゲットのことを、もうちょっと調べたいわね。","zh":"我想再多了解一下目标。"},{"label":"BoxShop_Login_1","jp":"それじゃ、手掛かりを集めるわよ。","zh":"那，我们来收集线索吧。"},{"label":"BoxShop_Login_2","jp":"先生、資料をまとめたいの、付き合ってもらえるかしら？","zh":"老师，我想整理一下资料。\n可以帮我一下吗？"},{"label":"Boxshop_SPBuy_1","jp":"おお、そういうことだったのね。","zh":"啊……原来是这样啊。"},{"label":"Boxshop_SPBuy_2","jp":"完全に、理解したわ。","zh":"我，彻底明白了！"},{"label":"Boxshop_SPBuy_3","jp":"さすが、私の見込んだパートナーだわ。","zh":"不愧是我看中的搭档！"}]},"stats":{"init":[{"name":"攻击力","value":"345"},{"name":"防御力","value":"17"},{"name":"生命值","value":"2218"},{"name":"治愈力","value":"1661"},{"name":"命中值","value":"908"},{"name":"闪避值","value":"198"},{"name":"暴击值","value":"201"},{"name":"暴击伤害","value":"200%"},{"name":"稳定值","value":"1980"},{"name":"射程","value":"750"},{"name":"群控强化力","v